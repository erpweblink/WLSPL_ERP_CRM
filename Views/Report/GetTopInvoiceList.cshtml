                                        </div>
                                    </div>


                                    <!-- MODAL FOOTER -->
                                    <div class="modal-footer">

                                        <div class="me-auto text-muted">
                                            @monthData.Count salesperson(s)
                                        </div>

                                        <button type="button"
                                                class="btn btn-secondary"
                                                data-bs-dismiss="modal">

                                            Close

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                    }

                </div>

            </div>
        }
}

</div>
