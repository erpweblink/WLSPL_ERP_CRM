@model List<WEBLINK_CRM.Models.VM_Reports>

@{
    ViewData["Title"] = "Top Salesperson - Year & Month Wise";

    var groupedYears = Model
        .GroupBy(x => x.Year)
        .OrderByDescending(x => x.Key);
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    .tablehead {
        color: black;
    }

    :root {
        --ink: #151b24;
        --ink-soft: #2b3542;
        --paper: #ffffff;
        --line: #e3e1db;
        --muted: #7a8290;
        --gold: #b8863b;
        --gold-bg: #faf1de;
        --silver: #78818f;
        --silver-bg: #f0f1f3;
        --bronze: #a66a3d;
        --bronze-bg: #f6e9de;
        --revenue: #3f7a5e;
        --revenue-bg: #eaf3ee;
    }

    .sp-report {
        font-family: 'Inter', -apple-system, sans-serif;
        color: var(--ink);
    }

        .sp-report .display {
            font-family: 'Space Grotesk', 'Inter', sans-serif;
        }

        .sp-report .tnum {
            font-variant-numeric: tabular-nums;
        }





    /* ================================
                   YEAR SECTION
                ================================ */

    .year-section {
        margin-bottom: 40px;
    }

    .year-title {
        display: flex;
        align-items: baseline;
        gap: 14px;
        margin-bottom: 18px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--ink);
    }

        .year-title .year-num {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 30px;
            font-weight: 700;
            letter-spacing: -.5px;
        }

        .year-title .year-note {
            color: var(--muted);
            font-size: 14px;
        }


    /* ================================
                   MONTH GRID
                ================================ */

    .month-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 14px;
    }


    /* ================================
                   MONTH CARD
                ================================ */

    .month-card {
        position: relative;
        min-height: 200px;
        border: 1px solid var(--line);
        border-left: 3px solid var(--gold);
        border-radius: 4px;
        background: var(--paper);
        cursor: pointer;
        transition: border-color .15s ease, transform .15s ease;
    }

        .month-card:hover {
            border-color: var(--ink-soft);
            border-left-width: 3px;
            transform: translateY(-3px);
        }

        .month-card:active {
            transform: translateY(-1px);
        }

        .month-card .card-body {
            padding: 18px 18px 16px;
            display: flex;
            flex-direction: column;
            height: 100%;
        }


    /* ================================
                   MONTH NAME / COUNT
                ================================ */

    .month-name {
        font-family: 'Space Grotesk', sans-serif;
        color: orangered;
        font-size: 16px;
        font-weight: 600;
    }

    .sales-count {
        color: var(--muted);
        font-size: 12px;
        margin-top: 3px;
    }


    /* ================================
                   TOP PERSON
                ================================ */

    .top-person {
        margin-top: auto;
        padding-top: 14px;
        border-top: 1px solid var(--line);
        font-size: 12px;
        color: black;
    }

        .top-person strong {
            display: block;
            margin-top: 4px;
            font-size: 14px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }


    /* ================================
                   TOP AMOUNT
                ================================ */

    .top-amount {
        margin-top: 6px;
        color: var(--revenue);
        font-family: 'Space Grotesk', sans-serif;
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -.2px;
    }


    /* ================================
                   MODAL
                ================================ */

    #salespersonSalesModal .modal-content {
        border: none;
        border-radius: 6px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(21,27,36,.25);
    }

    #salespersonSalesModal .modal-header {
        background: var(--ink);
        color: #fff;
        padding: 20px 24px;
        border: none;
    }

    #salespersonSalesModal .modal-title {
        font-family: 'Space Grotesk', sans-serif;
        color: #fff !important;
        font-size: 19px;
        font-weight: 600;
    }

    #salespersonSalesModal .modal-header small {
        color: rgba(255,255,255,.60) !important;
    }

    #salespersonSalesModal .btn-close {
        filter: brightness(0) invert(1);
        opacity: .75;
    }

    #salespersonSalesModal .modal-body {
        background: var(--paper);
    }

    #salespersonSalesModal .modal-footer {
        background: #fafafa;
        border-top: 1px solid var(--line);
        padding: 13px 20px;
    }

        #salespersonSalesModal .modal-footer .text-muted {
            color: var(--muted) !important;
            font-size: 13px;
        }

        #salespersonSalesModal .modal-footer .btn-secondary {
            background: var(--ink);
            border-color: var(--ink);
            padding: 7px 20px;
            border-radius: 4px;
            font-weight: 600;
        }

            #salespersonSalesModal .modal-footer .btn-secondary:hover {
                background: var(--ink-soft);
                border-color: var(--ink-soft);
            }

    .modal-backdrop.show {
        opacity: .55 !important;
    }


    /* ================================
                   SALES TABLE
                ================================ */

    .sales-table {
        margin: 0;
    }

        .sales-table thead th {
            padding: 12px 16px;
            background: #5b6493;
            border-bottom: 1px solid var(--line);
            color: var(--muted);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .3px;
        }

        .sales-table tbody td {
            padding: 14px 16px;
            border-color: var(--line);
            vertical-align: middle;
        }

        .sales-table tbody tr:hover {
            background: #fafafa;
        }


    /* ================================
                   RANK
                ================================ */

    .rank-number {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #f1f2f3;
        color: var(--ink-soft);
        font-family: 'Space Grotesk', sans-serif;
        font-size: 13px;
        font-weight: 700;
    }

        .rank-number.rank-1 {
            background: var(--gold-bg);
            color: var(--gold);
            border: 1px solid rgba(184,134,59,.35);
        }

        .rank-number.rank-2 {
            background: var(--silver-bg);
            color: var(--silver);
            border: 1px solid rgba(120,129,143,.35);
        }

        .rank-number.rank-3 {
            background: var(--bronze-bg);
            color: var(--bronze);
            border: 1px solid rgba(166,106,61,.35);
        }


    /* ================================
                   SHARE BAR (relative to month leader)
                ================================ */

    .share-cell {
        min-width: 140px;
    }

    .share-track {
        position: relative;
        height: 5px;
        border-radius: 3px;
        background: #edeeef;
        overflow: hidden;
        margin-bottom: 5px;
    }

    .share-fill {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        border-radius: 3px;
        background: var(--muted);
    }

        .share-fill.rank-1 {
            background: var(--gold);
        }

        .share-fill.rank-2 {
            background: var(--silver);
        }

        .share-fill.rank-3 {
            background: var(--bronze);
        }


    /* ================================
                   AMOUNT
                ================================ */

    .amount {
        color: var(--revenue);
        font-family: 'Space Grotesk', sans-serif;
        font-size: 15px;
        font-weight: 600;
    }


    /* ================================
                   RESPONSIVE
                ================================ */

    @@media (max-width: 1200px) {
        .month-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .month-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .month-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .month-card {
            min-height: 190px;
        }

        .report-header {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @@media (max-width: 480px) {
        .month-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
        }

        .month-card .card-body {
            padding: 13px;
        }

        .month-name {
            font-size: 14px;
        }

        .top-person strong {
            font-size: 12px;
        }

        .top-amount {
            font-size: 15px;
        }

        .share-cell {
            min-width: 90px;
        }
    }

</style>


<div class="container-fluid sp-report">

    <!-- HEADER -->

    <div class="card-header d-flex align-items-center justify-content-between">
        <h3 class="mb-0 text-uppercase">
            <i class="fa fa-users"></i>
            Top Salesperson
        </h3>
        <div class="header-mark">Leaderboard</div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No sales data found.
        </div>
    }
    else
    {
        foreach (var yearGroup in groupedYears)
        {
            <div class="year-section">

                <!-- YEAR -->
                <div class="year-title">
                    <span class="year-num">@yearGroup.Key</span>
                    <span class="year-note">Monthly sales</span>
                </div>


                <!-- MONTH CARDS -->
                <div class="month-grid">

                    @foreach (var monthGroup in yearGroup
                                .GroupBy(x => new { x.Month, x.MonthName })
                                .OrderBy(x => x.Key.Month))
                    {
                        var monthData = monthGroup
                        .OrderByDescending(x => x.TotalAmount)
                        .ToList();

                        var topPerson = monthData.FirstOrDefault();

                        // Unique modal ID for every month
                        var modalId = $"salesModal_{yearGroup.Key}_{monthGroup.Key.Month}";


                        <!-- MONTH CARD -->
                        <div class="card month-card"
                             role="button"
                             data-bs-toggle="modal"
                             data-bs-target="#@modalId">

                            <div class="card-body">

                                <!-- MONTH -->
                                <div class="month-name">
                                    @monthGroup.Key.MonthName
                                </div>

                                <!-- SALESPERSON COUNT -->
                                <div class="sales-count">
                                    @monthData.Count salesperson(s)
                                </div>

                                <!-- TOP SALESPERSON -->
                                @if (topPerson != null)
                                {
                                    <div class="top-person">

                                        Top salesperson

                                        <strong title="@topPerson.Name">
                                            @topPerson.Name
                                        </strong>

                                        <div class="top-amount tnum">
                                            ₹@topPerson.TotalAmount.ToString("N2")
                                        </div>

                                    </div>
                                }

                            </div>

                        </div>


                        <!-- ================================= -->
                        <!-- MONTH SALESPERSON MODAL -->
                        <!-- ================================= -->

                        <div class="modal fade"
                             id="@modalId"
                             tabindex="-1"
                             aria-labelledby="@(modalId)_Label"
                             aria-hidden="true">

                            <div class="modal-dialog modal-lg modal-dialog-centered">

                                <div class="modal-content">

                                    <div class="modal-header">

                                        <div>
                                            <h5 class="modal-title" id="@(modalId)_Label">
                                                @monthGroup.Key.MonthName @yearGroup.Key
                                            </h5>

                                            <small class="modal-title">
                                                Salesperson performance
                                            </small>
                                        </div>

                                        <button type="button"
                                                class="btn-close"
                                                data-bs-dismiss="modal">
                                        </button>

                                    </div>


                                    <!-- MODAL BODY -->
                                    <div class="modal-body p-0">
                                        <div style="overflow-x: auto; max-height: 600px; overflow-y: auto; border: 1px solid #ccc;">
                                            <div class="table-responsive">

                                                <table class="table table-hover align-middle mb-0 sales-table">

                                                    <thead class="tablehead">

                                                        <tr>

                                                            <th>
                                                                Rank
                                                            </th>

                                                            <th>
                                                                Salesperson
                                                            </th>

                                                            <th>
                                                                Share of top
                                                            </th>

                                                            <th>
                                                                Total sales
                                                            </th>

                                                        </tr>

                                                    </thead>


                                                    <tbody>

                                                        @{
                                                            int rank = 1;
                                                        }

                                                        @foreach (var person in monthData)
                                                        {
                                                            var rankClass = rank <= 3 ? $"rank-{rank}" : "";
                                                            var sharePct = (topPerson != null && topPerson.TotalAmount > 0)
                                                            ? (double)(person.TotalAmount / topPerson.TotalAmount * 100)
                                                            : 0;

                                                            <tr>

                                                                <!-- RANK -->
                                                                <td class="tablehead">
                                                                    <span class="rank-number @rankClass">
                                                                        @rank
                                                                    </span>
                                                                </td>


                                                                <!-- SALESPERSON -->
                                                                <td>
                                                                    <strong>
                                                                        @person.Name
                                                                    </strong>
                                                                </td>


                                                                <!-- SHARE -->
                                                                <td class="share-cell">
                                                                    <div class="share-track">
                                                                        <div class="share-fill @rankClass" style="width:@(sharePct.ToString("0.#"))%;"></div>
                                                                    </div>
                                                                </td>


                                                                <!-- AMOUNT -->
                                                                <td class="text-end pe-4">
                                                                    <strong class="amount tnum">
                                                                        ₹@person.TotalAmount.ToString("N2")
                                                                    </strong>
                                                                </td>

                                                            </tr>

                                                            rank++;
                                                        }

                                                    </tbody>

                                                </table>

                                            </div>
                                        </div>
                                    </div>


                                    <!-- MODAL FOOTER -->
                                    <div class="modal-footer">

                                        <div class="me-auto text-muted">
                                            @monthData.Count salesperson(s)
                                        </div>

                                        <button type="button"
                                                class="btn btn-secondary"
                                                data-bs-dismiss="modal">

                                            Close

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                    }

                </div>

            </div>
        }
    }

</div>
