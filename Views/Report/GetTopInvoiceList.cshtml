@model List<WEBLINK_CRM.Models.VM_Reports>

@{
    ViewData["Title"] = "Top Salesperson - Year & Month Wise";

    var groupedYears = Model
        .GroupBy(x => x.Year)
        .OrderByDescending(x => x.Key);
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    .tablehead {
        color: black;
    }

    :root {
        --ink: #151b24;
        --ink-soft: #2b3542;
        --paper: #ffffff;
        --line: #e3e1db;
        --muted: #7a8290;
        --gold: #b8863b;
        --gold-bg: #faf1de;
        --silver: #78818f;
        --silver-bg: #f0f1f3;
        --bronze: #a66a3d;
        --bronze-bg: #f6e9de;
        --revenue: #3f7a5e;
        --revenue-bg: #eaf3ee;
    }

    .sp-report {
        font-family: 'Inter', -apple-system, sans-serif;
        color: var(--ink);
    }

        .sp-report .display {
            font-family: 'Space Grotesk', 'Inter', sans-serif;
        }

        .sp-report .tnum {
            font-variant-numeric: tabular-nums;
        }





    /* ================================
                   YEAR SECTION
                ================================ */

    .year-section {
        margin-bottom: 40px;
    }

    .year-title {
        display: flex;
        align-items: baseline;
        gap: 14px;
        margin-bottom: 18px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--ink);
    }

        .year-title .year-num {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 30px;
            font-weight: 700;
            letter-spacing: -.5px;
        }

        .year-title .year-note {
            color: var(--muted);
            font-size: 14px;
        }


    /* ================================
                   MONTH GRID
                ================================ */

    .month-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 14px;
    }


    /* ================================
                   MONTH CARD
                ================================ */

    .month-card {
        position: relative;
        min-height: 200px;
        border: 1px solid var(--line);
        border-left: 3px solid var(--gold);
        border-radius: 4px;
        background: var(--paper);
        cursor: pointer;
        transition: border-color .15s ease, transform .15s ease;
    }

        .month-card:hover {
            border-color: var(--ink-soft);
            border-left-width: 3px;
            transform: translateY(-3px);
        }

        .month-card:active {
            transform: translateY(-1px);
        }

        .month-card .card-body {
            padding: 18px 18px 16px;
            display: flex;
            flex-direction: column;
            height: 100%;
        }


    /* ================================
                   MONTH NAME / COUNT
                ================================ */

    .month-name {
        font-family: 'Space Grotesk', sans-serif;
        color: orangered;
        font-size: 16px;
        font-weight: 600;
    }

    .sales-count {
        color: var(--muted);
        font-size: 12px;
        margin-top: 3px;
    }


    /* ================================
                   TOP PERSON
                ================================ */

    .top-person {
        margin-top: auto;
        padding-top: 14px;
        border-top: 1px solid var(--line);
        font-size: 12px;
        color: black;
    }

        .top-person strong {
            display: block;
            margin-top: 4px;
            font-size: 14px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }


    /* ================================
                   TOP AMOUNT
                ================================ */

    .top-amount {
        margin-top: 6px;
        color: var(--revenue);
        font-family: 'Space Grotesk', sans-serif;
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -.2px;
    }


    /* ================================
                   MODAL
                ================================ */

    #salespersonSalesModal .modal-content {
        border: none;
        border-radius: 6px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(21,27,36,.25);
    }

    #salespersonSalesModal .modal-header {
        background: var(--ink);
        color: #fff;
        padding: 20px 24px;
        border: none;
    }

    #salespersonSalesModal .modal-title {
        font-family: 'Space Grotesk', sans-serif;
        color: #fff !important;
        font-size: 19px;
        font-weight: 600;
    }

    #salespersonSalesModal .modal-header small {
        color: rgba(255,255,255,.60) !important;
    }

    #salespersonSalesModal .btn-close {
        filter: brightness(0) invert(1);
        opacity: .75;
    }

    #salespersonSalesModal .modal-body {
        background: var(--paper);
    }

    #salespersonSalesModal .modal-footer {
        background: #fafafa;
        border-top: 1px solid var(--line);
        padding: 13px 20px;
    }

        #salespersonSalesModal .modal-footer .text-muted {
            color: var(--muted) !important;
            font-size: 13px;
        }

        #salespersonSalesModal .modal-footer .btn-secondary {
            background: var(--ink);
            border-color: var(--ink);
            padding: 7px 20px;
            border-radius: 4px;
            font-weight: 600;
        }

            #salespersonSalesModal .modal-footer .btn-secondary:hover {
                background: var(--ink-soft);
                border-color: var(--ink-soft);
            }

    .modal-backdrop.show {
        opacity: .55 !important;
    }


    /* ================================
                   SALES TABLE
                ================================ */

    .sales-table {
        margin: 0;
}

<h2 class="mb-4">Top Salesperson — Year &amp; Month Wise</h2>

        .share-fill.rank-1 {
            background: var(--gold);
        }

        .share-fill.rank-2 {
            background: var(--silver);
        }

        .share-fill.rank-3 {
            background: var(--bronze);
        }


    /* ================================
                   AMOUNT
                ================================ */

    .amount {
        color: var(--revenue);
        font-family: 'Space Grotesk', sans-serif;
        font-size: 15px;
        font-weight: 600;
    }


    /* ================================
                   RESPONSIVE
                ================================ */

    @@media (max-width: 1200px) {
        .month-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .month-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .month-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .month-card {
            min-height: 190px;
        }

        .report-header {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @@media (max-width: 480px) {
        .month-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
        }

        .month-card .card-body {
            padding: 13px;
        }

        .month-name {
            font-size: 14px;
        }

        .top-person strong {
            font-size: 12px;
        }

        .top-amount {
            font-size: 15px;
        }

        .share-cell {
            min-width: 90px;
        }
    }

</style>


<div class="container-fluid sp-report">

    <!-- HEADER -->

    <div class="card-header d-flex align-items-center justify-content-between">
        <h3 class="mb-0 text-uppercase">
            <i class="fa fa-users"></i>
            Top Salesperson
        </h3>
        <div class="header-mark">Leaderboard</div>
    </div>

@if (!Model.Any())
{
    <div class="alert alert-info">No sales data found.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Year</th>
                <th>Month</th>
                <th>Top Salesperson</th>
                <th class="text-end">Total Sales</th>
            </tr>

        </thead>


        <tbody>

            @{
                int? lastYear = null;
            }
            @foreach (var row in Model)
            {
                bool newYear = lastYear != row.Year;
                lastYear = row.Year;

                <tr class="@(newYear ? "border-top border-3" : "")">
                    <td>@(newYear? row.Year.ToString() : "")</td>
                    <td>@row.MonthName</td>
                    <td>🏆 @row.Name</td>
                    <td class="text-end">@row.TotalAmount.ToString("C2")</td>
                </tr>

                                                            rank++;
            }

        </tbody>

    </table>

