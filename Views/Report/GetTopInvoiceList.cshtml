@model List<WEBLINK_CRM.Models.VM_Reports>

@functions {
    static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0].Substring(0, 1).ToUpper()
            : (parts[0].Substring(0, 1) + parts[parts.Length - 1].Substring(0, 1)).ToUpper();
    }

    // Stable colour per person (string.GetHashCode is randomised per process in .NET Core)
    static int Tone(string name)
    {
        if (string.IsNullOrEmpty(name)) return 0;
        int sum = 0;
        foreach (var c in name) sum += c;
        return sum % 6;
    }

    static string Short(decimal v)
    {
        if (v >= 10000000m) return "₹" + (v / 10000000m).ToString("0.##") + " Cr";
        if (v >= 100000m) return "₹" + (v / 100000m).ToString("0.##") + " L";
        return "₹" + v.ToString("N0");
    }
}

@{
    ViewData["Title"] = "Top Salesperson - Year & Month Wise";

    var groupedYears = Model
        .GroupBy(x => x.Year)
        .OrderByDescending(x => x.Key);

    var currentYear = DateTime.Now.Year;

    // open current year; if there's no data for it, open the latest year instead
    var openYear = groupedYears.Any(g => g.Key == currentYear)
        ? currentYear
        : groupedYears.Max(g => g.Key);
}

<style>
    .sp-report {
        --ink: #172036;
        --ink-soft: #3b4660;
        --muted: #7b8498;
        --line: #2c3652;
        --surface: #ffffff;
        --canvas: #f4f6fb;
        --accent: #4f46e5;
        --accent-soft: #eceafd;
        --revenue: #0f9d73;
        --revenue-soft: #e3f6ef;
        --gold: #c58a12;
        --gold-soft: #fdf3d8;
        --silver: #6b7488;
        --silver-soft: #eef0f5;
        --bronze: #b0602d;
        --bronze-soft: #e9d3c3;
        font-family: 'Inter', -apple-system, 'Segoe UI', sans-serif;
        color: var(--ink);
    }

        .sp-report .display {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        }

        .sp-report .tnum {
            font-variant-numeric: tabular-nums;
        }

    /* ---------- Page header ---------- */
    .sp-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 28px;
        padding: 22px 26px;
        border-radius: 16px;
        color: #fff;
        background: linear-gradient( 265deg, #0b0f14, #1a3e66);
    }

        .sp-hero h3 {
            margin: 0;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -.2px;
            color: #fff;
        }

        .sp-hero p {
            margin: 4px 0 0;
            font-size: 13px;
            color: rgba(255,255,255,.7);
        }

        .sp-hero .hero-icon {
            width: 46px;
            height: 46px;
            flex: none;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: rgba(255,255,255,.14);
            font-size: 20px;
        }

        .sp-hero .hero-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }

    /* ---------- Year section ---------- */
    .year-section {
        margin-bottom: 44px;
    }

    .year-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }

    .year-num {
        font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        font-size: 34px;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -1px;
    }

    .year-note {
        color: var(--muted);
        font-size: 13px;
        margin-top: 6px;
    }

    .year-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .stat-chip {
        padding: 9px 14px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--surface);
        min-width: 150px;
    }

        .stat-chip .label {
            font-size: 11.5px;
            color: var(--muted);
        }

        .stat-chip .value {
            font-size: 16px;
            font-weight: 700;
            margin-top: 1px;
        }

            .stat-chip .value.green {
                color: var(--revenue);
            }

    /* ---------- Month grid ---------- */
    .month-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 16px;
    }

    .month-card {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 18px;
        border: 1px solid var(--line);
        border-radius: 16px;
        background: var(--surface);
        cursor: pointer;
        text-align: left;
        width: 100%;
        transition: box-shadow .2s ease, border-color .2s ease, transform .2s ease;
    }

        .month-card:hover {
            border-color: #c9ccf5;
            box-shadow: 0 10px 28px rgba(79,70,229,.12);
            transform: translateY(-3px);
        }

        .month-card:focus-visible {
            outline: 3px solid var(--accent);
            outline-offset: 2px;
        }

        .month-card.is-best {
            border-color: #f1d58b;
            background: linear-gradient(180deg, #fffaf0 0%, #fff 55%);
        }

    .month-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .month-name {
        font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        font-size: 17px;
        font-weight: 700;
    }

    .best-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        border-radius: 999px;
        background: var(--gold-soft);
        color: var(--gold);
        font-size: 11px;
        font-weight: 600;
    }

    .month-total {
        margin-top: 12px;
        font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        font-size: 24px;
        font-weight: 800;
        letter-spacing: -.5px;
    }

    .month-sub {
        color: var(--muted);
        font-size: 12px;
        margin-top: 2px;
    }

    .month-meter {
        height: 5px;
        margin-top: 12px;
        border-radius: 3px;
        background: #eef0f6;
        overflow: hidden;
    }

        .month-meter span {
            display: block;
            height: 100%;
            border-radius: 3px;
            background: linear-gradient(90deg, var(--accent), #8b85f5);
        }

    .month-card.is-best .month-meter span {
        background: linear-gradient(90deg, #e0a526, #f3c75b);
    }

    .top-person {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px dashed var(--line);
    }

        .top-person .who {
            min-width: 0;
            flex: 1;
        }

            .top-person .who small {
                display: block;
                font-size: 11px;
                color: var(--muted);
            }

            .top-person .who strong {
                display: block;
                font-size: 13.5px;
                font-weight: 600;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

        .top-person .top-amount {
            font-size: 13px;
            font-weight: 700;
            color: var(--revenue);
            background: var(--revenue-soft);
            padding: 3px 8px;
            border-radius: 8px;
            white-space: nowrap;
        }

    /* ---------- Avatar ---------- */
    .avatar {
        width: 36px;
        height: 36px;
        flex: none;
        display: grid;
        place-items: center;
        border-radius: 50%;
        font-size: 12.5px;
        font-weight: 700;
        color: #fff;
    }

        .avatar.sm {
            width: 32px;
            height: 32px;
            font-size: 11.5px;
        }

    .tone-0 {
        background: #4f46e5;
    }

    .tone-1 {
        background: #0f9d73;
    }

    .tone-2 {
        background: #e0701f;
    }

    .tone-3 {
        background: #d6336c;
    }

    .tone-4 {
        background: #0b7fb5;
    }

    .tone-5 {
        background: #7a4fd0;
    }

    /* ---------- Modal ---------- */
    .sp-modal .modal-content {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(23,32,54,.28);
    }

    .sp-modal .modal-header {
        padding: 8px 27px;
        border: none;
        color: #fff;
        background: linear-gradient(120deg, #172036 0%, #0d151d 70%, #0d151d 100%);
    }

    .sp-modal .modal-title {
        font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        font-size: 20px;
        font-weight: 700;
        color: #fff;
    }

    .sp-modal .modal-sub {
        font-size: 12.5px;
        color: rgba(255,255,255,.7);
        margin-top: 2px;
    }

    .sp-modal .btn-close {
        filter: brightness(0) invert(1);
        opacity: .8;
    }

    .sp-modal .modal-body {
        padding: 0;
        background: var(--surface);
    }


    /* Podium summary */
    .podium {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 3px;
        padding: 6px 18px 4px;
    }

    .podium-item {
        padding: 12px;
        border-radius: 14px;
        text-align: center;
        background: var(--silver-soft);
    }

        .podium-item.p1 {
            background: var(--gold-soft);
        }

        .podium-item.p3 {
            background: var(--bronze-soft);
        }

        .podium-item .avatar {
            margin: 0 auto 8px;
        }

        .podium-item .pname {
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .podium-item .pamt {
            font-size: 13px;
            font-weight: 700;
            color: var(--revenue);
            margin-top: 2px;
        }

        .podium-item .pmedal {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .podium-item.p1 .pmedal {
            color: var(--gold);
        }

        .podium-item.p2 .pmedal {
            color: var(--silver);
        }

        .podium-item.p3 .pmedal {
            color: var(--bronze);
        }

    /* Table */
    .sales-table-wrapper {
        max-height: 370px;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: #0d151c transparent;
    }

    .sales-table {
        margin: 0 !important;
    }

        .sales-table thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 12px 18px;
            background: linear-gradient(265deg, #0b0f14, #1a3e66);
            color: var(--muted);
            border-bottom: 1px solid var(--line);
            font-size: 12px;
            font-weight: 700;
        }

        .sales-table tbody tr:hover {
            background: #f8f9fd;
        }

    .person-cell {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        font-size: 14px;
    }

    .rank-number {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #f1f2f6;
        color: var(--ink-soft);
        font-size: 12.5px;
        font-weight: 700;
    }

        .rank-number.rank-1 {
            background: var(--gold-soft);
            color: var(--gold);
        }

        .rank-number.rank-2 {
            background: var(--silver-soft);
            color: var(--silver);
        }

        .rank-number.rank-3 {
            background: var(--bronze-soft);
            color: var(--bronze);
        }

    .share-cell {
        min-width: 150px;
    }

    .share-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .share-track {
        flex: 1;
        height: 6px;
        border-radius: 3px;
        background: #edeff5;
        overflow: hidden;
    }

    .share-fill {
        height: 100%;
        border-radius: 3px;
        background: #b3b9cc;
    }

        .share-fill.rank-1 {
            background: var(--gold);
        }

        .share-fill.rank-2 {
            background: var(--silver);
        }

        .share-fill.rank-3 {
            background: var(--bronze);
        }

    .share-pct {
        width: 38px;
        text-align: right;
        font-size: 11.5px;
        color: var(--muted);
    }

    .amount {
        color: var(--revenue);
        font-size: 14.5px;
        font-weight: 700;
    }

    .modal-backdrop.show {
        opacity: .5 !important;
    }

    .year-toggle {
        width: 100%;
        background: none;
        border: 0;
        padding: 0;
        text-align: left;
        color: inherit;
        cursor: pointer;
    }

        .year-toggle:focus-visible {
            outline: 3px solid var(--accent);
            outline-offset: 4px;
            border-radius: 8px;
        }

        .year-toggle .year-chevron {
            margin-left: 12px;
            font-size: 18px;
            color: var(--muted);
            transition: transform .2s ease;
        }

        .year-toggle[aria-expanded="false"] .year-chevron {
            transform: rotate(-90deg);
        }

    /* ---------- Responsive ---------- */
    @@media (max-width: 768px) {
        .sp-hero {
            padding: 18px;
        }

        .month-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .month-card {
            padding: 14px;
        }

        .month-total {
            font-size: 19px;
        }

        .year-num {
            font-size: 28px;
        }

        .podium {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 480px) {
        .month-grid {
            grid-template-columns: 1fr;
        }

        .stat-chip {
            flex: 1;
            min-width: 130px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .month-card {
            transition: none;
        }

            .month-card:hover {
                transform: none;
            }
    }
</style>

<div class="container-fluid sp-report">

    @* ===== HEADER ===== *@
    <div class="sp-hero">
        <div class="hero-left">
            <div class="hero-icon"><i class="fa fa-trophy"></i></div>
            <div>
                <h3 class="display">Top Salesperson</h3>
                <p>Monthly leaderboard by total sales. Select a month to see everyone's ranking.</p>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No sales data found.
        </div>
    }
    else
    {
        foreach (var yearGroup in groupedYears)
        {
            // Build per-month data once so cards and modals share it
            var months = yearGroup
            .GroupBy(x => new { x.Month, x.MonthName })
            .OrderBy(x => x.Key.Month)
            .Select(g => new
            {
                Month = g.Key.Month,
                MonthName = g.Key.MonthName,
                People = g.OrderByDescending(x => x.TotalAmount).ToList(),
                Total = g.Sum(x => x.TotalAmount)
            })
            .ToList();

            var yearTotal = months.Sum(m => m.Total);
            var bestMonth = months.OrderByDescending(m => m.Total).First();
            var maxMonthTotal = bestMonth.Total;
            var isOpen = yearGroup.Key == openYear;

            <div class="year-section">

                @* ===== YEAR HEADER ===== *@
                <button type="button" class="year-head year-toggle" data-bs-toggle="collapse" data-bs-target="#yearBody_@yearGroup.Key" aria-expanded="@(isOpen ? "true" : "false")" aria-controls="yearBody_@yearGroup.Key">
                    <div>
                        <div class="year-num">@yearGroup.Key</div>
                        <div class="year-note">@months.Count month(s) of sales data</div>
                    </div>

                    <div class="year-stats">
                        <div class="stat-chip">
                            <div class="label">Total sales</div>
                            <div class="value green tnum">@Short(yearTotal)</div>
                        </div>
                        <div class="stat-chip">
                            <div class="label">Best month</div>
                            <div class="value">@bestMonth.MonthName</div>
                        </div>
                    </div>
                </button>

                @* ===== MONTH CARDS ===== *@
                <div class="collapse @(isOpen ? "show" : "")" id="yearBody_@yearGroup.Key">
                    <div class="month-grid">

                        @foreach (var m in months)
                        {
                            var topPerson = m.People.FirstOrDefault();
                            var modalId = $"salesModal_{yearGroup.Key}_{m.Month}";
                            var isBest = m.Month == bestMonth.Month && months.Count > 1;
                            var meterPct = maxMonthTotal > 0 ? (double)(m.Total / maxMonthTotal * 100) : 0;

                            <button type="button"
                                    class="month-card @(isBest ? "is-best" : "")"
                                    data-bs-toggle="modal"
                                    data-bs-target="#@modalId">

                                <div class="month-top">
                                    <span class="month-name">@m.MonthName</span>
                                    @if (isBest)
                                    {
                                        <span class="best-badge"><i class="fa fa-star"></i> Best month</span>
                                    }
                                </div>

                                <div class="month-total tnum">@Short(m.Total)</div>
                                <div class="month-sub">@m.People.Count salesperson(s)</div>

                                <div class="month-meter" title="Compared with the best month of @yearGroup.Key">
                                    <span style="width:@(meterPct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                </div>

                                @if (topPerson != null)
                                {
                                    <div class="top-person">
                                        <div class="avatar tone-@Tone(topPerson.Name)">@Initials(topPerson.Name)</div>
                                        <div class="who">
                                            <small>Top salesperson</small>
                                            <strong title="@topPerson.Name">@topPerson.Name</strong>
                                        </div>
                                        <span class="top-amount tnum">@Short(topPerson.TotalAmount)</span>
                                    </div>
                                }
                            </button>
                        }

                    </div>

                    @* ===== MODALS (outside the grid so they don't affect layout) ===== *@
                    @foreach (var m in months)
                    {
                        var topPerson = m.People.FirstOrDefault();
                        var modalId = $"salesModal_{yearGroup.Key}_{m.Month}";
                        int rank = 1;

                        <div class="modal fade sp-modal"
                             id="@modalId"
                             tabindex="-1"
                             aria-labelledby="@(modalId)_Label"
                             aria-hidden="true">

                            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                                <div class="modal-content">

                                    <div class="modal-header">
                                        <div>
                                            <h5 class="modal-title" id="@(modalId)_Label">@m.MonthName @yearGroup.Key</h5>
                                            <div class="modal-sub">
                                                @m.People.Count salesperson(s) &middot; Total <span class="tnum">₹@m.Total.ToString("N2")</span>
                                            </div>
                                        </div>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>

                                    <div class="modal-body">

                                        @* Top 3 *@
                                        <div class="podium">
                                            @foreach (var p in m.People.Take(3).Select((value, index) => new { value, index }))
                                            {
                                                <div class="podium-item p@(p.index + 1)">
                                                    <div class="pmedal"><i class="fa fa-medal"></i> #@(p.index + 1)</div>
                                                    <div class="avatar tone-@Tone(p.value.Name)">@Initials(p.value.Name)</div>
                                                    <div class="pname" title="@p.value.Name">@p.value.Name</div>
                                                    <div class="pamt tnum">@Short(p.value.TotalAmount)</div>
                                                </div>
                                            }
                                        </div>

                                        <div class="sales-table-wrapper mt-3">
                                            <table class="table table-hover align-middle mb-0 sales-table">
                                                <thead>
                                                    <tr>
                                                        <th>Rank</th>
                                                        <th>Salesperson</th>
                                                        <th>Compared with top</th>
                                                        <th class="text-end">Total sales</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var person in m.People)
                                                    {
                                                        var rankClass = rank <= 3 ? $"rank-{rank}" : "";

                                                        var sharePct = (topPerson != null && topPerson.TotalAmount > 0)
                                                        ? (double)(person.TotalAmount / topPerson.TotalAmount * 100)
                                                        : 0;

                                                        <tr>
                                                            <td><span class="rank-number @rankClass">@rank</span></td>

                                                            <td>
                                                                <div class="person-cell">
                                                                    <div class="avatar sm tone-@Tone(person.Name)">@Initials(person.Name)</div>
                                                                    <span>@person.Name</span>
                                                                </div>
                                                            </td>

                                                            <td class="share-cell">
                                                                <div class="share-row">
                                                                    <div class="share-track">
                                                                        <div class="share-fill @rankClass"
                                                                             style="width:@(sharePct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                                                                    </div>
                                                                    <span class="share-pct tnum">@sharePct.ToString("0")%</span>
                                                                </div>
                                                            </td>

                                                            <td class="text-end pe-4">
                                                                <span class="amount tnum">₹@person.TotalAmount.ToString("N2")</span>
                                                            </td>
                                                        </tr>

                                                        rank++;
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>
        }
    }

</div>
