@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Bootstrap 5.3.8 CSS -->
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">

<!-- Bootstrap 5.3.8 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>


<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>


<!-- Bootstrap Datepicker -->
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/css/bootstrap-datepicker.min.css" />

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/js/bootstrap-datepicker.min.js"></script>


<!-- jQuery UI -->
<link rel="stylesheet"
      href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />

<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>


<!-- Select2 -->
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>


<!-- DataTables -->
<link rel="stylesheet"
      href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" />

<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<div class="page-wrapper">

    <center>
        <div id='loader' style='display: none;'>
            <img src="~/assets/images/loader.gif" class="loader-gif" />
        </div>
    </center>
    <div class="container-fluid">
        <div class="card">
            <div class="card-header text-uppercase text-black"
                 style="display:flex; align-items:center; justify-content:space-between;">

                <h5 style="color:black; margin:0;" id="lblHeader">
                    Work Order List
                </h5>

                <button type="button"
                        class="btn btn-primary"
                        onclick="window.location= '@Url.Action("Create", "WorkOrder")'">
                    <i class="fa fa-arrow-right"></i> Create
                </button>

            </div>
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12" style="padding: 20px;">
                        <div class="row">
                            <div class="col-md-6 text-md-end">
                            </div>
                            <div class="col-md-6 text-md-end">
                                <span class="record-info">
                                    Show
                                    <select id="ddlStatus" class="form-select form-select-sm d-inline-block" style="width:auto;">
                                        <option value="1">1</option>
                                        <option value="20">20</option>
                                        <option value="50">50</option>
                                        <option value="100" selected>100</option>
                                        <option value="all">All</option>
                                    </select>
                                    Total Records :
                                    <strong id="totalRecords">@(Model?.Count() ?? 0)</strong>
                                </span>
                            </div>
                        </div>
                        <br />
                        <div style="width: 100%;">
                            <div class="table-responsive">
                                <table id="tblWorkOrder" style="width:100%!important" class="table table-striped table-bordered dt-responsive nowrap" cellspacing="0">
                                    <thead class="clsthead">
                                        <tr>
                                            <th>WorkOrder Id</th>
                                            <th>Created Date</th>
                                            <th>W.O. No.</th>
                                            <th>Company Name</th>
                                            <th>Total Deal Basic Amount</th>
                                            <th>Total Deal GSTAmount</th>
                                            <th style="width:10px;">Action</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


<div class="modal fade bd-example-modal-lg" id="WorkOrderModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">

                <h5 class="modal-title" id="exampleModalLabel">
                    Work Order Details
                </h5>

                <button type="button"
                        class="btn btn-danger btn-sm ms-auto"
                        onclick="window.location.href='@Url.Action("Index", "WorkOrder")'"
                        title="Close">
                    <i class="fa fa-times"></i>
                </button>

            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12" style="padding: 20px;">
                        <div style="width: 100%;">
                            <div class="table-responsive">
                                <table id="tblWorkOrderList" style="width:100%!important" class="table table-striped table-bordered dt-responsive nowrap" cellspacing="0">
                                    <thead class="clsthead">
                                        <tr>
                                            <th>Department</th>
                                            <th>Service Description</th>
                                            <th>Remarks</th>
                                            <th>Qty</th>
                                            <th>No. Of Yr.</th>
                                            <th>Rate</th>
                                            <th>Amount</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-danger sm"
                        onclick="window.location= '@Url.Action("Index", "WorkOrder")'">
                    <i class="fa fa-times"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>


<script src="~/js/WorkOrderIndex.js"></script>
<script type="text/javascript">
    jQuery(document).ready(function () {
        GetWorkOrderIndex.init();
    });
</script>
