@model IEnumerable<WEBLINK_CRM.Models.VM_WorkOrder>

@{
    ViewData["Title"] = "Work Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-wrapper">

    <!-- Loader -->
    <div id="loader" style="display:none;">
        <div class="text-center">
            <img src="~/assets/images/loader.gif"
                 class="loader-gif"
                 alt="Loading..." />
        </div>
    </div>

    <div class="container-fluid">

        <div class="card shadow-sm">

            <!-- ================= HEADER ================= -->
            <div class="card-header d-flex align-items-center justify-content-between">

                <h5 class="mb-0 text-uppercase">
                    <i class="fa fa-file-text-o me-2"></i>
                    Work Order List
                </h5>

                <a asp-controller="WorkOrder"
                   asp-action="Create"
                   class="btn btn-primary btn-sm">
                    <i class="fa fa-plus me-1"></i>
                    Create
                </a>

            </div>

            <!-- ================= BODY ================= -->
            <div class="card-body">

                <!-- Search / Record Information -->
                <div class="row align-items-center mb-3">

                    <div class="col-md-4 mb-2 mb-md-0">

                        <input type="text"
                               id="searchInput"
                               class="form-control"
                               placeholder="Search Work Order..." />

                    </div>

                    <div class="col-md-8 text-md-end">

                        <span class="record-info">

                            Show

                            <select id="ddlStatus"
                                    class="form-select form-select-sm d-inline-block"
                                    style="width:auto;">

                                <option value="10">10</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                                <option value="100" selected>100</option>
                                <option value="all">All</option>

                            </select>

                            &nbsp;&nbsp;

                            Total Records :
                            <strong id="totalRecords">
                                @(Model?.Count() ?? 0)
                            </strong>

                        </span>

                    </div>

                </div>


                <!-- ================= TABLE ================= -->
                <div class="table-responsive">

                    <table id="tblWorkOrder"
                           class="table table-bordered table-hover align-middle"
                           style="width:100%;">

                        <thead class="table-light">

                            <tr>

                                <th>Sr.No.</th>

                                <th>Created Date</th>

                                <th>W.O. No.</th>

                                <th>Company Name</th>

                                <th>Total Deal Basic Amount</th>

                                <th>Total Deal GST Amount</th>

                                <th class="text-center"
                                    style="width:120px;">
                                    Action
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @if (Model != null && Model.Any())
                            {
                                int count = 1;

                                foreach (var item in Model)
                                {
                                    <tr>

                                        <td class="row-number">
                                            @count
                                        </td>

                                        <td>
                                            @(item.TodayDt.HasValue
                                                                                ? item.TodayDt.Value.ToString("dd/MM/yyyy")
                                                                                : "")
                                </td>
                                <td>
                                    <strong>
                                        @item.WONo
                                    </strong>
                                </td>

                                        <td>
                                            @item.CompanyName
                                        </td>

                                        <td class="text-end">
                                            @item.TotalDealBasicAmount
                                        </td>

                                        <td class="text-end">
                                            @item.TotalDealGSTAmount
                                        </td>

                                        <td>

                                            <div class="d-flex justify-content-center gap-1">

                                                <!-- Edit -->
                                                <a asp-controller="WorkOrder"
                                                   asp-action="Create"
                                                   asp-route-ID="@item.ID"
                                                   class="btn btn-sm btn-primary"
                                                   title="Edit">
                                                    <i class="fa fa-edit"></i>
                                                </a>

                                                <!-- Details -->
                                                <button type="button"
                                                        class="btn btn-sm btn-info"
                                                        title="View Details"
                                                        onclick="GetWorkOrderDetails('@item.ID')">

                                                    <i class="fa fa-eye"></i>

                                                </button>

                                                <!-- Delete -->
                                                <button type="button"
                                                        class="btn btn-sm btn-danger"
                                                        title="Delete"
                                                        onclick="DeleteWorkOrder('@item.ID')">

                                                    <i class="fa fa-trash"></i>

                                                </button>

                                            </div>

                                        </td>

                                    </tr>

                                                        count++;
                                }
                            }
                            else
                            {
                                <tr id="noDataRow">

                                    <td colspan="8"
                                        class="text-center py-4">

                                        <i class="fa fa-info-circle me-2"></i>

                                        No Work Order records found.

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <nav>

                    <ul class="pagination justify-content-center mt-3"
                        id="pagination">
                    </ul>

                </nav>

            </div>

        </div>

    </div>

</div>


<div class="modal fade"
     id="WorkOrderModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    <i class="fa fa-file-text-o me-2"></i>
                    Work Order Details
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <div class="table-responsive">

                    <table id="tblWorkOrderList"
                           class="table table-bordered table-striped"
                           style="width:100%;">

                        <thead class="table-light">

                            <tr>

                                <th>Department</th>

                                <th>Service Description</th>

                                <th>Remarks</th>

                                <th>Qty</th>

                                <th>No. Of Yr.</th>

                                <th>Rate</th>

                                <th>Amount</th>

                            </tr>

                        </thead>

                        <tbody>
                        </tbody>

                    </table>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-danger"
                        data-bs-dismiss="modal">

                    <i class="fa fa-times me-1"></i>
                    Close

                </button>

            </div>

        </div>

    </div>

</div>

<script>
    const searchInput = document.getElementById("searchInput");
    const pagination = document.getElementById("pagination");
    const totalRecords = document.getElementById("totalRecords");
    const pageSizeDropdown = document.getElementById("ddlStatus");

    const table = document.getElementById("tblWorkOrder");
    const tbody = table.querySelector("tbody");

    let allRows = [];
    let filteredRows = [];
    let currentPage = 1;
    let rowsPerPage = 100;


    function loadRows() {
        allRows = Array.from(tbody.querySelectorAll("tr")).filter(row => !row.id);
        filteredRows = allRows;
        updateTotalRecords();
        displayTable(1);
    }


    function updateTotalRecords() {
        totalRecords.innerText = filteredRows.length;
    }


    function displayTable(page) {
        currentPage = page;

        allRows.forEach(function (row) {
            row.style.display = "none";
        });

        let start = 0;
        if (rowsPerPage !== "all") {
            start = (page - 1) * parseInt(rowsPerPage);
        }

        let end = rowsPerPage === "all"
            ? filteredRows.length
            : start + parseInt(rowsPerPage);

        filteredRows.slice(start, end).forEach(function (row, index) {
            row.style.display = "";
            let numberCell = row.querySelector(".row-number");
            if (numberCell) {
                numberCell.innerText = start + index + 1;
            }
        });

        createPagination();
    }


    function createPagination() {
        pagination.innerHTML = "";

        if (rowsPerPage === "all") {
            return;
        }

        const totalPages = Math.ceil(filteredRows.length / parseInt(rowsPerPage));

        if (totalPages <= 1) {
            return;
        }

        // Previous
        const previousLi = document.createElement("li");
        previousLi.className = "page-item " + (currentPage === 1 ? "disabled" : "");
        previousLi.innerHTML = `
            <a class="page-link" href="javascript:void(0)">
                <i class="fa fa-chevron-left"></i>
            </a>
        `;
        previousLi.onclick = function () {
            if (currentPage > 1) {
                displayTable(currentPage - 1);
            }
        };
        pagination.appendChild(previousLi);

        // Page Numbers
        for (let i = 1; i <= totalPages; i++) {
            const li = document.createElement("li");
            li.className = "page-item " + (i === currentPage ? "active" : "");
            li.innerHTML = `
                <a class="page-link" href="javascript:void(0)">
                    ${i}
                </a>
            `;
            li.onclick = function () {
                displayTable(i);
            };
            pagination.appendChild(li);
        }

        // Next
        const nextLi = document.createElement("li");
        nextLi.className = "page-item " + (currentPage === totalPages ? "disabled" : "");
        nextLi.innerHTML = `
            <a class="page-link" href="javascript:void(0)">
                <i class="fa fa-chevron-right"></i>
            </a>
        `;
        nextLi.onclick = function () {
            if (currentPage < totalPages) {
                displayTable(currentPage + 1);
            }
        };
        pagination.appendChild(nextLi);
    }


    searchInput.addEventListener("keyup", function () {
        const value = this.value.toLowerCase().trim();

        filteredRows = allRows.filter(function (row) {
            return row.innerText.toLowerCase().includes(value);
        });

        updateTotalRecords();
        currentPage = 1;
        displayTable(1);
    });

    pageSizeDropdown.addEventListener("change", function () {
        rowsPerPage = this.value === "all" ? "all" : parseInt(this.value);
        currentPage = 1;
        displayTable(1);
    });


    $(document).ready(function () {
        loadRows();
    });


    function GetWorkOrderDetails(id) {
        $("#loader").show();

        $.ajax({
            url: '@Url.Action("GetWorkOrderDEtailsByID", "WorkOrder")',
            type: "POST",
            data: {
                ID: id
            },
            success: function (response) {
                if (response.success === true) {
                    $("#tblWorkOrderList tbody").empty();

                    var details = response.data;

                    if (details != null && details.length > 0) {
                        var html = "";

                        $.each(details, function (i, item) {
                            html += `
                                <tr>
                                    <td>${item.department ?? ""}</td>
                                    <td>${item.servicesDescription ?? ""}</td>
                                    <td>${item.remark ?? ""}</td>
                                    <td class="text-end">${item.qty ?? 0}</td>
                                    <td class="text-end">${item.noofYr ?? 0}</td>
                                    <td class="text-end">${item.rate ?? 0}</td>
                                    <td class="text-end">${item.amount ?? 0}</td>
                                </tr>
                            `;
                        });

                        $("#tblWorkOrderList tbody").html(html);
                    } else {
                        $("#tblWorkOrderList tbody").html(`
                            <tr>
                                <td colspan="7" class="text-center text-muted">
                                    No Work Order details found.
                                </td>
                            </tr>
                        `);
                    }

                    // Open Bootstrap 5 modal
                    var modalElement = document.getElementById("WorkOrderModal");
                    var modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                    modal.show();
                }
                else {
                    showToast(response.message || "Unable to load Work Order details.", "error");
                }
            },
            complete: function () {
                $("#loader").hide();
            },
            error: function (xhr) {
                showToast("Error while loading Work Order details.", "error");
            }
        });
    }


    function DeleteWorkOrder(id) {
        if (!id || id === "" || id === "0") {
            showToast("Invalid Work Order ID.", "error");
            return;
        }
        if (!confirm("Are you sure you want to delete this Work Order?")) {
            return;
        }

        $("#loader").show();

        $.ajax({
            url: '@Url.Action("DeleteWorkOrder", "WorkOrder")',
            type: "POST",
            data: {
                ID: id
            },
            success: function (response) {
                if (response.success === true) {
                    showToast(response.message || "Work Order deleted successfully.", "success");

                    setTimeout(function () {
                        location.reload();
                    }, 800);
                }
                else {
                    showToast(response.message || "Unable to delete Work Order.", "error");
                }
            },
            complete: function () {
                $("#loader").hide();
            },
            error: function (xhr) {
                showToast("Something went wrong while deleting Work Order.", "error");
            }
        });
    }
</script>