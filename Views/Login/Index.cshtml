@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login – WEB LINK CRM</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/login/assets/css/style.css" />
</head>
<body>

    <div class="bg-blob"></div>
    <div class="bg-blob"></div>
    <div class="bg-blob"></div>

    <div id="toast-root"></div>

    <div class="page">

        <!-- LEFT -->
        <div class="left">
            <div class="deco-circle"></div>
            <div class="deco-circle"></div>
            <div class="left-inner">
                <div class="brand-tag"><i class="fa-solid fa-bolt"></i> WEB LINK CRM</div>
                <h1>Manage your<br /><span>business smarter</span></h1>
                <p>The all-in-one CRM platform to track leads, close deals, and grow your sales team — all in one place.</p>
                <div class="features">
                    <div class="feat"><div class="feat-icon"><i class="fa-solid fa-chart-line"></i></div>Real-time sales analytics</div>
                    <div class="feat"><div class="feat-icon"><i class="fa-solid fa-users"></i></div>Team collaboration tools</div>
                    <div class="feat"><div class="feat-icon"><i class="fa-solid fa-shield-halved"></i></div>Enterprise-grade security</div>
                </div>
            </div>
        </div>

        <!-- RIGHT -->
        <div class="right">
            <div class="logo-wrap">
                <img src="https://www.weblinkservices.net/assets-web/logo-main.png" alt="WEB LINK Services" />
            </div>

            <h2>Welcome back</h2>
            <p class="sub">Sign in to access your CRM dashboard</p>

            <form asp-controller="Login" asp-action="Index" method="post" id="loginForm">
                @Html.AntiForgeryToken()

                <!-- ✅ input MUST come BEFORE label for float CSS to work -->
                <div class="field">
                    <input type="text" id="username" name="username"
                           placeholder=" " autocomplete="username" />
                    <label for="username">
                        <i class="fa-regular fa-user" style="margin-right:5px;"></i>Username or Email
                    </label>
                </div>

                <div class="field">
                    <input type="password" id="password" name="password"
                           placeholder=" " autocomplete="current-password" />
                    <label for="password">
                        <i class="fa-solid fa-lock" style="margin-right:5px;font-size:12px;"></i>Password
                    </label>
                    <span class="eye" onclick="togglePwd()">
                        <i class="fa-regular fa-eye" id="eyeIcon"></i>
                    </span>
                </div>

                <div class="row-meta">
                    <label class="check-label">
                        <input type="checkbox" id="rememberMe" name="rememberMe" value="true" />
                        Remember me
                    </label>
                    <a href="#" class="forgot">Forgot password?</a>
                </div>

                <button type="button" class="btn-login" onclick="handleLogin()">
                    <i class="fa-solid fa-right-to-bracket"></i> Login to your Account
                </button>
            </form>

            <div class="secure">
                <i class="fa-solid fa-circle-check"></i>
                Secure SSL connection · WEB LINK CRM
            </div>
        </div>

    </div>

    <script>
        /* ── Toast ── */
        function showToast(msg, type, title) {
            type = type || 'success';
            var icons  = { success: 'fa-circle-check', error: 'fa-circle-xmark', warning: 'fa-triangle-exclamation', info: 'fa-circle-info' };
            var titles = { success: 'Success', error: 'Error', warning: 'Warning', info: 'Info' };
            var root   = document.getElementById('toast-root');
            var t      = document.createElement('div');
            t.className = 'toast ' + type;
            t.innerHTML =
                '<i class="fa-solid ' + (icons[type] || icons.success) + ' toast-icon"></i>' +
                '<div class="toast-body">' +
                  '<div class="toast-title">' + (title || titles[type] || 'Notice') + '</div>' +
                  '<div class="toast-msg">'   + msg + '</div>' +
                '</div>' +
                '<button class="toast-close" onclick="dismissToast(this.closest(\'.toast\'))">&#x2715;</button>' +
                '<div class="toast-bar"></div>';
            root.appendChild(t);
            setTimeout(function () { dismissToast(t); }, 3500);
        }

        function dismissToast(t) {
            t.classList.add('hide');
            setTimeout(function () { t.remove(); }, 300);
        }

        /* ── Password toggle ── */
        function togglePwd() {
            var p = document.getElementById('password');
            var i = document.getElementById('eyeIcon');
            if (p.type === 'password') {
                p.type = 'text';
                i.className = 'fa-regular fa-eye-slash';
            } else {
                p.type = 'password';
                i.className = 'fa-regular fa-eye';
            }
        }

        /* ── Client-side validation ── */
        function handleLogin() {
            var u = document.getElementById('username').value.trim();
            var p = document.getElementById('password').value.trim();
            if (!u) { showToast('Please enter your username or email.', 'warning', 'Missing field'); return; }
            if (!p) { showToast('Please enter your password.', 'warning', 'Missing field'); return; }
            document.getElementById('loginForm').submit();
        }

        /* ── Server messages on DOM ready ── */
        document.addEventListener('DOMContentLoaded', function () {

            @if (ViewBag.ErrorMessage != null)
            {
                    <text>
                    showToast('@Html.Raw(ViewBag.ErrorMessage)', 'error', 'Login failed');
                    </text>
            }

            @if (ViewBag.LoginSuccess != null)
            {
                    <text>
                    showToast('@Html.Raw(ViewBag.LoginSuccess)', 'success', 'Welcome!');
                    setTimeout(function () {
                        window.location.href = '@Html.Raw(ViewBag.RedirectUrl)';
                    }, 2000);
                    </text>
            }

            @if (TempData["LogoutMessage"] != null)
            {
                    <text>
                    showToast('@Html.Raw(TempData["LogoutMessage"])', 'info', 'Logged out');
                    </text>
            }

        });
    </script>

</body>
</html>