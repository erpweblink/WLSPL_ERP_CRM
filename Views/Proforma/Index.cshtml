@model IEnumerable<WEBLINK_CRM.Models.VM_Proforma>

@{
    ViewData["Title"] = "Proforma";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .active-status {
        background-color: #198754 !important;
        color: #ffffff !important;
        padding: 10px 12px !important;
        border-radius: 20px !important;
        font-size: 11px !important;
        font-weight: 600 !important;
        display: inline-block;
    }

    .inactive-status {
        background-color: #dc3545 !important;
        color: #ffffff !important;
        padding: 10px 12px !important;
        border-radius: 20px !important;
        font-size: 11px !important;
        font-weight: 600 !important;
        display: inline-block;
    }
</style>
<!-- Loader -->
<div id="loader" style="display:none;">
    <div class="text-center">
        <img src="~/assets/images/loader.gif"
             class="loader-gif"
             alt="Loading..." />
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h3 class="mb-0 text-uppercase">
            <i class="fa-jelly-fill fa-regular fa-file"></i>
            Proforma List
        </h3>

        <a asp-controller="Proforma"
           asp-action="Create"
           class="btn btn-primary btn-sm">
            <i class="fa fa-plus me-1"></i>
            Create
        </a>

    </div>
    <div class="card-body">

        <!-- Search / Record Information -->
        <div class="row align-items-center mb-3">

            <div class="col-md-4 mb-2 mb-md-0">

                <input type="text"
                       id="searchInput"
                       class="form-control"
                       placeholder="Search Proforma..." />

            </div>

            <div class="col-md-8 text-md-end">

                <span class="record-info">

                    Show

                    <select id="ddlStatus"
                            class="form-select form-select-sm d-inline-block"
                            style="width:auto;">

                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100" selected>100</option>
                        <option value="all">All</option>

                    </select>

                    &nbsp;&nbsp;

                    Total Records :
                    <strong id="totalRecords">
                        @(Model?.Count() ?? 0)
                    </strong>

                </span>

            </div>

        </div>


        <!-- ================= TABLE ================= -->
        <div class="table-responsive">

            <table id="tblProforma"
                   class="table table-bordered table-hover align-middle"
                   style="width:100%;">

                <thead class="table-light">

                    <tr>

                        <th>Sr.No.</th>

                        <th>Created Date</th>

                        <th>Proforma No.</th>

                        <th>Company Name</th>

                        <th>Basic Amount</th>

                        <th>GST Amount</th>

                        <th class="text-center"
                            style="width:120px;">
                            Action
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        int count = 1;

                        foreach (var item in Model)
                        {
                            <tr>

                                <td class="row-number">
                                    @count
                                </td>

                                <td>
                                    @(item.ProformaDate.HasValue
                                                                ? item.ProformaDate.Value.ToString("dd/MM/yyyy")
                                                                : "")
                        </td>
                        <td>
                            <strong>
                                @item.ProformaNo
                            </strong>
                        </td>

                                <td>
                                    @item.CompanyName
                                </td>

                                <td class="text-end">
                                    @item.TotalAmtBeforeTax
                                </td>

                                <td class="text-end">
                                    @item.TotalAmtAfterTax
                                </td>

                                <td>

                                    <div class="d-flex justify-content-center gap-1">

                                        <!-- Edit -->
                                        <a asp-controller="Proforma"
                                           asp-action="Create"
                                           asp-route-ID="@item.ID"
                                           class="btn btn-sm btn-primary"
                                           title="Edit">
                                            <i class="fa fa-edit"></i>
                                        </a>

                                        <!-- Details -->
                                        <button type="button"
                                                class="btn btn-sm btn-info"
                                                title="View Details"
                                                onclick="GetProformaDetails('@item.ID')">

                                            <i class="fa fa-eye"></i>

                                        </button>

                                        <!-- Delete -->
                                        <button type="button"
                                                class="btn btn-sm btn-danger"
                                                title="Delete"
                                                onclick="DeleteProforma('@item.ID')">

                                            <i class="fa fa-trash"></i>

                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-primary"
                                                title="Send PDF"
                                                onclick="ViewPDF('@item.ID')">
                                            <i class="fa fa-file-pdf"></i>
                                        </button>
                                    </div>

                                </td>

                            </tr>

                            count++;
                        }
                    }
                    else
                    {
                        <tr id="noDataRow">

                            <td colspan="8"
                                class="text-center py-4">

                                <i class="fa fa-info-circle me-2"></i>

                                No Proforma records found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <nav>

            <ul class="pagination justify-content-center mt-3"
                id="pagination">
            </ul>

        </nav>

    </div>

</div>

<div class="modal fade"
     id="ProformaModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    <i class="fa fa-file-text-o me-2"></i>
                    Proforma Details
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <div class="table-responsive">

                    <table id="tblProformaList"
                           class="table table-bordered table-striped"
                           style="width:100%;">

                        <thead class="table-light">

                            <tr>

                                <th>Service </th>
                                <th>Sac Code.</th>
                                <th>Qty</th>
                                <th>Rate</th>
                                <th>Amount</th>
                                <th>Total</th>


                            </tr>

                        </thead>

                        <tbody>
                        </tbody>

                    </table>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-danger"
                        data-bs-dismiss="modal">

                    <i class="fa fa-times me-1"></i>
                    Close

                </button>

            </div>

        </div>

    </div>

</div>

<script>
    const searchInput = document.getElementById("searchInput");
    const pagination = document.getElementById("pagination");
    const totalRecords = document.getElementById("totalRecords");
    const pageSizeDropdown = document.getElementById("ddlStatus");

    const table = document.getElementById("tblProforma");
    const tbody = table.querySelector("tbody");

    let allRows = [];
    let filteredRows = [];
    let currentPage = 1;
    let rowsPerPage = 100;


    function loadRows() {
        allRows = Array.from(tbody.querySelectorAll("tr")).filter(row => !row.id);
        filteredRows = allRows;
        updateTotalRecords();
        displayTable(1);
    }


    function updateTotalRecords() {
        totalRecords.innerText = filteredRows.length;
    }


    function displayTable(page) {
        currentPage = page;

        allRows.forEach(function (row) {
            row.style.display = "none";
        });

        let start = 0;
        if (rowsPerPage !== "all") {
            start = (page - 1) * parseInt(rowsPerPage);
        }

        let end = rowsPerPage === "all"
            ? filteredRows.length
            : start + parseInt(rowsPerPage);

        filteredRows.slice(start, end).forEach(function (row, index) {
            row.style.display = "";
            let numberCell = row.querySelector(".row-number");
            if (numberCell) {
                numberCell.innerText = start + index + 1;
            }
        });

        createPagination();
    }


    function createPagination() {
        pagination.innerHTML = "";

        if (rowsPerPage === "all") {
            return;
        }

        const totalPages = Math.ceil(filteredRows.length / parseInt(rowsPerPage));

        if (totalPages <= 1) {
            return;
        }

        // Previous
        const previousLi = document.createElement("li");
        previousLi.className = "page-item " + (currentPage === 1 ? "disabled" : "");
        previousLi.innerHTML = `
            <a class="page-link" href="javascript:void(0)">
                <i class="fa fa-chevron-left"></i>
            </a>
        `;
        previousLi.onclick = function () {
            if (currentPage > 1) {
                displayTable(currentPage - 1);
            }
        };
        pagination.appendChild(previousLi);

        // Page Numbers
        for (let i = 1; i <= totalPages; i++) {
            const li = document.createElement("li");
            li.className = "page-item " + (i === currentPage ? "active" : "");
            li.innerHTML = `
                <a class="page-link" href="javascript:void(0)">
                    ${i}
                </a>
            `;
            li.onclick = function () {
                displayTable(i);
            };
            pagination.appendChild(li);
        }

        // Next
        const nextLi = document.createElement("li");
        nextLi.className = "page-item " + (currentPage === totalPages ? "disabled" : "");
        nextLi.innerHTML = `
            <a class="page-link" href="javascript:void(0)">
                <i class="fa fa-chevron-right"></i>
            </a>
        `;
        nextLi.onclick = function () {
            if (currentPage < totalPages) {
                displayTable(currentPage + 1);
            }
        };
        pagination.appendChild(nextLi);
    }


    searchInput.addEventListener("keyup", function () {
        const value = this.value.toLowerCase().trim();
        filteredRows = allRows.filter(function (row) {
            return row.textContent.toLowerCase().includes(value);
        });
        updateTotalRecords();
        currentPage = 1;
        displayTable(1);
    });

    pageSizeDropdown.addEventListener("change", function () {
        rowsPerPage = this.value === "all" ? "all" : parseInt(this.value);
        currentPage = 1;
        displayTable(1);
    });


    $(document).ready(function () {
        loadRows();
    });


    function GetProformaDetails(id) {
        $("#loader").show();

        $.ajax({
            url: '@Url.Action("GetDetailsById", "Proforma")',
            type: "POST",
            data: {
                ID: id
            },
            success: function (response) {
                if (response.success === true) {
                    $("#tblProformaList tbody").empty();

                    var details = response.data;

                    if (details != null && details.length > 0) {
                        var html = "";

                        $.each(details, function (i, item) {
                            html += `
                                <tr>                          
                                    <td>${item.productDescription ?? ""}</td>
                                    <td>${item.sacCode ?? ""}</td>
                                    <td class="text-end">${item.qty ?? 0}</td>                           
                                    <td class="text-end">${item.rate ?? 0}</td>
                                    <td class="text-end">${item.taxableValue ?? 0}</td>
                                    <td class="text-end">${item.total ?? 0}</td>
                                </tr>
                            `;
                        });

                        $("#tblProformaList tbody").html(html);
                    } else {
                        $("#tblProformaList tbody").html(`
                            <tr>
                                <td colspan="7" class="text-center text-muted">
                                    No Proforma details found.
                                </td>
                            </tr>
                        `);
                    }

                    // Open Bootstrap 5 modal
                    var modalElement = document.getElementById("ProformaModal");
                    var modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                    modal.show();
                }
                else {
                    showToast(response.message || "Unable to load Proforma details.", "error");
                }
            },
            complete: function () {
                $("#loader").hide();
            },
            error: function (xhr) {
                showToast("Error while loading Proforma details.", "error");
            }
        });
    }


    function DeleteProforma(id) {
        if (!id || id === "" || id === "0") {
            showToast("Invalid Proforma ID.", "error");
            return;
        }
        if (!confirm("Are you sure you want to delete this Proforma?")) {
            return;
        }

        $("#loader").show();

        $.ajax({
            url: '@Url.Action("Delete", "Proforma")',
            type: "POST",
            data: {
                ID: id
            },
            success: function (response) {
                if (response.success === true) {
                    showToast(response.message || "Proforma deleted successfully.", "success");

                    setTimeout(function () {
                        location.reload();
                    }, 800);
                }
                else {
                    showToast(response.message || "Unable to delete Proforma.", "error");
                }
            },
            complete: function () {
                $("#loader").hide();
            },
            error: function (xhr) {
                showToast("Something went wrong while deleting Proforma.", "error");
            }
        });
    }


        function ViewPDF(id) {

        $.ajax({
            url: '/Proforma/ViewPDF',
            type: 'POST',
            data: { ID: id },
            success: function (response) {
                if (response.success) {
                    const byteChars = atob(response.fileData);
                const byteNumbers = new Array(byteChars.length);
                for (let i = 0; i < byteChars.length; i++) {
                    byteNumbers[i] = byteChars.charCodeAt(i);
                }
                const byteArray = new Uint8Array(byteNumbers);
                const blob = new Blob([byteArray], { type: 'application/pdf' });
                const url = window.URL.createObjectURL(blob);              
                window.open(url);
                setTimeout(() => window.URL.revokeObjectURL(url), 10000);
                } else {
                    showToast(response.message || "Failed to View PDF.","error");
                }
            },
            error: function () {
                showToast("Something went wrong while View PDF.","error");
            }
        });
    }
</script>