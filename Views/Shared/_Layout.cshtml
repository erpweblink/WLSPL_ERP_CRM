    <div class="page-wrapper">
        <div class="page-content">
            <main role="main">
                <div id="toastContainer"></div>
                <div class="container-fluid">
                    @RenderBody()
                    @await RenderSectionAsync("Scripts", required: false)
                </div>
            </main>
        </div>
    </div>

    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/app.js"></script>

    @if (TempData["ToastMessage"] != null)
    {
        <script type="text/javascript">
                document.addEventListener("DOMContentLoaded", function () {
                showToast(
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastMessage"]?.ToString())),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastType"]?.ToString() ?? "info")));
            });
        </script>
    }

    <script type="text/javascript">
                 // TosterScxript
           function showToast(message, type) {
            type = type || "info";

            var iconClass = "fas fa-info-circle";

            if (type === "success") {
                iconClass = "fas fa-check-circle";
            }
            else if (type === "error") {
                iconClass = "fas fa-times-circle";
            }
            else if (type === "warning") {
                iconClass = "fas fa-exclamation-triangle";
            }

            var toast = document.createElement("div");

            toast.className = "app-toast " + type;

            toast.innerHTML =
                '<div class="toast-icon-wrap">' +
                    '<i class="' + iconClass + ' toast-icon"></i>' +
                '</div>' +
                '<div class="toast-message"></div>' +
                '<button type="button" class="toast-close">&times;</button>' +
                '<div class="toast-progress"></div>';

            toast.querySelector(".toast-message").textContent = message;

            var container = document.getElementById("toastContainer");

            container.appendChild(toast);

            requestAnimationFrame(function () {
                toast.classList.add("show");
            });

            function removeToast() {
                toast.classList.add("hide");
                toast.classList.remove("show");

                setTimeout(function () {
                    toast.remove();
                }, 400);
            }

            toast.querySelector(".toast-close")
                .addEventListener("click", removeToast);

            setTimeout(removeToast, 4000);
        }

           function showConfirmToast(message, onYes, onNo) {

            var toast = document.createElement("div");

            toast.className = "app-toast warning confirm-toast";

            toast.innerHTML =
                '<div class="toast-icon-wrap">' +
                    '<i class="fas fa-question-circle toast-icon"></i>' +
                '</div>' +

                '<div class="toast-message">' +
                    '<div>' + message + '</div>' +

                    '<div class="confirm-buttons">' +
                        '<button type="button" class="confirm-yes">Yes</button>' +
                        '<button type="button" class="confirm-no">No</button>' +
                    '</div>' +

                '</div>' +

                '<div class="toast-progress"></div>';

            var container = document.getElementById("toastContainer");

            container.appendChild(toast);

            requestAnimationFrame(function () {
                toast.classList.add("show");
            });

            var yesButton = toast.querySelector(".confirm-yes");
            var noButton = toast.querySelector(".confirm-no");

            var closed = false;

            function removeToast() {

                if (closed) return;

                closed = true;

                toast.classList.add("hide");
                toast.classList.remove("show");

                setTimeout(function () {
                    toast.remove();
                }, 300);
            }

            yesButton.addEventListener("click", function () {

                removeToast();

                if (typeof onYes === "function") {
                    onYes();
                }

            });

            noButton.addEventListener("click", function () {

                removeToast();

                if (typeof onNo === "function") {
                    onNo();
                }

            });
        }
    </script>
</body>
</html>
