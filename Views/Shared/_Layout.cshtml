<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>WLSPL | CRM</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta content="Premium Multipurpose Admin & Dashboard Template" name="description" />
    <meta content="" name="author" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="shortcut icon" href="~/assets/images/WLSPL_FAVICON.png">

    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/app.min.css" rel="stylesheet" type="text/css" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <style type="text/css">
        /* ===== TOAST NOTIFICATIONS - FUTURISTIC ===== */
        #toastContainer {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            gap: 14px;
            max-width: 380px;
        }

        .app-toast {
            position: relative;
            display: flex;
            align-items: flex-start;
            gap: 14px;
            border-radius: 16px;
            padding: 16px 18px 18px 16px;
            overflow: hidden;
            color: #fff;
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, .18);
            opacity: 0;
            transform: translateX(50px) scale(.92);
            transition: opacity .4s cubic-bezier(.21,1.02,.73,1), transform .4s cubic-bezier(.21,1.02,.73,1);
        }

            .app-toast.show {
                opacity: 1;
                transform: translateX(0) scale(1);
            }

            .app-toast.hide {
                opacity: 0;
                transform: translateX(50px) scale(.92);
            }

            /* Gradient backgrounds per type */
            .app-toast.success {
                background: linear-gradient(135deg, rgba(17,153,142,.95), rgba(56,239,125,.9));
                box-shadow: 0 8px 32px rgba(17,153,142,.45), 0 0 0 1px rgba(56,239,125,.2) inset;
            }

            .app-toast.error {
                background: linear-gradient(135deg, rgba(203,0,49,.95), rgba(255,75,75,.9));
                box-shadow: 0 8px 32px rgba(203,0,49,.45), 0 0 0 1px rgba(255,75,75,.2) inset;
            }

            .app-toast.warning {
                background: linear-gradient(135deg, rgba(240,152,25,.95), rgba(255,201,71,.9));
                box-shadow: 0 8px 32px rgba(240,152,25,.4), 0 0 0 1px rgba(255,201,71,.2) inset;
            }

            .app-toast.info {
                background: linear-gradient(135deg, rgba(37,117,252,.95), rgba(106,17,203,.9));
                box-shadow: 0 8px 32px rgba(37,117,252,.45), 0 0 0 1px rgba(106,17,203,.2) inset;
            }

            .app-toast .toast-icon-wrap {
                flex-shrink: 0;
                width: 36px;
                height: 36px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(255, 255, 255, .22);
                box-shadow: 0 0 12px rgba(255, 255, 255, .35);
            }

            .app-toast .toast-icon {
                font-size: 17px;
                line-height: 1;
                color: #fff;
            }

            .app-toast .toast-message {
                flex: 1;
                font-size: 13.5px;
                font-weight: 600;
                line-height: 1.4;
                color: #fff;
                padding-top: 7px;
                text-shadow: 0 1px 2px rgba(0,0,0,.15);
            }

            .app-toast .toast-close {
                cursor: pointer;
                color: rgba(255, 255, 255, .8);
                font-size: 16px;
                line-height: 1;
                background: rgba(255, 255, 255, .15);
                border: none;
                padding: 5px;
                width: 24px;
                height: 24px;
                border-radius: 50%;
                transition: background .2s, transform .2s;
                align-self: flex-start;
            }

                .app-toast .toast-close:hover {
                    background: rgba(255, 255, 255, .3);
                    transform: rotate(90deg);
                }

            .app-toast .toast-progress {
                position: absolute;
                bottom: 0;
                left: 0;
                height: 3px;
                width: 100%;
                background: rgba(255, 255, 255, .55);
                box-shadow: 0 0 8px rgba(255, 255, 255, .6);
                transform-origin: left;
                animation: toastProgress 5s linear forwards;
            }

        @@keyframes toastProgress {
            from {
                transform: scaleX(1);
            }

            to {
                transform: scaleX(0);
            }
        }

        @@media (max-width: 768px) {
            #toastContainer {
                left: 12px;
                right: 12px;
                max-width: none;
                top: 12px;
            }
        }


        .confirm-toast {
            min-width: 350px;
        }

        .confirm-buttons {
            margin-top: 12px;
            display: flex;
            gap: 8px;
        }

            .confirm-buttons button {
                border: none;
                padding: 6px 16px;
                border-radius: 5px;
                cursor: pointer;
                font-size: 13px;
                font-weight: 600;
            }

        .confirm-yes {
            background: #28a745;
            color: #fff;
        }

        .confirm-no {
            background: #dc3545;
            color: #fff;
        }

        .confirm-buttons button:hover {
            opacity: 0.85;
        }
    </style>
</head>

<body>
    <div class="topbar d-print-none">
        <nav class="topbar-custom d-flex justify-content-between" id="topbar-custom">
            <ul class="topbar-item list-unstyled d-inline-flex align-items-center mb-0">
                <li>
                    <button class="nav-link mobile-menu-btn nav-icon" id="togglemenu">
                        <i class="iconoir-menu-scale "></i>
                    </button>
                </li>

                @{
                    var userName = Context.Session.GetString("UserName");
                    var fullName = Context.Session.GetString("EmployeeName");

                    var currentHour = DateTime.Now.Hour;

                    string greeting;

                    if (currentHour >= 5 && currentHour < 12)
                    {
                        greeting = "Good Morning";
                    }
                    else if (currentHour >= 12 && currentHour < 17)
                    {
                        greeting = "Good Afternoon";
                    }
                    else
                    {
                        greeting = "Good Evening";
                    }
                }

                @if (!string.IsNullOrEmpty(fullName))
                {
                    <li class="mx-3 welcome-text">
                        <h3 class="mb-0 fw-bold text-truncate">
                            @greeting, @fullName
                        </h3>
                    </li>
                }


            </ul>
            <ul class="topbar-item list-unstyled d-inline-flex align-items-center mb-0">
                @{
                    var profileName = Context.Session.GetString("EmployeeName");
                    var profileUserName = Context.Session.GetString("UserName");
                    var profileRole = Context.Session.GetString("Role");

                    // Default profile image
                    var profileImage = Context.Session.GetString("Profile");

                    if (string.IsNullOrEmpty(profileImage))
                    {
                        profileImage = "https://api.iconify.design/mdi/account-circle.svg?color=%23666666";
                    }
                }

                @if (!string.IsNullOrEmpty(profileName))
                {
                    <li class="dropdown topbar-item">

                        <a class="nav-link dropdown-toggle arrow-none nav-icon"
                           data-bs-toggle="dropdown"
                           href="#"
                           role="button"
                           aria-haspopup="false"
                           aria-expanded="false">

                            <img src="@profileImage"
                                 alt="@profileName"
                                 class="thumb-lg rounded-circle">
                        </a>

                        <div class="dropdown-menu dropdown-menu-end py-0">

                            <!-- User information -->
                            <div class="d-flex align-items-center dropdown-item py-2 bg-secondary-subtle">

                                <div class="flex-shrink-0">

                                    <img src="@profileImage"
                                         alt="@profileName"
                                         class="thumb-md rounded-circle">

                                </div>

                                <div class="flex-grow-1 ms-2 text-truncate align-self-center">

                                    <h6 class="my-0 fw-medium text-dark fs-13">
                                        @profileName
                                    </h6>

                                    <small class="text-muted mb-0">
                                        @profileRole
                                    </small>

                                </div>

                            </div>

                            <div class="dropdown-divider mt-0"></div>

                            <small class="text-muted px-2 pb-1 d-block">
                                Account
                            </small>

                            <!-- Profile -->
                            <a class="dropdown-item"
                               asp-controller="Dashboard"
                               asp-action="ShowProfile">

                                <i class="las la-user fs-18 me-1 align-text-bottom"></i>

                                Profile

                            </a>

                            <div class="dropdown-divider mb-0"></div>

                            <a class="dropdown-item text-danger"
                               asp-controller="Login"
                               asp-action="Logout">

                                <i class="las la-power-off fs-18 me-1 align-text-bottom"></i>

                                Logout

                            </a>

                        </div>

                    </li>
                }

            </ul>
        </nav>
    </div>

