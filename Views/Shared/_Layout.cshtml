<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>WLSPL | CRM</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta content="Premium Multipurpose Admin & Dashboard Template" name="description" />
    <meta content="" name="author" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="shortcut icon" href="~/assets/images/WLSPL_FAVICON.png">

    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/app.min.css" rel="stylesheet" type="text/css" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
</head>

<body>
    <div class="topbar d-print-none">
        <nav class="topbar-custom d-flex justify-content-between" id="topbar-custom">
            <ul class="topbar-item list-unstyled d-inline-flex align-items-center mb-0">
                <li>
                    <button class="nav-link mobile-menu-btn nav-icon" id="togglemenu">
                        <i class="iconoir-menu-scale "></i>
                    </button>
                </li>

                @{
                    var userName = Context.Session.GetString("UserName");
                    var fullName = Context.Session.GetString("EmployeeName");

                    var currentHour = DateTime.Now.Hour;

                    string greeting;

                    if (currentHour >= 5 && currentHour < 12)
                    {
                        greeting = "Good Morning";
                    }
                    else if (currentHour >= 12 && currentHour < 17)
                    {
                        greeting = "Good Afternoon";
                    }
                    else
                    {
                        greeting = "Good Evening";
                    }
                }

                @if (!string.IsNullOrEmpty(fullName))
                {
                    <li class="mx-3 welcome-text">
                        <h3 class="mb-0 fw-bold text-truncate">
                            @greeting, @fullName
                        </h3>
                    </li>
                }


            </ul>
            <ul class="topbar-item list-unstyled d-inline-flex align-items-center mb-0">
                @{
                    var profileName = Context.Session.GetString("EmployeeName");
                    var profileUserName = Context.Session.GetString("UserName");
                    var profileRole = Context.Session.GetString("Role");
                    var profileImage = Context.Session.GetString("Profile");
                    if (string.IsNullOrEmpty(profileImage))
                    {
                        profileImage = "https://api.iconify.design/mdi/account-circle.svg?color=%23666666";
                    }
                }
                @if (!string.IsNullOrEmpty(profileName))
                {
                    <li class="dropdown topbar-item">
                        <!-- Trigger button -->
                        <a class="nav-link arrow-none nav-icon profile-trigger"
                           data-bs-toggle="dropdown"
                           href="#"
                           role="button"
                           aria-haspopup="false"
                           aria-expanded="false">
                            <div class="profile-avatar-wrap">
                                <img src="@profileImage"
                                     alt="@profileName"
                                     class="profile-avatar-img">
                                <span class="profile-online-dot"></span>
                            </div>
                            <div class="profile-trigger-info d-none d-md-block">
                                <span class="profile-trigger-name">@profileName</span>
                                <span class="profile-trigger-role d-none">@profileRole</span>
                            </div>
                            <i class="las la-angle-down profile-chevron d-none d-md-block"
                               style="font-size: 12px !important;display: inline-flex !important;
                               align-items: center !important;justify-content: center !important;"></i>
                        </a>

                        <!-- Dropdown -->
                        <div class="dropdown-menu dropdown-menu-end profile-dropdown-menu py-0">

                            <!-- Header -->
                            <div class="profile-dropdown-header">
                                <div class="profile-header-bg"></div>
                                <div class="profile-header-content">
                                    <div class="profile-header-avatar-wrap">
                                        <img src="@profileImage"
                                             alt="@profileName"
                                             class="profile-header-avatar">
                                        <span class="profile-header-online"></span>
                                    </div>
                                    <div class="profile-header-info">
                                        <h6 class="profile-header-name">@profileName</h6>
                                        <span class="profile-header-username">@profileUserName</span>
                                        <span class="profile-header-badge">@profileRole</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Menu items -->
                            <div class="profile-dropdown-body">
                                <p class="profile-section-label">Account</p>

                                <a class="profile-menu-item"
                                   asp-controller="UserMaster"
                                   asp-action="UserProfile">
                                    <span class="profile-menu-icon" style="background: rgba(99,102,241,.12); color:#6366f1;">
                                        <i class="las la-user"></i>
                                    </span>
                                    <span class="profile-menu-text">
                                        <span class="profile-menu-title">My Profile</span>
                                        <span class="profile-menu-sub">View & edit your info</span>
                                    </span>
                                    <i class="las la-angle-right profile-menu-arrow"></i>
                                </a>

                                <div class="profile-divider"></div>

                                <a class="profile-menu-item profile-menu-danger"
                                   asp-controller="Login"
                                   asp-action="Logout">
                                    <span class="profile-menu-icon" style="background: rgba(239,68,68,.10); color:#ef4444;">
                                        <i class="las la-power-off"></i>
                                    </span>
                                    <span class="profile-menu-text">
                                        <span class="profile-menu-title">Sign Out</span>
                                        <span class="profile-menu-sub">End your session</span>
                                    </span>
                                    <i class="las la-angle-right profile-menu-arrow"></i>
                                </a>
                            </div>

                        </div>
                    </li>
                }
            </ul>
        </nav>
    </div>

    <div class="startbar d-print-none">
        <div class="brand">
            <a href="#" class="logo">
                <span>
                    <img src="~/assets/wlsplimage/logo-sm.png" alt="logo-small" class="logo-sm">
                </span>
                <span class="">
                    <img src="~/assets/wlsplimage/logo-light.png" alt="logo-large" class="logo-lg logo-light" style="height: 55px;">
                    <img src="~/assets/wlsplimage/logo-dark.png" alt="logo-large" class="logo-lg logo-dark" style="height: 55px;">
                </span>
            </a>
        </div>

        <div class="startbar-menu">
            <div class="startbar-collapse" id="startbarCollapse" data-simplebar>
                <div class="d-flex align-items-start flex-column w-100">
                    <ul class="navbar-nav mb-auto w-100">
                        <li class="menu-label pt-0 mt-0">
                            <span>Menu</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                <i class="iconoir-dashboard-speed menu-icon"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#sidebarDashboards" data-bs-toggle="collapse" role="button"
                               aria-expanded="false" aria-controls="sidebarDashboards">
                                <i class="iconoir-home-simple menu-icon"></i>
                                <span>CRM</span>
                            </a>
                            <div class="collapse " id="sidebarDashboards">
                                <ul class="nav flex-column">
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="UserMaster" asp-action="index">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">User's</span></div>
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Services" asp-action="Index">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Services</span></div>
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Lead" asp-action="InquiryList">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Web Site Inquiry</span></div>
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Lead" asp-action="WhatsappInquiry">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">What'sapp Inquiry</span></div>
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Lead" asp-action="index">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Lead Generation</span></div>
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Companymaster" asp-action="index">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Company</span></div>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="CallandMeeting" asp-action="Create">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Call and Meeting Update</span></div>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Callandmeeting" asp-action="FollowUpReport">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Call and Meeting Report</span></div>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Callandmeeting" asp-action="NotUpdateIndex">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Not Updated List</span></div>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#sidebarApplications" data-bs-toggle="collapse" role="button"
                               aria-expanded="false" aria-controls="sidebarApplications">
                                <i class="iconoir-view-grid menu-icon"></i>
                                <span>ERP</span>
                            </a>
                            <div class="collapse " id="sidebarApplications">
                                <ul class="nav flex-column">

                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Quotation" asp-action="Index">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Quotation</span></div>
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Proforma" asp-action="Index">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Proforma</span></div>
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="WorkOrder" asp-action="Index">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Work-Order</span></div>
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="TaxInvoice" asp-action="Index">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Tax Invoice</span></div>
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="TaxInvoice" asp-action="BalancePayment">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Balance Payment List</span></div>
                                        </a>
                                    </li>

                                </ul>
                            </div>
                        </li>
                        <li class="nav-item d-none">
                            <a class="nav-link" href="#sidebarApplicationss" data-bs-toggle="collapse" role="button"
                               aria-expanded="false" aria-controls="sidebarApplicationss">
                                <i class="iconoir-view-grid menu-icon"></i>
                                <span>HRMS</span>
                            </a>
                            <div class="collapse " id="sidebarApplicationss">
                                <ul class="nav flex-column">
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Workforce" asp-action="GetQuotationlist">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Workforce</span></div>
                                        </a>
                                    </li>


                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Performance" asp-action="Index">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Performance</span></div>
                                        </a>
                                    </li>


                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Payroll" asp-action="Getworkorderlist">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Payroll</span></div>
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Attendance" asp-action="Index">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Attendance</span></div>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Recruitment" asp-action="Index">
                                            <div class="d-flex align-items-center"><span class="nav-link-text">Recruitment</span></div>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="page-wrapper">
        <div class="page-content">
            <main role="main">
                <div id="toastContainer"></div>
                <div class="container-fluid">
                    @RenderBody()
                    @await RenderSectionAsync("Scripts", required: false)
                </div>
            </main>
        </div>
    </div>

    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/app.js"></script>

    @if (TempData["ToastMessage"] != null)
    {
        <script type="text/javascript">
                document.addEventListener("DOMContentLoaded", function () {
                showToast(
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastMessage"]?.ToString())),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ToastType"]?.ToString() ?? "info")));
            });
        </script>
    }

    <script type="text/javascript">
           // TosterScxript
           function showToast(message, type) {
                type = type || "info";

                var iconClass = "fas fa-info-circle";

                if (type === "success") {
                    iconClass = "fas fa-check-circle";
                }
                else if (type === "error") {
                    iconClass = "fas fa-times-circle";
                }
                else if (type === "warning") {
                    iconClass = "fas fa-exclamation-triangle";
                }

                var toast = document.createElement("div");

                toast.className = "app-toast " + type;

                toast.innerHTML =
                    '<div class="toast-icon-wrap">' +
                        '<i class="' + iconClass + ' toast-icon"></i>' +
                    '</div>' +
                    '<div class="toast-message"></div>' +
                    '<button type="button" class="toast-close">&times;</button>' +
                    '<div class="toast-progress"></div>';

                toast.querySelector(".toast-message").textContent = message;

                var container = document.getElementById("toastContainer");

                container.appendChild(toast);

                requestAnimationFrame(function () {
                    toast.classList.add("show");
                });

                function removeToast() {
                    toast.classList.add("hide");
                    toast.classList.remove("show");

                    setTimeout(function () {
                        toast.remove();
                    }, 400);
                }

                toast.querySelector(".toast-close")
                    .addEventListener("click", removeToast);

                setTimeout(removeToast, 4000);
        }

           function showConfirmToast(message, onYes, onNo) {

                var toast = document.createElement("div");

                toast.className = "app-toast warning confirm-toast";

                toast.innerHTML =
                    '<div class="toast-icon-wrap">' +
                        '<i class="fas fa-question-circle toast-icon"></i>' +
                    '</div>' +

                    '<div class="toast-message">' +
                        '<div>' + message + '</div>' +

                        '<div class="confirm-buttons">' +
                            '<button type="button" class="confirm-yes">Yes</button>' +
                            '<button type="button" class="confirm-no">No</button>' +
                        '</div>' +

                    '</div>' +

                    '<div class="toast-progress"></div>';

                var container = document.getElementById("toastContainer");

                container.appendChild(toast);

                requestAnimationFrame(function () {
                    toast.classList.add("show");
                });

                var yesButton = toast.querySelector(".confirm-yes");
                var noButton = toast.querySelector(".confirm-no");

                var closed = false;

                function removeToast() {

                    if (closed) return;

                    closed = true;

                    toast.classList.add("hide");
                    toast.classList.remove("show");

                    setTimeout(function () {
                        toast.remove();
                    }, 300);
                }

                yesButton.addEventListener("click", function () {

                    removeToast();

                    if (typeof onYes === "function") {
                        onYes();
                    }

                });

                noButton.addEventListener("click", function () {

                    removeToast();

                    if (typeof onNo === "function") {
                        onNo();
                    }

                });
        }
    </script>
</body>
</html>
