<script>

    // =========================================================
    // DEPARTMENT CONFIGURATION
    // =========================================================

    function loadDepartmentConfiguration() {

        var selected =
            $("#DepartmentID option:selected");

        var departmentCode =
            selected.attr("data-code");

        var departmentName =
            selected.text().trim();


        $(".service-config").hide();

        $("#departmentInfo").hide();


        if (!departmentCode) {
            return;
        }


        $("#selectedDepartment")
            .text(departmentName);

        $("#selectedDepartmentCode")
            .text(departmentCode);

        $("#departmentInfo").slideDown();


        switch (departmentCode) {

            case "SEO":

                $("#seoConfiguration")
                    .slideDown();

                break;


            case "WEBDEV":

                $("#webDevelopmentConfiguration")
                    .slideDown();

                break;


            case "GRASMO":

                $("#graphicsConfiguration")
                    .slideDown();

                break;


            case "SWDEV":

                $("#softwareDevelopmentConfiguration")
                    .slideDown();

                break;


            case "SWTEST":

                $("#testingConfiguration")
                    .slideDown();

                break;


            case "SALES":

                $("#salesConfiguration")
                    .slideDown();

                break;


            case "HR":

                $("#hrConfiguration")
                    .slideDown();

                break;

        }

    }


    // =========================================================
    // SEO CONFIGURATION
    // =========================================================

    function loadSEOConfiguration() {

        var seoType =
            $("#SEOType").val();


        $("#localSEO").hide();
        $("#nationalSEO").hide();
        $("#ecommerceSEO").hide();


        if (seoType === "Local SEO") {

            $("#localSEO").slideDown();

        }

        else if (seoType === "National SEO") {

            $("#nationalSEO").slideDown();

        }

        else if (seoType === "E-Commerce SEO") {

            $("#ecommerceSEO").slideDown();

        }

    }


    // =========================================================
    // ADD KEYWORD
    // =========================================================

    function addKeyword() {

        var html = `

            <div class="keyword-row">

                <input type="text"
                       name="Keywords"
                       class="form-control"
                       placeholder="Example: SEO company in Delhi" />

                <button type="button"
                        class="btn btn-danger remove-keyword"
                        onclick="removeKeyword(this)">

                    <i class="fa fa-trash"></i>

                </button>

            </div>

        `;

        $("#keywordContainer").append(html);

    }


    // =========================================================
    // REMOVE KEYWORD
    // =========================================================

    function removeKeyword(button) {

        var rows =
            $("#keywordContainer .keyword-row");


        if (rows.length > 1) {

            $(button)
                .closest(".keyword-row")
                .remove();

        }

    }


    // =========================================================
    // SERVICE CODE
    // =========================================================

    $("#ServiceCode").on("input", function () {

        this.value = this.value
            .toUpperCase()
            .replace(/[^A-Z0-9-_]/g, "");

    });


    // =========================================================
    // PRICE
    // =========================================================

    $("#Price").on("input", function () {

        if (parseFloat(this.value) < 0) {

            this.value = 0;

        }

    });


    // =========================================================
    // YEARS
    // =========================================================

    $("#Years").on("input", function () {

        let value = Number(this.value);

        if (value < 1 && this.value !== "") {
            this.value = 1;
        }

        if (value > 50) {
            this.value = 50;
        }

    });


    // =========================================================
    // MAIN VALIDATION
    // =========================================================

    function validateServiceForm() {

        let isValid = true;


        $(".text-danger").text("");

        $(".form-control, .form-select")
            .removeClass("is-invalid");


        // -----------------------------------------------------
        // REQUIRED FIELDS
        // -----------------------------------------------------

        let requiredFields = [

            "DepartmentID",
            "ServiceName",
            "ServiceCode",
            "Price",
            "Currency",
            "Years"

        ];


        requiredFields.forEach(function (fieldName) {

            let field =
                $("[name='" + fieldName + "']");


            if (field.length > 0) {

                let value =
                    field.val();


                if (value == null ||
                    value.toString().trim() === "") {

                    field.addClass("is-invalid");

                    $("[data-valmsg-for='" +
                        fieldName +
                        "']")
                        .text(fieldName + " is required");

                    isValid = false;

                }

            }

        });


        // -----------------------------------------------------
        // PRICE
        // -----------------------------------------------------

        let price =
            Number($("#Price").val());


        if (price < 0) {

            $("#Price")
                .addClass("is-invalid");

            $("[data-valmsg-for='Price']")
                .text("Price cannot be negative");

            isValid = false;

        }


        // -----------------------------------------------------
        // SERVICE CODE
        // -----------------------------------------------------

        let serviceCode =
            $("#ServiceCode").val();


        if (serviceCode !== "" &&
            serviceCode.length < 2) {

            $("#ServiceCode")
                .addClass("is-invalid");

            $("[data-valmsg-for='ServiceCode']")
                .text(
                    "Service Code must contain at least 2 characters"
                );

            isValid = false;

        }


        // -----------------------------------------------------
        // DURATION
        // -----------------------------------------------------

        let years =
            $("#Years").val();


        if (years !== "") {

            let duration =
                Number(years);


            if (!Number.isInteger(duration)) {

                $("#Years")
                    .addClass("is-invalid");

                $("[data-valmsg-for='Years']")
                    .text(
                        "Duration must be a whole number"
                    );

                isValid = false;

            }

            else if (duration < 1) {

                $("#Years")
                    .addClass("is-invalid");

                $("[data-valmsg-for='Years']")
                    .text(
                        "Duration must be at least 1 year"
                    );

                isValid = false;

            }

            else if (duration > 50) {

                $("#Years")
                    .addClass("is-invalid");

                $("[data-valmsg-for='Years']")
                    .text(
                        "Duration cannot exceed 50 years"
                    );

                isValid = false;

            }

        }


        // -----------------------------------------------------
        // DEPARTMENT
        // -----------------------------------------------------

        var selected =
            $("#DepartmentID option:selected");

        var departmentCode =
            selected.attr("data-code");


        // -----------------------------------------------------
        // SEO
        // -----------------------------------------------------

        if (departmentCode === "SEO") {

            var seoType =
                $("#SEOType").val();


            if (seoType === "") {

                $("#SEOType")
                    .addClass("is-invalid");

                $("#SEOTypeError")
                    .text("SEO Type is required");

                isValid = false;

            }


            // LOCAL SEO

            if (seoType === "Local SEO") {

                var city =
                    $("#City").val();


                if (city.trim() === "") {

                    $("#City")
                        .addClass("is-invalid");

                    isValid = false;

                }

            }

        }


        // -----------------------------------------------------
        // SCROLL
        // -----------------------------------------------------

        if (!isValid) {

            window.scrollTo({

                top: 0,
                behavior: "smooth"

            });

        }


        return isValid;

    }


    // =========================================================
    // PAGE LOAD
    // =========================================================

    $(document).ready(function () {

        loadDepartmentConfiguration();

        loadSEOConfiguration();

    });

</script>
