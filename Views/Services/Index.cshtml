@using WEBLINK_CRM.Models
@using WEBLINK_CRM.Helpers
@model IEnumerable<Services>

@{
    ViewData["Title"] = "Service Management";
}

<style>
    .search-box {
        width: 315px;
        height: 35px;
        font-size: 13px;
        border-radius: 6px;
    }

    .record-info {
        font-size: 13px;
        color: #6c757d;
    }

        .record-info strong {
            color: #212529;
        }

    .table tbody td {
        font-size: 12px;
        vertical-align: middle;
        padding: 8px 7px;
        border: 1px dashed #d9dfe5;
    }

    .table tbody tr:hover {
        background: #f4f8ff;
    }

    .service-code {
        color: #0d6efd;
        font-weight: 600;
    }

    .service-name {
        font-weight: 600;
        color: #111;
    }

    .price {
        font-weight: 600;
        color: #212529;
    }

    .action-btn {
        width: 32px;
        height: 30px;
        padding: 5px;
        border-radius: 5px;
    }

    .edit-btn {
        background: #ffc107;
        border-color: #ffc107;
        color: #000;
    }

    .delete-btn {
        background: #dc3545;
        border-color: #dc3545;
        color: #fff;
    }

    .no-record {
        text-align: center;
        padding: 30px !important;
        color: #777;
    }

    .pagination {
        margin-bottom: 0;
    }

        .pagination .page-link {
            font-size: 12px;
            padding: 6px 11px;
            color: #0d6efd;
        }

        .pagination .active .page-link {
            background-color: #0d6efd;
            border-color: #0d6efd;
            color: white;
        }

        .pagination .page-link:hover {
            background-color: #e9f2ff;
        }
</style>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h3><i class="fa fa-cogs"></i> Service Management</h3>
        <a asp-action="CreateService" class="btn btn-primary btn-sm">
            <i class="fa fa-plus"></i> Add New Service
        </a>
    </div>

    <div class="card-body">
        <div class="row mb-2 align-items-center">
            <div class="col-md-6">
                <input type="text" id="searchInput" class="form-control search-box" placeholder="Search service..." />
            </div>
            <div class="col-md-6 text-md-end">
                <span class="record-info">Total Records : <strong id="totalRecords">@(Model?.Count() ?? 0)</strong></span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="serviceTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Service Name</th>
                        <th>Service Code</th>
                        <th>Price</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int count = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="row-number">@count</td>
                                <td><strong class="service-name">@item.ServiceName</strong></td>
                                <td><span class="service-code">@item.ServiceCode</span></td>
                                <td>@item.Price.ToString("N2")</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="EditService"
                                           asp-route-id="@EncryptionHelper.Encrypt(item.ID)"
                                           class="btn btn-sm action-btn edit-btn"
                                           title="Edit">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-id="@EncryptionHelper.Encrypt(item.ID)"
                                           class="btn btn-sm action-btn delete-btn"
                                           title="Delete"
                                           onclick="return confirm('Are you sure you want to delete this service?');">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            count++;
                        }
                    }
                    else
                    {
                        <tr id="noDataRow">
                            <td colspan="5" class="no-record">
                                <i class="fa fa-info-circle"></i> No service records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav>
            <ul class="pagination justify-content-center mt-3" id="pagination"></ul>
        </nav>
    </div>
</div>

<script>
    const rowsPerPage = 100;
    let currentPage = 1;
    let filteredRows = [];

    const table = document.getElementById("serviceTable");
    const tbody = table.querySelector("tbody");
    const searchInput = document.getElementById("searchInput");
    const pagination = document.getElementById("pagination");
    const totalRecords = document.getElementById("totalRecords");

    const allRows = Array.from(tbody.querySelectorAll("tr")).filter(row => !row.id);
    filteredRows = allRows;

    function displayTable(page) {
        currentPage = page;
        allRows.forEach(row => row.style.display = "none");

        const start = (page - 1) * rowsPerPage;
        const end = start + rowsPerPage;

        filteredRows.slice(start, end).forEach((row, index) => {
            row.style.display = "";
            const cell = row.querySelector(".row-number");
            if (cell) cell.innerText = start + index + 1;
        });

        createPagination();
    }

    function createPagination() {
        pagination.innerHTML = "";
        const totalPages = Math.ceil(filteredRows.length / rowsPerPage);
        if (totalPages <= 1) return;

        const prevLi = document.createElement("li");
        prevLi.className = "page-item " + (currentPage === 1 ? "disabled" : "");
        prevLi.innerHTML = `<a class="page-link" href="javascript:void(0)"><i class="fa fa-chevron-left"></i></a>`;
        prevLi.onclick = () => { if (currentPage > 1) displayTable(currentPage - 1); };
        pagination.appendChild(prevLi);

        for (let i = 1; i <= totalPages; i++) {
            const li = document.createElement("li");
            li.className = "page-item " + (i === currentPage ? "active" : "");
            li.innerHTML = `<a class="page-link" href="javascript:void(0)">${i}</a>`;
            li.onclick = () => displayTable(i);
            pagination.appendChild(li);
        }

        const nextLi = document.createElement("li");
        nextLi.className = "page-item " + (currentPage === totalPages ? "disabled" : "");
        nextLi.innerHTML = `<a class="page-link" href="javascript:void(0)"><i class="fa fa-chevron-right"></i></a>`;
        nextLi.onclick = () => { if (currentPage < totalPages) displayTable(currentPage + 1); };
        pagination.appendChild(nextLi);
    }

    searchInput.addEventListener("keyup", function () {
        const value = this.value.toLowerCase().trim();
        filteredRows = allRows.filter(row => row.innerText.toLowerCase().includes(value));
        totalRecords.innerText = filteredRows.length;
        currentPage = 1;
        displayTable(1);
    });

    displayTable(1);
</script>