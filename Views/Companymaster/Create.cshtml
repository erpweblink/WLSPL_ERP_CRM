@model WEBLINK_CRM.Models.Companymaster

@{
    ViewData["Title"] = "Create Company";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style type="text/css">
    .section-title {
        color: #425d7e;
        font-size: 17px;
        font-weight: 600;
        margin: 5px 0 15px;
    }

        .section-title i {
            margin-right: 7px;
        }

    .form-label {
        font-weight: 600;
        color: #333;
    }

    .form-control,
    .form-select {
        height: 45px;
        border-radius: 10px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .2rem rgba(13,110,253,.15);
        }

    .btn {
        border-radius: 8px;
        height: 43px;
        font-weight: 600;
        transition: .3s;
    }

    .btn-success {
        background: #198754;
        border: none;
    }

        .btn-success:hover {
            background: #157347;
            transform: translateY(-2px);
        }

    .btn-danger {
        background: #dc3545;
        border: none;
    }

        .btn-danger:hover {
            background: #bb2d3b;
            transform: translateY(-2px);
        }

    .req {
        color: red;
    }

</style>

<div class="card">

    <div class="card-header" style="background: linear-gradient(314deg, #0b0f14, #1a3e66);color: whitesmoke;">
        <h3>
            <i class="fa fa-building"></i>
            Create New Company
        </h3>

    </div>

    <div class="card-body">
        <form asp-action="Create" method="post" onsubmit="return validateForm();">

            @Html.AntiForgeryToken()

            <div class="row">

                <input type="hidden"
                       asp-for="LeadCode" />



                <!-- Register Type -->

                <div class="col-md-4 mb-3">
                    <label class="form-label">
                        Register Type
                    </label>

                    <select asp-for="RegisterType"
                            id="RegisterType"
                            class="form-select">

                        <option value="WLSPL">WLSPL</option>
                        <option value="WLS">WLS</option>

                    </select>

                    <!-- disabled select is NOT submitted -->
                    <input type="hidden" asp-for="RegisterType" />
                </div>
                <!-- Category -->
                <div class="col-md-4 mb-3">
                    <label asp-for="Category" class="form-label">
                        Category
                    </label>

                    <select asp-for="Category"
                            id="Category"
                            class="form-select">

                        <option value="">-- Select Category --</option>

                        <option value="Trading/Manufacturing">
                            Trading/Manufacturing
                        </option>

                        <option value="Hospital/Clinic">
                            Hospital/Clinic
                        </option>

                        <option value="Others Non-GST">
                            Others Non-GST
                        </option>

                    </select>

                    <span asp-validation-for="Category"
                          class="text-danger"></span>

                </div>
                <!-- GST -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        GST No
                    </label>

                    <input asp-for="GSTNo"
                           id="GSTNo"
                           maxlength="15"
                           class="form-control"
                           placeholder="Enter GST Number"
                           onblur="getGSTDetails()" />



                    <span asp-validation-for="GSTNo"
                          class="text-danger"></span>
                    <a href="https://services.gst.gov.in/services/searchtp" target="_blank" class="btn btn-link">(Check GST Number)</a>

                </div>

                <!-- Company Name -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Company Name <span class="req">*</span>
                    </label>


                    <input asp-for="CName"
                           id="CName"
                           class="form-control"
                           placeholder="Enter Company Name" />


                    <span asp-validation-for="CName"
                          class="text-danger"></span>


                </div>




                <!-- Owner Name -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Owner Name <span class="req">*</span>
                    </label>


                    <input asp-for="OName"
                           class="form-control"
                           placeholder="Enter Owner Name" />


                    <span asp-validation-for="OName"
                          class="text-danger"></span>

                </div>




                <!-- Email -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Email <span class="req">*</span>
                    </label>


                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter Email" />


                    <span asp-validation-for="Email"
                          class="text-danger"></span>


                </div>




                <!-- Mobile -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Mobile <span class="req">*</span>
                    </label>


                    <input asp-for="Mobile"
                           id="Mobile"
                           maxlength="10"
                           class="form-control"
                           placeholder="Enter Mobile Number" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0,10);" />


                    <span asp-validation-for="Mobile"
                          class="text-danger"></span>


                </div>






                <div class="col-md-4 mb-3">
                    <label class="form-label">
                        BDE
                    </label>
                    <select asp-for="BDE" class="form-select">

                        <option value="">-- Select BDE --</option>

                        @foreach (var employee in Model.SalesPersons)
                        {
                            <option value="@employee.empcode">
                                @employee.name
                            </option>
                        }

                    </select>

                </div>






                <!-- Area -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Area <span class="req">*</span>
                    </label>


                    <input asp-for="Area"
