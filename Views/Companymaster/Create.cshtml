                <div class="col-md-12 mb-3">

                    <label class="form-label">
                        Billing Address
                    </label>


<textarea asp-for="Address"
          id="BillingAddress"
          class="form-control"
          rows="3"></textarea>


                </div>





                <div class="form-check mb-3">

                    <input class="form-check-input"
                           type="checkbox"
                           id="sameBilling" onchange="copyBillingToShipping()">


                    <label class="form-check-label">

                        Shipping Same As Billing

                    </label>


                </div>





                <hr />

                <h5 class="text-primary">
                    Shipping Details
                </h5>




                <!-- Shipping Location -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Shipping Location
                    </label>


                    <input asp-for="ShippingLocation"
                           id="ShippingLocation"
                           class="form-control"
                           placeholder="Shipping Location" />


                </div>





                <!-- Shipping Pincode -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Shipping Pincode
                    </label>


                    <input asp-for="ShippingPincode"
                           id="ShippingPincode"
                           maxlength="6"
                           class="form-control"
                           placeholder="Shipping Pincode" />


                </div>





                <!-- Shipping State -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Shipping State Code
                    </label>


                    <input asp-for="ShippingStateCode"
                           id="ShippingStateCode"
