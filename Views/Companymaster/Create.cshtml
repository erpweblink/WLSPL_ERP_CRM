    </div>
</div>


<script type="text/javascript">

        function validateForm() {

            let isValid = true;


            // Clear old messages
            $(".text-danger").text("");

            $(".form-control, .form-select")
                .removeClass("is-invalid");



            // ==========================
            // Mandatory Fields
            // ==========================

            let requiredFields = [
                "CCode",
                "CName",
                "OName",
                "Email",
                "Mobile",
                "Area",
                "CountryName",
                "Address",
                "RegisterType",
                "EInvTypeOfSupply",
                "Status"
            ];


            requiredFields.forEach(function(fieldName){

                let field = $("[name='" + fieldName + "']");


                if(field.length > 0)
                {

                    if(field.val() == null || field.val().trim() == "")
                    {

                        field.addClass("is-invalid");


                        $("[data-valmsg-for='" + fieldName + "']")
                        .text(fieldName + " is required");


                        isValid = false;

                    }

                }

            });





            // ==========================
            // Mobile Validation
            // ==========================

            let mobile = $("#Mobile").val();


            if(mobile != null && mobile != "")
            {

                if(mobile.length != 10)
                {

                    $("#Mobile")
                    .addClass("is-invalid");


                    $("[data-valmsg-for='Mobile']")
                    .text("Mobile number must be 10 digits");


                    isValid = false;

                }

            }





            // ==========================
            // Register Type GST Validation
            // ==========================

            let registerType = $("#RegisterType").val();

            let gstNo = $("#GSTNo").val().trim();



            if(registerType == "WLSPL")
            {

                if(gstNo == "")
                {

                    $("#GSTNo")
                    .addClass("is-invalid");


                    $("[data-valmsg-for='GSTNo']")
                    .text("GST Number is required for WLSPL");


                    isValid = false;

                }
                else if(gstNo.length != 15)
                {

                    $("#GSTNo")
                    .addClass("is-invalid");


                    $("[data-valmsg-for='GSTNo']")
                    .text("GST Number must be 15 digits");


                    isValid = false;

                }

            }



            if(registerType == "WLS")
            {

                $("#GSTNo")
                .removeClass("is-invalid");


                $("[data-valmsg-for='GSTNo']")
                .text("");

            }






            // ==========================
            // Country Wise State Validation
            // ==========================

            let country = $("#CountryName").val();

            let state = $("#State").val();



            if(country == "India")
            {

                if(state == null || state.trim() == "")
                {

                    $("#State")
                    .addClass("is-invalid");


                    $("[data-valmsg-for='State']")
                    .text("State is required for India");


                    isValid = false;

                }

            }
            else
            {

                $("#State")
                .removeClass("is-invalid");


                $("[data-valmsg-for='State']")
                .text("");

            }





            // ==========================
            // Scroll To Error
            // ==========================

            if(!isValid)
            {

                window.scrollTo({

                    top:0,

                    behavior:"smooth"

                });

            }



            return isValid;

        }

     function getGSTDetails() {

         debugger

        var gstNo = $("#GSTNo").val().trim();



        fetch(`/Companymaster/GetGSTDetails?gstNo=${gstNo}`)
            .then(res => res.json())
            .then(data => {

                if (data.success) {

                    // Company Name
                    $("#CName").val(data.tradeName || "");

                    // Billing Details
                    $("#BillingAddress").val(data.address || "");

                    $("#BillingLocation").val(data.location || "");

                    $("#BillingPincode").val(data.pincode || "");

                    $("#BillingStateCode").val(data.stateCode || "");

                }
                else {

                    alert(data.message || "GST details not found");

                    $("#CName").val("");

                    $("#BillingAddress").val("");

                    $("#BillingLocation").val("");

                    $("#BillingPincode").val("");

                    $("#BillingStateCode").val("");

                }

            })
            .catch(function(error){

                console.log(error);

                alert("GST API error");

            });

    }

                            // Copy Billing Details To Shipping Details

    function copyBillingToShipping() {


        if ($("#sameBilling").is(":checked")) {


            $("#ShippingAddress").val(
                $("#BillingAddress").val()
            );


            $("#ShippingLocation").val(
                $("#BillingLocation").val()
            );


            $("#ShippingPincode").val(
                $("#BillingPincode").val()
            );


            $("#ShippingStateCode").val(
                $("#BillingStateCode").val()
            );


        }
        else {


            $("#ShippingAddress").val("");

            $("#ShippingLocation").val("");

            $("#ShippingPincode").val("");

            $("#ShippingStateCode").val("");


        }

    }

                    function checkRegisterType() {

        var registerType = $("#RegisterType").val();

        if (registerType == "WLSPL") {

            // GST Mandatory
            $("#gstRequired").show();

        }
        else if (registerType == "WLS") {

            // GST Optional
            $("#gstRequired").hide();

            $("#GSTNo").removeClass("is-invalid");

            $("[data-valmsg-for='GSTNo']").text("");

        }
        else {

            $("#gstRequired").hide();

        }

    }

    const countryStates = {

        "India": [
            "Andhra Pradesh",
            "Arunachal Pradesh",
            "Assam",
            "Bihar",
            "Chhattisgarh",
            "Goa",
            "Gujarat",
            "Haryana",
            "Himachal Pradesh",
            "Jharkhand",
            "Karnataka",
            "Kerala",
            "Madhya Pradesh",
            "Maharashtra",
            "Manipur",
            "Meghalaya",
            "Mizoram",
            "Nagaland",
            "Odisha",
            "Punjab",
            "Rajasthan",
            "Sikkim",
            "Tamil Nadu",
            "Telangana",
            "Tripura",
            "Uttar Pradesh",
            "Uttarakhand",
            "West Bengal",
            "Delhi",
            "Jammu and Kashmir",
            "Ladakh",
            "Puducherry"
        ],

        "Australia": [
            "New South Wales",
            "Queensland",
            "South Australia",
            "Tasmania",
            "Victoria",
            "Western Australia",
            "Northern Territory",
            "Australian Capital Territory"
        ],

        "Canada": [
            "Alberta",
            "British Columbia",
            "Manitoba",
            "New Brunswick",
            "Newfoundland and Labrador",
            "Nova Scotia",
            "Ontario",
            "Prince Edward Island",
            "Quebec",
            "Saskatchewan"
        ],

        "United States": [
            "Alabama",
            "Alaska",
            "Arizona",
            "California",
            "Florida",
            "New York",
            "Texas",
            "Washington"
        ],

        "United Kingdom": [
            "England",
            "Scotland",
            "Wales",
            "Northern Ireland"
        ]

    };


    const countryDropdown =
        document.getElementById("CountryName");

    const stateDropdown =
        document.getElementById("State");

    const countryCode =
        document.getElementById("CountryCode");


    countryDropdown.addEventListener("change", function () {

        const country = this.value;

        // ============================
        // COUNTRY CODE
        // ============================

        const selectedOption =
            this.options[this.selectedIndex];

        const code =
            selectedOption.getAttribute("data-code");

        countryCode.value = code || "";


        // ============================
        // STATE
        // ============================

        stateDropdown.innerHTML =
            '<option value="">-- Select State --</option>';


        if (countryStates[country]) {

            countryStates[country].forEach(function (state) {

                const option =
                    document.createElement("option");

                option.value = state;
                option.textContent = state;

                stateDropdown.appendChild(option);

            });

        }

    });


    // ============================
    // DEFAULT INDIA
    // ============================

    document.addEventListener("DOMContentLoaded", function () {

        countryDropdown.value = "India";

        countryDropdown.dispatchEvent(
            new Event("change")
        );

        // Default Maharashtra
        stateDropdown.value = "Maharashtra";

    });

</script>