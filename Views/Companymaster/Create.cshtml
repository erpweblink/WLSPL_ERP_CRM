                </div>





                <!-- Billing Pincode -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Billing Pincode
                    </label>


                    <input asp-for="BillingPincode"
                           id="BillingPincode"
                           maxlength="6"
                           class="form-control"
                           placeholder="Billing Pincode" />


                </div>





                <!-- Billing State Code -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Billing State Code
                    </label>


                    <input asp-for="BillingStateCode"
                           id="BillingStateCode"
                           class="form-control"
                           placeholder="State Code" />


