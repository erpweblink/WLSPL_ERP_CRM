        }
    }
</style>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h3 class="page-title mb-0">
            <i class="fa fa-users"></i>
            Company Management
        </h3>
        <a asp-action="Create"
           class="btn btn-primary add-btn btn-sm">
            <i class="fa fa-plus"></i>
            Add New Company
        </a>
    </div>

    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
            <button type="button" id="btnToggleFilter" class="btn btn-filter-toggle btn-sm">
                <i class="fa-solid fa-filter"></i>
                <span>Show Filters</span>
            </button>
            <div class="record-info">
                <span>
                    <i class="fa-solid fa-list-ol"></i> Total Records
                </span>
                <strong id="totalRecords">@Model.Count()</strong>
            </div>
        </div>
        <br />
        <div class="filter-card filter-collapsed" id="filterCard">
            <div class="row g-3 align-items-end">
                <div class="col-xl-3 col-lg-3 col-md-6">
                    <label class="modern-label">
                        <i class="fa-solid fa-magnifying-glass"></i> Search
                    </label>

                    <div class="search-wrapper">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text"
                               id="searchInput"
                               class="search-input"
                               placeholder="Search company name..." />
                    </div>
                </div>

                <div class="col-xl-3 col-lg-3 col-md-6">
                    <label class="modern-label">
                        <i class="fa-solid fa-user-tie"></i> Sales Manager
                    </label>

                    <select id="ddlTeamuser" class="form-control modern-control">
                        <option value="">-- All Managers --</option>
                        @if (ViewBag.SalesManagers != null)
                        {
                            foreach (var mgr in (IEnumerable<dynamic>)ViewBag.SalesManagers)
                            {
                                string userCode = mgr.UserCode;

                                <option value="@userCode">
                                    @mgr.FullName
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-xl-3 col-lg-3 col-md-6">
                    <label class="modern-label">
                        <i class="fa-solid fa-building-circle-check"></i> Status
                    </label>

                    <select id="ddlmeetingwith" class="form-control modern-control">
                        <option value="">All</option>
                        <option value="Paid">Paid</option>
                        <option value="Unpaid">Unpaid</option>
                        <option value="Downloaded">Downloaded</option>
                    </select>
                </div>

                <div class="col-xl-3 col-lg-3 col-md-6">
                    <div class="filter-actions">
                        <button type="button" id="btnSearchData" class="btn btn-search d-none" title="Search">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                        <button type="button" id="btnresetfilter" class="btn btn-reset" title="Reset">
                            <i class="fa-solid fa-arrow-rotate-left"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="companyTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Company Code</th>
                        <th>Company Name</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>GST No</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int count = 1;

                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="row-number">
                                    @count
                                </td>
                                <td>
                                    <span class="company-code">
                                        @item.CCode
                                    </span>
                                </td>
                                <td>
                                    <a href="javascript:void(0)"
                                       class="company-name open-company-modal"
                                       data-id="@item.Id">
                                        @item.CName
                                    </a>
                                </td>
                                <td>
                                    @item.Email
                                </td>
                                <td>
                                    @item.Mobile
                                </td>
                                <td>
                                    @item.GSTNo
                                </td>
                                <td>
                                    @if (item.typess == "Paid")
                                    {
                                        <span class="active-status">
                                            <i class="fa fa-check-circle"></i>
                                            Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inactive-status">
                                            <i class="fa fa-times-circle"></i>
                                            Un-Paid
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm action-btn edit-btn"
                                           title="Edit">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-danger btn-sm action-btn delete-btn"
                                           title="Delete"
                                           onclick="return confirm('Are you sure you want to delete this company?');">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            count++;
                        }
                    }
                    else
                    {
                        <tr id="noDataRow">
                            <td colspan="11"
                                class="no-record">
                                <i class="fa fa-info-circle"></i>
                                No company records found.
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
            <nav>
                <ul class="pagination justify-content-center mt-3"
                    id="pagination">
                </ul>
            </nav>
        </div>

        <div class="modal fade" id="companyDetailModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content modelprofile1">
                    <div class="modal-header d-flex align-items-center">
                        <h4 class="modal-title mb-0" id="modalMainTitle">Company Detail</h4>
                        <button type="button" class="btn-close-cm" data-bs-dismiss="modal">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>

                    <div class="modal-body">
                        <div id="detailPanel">
                            <div class="cm-card">
                                <div class="cm-profile-fields">
                                    <div>
                                        <span class="cm-field-label">Company Code</span>
                                        <div class="cm-field-value lblpopup" id="lblccode" name="Ccode"></div>
                                        <input type="hidden" id="commenthistoryId" name="Id" />
                                        <input type="hidden" id="companyid" name="Ids" />
                                    </div>
                                    <div>
                                        <span class="cm-field-label">Company Name</span>
                                        <div class="cm-field-value lblpopup" id="lblcname" name="CompanyName"></div>
                                    </div>
                                    <div>
                                        <span class="cm-field-label">Owner Name</span>
                                        <div class="cm-field-value lblpopup" id="lbloname" name="PersonName"></div>
                                    </div>
                                    <div>
                                        <span class="cm-field-label">Email Id</span>
