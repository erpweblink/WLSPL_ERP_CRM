            font-weight: 600;
            border: none;
            transition: all .2s ease;
        }

    .btn-searchss {
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: #fff;
        box-shadow: 0 3px 8px rgba(37,99,235,.20);
    }

        .btn-searchss:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(37,99,235,.28);
        }

    .btn-search {
        background: #fff;
        color: #2563eb;
        border: 1px solid #2563eb !important;
    }

        .btn-search:hover {
            background: linear-gradient(135deg, #2563eb, #4f46e5);
            color: #fff;
            box-shadow: 0 3px 8px rgba(37,99,235,.20);
        }

    .btn-reset {
        background: #fff;
        color: #f50000;
        border: 1px solid #fd001f !important;
    }

        .btn-reset:hover {
            background: linear-gradient(135deg, #f90000, #db688a);
            color: whitesmoke;
        }

    .record-info {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 7px;
        color: #8a94a6;
        font-size: 12px;
        white-space: nowrap;
    }

        .record-info strong {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 34px;
            height: 26px;
            padding: 0 8px;
            border-radius: 20px;
