<script type="text/javascript">
    const rowsPerPage = 50;
    let currentPage = 1;

    const tbody = document.querySelector("#companyTable tbody");

    // ── Paginate whatever rows are currently in tbody ──
    function paginateCurrentRows() {
        const rows = Array.from(tbody.querySelectorAll("tr:not(#noDataRow)"));
        const total = rows.length;
        const start = (currentPage - 1) * rowsPerPage;
        const end = start + rowsPerPage;

        rows.forEach((row, i) => {
            row.style.display = (i >= start && i < end) ? "" : "none";
        });

        // Re-number only visible rows
        rows.slice(start, end).forEach((row, i) => {
            const cell = row.querySelector(".row-number");
            if (cell) cell.textContent = start + i + 1;
        });

        buildPagination(total);
        document.getElementById("totalRecords").innerText = total;
    }

    function buildPagination(total) {
        const pg = document.getElementById("pagination");
        const totalPages = Math.ceil(total / rowsPerPage);
        pg.innerHTML = "";
        if (totalPages <= 1) return;

        const mkLi = (label, page, disabled) => {
            const li = document.createElement("li");
            li.className = "page-item " + (disabled ? "disabled" : "");
            li.innerHTML = `<a class="page-link" href="javascript:void(0)">${label}</a>`;
            if (!disabled) li.onclick = () => { currentPage = page; paginateCurrentRows(); };
            return li;
        };

        // ── Prev button ──
        pg.appendChild(mkLi('<i class="fa fa-chevron-left"></i>', currentPage - 1, currentPage === 1));

        // ── Page numbers — show max 10 at a time ──
        const maxVisible = 10;
        let startPage, endPage;

        if (totalPages <= maxVisible) {
            // fewer than 10 pages — show all
            startPage = 1;
            endPage = totalPages;
        } else {
            // center current page in the window
            const half = Math.floor(maxVisible / 2);
            startPage = currentPage - half;
            endPage   = currentPage + half - 1;

            // clamp to valid range
            if (startPage < 1) {
                startPage = 1;
                endPage   = maxVisible;
            }
            if (endPage > totalPages) {
                endPage   = totalPages;
                startPage = totalPages - maxVisible + 1;
            }
        }

        // ── First page + ellipsis if window doesn't start at 1 ──
        if (startPage > 1) {
            pg.appendChild(mkLi(1, 1, false));
            if (startPage > 2) {
                const li = document.createElement("li");
                li.className = "page-item disabled";
                li.innerHTML = `<a class="page-link">…</a>`;
                pg.appendChild(li);
            }
        }

        // ── Visible page buttons ──
        for (let i = startPage; i <= endPage; i++) {
            const li = document.createElement("li");
            li.className = "page-item " + (i === currentPage ? "active" : "");
            li.innerHTML = `<a class="page-link" href="javascript:void(0)">${i}</a>`;
            li.onclick = (function (page) {
                return function () { currentPage = page; paginateCurrentRows(); };
            })(i);
            pg.appendChild(li);
        }

        // ── Ellipsis + last page if window doesn't reach the end ──
        if (endPage < totalPages) {
            if (endPage < totalPages - 1) {
                const li = document.createElement("li");
                li.className = "page-item disabled";
                li.innerHTML = `<a class="page-link">…</a>`;
                pg.appendChild(li);
            }
            pg.appendChild(mkLi(totalPages, totalPages, false));
        }

        // ── Next button ──
        pg.appendChild(mkLi('<i class="fa fa-chevron-right"></i>', currentPage + 1, currentPage === totalPages));
    }

    // ── Render table from AJAX response ──
    function renderTable(data) {
        // ✅ Step 1: wipe the slate completely first
        tbody.innerHTML = "";

        if (!data || data.length === 0) {
            tbody.innerHTML = `<tr id="noDataRow">
                <td colspan="8" class="no-record">
                    <i class="fa fa-info-circle"></i> No records found.
                </td>
            </tr>`;
            document.getElementById("totalRecords").innerText = 0;
            document.getElementById("pagination").innerHTML = "";
            return;
        }

        // ✅ Step 2: build all rows into a fragment (single DOM write)
        const fragment = document.createDocumentFragment();

        data.forEach((item, index) => {
            const isPaid = item.typess === "Paid";
            const statusBadge = isPaid
                ? `<span class="active-status"><i class="fa fa-check-circle"></i> Paid</span>`
                : `<span class="inactive-status"><i class="fa fa-times-circle"></i> Un-Paid</span>`;

            const tr = document.createElement("tr");
            // ✅ Step 3: data-id is set cleanly on every fresh row
            tr.innerHTML = `
                <td class="row-number">${index + 1}</td>
                <td><span class="company-code">${item.cCode ?? ""}</span></td>
                <td>
                    <a href="javascript:void(0)"
                       class="company-name open-company-modal"
                      data-id="${String(item.id).trim()}">
                        ${item.cName ?? ""}
                    </a>
                </td>
                <td>${item.email ?? ""}</td>
                <td>${item.mobile ?? ""}</td>
                <td>${item.gstNo ?? ""}</td>
                <td>${statusBadge}</td>
                <td>
                    <div class="d-flex gap-1">
                        <a href="/CompanyMaster/Edit/${item.id}"
                           class="btn btn-sm action-btn edit-btn" title="Edit">
                            <i class="fa fa-edit"></i>
                        </a>
                        <a href="/CompanyMaster/Delete/${item.id}"
                           class="btn btn-sm action-btn delete-btn" title="Delete"
                           onclick="return confirm('Are you sure you want to delete this company?');">
                            <i class="fa fa-trash"></i>
                        </a>
                    </div>
                </td>`;
            fragment.appendChild(tr);
        });

        // ✅ Step 4: commit all rows in one shot, then paginate
        tbody.appendChild(fragment);
        currentPage = 1;
        paginateCurrentRows();
    }

    // ── AJAX filter ──
    function getFilterPayload() {
        return {
            SessionName: $("#ddlTeamuser").val(),
            typess: $("#ddlmeetingwith").val(),
            CName: $("#searchInput").val()
        };
    }

    function triggerSearch() {
        $.ajax({
            url: "/Companymaster/GetFilteredCompanies",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(getFilterPayload()),
            success: function (res) {
                if (!res.success) { showToast(res.message, "error"); return; }
                renderTable(res.data);
            },
            error: function () { showToast("Failed to load filtered data.", "error"); }
        });
    }

    // Debounce search input so it doesn't fire on every keystroke
    let searchTimer;
    document.getElementById("searchInput").addEventListener("keyup", function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(triggerSearch, 300);
    });

    $("#ddlTeamuser, #ddlmeetingwith").on("change", function () {
        triggerSearch();
    });

    $("#btnresetfilter").on("click", function () {
        $("#ddlTeamuser").val("").trigger("change.select2");
        $("#ddlmeetingwith").val("");
        $("#searchInput").val("");
        location.reload();
    });

    // ── Initial page load: paginate server-rendered rows ──
    $(document).ready(function () {
        paginateCurrentRows();
    });
</script>

<script type="text/javascript">
    const currentUserRole = "@Context.Session.GetString("Role")";
    const isAdmin = (currentUserRole === "Admin" || currentUserRole === "Sub Admin");

    $(document).ready(function () {

        $("#btnToggleFilter").on("click", function () {
            $("#filterCard").toggleClass("filter-collapsed");
            if ($("#filterCard").hasClass("filter-collapsed")) {
                $(this).find("span").text("Show Filters");
                $(this).find("i").removeClass("fa-filter-circle-xmark").addClass("fa-filter");
            } else {
                $(this).find("span").text("Hide Filters");
                $(this).find("i").removeClass("fa-filter").addClass("fa-filter-circle-xmark");
            }
        });

        $("#ddlTeamuser").select2({width: "100%" });

        $("#ddlregbypopup").select2({
            theme: "premium",
            placeholder: "Select Sales Manager",
            allowClear: true,
            width: "100%",
            dropdownParent: $("#companyDetailModal")
        });
    });

    function ShowDetailPanel() {
        document.getElementById("detailPanel").classList.remove("hidden");
        document.getElementById("historyPanel").classList.add("hidden");
        document.getElementById("modalMainTitle").textContent = "Company Detail";
    }

    function ShowHistoryPanel() {
        document.getElementById("detailPanel").classList.add("hidden");
        document.getElementById("historyPanel").classList.remove("hidden");
        document.getElementById("modalMainTitle").textContent = "Company Comment History";
    }

    /* ── Open detail modal ── */
    $(document).on("click", ".open-company-modal", function () {
        const companyId = $(this).attr("data-id");
        $.ajax({
            url: "/CompanyMaster/CloseFollowUpClick",
            type: "GET",
            data: { id: companyId },
            success: function (res) {
                if (!res.success) { showToast(res.message, "error"); return; }

                $("#commenthistoryId").val(res.commentId[0].ID_CommentHistory ?? 0);
                $("#companyid").val(res.commentId[0].id);
                $("#lblccode").text(res.commentId[0].ccode);
                $("#lblcname").text(res.commentId[0].cname);
                $("#lbloname").text(res.commentId[0].oname);
                $("#lblemail").text(res.commentId[0].email);
                $("#lblmobile").text(res.commentId[0].mobile);
                $("#hrefmob").attr("href", "tel:" + res.commentId[0].mobile);

                $("#ddlregbypopup").empty().append('<option value="NoName">-- Select Sales Manager --</option>');
                $.each(res.userList, function (i, user) {
                    $("#ddlregbypopup").append($("<option>", { value: user.UserCode, text: user.FullName }));
                });
                $("#ddlregbypopup").val(res.commentId[0].sessionname).trigger("change");

                const SessionRole = "@Context.Session.GetString("Role")";
                const isAdminRole = (SessionRole === "Admin" || SessionRole === "Sub Admin");
                $("#ddlregbypopup").prop("disabled", !isAdminRole);
                isAdminRole ? $("#btnChange").show() : $("#btnChange").hide();

                hideAll();
         
                ShowDetailPanel();
                new bootstrap.Modal(document.getElementById("companyDetailModal")).show();
            },
            error: function () { showToast("Failed to load company details.", "error"); }
        });
    });

    /* ── Visibility helpers ── */
    function hideAll() {
        ["DivMeetingUpdate", "DivTypeofclient", "DivCallUpdate", "lblfolldate"].forEach(function (id) {
            document.getElementById(id).classList.add("hidden");
        });
        document.getElementById("txtfollowupdatee").classList.add("hidden");
    }

    function CheckUpdateFor() {
        const updateForType = document.getElementById("ddlupdatefor").value;
        hideAll();
        document.getElementById("txtfollowupdatee").value = "";

        if (updateForType === "Call") {
            document.getElementById("ddlmeetingupdate").value = "";
            document.getElementById("ddlmeetingwithm").value = "1";
            document.getElementById("ddltypeofclient").value = "";
            document.getElementById("txtdealdetails").value = "";
            document.getElementById("txtmeetingtime").value = "";
            document.getElementById("DivCallUpdate").classList.remove("hidden");
        } else if (updateForType === "Meeting") {
            document.getElementById("ddlcallstatus").value = "";
            document.getElementById("DivMeetingUpdate").classList.remove("hidden");
        } else {
            document.getElementById("ddlcallstatus").value = "";
            document.getElementById("ddlmeetingupdate").value = "";
            document.getElementById("ddlmeetingwithm").value = "1";
            document.getElementById("ddltypeofclient").value = "";
            document.getElementById("txtdealdetails").value = "";
            document.getElementById("txtmeetingtime").value = "";
        }
    }

    function CheckCallMeetingUpdate() {
        const CallUpdateStatus = document.getElementById("ddlcallstatus").value;
        const MeetUpdateStatus = document.getElementById("ddlmeetingupdate").value;
        hideAll();
        CheckUpdateFor();

        if (CallUpdateStatus === "Follow-up" || MeetUpdateStatus === "Follow-up") {
            document.getElementById("lblfolldate").classList.remove("hidden");
            document.getElementById("txtfollowupdatee").classList.remove("hidden");
        }
        if (MeetUpdateStatus === "Closed") {
            document.getElementById("DivTypeofclient").classList.remove("hidden");
        }
    }

    function validateCompanyForm() {
        let isValid = true;
        $(".validation-error").text("");
        $(".required-field").removeClass("is-invalid");

        $(".required-field").each(function () {
            if (!$(this).is(":visible")) return;
            const value = $(this).val();
            if (!value || value.trim() === "" || value === "--Select--") {
                isValid = false;
                $(this).addClass("is-invalid");
                const labelText = $(this).closest(".row").find("b, label").first().text().replace("*", "").trim();
                $(this).next(".validation-error").text(labelText + " required");
                $(this).focus();
                return false;
            }
        });

        return isValid;
    }

    function ChangeCompanyUser() {
        const newName = $("#ddlregbypopup").val();
        const id = $("#companyid").val();

        if (newName === "NoName" || newName === null) {
            showToast("Please Select Sales Person First", "warning");
            return;
        }

        showConfirmToast(
            "Are you sure you want to change the company user?",
            function () {
                $.ajax({
                    url: "/CompanyMaster/UpdateCompanyUser",
                    type: "POST",
                    data: { newName: newName, CompCode: id },
                    success: function (res) {
                        showToast(res.success ? "Updated successfully" : res.message, res.success ? "success" : "error");
                    },
                    error: function () { showToast("Something went wrong while updating.", "error"); }
                });
            },
            function () { showToast("Update cancelled.", "warning"); }
        );
    }

    $("#btnSave").on("click", function () {
        debugger;
        if (!validateCompanyForm()) return;
        const companyData = getCompanyFormData();

        $.ajax({
            url: "/CompanyMaster/SaveCompanyUpdate",
            type: "POST",
            contentType: "application/json",
            data: JSON.stringify(companyData),
            success: function (res) {
                showToast(res.message, res.success ? "success" : "error");
                if (res.success) {
                    $("#companyDetailModal").modal("hide");
                    setTimeout(() => { location.reload(); }, 1600);
                }
            },
            error: function (err) {
                console.error(err);
                showToast("Something went wrong while saving.", "error");
            }
        });
    });

    function getCompanyFormData() {
        const data = {};
        debugger;

        $("#companyDetailModal").find("input, select, textarea").each(function () {
            if (!$(this).is(":visible")) return;
            const propName = $(this).attr("name");
            if (!propName) return;
            let value = $(this).val();
            if (value === undefined || value === null) value = "";

            if ($(this).attr("type") === "date") data[propName] = value ? new Date(value).toISOString() : null;
            else if ($(this).attr("type") === "time") data[propName] = value || null;
            else data[propName] = value.trim();
        });

        [
                { name: "Ccode",        selector: "#lblccode",        type: "label" },
                { name: "CompanyName",  selector: "#lblcname",        type: "label" },
                { name: "PersonName",   selector: "#lbloname",        type: "label" },
                { name: "ClientMail",   selector: "#lblemail",        type: "label" },
                { name: "ContactNo",    selector: "#lblmobile",       type: "label" },
                { name: "Id",           selector: "#commenthistoryId",type: "input" },
                { name: "Ids",          selector: "#companyid",       type: "input" }
        ].forEach(function (field) {
                const val = field.type === "input"
                    ? $(field.selector).val()
                    : $(field.selector).text();
                if (val && val.trim()) data[field.name] = val.trim();
        });

        return data;
    }

    /* ── History — loads inside the same modal ── */
    function OpenHistory() {
        const CompanyCode = $("#lblccode").text();
        const CompanyName = $("#lblcname").text();

        $.ajax({
            url: "/CompanyMaster/GetCommmentHistory",
            type: "GET",
            data: { CompanyCode: CompanyCode },
            success: function (res) {
                if (!res.success) { showToast(res.message, "error"); return; }

                $("#lblHistoryccode").text(CompanyCode);
                $("#lblHistorycname").text(CompanyName);

                const container = $("#commentHistoryContainer");
                container.empty();

                if (res.comments.length === 0) {
                    container.append('<p class="text-center">No comments found.</p>');
                }

                $.each(res.comments, function (i, item) {
                    container.append(`
                        <div class="row" style="background:#cbcbcb;padding:5px;">
                            <div class="col-md-4">&nbsp;- <span class="lbls">${item.name}</span></div>
                            <div class="col-md-4"><span class="lbls">${item.commentdatetime}</span></div>
                            <div class="col-md-4"><span class="lbls">${item.typeoftbl}</span></div>
                        </div>
                        <div class="row p-1"><div class="col-md-12"><p>${item.message}</p></div></div>
                        <hr class="new1" />
                    `);
                });

                ShowHistoryPanel();
            },
            error: function () { showToast("Failed to load company history.", "error"); }
        });
    }
</script>
