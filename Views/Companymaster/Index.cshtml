@using WEBLINK_CRM.Models
@model IEnumerable<Companymaster>

@{
    ViewData["Title"] = "Company Management";
}

<style type="text/css">
    .search-box {
        width: 315px;
        height: 35px;
        font-size: 13px;
        border-radius: 6px;
    }

    .record-info {
        font-size: 13px;
        color: #6c757d;
    }

        .record-info strong {
            color: #212529;
        }


    .table tbody td {
        font-size: 13px;
        vertical-align: middle;
    }

    .table tbody tr:hover {
        background: #f4f8ff;
    }

    .company-code {
        color: #0d6efd;
        font-weight: 600;
    }

    .company-name {
        font-weight: 600;
        color: #111;
    }

    .active-status {
        background-color: #198754 !important;
        color: #fff !important;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        display: inline-block;
    }

    .inactive-status {
        background-color: #dc3545 !important;
        color: #fff !important;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        display: inline-block;
    }

    .action-btn {
        width: 32px;
        height: 30px;
        padding: 5px;
        border-radius: 5px;
    }

    .edit-btn {
        background: #ffc107;
        border-color: #ffc107;
        color: #000;
    }

    .delete-btn {
        background: #dc3545;
        border-color: #dc3545;
        color: #fff;
    }

    .no-record {
        text-align: center;
        padding: 30px !important;
        color: #777;
    }

    .pagination {
        margin-bottom: 0;
    }

        .pagination .page-link {
            font-size: 12px;
            padding: 6px 11px;
            color: #0d6efd;
        }

        .pagination .active .page-link {
            background-color: #142c45;
            border-color: #142d47;
            color: #ffffff;
        }

        .pagination .page-link:hover {
            background-color: #e9f2ff;
        }

</style>

<div class="card ">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h3 class="page-title mb-0">
            <i class="fa fa-users"></i>
            Company Management
        </h3>

        <a asp-action="Create"
           class="btn btn-primary add-btn btn-sm">
            <i class="fa fa-plus"></i>
            Add New Company
        </a>
    </div>

    <!-- ================= BODY ================= -->

    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-4">
                <input type="text"
                       id="searchInput"
                       class="form-control search-box"
                       placeholder="Search employee..." />
            </div>

            <div class="col-md-8 d-flex justify-content-end align-items-center">
                <span class="record-info">
                    Total Records :
                    <strong id="totalRecords">@Model.Count()</strong>
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover"
                   id="companyTable">

                <thead>
                    <tr>
                        <th>#</th>

                        <th>Company Code</th>

                        <th>Company Name</th>

                        <th>Email</th>

                        <th>Mobile</th>

                        <th>GST No</th>

                        <th>Status</th>

                       <th>Action</th>
                    </tr>
                </thead>
                <tbody>

                    @if (Model != null && Model.Any())
                    {

                        int count = 1;

                        foreach (var item in Model)
                        {

                            <tr>

                                <td class="row-number">
                                    @count
                                </td>

                                <td>
                                    <span class="company-code">
                                        @item.CCode
                                    </span>
                                </td>

                                <td>
                                    <strong class="company-name">
                                        @item.CName
                                    </strong>
                                </td>

                                <td>
                                    @item.Email
                                </td>

                                <td>
                                    @item.Mobile
                                </td>

                                <td>
                                    @item.GSTNo
                                </td>

                                <td>
                                    @if (item.typess == "Paid")
                                    {
                                        <span class="active-status">
                                            <i class="fa fa-check-circle"></i>
                                            Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inactive-status">
                                            <i class="fa fa-times-circle"></i>
                                            Un-Paid
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm action-btn edit-btn"
                                           title="Edit">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm action-btn delete-btn"
                                           title="Delete"
                                           onclick="return confirm('Are you sure you want to delete this company?');">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </div>
                                </td>

                            </tr>

                            count++;
                       }
                    }
                    else
                    {
                        <tr id="noDataRow">
                            <td colspan="11"
                                class="no-record">

                                <i class="fa fa-info-circle"></i>

                                No company records found.

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ================= PAGINATION ================= -->
        <nav>
            <ul class="pagination justify-content-center mt-3"
                id="pagination">
            </ul>
        </nav>
    </div>
</div>

<script type="text/javascript">
    const rowsPerPage = 100;

    let currentPage = 1;

    let filteredRows = [];


    const table = document.getElementById("companyTable");

    const tbody = table.querySelector("tbody");

    const searchInput = document.getElementById("searchInput");

    const pagination = document.getElementById("pagination");

    const totalRecords = document.getElementById("totalRecords");


    // Get all actual data rows
    const allRows = Array.from(
        tbody.querySelectorAll("tr")
    ).filter(row => !row.id);


    filteredRows = allRows;


    // ==============================
    // DISPLAY TABLE
    // ==============================

    function displayTable(page) {

        currentPage = page;

        // Hide all rows first

        allRows.forEach(row => {

            row.style.display = "none";

        });


        // Calculate start/end

        const start =
            (page - 1) * rowsPerPage;

        const end =
            start + rowsPerPage;


        // Display current page

        filteredRows
            .slice(start, end)
            .forEach((row, index) => {

                row.style.display = "";

            });


        // Update serial numbers

        filteredRows
            .slice(start, end)
            .forEach((row, index) => {

                const numberCell =
                    row.querySelector(".row-number");

                if (numberCell) {

                    numberCell.innerText =
                        start + index + 1;

                }

            });


        createPagination();

    }


    // ==============================
    // CREATE PAGINATION
    // ==============================

    function createPagination() {

        pagination.innerHTML = "";


        const totalPages =
            Math.ceil(
                filteredRows.length / rowsPerPage
            );


        if (totalPages <= 1) {

            return;

        }


        // =========================
        // PREVIOUS
        // =========================

        const previousLi =
            document.createElement("li");

        previousLi.className =
            "page-item " +
            (currentPage === 1 ? "disabled" : "");


        previousLi.innerHTML = `

            <a class="page-link" href="javascript:void(0)">

                <i class="fa fa-chevron-left"></i>

            </a>

        `;


        previousLi.onclick = function () {

            if (currentPage > 1) {

                displayTable(
                    currentPage - 1
                );

            }

        };


        pagination.appendChild(previousLi);


        // =========================
        // PAGE NUMBERS
        // =========================

        for (
            let i = 1;
            i <= totalPages;
            i++
        ) {

            const li =
                document.createElement("li");


            li.className =
                "page-item " +
                (i === currentPage
                    ? "active"
                    : "");


            li.innerHTML = `

                <a class="page-link"
                   href="javascript:void(0)">

                    ${i}

                </a>

            `;


            li.onclick = function () {

                displayTable(i);

            };


            pagination.appendChild(li);

        }


        // =========================
        // NEXT
        // =========================

        const nextLi =
            document.createElement("li");


        nextLi.className =
            "page-item " +
            (
                currentPage === totalPages
                    ? "disabled"
                    : ""
            );


        nextLi.innerHTML = `

            <a class="page-link"
               href="javascript:void(0)">

                <i class="fa fa-chevron-right"></i>

            </a>

        `;


        nextLi.onclick = function () {

            if (currentPage < totalPages) {

                displayTable(
                    currentPage + 1
                );

            }

        };


        pagination.appendChild(nextLi);

    }


    // ==============================
    // SEARCH
    // ==============================

    searchInput.addEventListener(
        "keyup",
        function () {

            const value =
                this.value
                    .toLowerCase()
                    .trim();


            filteredRows =
                allRows.filter(row => {

                    return row.innerText
                        .toLowerCase()
                        .includes(value);

                });


            // Update total

            totalRecords.innerText =
                filteredRows.length;


            // Go to first page

            currentPage = 1;


            displayTable(1);

        }
    );


    // ==============================
    // INITIAL LOAD
    // ==============================

    displayTable(1);

</script>
