@using WEBLINK_CRM.Models
@model IEnumerable<Companymaster>

@{
    ViewData["Title"] = "Company Management";
}

<style type="text/css">
    .search-box {
        width: 315px;
        height: 35px;
        font-size: 13px;
        border-radius: 6px;
    }

    .record-info {
        font-size: 13px;
        color: #6c757d;
    }

        .record-info strong {
            color: #212529;
        }


    .table tbody td {
        font-size: 13px;
        vertical-align: middle;
    }

    .table tbody tr:hover {
        background: #f4f8ff;
    }

    .company-code {
        color: #111;
        font-weight: 600;
    }

    .company-name {
        font-weight: 600;
        color: #0d6efd;
    }

    .active-status {
        background-color: #198754 !important;
        color: #fff !important;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        display: inline-block;
    }

    .inactive-status {
        background-color: #dc3545 !important;
        color: #fff !important;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        display: inline-block;
    }

   .action-btn {
        width: 32px;
        height: 30px;
        padding: 5px;
        border-radius: 5px;
    }

    .edit-btn {
        background: #ffc107;
        border-color: #ffc107;
        color: #000;
    }

    .delete-btn {
        background: #dc3545;
        border-color: #dc3545;
        color: #fff;
    }

    .no-record {
        text-align: center;
        padding: 30px !important;
        color: #777;
    }

    .pagination {
        margin-bottom: 0;
    }

        .pagination .page-link {
            font-size: 12px;
            padding: 6px 11px;
            color: #0d6efd;
        }

        .pagination .active .page-link {
            background-color: #142c45;
            border-color: #142d47;
            color: #ffffff;
        }

        .pagination .page-link:hover {
            background-color: #e9f2ff;
        }




    /* ===== Unified Company Modal ===== */
    #companyDetailModal .modal-content {
        border: none;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 15px 45px rgba(15,23,42,.22);
    }

    #companyDetailModal .modal-header {
        background: linear-gradient(135deg, #1a4373 0%, #23262a 100%);
        padding: 14px 20px;
        border: none;
    }

    #companyDetailModal .modal-title {
        color: #fff;
        font-weight: 700;
        font-size: 16px;
    }

    #companyDetailModal .btn-close-cm {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        border: none;
        background: rgba(255,255,255,.12);
        color: #fff !important;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: auto;
        transition: .2s;
    }

        #companyDetailModal .btn-close-cm:hover {
            background: #f04438;
        }

    #companyDetailModal .modal-body {
        background: #f6f8fb;
        padding: 18px 20px;
    }


    #companyDetailModal .form-control {
        border: 1px solid #dbe2ea !important;
        border-radius: 7px !important;
        font-size: 13px;
        padding: 6px 10px;
        box-shadow: none !important;
    }

        #companyDetailModal .form-control:focus {
            border-color: #6b7cff !important;
            box-shadow: 0 0 0 3px rgba(107,124,255,.12) !important;
        }

        #companyDetailModal .form-control.is-invalid {
            border-color: #f04438 !important;
        }

    #companyDetailModal .validation-error {
        font-size: 10.5px;
    }

    #companyDetailModal .cm-hint {
        color: #b42318 !important;
        font-size: 10.5px;
        margin-top: 2px;
        display: block;
    }

</style>

<style type="text/css">
    .hidden {
        display: none !important;
    }

    .cm-card {
        background: #cbcbcb;
        border: 1px solid #e7ebf0;
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 12px;
    }

        .cm-card:last-of-type {
            margin-bottom: 0;
        }

    .cm-card-title {
        font-size: 11.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: #1a4373;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .cm-card-title i {
            color: #6b7cff;
        }

    .cm-profile-fields {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px 16px;
    }

    .cm-field-label {
        font-size: 10px;
        font-weight: 700;
        color: #8a94a6;
        text-transform: uppercase;
        display: block;
        margin-bottom: 2px;
    }

    .cm-field-value {
        font-size: 13.5px;
        font-weight: 600;
        color: #1e2022;
        line-height: 1.4;
    }

        .cm-field-value a {
            color: #1a4373;
            text-decoration: none;
        }

            .cm-field-value a:hover {
                text-decoration: underline;
            }

    .cm-manager-row {
        display: flex;
        align-items: flex-end;
        gap: 8px;
    }

        .cm-manager-row .cm-select-wrap {
            flex: 1;
            min-width: 0;
        }

    .cm-form-label {
        font-size: 12px;
        font-weight: 600;
        color: #344054;
        margin-bottom: 4px;
        display: block;
    }

    .cm-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 10px 14px;
        margin-bottom: 10px;
    }

        .cm-grid:last-child {
            margin-bottom: 0;
        }

        .cm-grid.full {
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        }

    .modal-footer-cm {
        display: flex;
        justify-content: space-between;
        padding-top: 12px;
        margin-top: 2px;
        border-top: 1px solid #e7ebf0;
    }

    .btn-cm-save {
        background: linear-gradient(135deg, #16a34a, #15803d);
        border: none;
        color: #fff;
        font-weight: 600;
        padding: 8px 22px;
        border-radius: 8px;
        font-size: 13.5px;
    }

    .btn-cm-history {
        background: #fff;
        border: 1px solid #1a4373;
        color: #1a4373;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 13.5px;
    }

    .btn-cm-back {
        background: #fff;
        border: 1px solid #6c757d;
        color: #6c757d;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 13.5px;
    }

    .btn-cm-change {
        background: #fff;
        border: 1px solid #f04438 !important;
        color: #f04438;
        font-weight: 600;
        height: 34px;
        border-radius: 7px !important;
        padding: 0 12px;
        font-size: 12.5px;
    }

    #historyScrollArea {
        overflow-x: hidden;
        overflow-y: scroll;
        height: 460px;
    }

    hr.new1 {
        border-top: 1px dashed green !important;
        border: 0;
        margin-top: 5px !important;
        margin-bottom: 5px !important;
        width: 100%;
    }

    .lbls {
        font-size: 12px;
        text-align: left;
        color: black !important;
    }

    /* select2 premium theme — unchanged */
    .select2-container--premium .select2-selection--single {
        height: 50px;
        background: #fff;
        border: 1.5px solid #e0e0e0;
        border-radius: 10px;
        display: flex;
        align-items: center;
        transition: border-color .2s, box-shadow .2s;
    }

        .select2-container--premium .select2-selection--single:hover {
            border-color: #aaa;
        }

    .select2-container--premium.select2-container--focus .select2-selection--single,
    .select2-container--premium.select2-container--open .select2-selection--single {
        border-color: #111;
        box-shadow: 0 0 0 3px rgba(0,0,0,.07);
        outline: none;
    }

    .select2-container--premium .select2-selection--single .select2-selection__rendered {
        line-height: 50px;
        padding-left: 16px;
        padding-right: 42px;
        color: #111;
        font-size: 14px;
        font-weight: 500;
    }

    .select2-container--premium .select2-selection--single .select2-selection__placeholder {
        color: #bbb;
        font-weight: 400;
    }

    .select2-container--premium .select2-selection--single .select2-selection__arrow {
        height: 50px;
        right: 14px;
    }

        .select2-container--premium .select2-selection--single .select2-selection__arrow b {
            border-color: #999 transparent transparent transparent;
            border-width: 5px 4px 0 4px;
        }

    .select2-container--premium.select2-container--open .select2-selection--single .select2-selection__arrow b {
        border-color: transparent transparent #111 transparent;
        border-width: 0 4px 5px 4px;
    }

    .select2-container--premium .select2-selection--single .select2-selection__clear {
        font-size: 18px;
        color: #d90000;
        line-height: 50px;
    }

        .select2-container--premium .select2-selection--single .select2-selection__clear:hover {
            color: #e74c3c;
        }

    @@media (max-width: 768px) {
        .cm-profile-fields {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>
<style type="text/css">
    /* ── all your existing styles unchanged ── */
    .btn-filter-toggle {
        background: #fff;
        border: 1px solid #ddd;
        color: #333;
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .btn-filter-toggle:hover {
            background: #f5f5f5;
            border-color: #bbb;
        }

    #filterCard {
        overflow: hidden;
        max-height: 1000px;
        opacity: 1;
        transition: max-height 0.35s ease, opacity 0.25s ease, margin 0.35s ease;
    }

        #filterCard.filter-collapsed {
            max-height: 0;
            opacity: 0;
            margin: 0;
            padding-top: 0;
            padding-bottom: 0;
        }

    /* filter card */
    .filter-card {
        background: #fff;
        border: 1px solid #e7ebf0;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(30,41,59,.06);
        overflow: visible;
        margin-bottom: 10px;
        padding: 5px;
    }

    .modern-label {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 7px;
        color: #526174;
        font-size: 12px;
        font-weight: 600;
    }

        .modern-label i {
            color: #6b7cff;
            font-size: 13px;
        }

    .modern-control {
        height: 38px !important;
        border: 1px solid #1e2022 !important;
        border-radius: 7px !important;
        background-color: #fff;
        color: #344054;
        font-size: 13px;
        transition: all .2s ease;
        box-shadow: none !important;
    }

        .modern-control:hover {
