@model WEBLINK_CRM.Models.Companymaster

@{
    ViewData["Title"] = "Edit Company";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style type="text/css">
    .form-label {
        font-weight: 600;
        color: #333;
    }

    .form-control,
    .form-select {
        height: 45px;
        border-radius: 10px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .2rem rgba(13,110,253,.15);
        }

    .btn {
        border-radius: 8px;
        height: 43px;
        font-weight: 600;
        transition: .3s;
    }

    .btn-success {
        background: #198754;
        border: none;
    }

        .btn-success:hover {
            background: #157347;
            transform: translateY(-2px);
        }

    .btn-danger {
        background: #dc3545;
        border: none;
    }

        .btn-danger:hover {
            background: #bb2d3b;
            transform: translateY(-2px);
        }

    .req {
        color: red;
    }

</style>

<div class="card">

    <div class="card-header">
        <h3>
            <i class="fa fa-building"></i>
            Edit Company
        </h3>
    </div>

    <div class="card-body">

        <form asp-action="Update"
              method="post"
              onsubmit="return validateForm();">

            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />

            <div class="row">


                <!-- Company Code -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Company Code
                    </label>

                    <input asp-for="CCode"
                           class="form-control"
                           readonly />

                    <span asp-validation-for="CCode"
                          class="text-danger"></span>

                </div>


                <!-- Register Type -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Register Type
                    </label>

                    <select asp-for="RegisterType"
                            id="RegisterType"
                            class="form-select">

                        <option value="WLSPL">
                            WLSPL
                        </option>

                        <option value="WLS">
                            WLS
                        </option>

                    </select>

                    <!-- Required because disabled select is not submitted -->

                    <input type="hidden"
                           asp-for="RegisterType" />

                </div>


                <!-- Category -->

                <div class="col-md-4 mb-3">

                    <label asp-for="Category"
                           class="form-label">

                        Category

                    </label>

                    <select asp-for="Category"
                            id="Category"
                            class="form-select">

                        <option value="">-- Select Category --</option>

                        <option value="Trading/Manufacturing">
                            Trading/Manufacturing
                        </option>

                        <option value="Hospital/Clinic">
                            Hospital/Clinic
                        </option>

                        <option value="Others Non-GST">
                            Others Non-GST
                        </option>

                    </select>

                    <span asp-validation-for="Category"
                          class="text-danger"></span>



                </div>


                <!-- GST Number -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        GST No
                    </label>

                    <input asp-for="GSTNo"
                           id="GSTNo"
                           maxlength="15"
                           class="form-control"
                           placeholder="Enter GST Number"
                           onblur="getGSTDetails()" />

                    <span asp-validation-for="GSTNo"
                          class="text-danger"></span>

                    <a href="https://services.gst.gov.in/services/searchtp"
                       target="_blank"
                       class="btn btn-link">

                        (Check GST Number)

                    </a>

                </div>


                <!-- Company Name -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">

                        Company Name
                        <span class="req">*</span>

                    </label>

                    <input asp-for="CName"
                           id="CName"
                           class="form-control"
                           placeholder="Enter Company Name" />

                    <span asp-validation-for="CName"
                          class="text-danger"></span>

                </div>


                <!-- Owner Name -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">

                        Owner Name
                        <span class="req">*</span>

                    </label>

                    <input asp-for="OName"
                           class="form-control"
                           placeholder="Enter Owner Name" />

                    <span asp-validation-for="OName"
                          class="text-danger"></span>

                </div>


                <!-- Email -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">

                        Email
                        <span class="req">*</span>

                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter Email" />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>

                </div>


                <!-- Mobile -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">

                        Mobile
                        <span class="req">*</span>

                    </label>

                    <input asp-for="Mobile"
                           id="Mobile"
                           maxlength="10"
                           class="form-control"
                           placeholder="Enter Mobile Number"
                           oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0,10);" />

                    <span asp-validation-for="Mobile"
                          class="text-danger"></span>

                </div>


                <!-- BDE -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        BDE
                    </label>

                    <input asp-for="BDE"
                           class="form-control"
                           placeholder="Enter BDE Name" />

                </div>


                <!-- Area -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">

                        Area
                        <span class="req">*</span>

                    </label>

                    <input asp-for="Area"
                           class="form-control"
                           placeholder="Enter Area" />

                    <span asp-validation-for="Area"
                          class="text-danger"></span>

                </div>


                <!-- Country -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">

                        Country Name
                        <span class="req">*</span>

                    </label>

                    <select asp-for="CountryName"
                            class="form-select"
                            id="CountryName">

                        <option value="">
                            -- Select Country --
                        </option>

                        <option value="India">
                            India
                        </option>

                        <option value="Australia">
                            Australia
                        </option>

                        <option value="Canada">
                            Canada
                        </option>

                        <option value="United States">
                            United States
                        </option>

                        <option value="United Kingdom">
                            United Kingdom
                        </option>

                        <option value="United Arab Emirates">
                            United Arab Emirates
                        </option>

                        <option value="Singapore">
                            Singapore
                        </option>

                        <option value="Germany">
                            Germany
                        </option>

                        <option value="France">
                            France
                        </option>

                        <option value="China">
                            China
                        </option>

                        <option value="Japan">
                            Japan
                        </option>

                        <option value="Nepal">
                            Nepal
                        </option>

                        <option value="Pakistan">
                            Pakistan
                        </option>

                        <option value="Sri Lanka">
                            Sri Lanka
                        </option>

                        <option value="South Africa">
                            South Africa
                        </option>

                    </select>

                    <span asp-validation-for="CountryName"
                          class="text-danger"></span>

                </div>


                <!-- State -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">

                        State
                        <span class="req">*</span>

                    </label>

                    <select asp-for="State"
                            class="form-select"
                            id="State">

                        <option value="">
                            -- Select State --
                        </option>

                    </select>
                    <input type="hidden" id="ExistingState" value="@Model.State" />
                    <span asp-validation-for="State"
                          class="text-danger"></span>

                </div>


                <!-- Address -->

                <div class="col-md-6 mb-3">

                    <label class="form-label">

                        Address
                        <span class="req">*</span>

                    </label>

                    <textarea asp-for="Address"
                              id="Address"
                              class="form-control"
                              rows="3"
                              placeholder="Enter Address"></textarea>

                    <span asp-validation-for="Address"
                          class="text-danger"></span>

                </div>


                <!-- Website -->

                <div class="col-md-3 mb-3">

                    <label class="form-label">
                        Website
                    </label>

                    <input asp-for="Website"
                           class="form-control"
                           placeholder="Enter Website" />

                </div>


                <!-- Visit Date -->

                <div class="col-md-3 mb-3">

                    <label class="form-label">
                        Visit Date
                    </label>

                    <input asp-for="VisitDate"
                           id="VisitDate"
                           type="date"
                           class="form-control" />

                </div>


                <!-- Supply Type -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Type Of Supply
                    </label>

                    <select asp-for="EInvTypeOfSupply"
                            class="form-select">

                        <option value="B2B">
                            B2B
                        </option>

                        <option value="B2C">
                            B2C
                        </option>

                        <option value="SEZ">
                            SEZ
                        </option>

                        <option value="Export">
                            Export
                        </option>

                    </select>

                    <span asp-validation-for="EInvTypeOfSupply"
                          class="text-danger"></span>

                </div>


                <!-- Status -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Status
                    </label>

                    <select asp-for="Status"
                            class="form-select">

                        <option value="true">
                            Active
                        </option>

                        <option value="false">
                            Inactive
                        </option>

                    </select>

                </div>


                <!-- Client Type -->

                <div class="col-md-3 mb-3">

                    <label class="form-label">
                        Client Type
                    </label>

                    <select asp-for="typess"
                            class="form-select">

                        <option value="">
                            -- Select Client Type --
                        </option>

                        <option value="Paid">
                            Paid
                        </option>

                        <option value="Un-Paid">
                            Un-Paid
                        </option>

                        <option value="Downloaded">
                            Downloaded
                        </option>

                    </select>

                    <span asp-validation-for="typess"
                          class="text-danger"></span>

                </div>


                <hr />


                <h5 class="text-primary">
                    Billing Details
                </h5>


                <!-- Billing Location -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Billing Location
                    </label>

                    <input asp-for="BillingLocation"
                           id="BillingLocation"
                           class="form-control"
                           placeholder="Billing Location" />

                </div>


                <!-- Billing Pincode -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Billing Pincode
                    </label>

                    <input asp-for="BillingPincode"
                           id="BillingPincode"
                           maxlength="6"
                           class="form-control"
                           placeholder="Billing Pincode" />

                </div>


                <!-- Billing State Code -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Billing State Code
                    </label>

                    <input asp-for="BillingStateCode"
                           id="BillingStateCode"
                           class="form-control"
                           placeholder="State Code" />

                </div>


                <!-- Billing Address -->

                <div class="col-md-12 mb-3">

                    <label class="form-label">
                        Billing Address
                    </label>

                    <textarea asp-for="BillingAddress"
                              id="BillingAddress"
                              class="form-control"
                              rows="3"></textarea>

                </div>


                <!-- Same Billing -->

                <div class="form-check mb-3">

                    <input class="form-check-input"
                           type="checkbox"
                           id="sameBilling"
                           onchange="copyBillingToShipping()" />

                    <label class="form-check-label">
                        Shipping Same As Billing
                    </label>

                </div>


                <hr />


                <h5 class="text-primary">
                    Shipping Details
                </h5>


                <!-- Shipping Location -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Shipping Location
                    </label>

                    <input asp-for="ShippingLocation"
                           id="ShippingLocation"
                           class="form-control"
                           placeholder="Shipping Location" />

                </div>


                <!-- Shipping Pincode -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Shipping Pincode
                    </label>

                    <input asp-for="ShippingPincode"
                           id="ShippingPincode"
                           maxlength="6"
                           class="form-control"
                           placeholder="Shipping Pincode" />

                </div>


                <!-- Shipping State Code -->

                <div class="col-md-4 mb-3">

                    <label class="form-label">
                        Shipping State Code
                    </label>

                    <input asp-for="ShippingStateCode"
                           id="ShippingStateCode"
                           class="form-control"
                           placeholder="State Code" />

                </div>


                <!-- Shipping Address -->

                <div class="col-md-12 mb-3">

                    <label class="form-label">
                        Shipping Address
                    </label>

                    <textarea asp-for="ShippingAddress"
                              id="ShippingAddress"
                              class="form-control"
                              rows="3"></textarea>

                </div>

            </div>
            <div class="row justify-content-center mt-3">
                <div class="col-md-3 text-end">
                    <button type="submit"
                            class="btn btn-success">

                        <i class="fa fa-save"></i>
                        Update Company

                    </button>

                </div>
                <div class="col-md-3 text-start">
                    <a asp-action="Index"
                       class="btn btn-danger">
                        <i class="fa fa-arrow-left"></i>
                        Back
                    </a>
                </div>
            </div>
        </form>

    </div>
</div>


<script>

    // ============================================
    // VALIDATION
    // ============================================

    function validateForm() {

        let isValid = true;

        $(".text-danger").text("");

        $(".form-control, .form-select")
            .removeClass("is-invalid");


        // ========================================
        // Mandatory Fields
        // ========================================

        let requiredFields = [
            "CCode",
            "CName",
            "OName",
            "Email",
            "Mobile",
            "Area",
            "CountryName",
            "Address",
            "RegisterType",
            "EInvTypeOfSupply",
            "Status"
        ];


        requiredFields.forEach(function (fieldName) {

            let field = $("[name='" + fieldName + "']");

            if (field.length > 0) {

                let value = field.val();

                if (value == null ||
                    value.toString().trim() == "") {

                    field.addClass("is-invalid");

                    $("[data-valmsg-for='" + fieldName + "']")
                        .text(fieldName + " is required");

                    isValid = false;
                }
            }

        });


        // ========================================
        // Mobile Validation
        // ========================================

        let mobile = $("#Mobile").val();

        if (mobile != null && mobile != "") {

            if (!/^[0-9]{10}$/.test(mobile)) {

                $("#Mobile")
                    .addClass("is-invalid");

                $("[data-valmsg-for='Mobile']")
                    .text("Mobile number must be 10 digits");

                isValid = false;
            }
        }


        // ========================================
        // GST Validation
        // ========================================

        let category = $("#Category").val();

        let gstNo = $("#GSTNo").val().trim();


        if (category === "GST") {

            if (gstNo === "") {

                $("#GSTNo")
                    .addClass("is-invalid");

                $("[data-valmsg-for='GSTNo']")
                    .text("GST Number is required");

                isValid = false;

            }
            else if (gstNo.length !== 15) {

                $("#GSTNo")
                    .addClass("is-invalid");

                $("[data-valmsg-for='GSTNo']")
                    .text("GST Number must be 15 characters");

                isValid = false;

            }

        }
        else {

            $("#GSTNo")
                .removeClass("is-invalid");

            $("[data-valmsg-for='GSTNo']")
                .text("");

        }


        // ========================================
        // Country Wise State Validation
        // ========================================

        let country = $("#CountryName").val();

        let state = $("#State").val();


        if (country === "India") {

            if (state == null ||
                state.trim() === "") {

                $("#State")
                    .addClass("is-invalid");

                $("[data-valmsg-for='State']")
                    .text("State is required for India");

                isValid = false;
            }

        }


        // ========================================
        // Scroll To Error
        // ========================================

        if (!isValid) {

            window.scrollTo({
                top: 0,
                behavior: "smooth"
            });

        }


        return isValid;

    }


    // ============================================
    // GST DETAILS
    // ============================================

    function getGSTDetails() {

        var gstNo = $("#GSTNo").val().trim();

        if (gstNo === "") {
            return;
        }


        fetch(`/Companymaster/GetGSTDetails?gstNo=${encodeURIComponent(gstNo)}`)

            .then(res => res.json())

            .then(data => {

                if (data.success) {

                    $("#CName")
                        .val(data.tradeName || "");

                    $("#BillingAddress")
                        .val(data.address || "");

                    $("#BillingLocation")
                        .val(data.location || "");

                    $("#BillingPincode")
                        .val(data.pincode || "");

                    $("#BillingStateCode")
                        .val(data.stateCode || "");

                    $("#Address")
                        .val(data.address || "");

                }
                else {

                    alert(data.message ||
                        "GST details not found");

                }

            })

            .catch(function (error) {

                console.log(error);

                alert("GST API error");

            });

    }


    // ============================================
    // COPY BILLING TO SHIPPING
    // ============================================

    function copyBillingToShipping() {

        if ($("#sameBilling").is(":checked")) {

            $("#ShippingAddress")
                .val($("#BillingAddress").val());

            $("#ShippingLocation")
                .val($("#BillingLocation").val());

            $("#ShippingPincode")
                .val($("#BillingPincode").val());

            $("#ShippingStateCode")
                .val($("#BillingStateCode").val());

        }
        else {

            $("#ShippingAddress").val("");

            $("#ShippingLocation").val("");

            $("#ShippingPincode").val("");

            $("#ShippingStateCode").val("");

        }

    }


    // ============================================
    // COUNTRY / STATE
    // ============================================

         // ============================================
    // COUNTRY / STATE
    // ============================================

    const countryStates = {

        "India": [
            "Andhra Pradesh",
            "Arunachal Pradesh",
            "Assam",
            "Bihar",
            "Chhattisgarh",
            "Goa",
            "Gujarat",
            "Haryana",
            "Himachal Pradesh",
            "Jharkhand",
            "Karnataka",
            "Kerala",
            "Madhya Pradesh",
            "Maharashtra",
            "Manipur",
            "Meghalaya",
            "Mizoram",
            "Nagaland",
            "Odisha",
            "Punjab",
            "Rajasthan",
            "Sikkim",
            "Tamil Nadu",
            "Telangana",
            "Tripura",
            "Uttar Pradesh",
            "Uttarakhand",
            "West Bengal",
            "Delhi",
            "Jammu and Kashmir",
            "Ladakh",
            "Puducherry"
        ],

        "Australia": [
            "New South Wales",
            "Queensland",
            "South Australia",
            "Tasmania",
            "Victoria",
            "Western Australia",
            "Northern Territory",
            "Australian Capital Territory"
        ],

        "Canada": [
            "Alberta",
            "British Columbia",
            "Manitoba",
            "New Brunswick",
            "Newfoundland and Labrador",
            "Nova Scotia",
            "Ontario",
            "Prince Edward Island",
            "Quebec",
            "Saskatchewan"
        ],

        "United States": [
            "Alabama",
            "Alaska",
            "Arizona",
            "California",
            "Florida",
            "New York",
            "Texas",
            "Washington"
        ],

        "United Kingdom": [
            "England",
            "Scotland",
            "Wales",
            "Northern Ireland"
        ]

    };


    // ============================================
    // LOAD STATES
    // ============================================

    function loadStates(country, selectedState) {

        const stateDropdown = $("#State");

        stateDropdown.empty();

        stateDropdown.append(
            $("<option>", {
                value: "",
                text: "-- Select State --"
            })
        );


        if (countryStates[country]) {

            countryStates[country].forEach(function (state) {

                stateDropdown.append(
                    $("<option>", {
                        value: state,
                        text: state
                    })
                );

            });

        }


        // IMPORTANT
        // Set selected state AFTER options are created

        if (selectedState) {

            stateDropdown.val(selectedState);

        }

    }


    // ============================================
    // COUNTRY CHANGE
    // ============================================

    $("#CountryName").on("change", function () {

        const country = $(this).val();

        // New country = don't retain old state
        loadStates(country, "");

    });


    // ============================================
    // PAGE LOAD - EDIT
    // ============================================

    $(document).ready(function () {

        const existingCountry = $("#CountryName").val();

        // Get state from hidden field
        const existingState = $("#ExistingState").val();

        console.log("Country:", existingCountry);
        console.log("Existing State:", existingState);

        if (existingCountry) {

            loadStates(
                existingCountry,
                existingState
            );

        }

    });


    // ============================================
    // COUNTRY CHANGE
    // ============================================

    $("#CountryName").on("change", function () {

        let country = $(this).val();

        let oldState = $("#State").val();


        $("#State").html(
            '<option value="">-- Select State --</option>'
        );


        if (countryStates[country]) {

            countryStates[country].forEach(function (state) {

                $("#State").append(
                    $("<option>", {
                        value: state,
                        text: state
                    })
                );

            });

        }


        // Restore existing state on Edit

        if (oldState) {

            $("#State").val(oldState);

        }

    });


    // ============================================
    // PAGE LOAD
    // ============================================

    $(document).ready(function () {




        // ========================================
        // Country / State
        // ========================================

        let existingCountry =
            $("#CountryName").val();

        let existingState =
            $("#State").val();


        if (existingCountry) {

            $("#State").html(
                '<option value="">-- Select State --</option>'
            );


            if (countryStates[existingCountry]) {

                countryStates[existingCountry]
                    .forEach(function (state) {

                        $("#State").append(
                            $("<option>", {
                                value: state,
                                text: state
                            })
                        );

                    });

            }


            if (existingState) {

                $("#State")
                    .val(existingState);

            }

        }


        // ========================================
        // Default Supply Type
        // ========================================

        if (!$("#EInvTypeOfSupply").val()) {

            $("#EInvTypeOfSupply")
                .val("B2B");

        }


    });

</script>


