@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .table-invalid {
        border: 2px solid #dc3545 !important;
        border-radius: 4px;
        box-shadow: 0 0 0 0.15rem rgba(220, 53, 69, 0.25);
    }
</style>

<style>
    #tblDetails thead th {
        text-align: center;
        vertical-align: middle;
        padding: 5px 4px;
        border: 1px solid #000;
        font-size: 12px;
    }

    #tblDetails thead tr:first-child th {
        font-weight: bold;
        height: 28px;
    }

    #tblDetails thead tr:nth-child(2) th {
        font-size: 11px;
        padding: 3px 4px;
        height: 22px;
    }

    #tblDetails tbody td {
        border: 1px solid #000;
        padding: 4px;
        vertical-align: middle;
    }
</style>
<form id="WorkOrderform">
    <div id="loader" style="display:none;">
        <div class="text-center">
            <img src="~/assets/images/loader.gif"
                 class="loader-gif"
                 alt="Loading..." />
        </div>
    </div>
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h3 style="color:black; margin:0;" id="lblHeader">
                Create Quotation
            </h3>

            <button type="button"
                    class="btn btn-primary"
                    onclick="window.history.back();">
                <i class="fa fa-arrow-left"></i> Back
            </button>

        </div>
        <div class="card-body">

            <div class="row mb-3">
                <!-- Quotation Date -->
                <div class="col-md-6">
                    <div class="row align-items-center">
                        <label class="col-md-4 col-form-label font-weight-bold text-md-right">
                            <span class="text-danger">*</span> Quotation Date
                        </label>
                        <div class="col-md-8">
                            <input type="date"
                                   class="form-control"
                                   id="txtQuotationDate"
                                   name="txtQuotationDate"
                                   readonly />
                        </div>
                    </div>
                </div>

                <!-- Reverse Charge -->
                <div class="col-md-6">
                    <div class="row align-items-center">
                        <label class="col-md-4 col-form-label font-weight-bold text-md-right">
                            <span class="text-danger">*</span> Reverse Charge (Y/N)
                        </label>
                        <div class="col-md-8">
                            <select class="form-control" id="ddlReverseCharge" name="ddlReverseCharge">
                                <option value="N">N</option>
                                <option value="Y">Y</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <!-- Company Name -->
                <div class="col-md-6">
                    <div class="row align-items-center">
                        <label class="col-md-4 col-form-label font-weight-bold text-md-right">
                            <span class="text-danger">*</span> Company Name
                        </label>
                        <div class="col-md-8">
                            <select class="form-control ddlselect" id="ddlCompanyname" name="ddlCompanyname">
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Bill State -->
                <div class="col-md-6">
                    <div class="row align-items-center">
                        <label class="col-md-4 col-form-label font-weight-bold text-md-right">
                            <span class="text-danger">*</span> State
                        </label>
                        <div class="col-md-8">
                            <select class="form-control ddlselect" id="ddlBillState" name="ddlBillState">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <!-- GSTIN -->
                <div class="col-md-6">
                    <div class="row align-items-center">
                        <label class="col-md-4 col-form-label font-weight-bold text-md-right">
                            <span class="text-danger">*</span> GSTIN
                        </label>
                        <div class="col-md-8">
                            <input type="text"
                                   class="form-control"
                                   id="txtGSTNo"
                                   name="txtGSTNo"
                                   readonly />
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <!-- Address -->
                <div class="col-md-12">
                    <div class="row">
                        <label class="col-md-2 col-form-label font-weight-bold">
                            <span class="text-danger">*</span> Address
                        </label>
                        <div class="col-md-10">
                            <textarea class="form-control"
                                      id="txtAddress"
                                      name="txtAddress"
                                      rows="2"
                                      readonly></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <input type="hidden" id="ID" name="ID" />

        </div>

    </div>

    <div class="card">
        <div class="card-header text-uppercase">
            <h3 style="color:black">Add Services</h3>
        </div>

        <div class="row">
            <div class="col-md-12">

                <div class="card-body">


                    <input type="hidden" id="rowID" value="" />
                    <div class="table-responsive">
                        <!-- Service Entry Table -->
                        <table id="tbldetails"
                               class="table table-striped table-bordered dt-responsive nowrap"
                               style="width:100%;">

                            <thead class="clsthed">
                                <tr>
                                    <th class="col-action" rowspan="2">Action</th>
                                    <th class="col-desc" rowspan="2">Service Name</th>
                                    <th class="col-sac" rowspan="2">SAC Code</th>
                                    <th class="col-qty" rowspan="2">QTY</th>
                                    <th class="col-rate" rowspan="2">Rate</th>

                                    <!-- GST GROUPS -->
                                    <th class="col-tax" colspan="2">CGST %</th>
                                    <th class="col-tax" colspan="2">SGST %</th>
                                    <th class="col-tax" colspan="2">IGST %</th>

                                    <th class="col-taxable" rowspan="2">Amount</th>
                                    <th class="col-total" rowspan="2">All Total</th>
                                </tr>

                                <!-- SUB HEADER -->
                                <tr>
                                    <th class="col-tax">Rate</th>
                                    <th class="col-tax">Amount</th>

                                    <th class="col-tax">Rate</th>
                                    <th class="col-tax">Amount</th>

                                    <th class="col-tax">Rate</th>
                                    <th class="col-tax">Amount</th>
                                </tr>
                            </thead>

                            <tbody id="tblDetailsBody">
                                <!-- rows added by JS -->
                            </tbody>

                        </table>
                    </div>
                    <div class="col-md-12 text-center">
                        <input type="button"
                               class="btn btn-primary btn-sm btnAddRow"
                               value="Add Service"
                               id="btnAddRow" />
                    </div>
                </div>

            </div>
        </div>


        <div class="row">
            <div class="col-md-8">
            </div>
            <div class="col-md-4">
                <div class="table-responsive">
                    <table style="width:100%!important" id="tblAccountDetails" class="table table-striped table-bordered dt-responsive nowrap" cellspacing="0">
                        <thead class="clsthead">
                        </thead>
                        <tbody>
                            <tr>
                                <td id="lblTotalDealBasicAmount">Basic Amount</td>
                                <td><input class="form-control numeric" value="0" id="txtTotalDealBasicAmount" name="txtTotalDealBasicAmount" /></td>
                            </tr>
                            <tr id="trTotalDealGSTAmount">
                                <td> GST Amount</td>
                                <td><input class="form-control" value="0" id="txtTotalDealGSTAmount" name="txtTotalDealGSTAmount" readonly /></td>
                            </tr>
                            <tr>
                                <td>Total Amount</td>
                                <td><input class="form-control" id="txtTotalAmountBalance" name="txtTotalAmountBalance" readonly /></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="row justify-content-center mt-3">
            <div class="col-md-3 text-end">
                <button type="submit" id="btnSubmit" class="btn btn-primary">Save</button>
            </div>

            <div class="col-md-3 text-start">
                <a href="~/Quotation/Index">
                    <input type="button" id="btnCancel" value="Cancel" class="btn btn-warning" />
                </a>
            </div>

        </div>
        <br />
    </div>

</form>
<script>
    $(document).ready(function () {

          $('.ddlselect').select2({
              selectOnClose: true,
              width: '100%'
          });

      });
</script>
@section Scripts {

    <script src="~/js/Quotation.js"></script>
    <script type="text/javascript">

        $(document).ready(function ($) {

            GetQuotationForm.init();
        });
    </script>

}

