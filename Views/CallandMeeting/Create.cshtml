<script type="text/javascript">

    function hideAll() {

        $("#DivCallUpdate").hide();

        $("#DivMeetingUpdate").hide();

        $("#DivTypeofclient").hide();

        $("#DivMeetingtime").hide();

        $("#DivMailID").hide();

        $("#DivFollowDate").hide();

    }

    function CheckRegistrationCategory() {

        var category = $("#RegistrationCategory").val();

        if (category === "Trading/Manufacturing") {

            $("#DivGSTNo").show();

            $("#LblGSTNo").show();

            $("#GSTRequired").show();

            $("#GSTNo").prop("required", true);

            $("#RegistrationFor")
                .val("WLSPL");

        }

        else if (category === "Hospital/Clinic") {

            $("#DivGSTNo").hide();

            $("#LblGSTNo").hide();

            $("#GSTRequired").hide();

            $("#GSTNo")
                .val("")
                .prop("required", false);

            $("#GSTNoError").text("");

            $("#RegistrationFor")
                .val("WLS");

        }

        else if (category === "Other Non GTS") {

            $("#DivGSTNo").hide();

            $("#LblGSTNo").hide();

            $("#GSTRequired").hide();

            $("#GSTNo")
                .val("")
                .prop("required", false);

            $("#GSTNoError").text("");

            $("#RegistrationFor")
                .val("WLS");

        }

        else {

            $("#DivGSTNo").hide();

            $("#LblGSTNo").hide();

            $("#GSTRequired").hide();

            $("#GSTNo")
                .val("")
                .prop("required", false);

            $("#GSTNoError").text("");

            $("#RegistrationFor").val("");

        }
    }

    function CheckUpdateFor() {

        var updateForType = $("#UpdateFor").val();

        hideAll();

        $("#txtfolldate").val("");


        if (updateForType === "Call") {

            $("#MeetUpdateStatus").val("");

            $("#MeetingwithManager").val("1");

            $("#TypeofClient").val("");

            $("#DealDetails").val("");

            $("#MeetingTime").val("");

            $("#DivCallUpdate").show();

        }


        else if (updateForType === "Meeting") {

            if ($("#txtCompanyName").val() !== "") {

                $("#DivMailID").show();

            }

            $("#CallUpdateStatus").val("");

            $("#DivMeetingUpdate").show();

        }
    }

    function CheckCallMeetingUpdate() {

        var callStatus =
            $("#CallUpdateStatus").val();

        var meetingStatus =
            $("#MeetUpdateStatus").val();


        if ($("#UpdateFor").val() === "Call") {

            $("#DivCallUpdate").show();

        }


        if ($("#UpdateFor").val() === "Meeting") {

            $("#DivMeetingUpdate").show();

        }


        if (
            callStatus === "Follow-up" ||
            meetingStatus === "Follow-up"
        ) {

            $("#DivFollowDate").slideDown(300);

        }
        else {

            $("#DivFollowDate").slideUp(200);

            $("#txtfolldate").val("");

        }


        if (meetingStatus === "Closed") {

            $("#DivTypeofclient").show();

            $("#DivMeetingtime").show();

        }
        else {

            $("#DivTypeofclient").hide();

            $("#DivMeetingtime").hide();

            $("#TypeofClient").val("");

            $("#DealDetails").val("");

            $("#MeetingTime").val("");

        }
    }

    function validateGST() {

        var category =
            $("#RegistrationCategory").val();

        if (category === "Trading/Manufacturing") {

            var gst =
                $("#GSTNo").val().trim().toUpperCase();

            if (gst === "") {

                $("#GSTNoError")
                    .text("GST No. is required.");

                return false;
            }


            var gstRegex =
                /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$/;


            if (!gstRegex.test(gst)) {

                $("#GSTNoError")
                    .text("Please enter a valid GST No.");

                return false;
            }


            $("#GSTNo")
                .val(gst);

        }

        return true;
    }

    function validateForm() {
        var isValid = true;

        $(".text-danger").text("");

        var fields = [
            {
                id: "#txtCompanyName",
                error: "#CompanyNameError",
                name: "Company Name"
            },
            {
                id: "#PersonName",
                error: "#PersonNameError",
                name: "Owner Name"
            },
            {
                id: "#ContactNo",
                error: "#ContactNoError",
                name: "Contact No"
            },
            {
                id: "#Area",
                error: "#AreaError",
                name: "Area"
            },
            {
                id: "#Address",
                error: "#AddressError",
                name: "Address"
            },
            {
                id: "#FeedBack",
                error: "#FeedBackError",
                name: "Feedback",
                min: 100
            },
            {
                id: "#RegistrationCategory",
                error: "#RegistrationCategoryError",
                name: "Registration Category"
            },
            {
                id: "#UpdateFor",
                error: "#UpdateForError",
                name: "Type of Update"
            },
            {
                id: "#Type",
                error: "#TypeError",
                name: "Type"
            }
        ];

        fields.forEach(function (field) {
            if ($(field.id).is(":visible")) {
                var value =
                    $(field.id).val();
                if (
                    value == null ||
                    value.trim() === ""
                ) {
                    $(field.error)
                        .text(
                            field.name +
                            " is required."
                        );
                    isValid = false;
                }
                else if (
                    field.min &&
                    value.length < field.min
                ) {
                    $(field.error)
                        .text(
                            field.name +
                            " must contain minimum " +
                            field.min +
                            " characters."
                        );
                    isValid = false;
                }
            }
        });
        if (!validateGST()) {

            isValid = false;

        }


        if (
            $("#UpdateFor").val() === "Call"
        ) {

            if (
                $("#CallUpdateStatus").val() === ""
            ) {

                $("#CallUpdateStatusError")
                    .text(
                        "Call Status is required."
                    );

                isValid = false;

            }


            if (
                $("#CallUpdateStatus").val() ===
                "Follow-up"
            ) {

                if (
                    $("#txtfolldate").val().trim() === ""
                ) {

                    $("#FollowDateError")
                        .text(
                            "Follow Date is required."
                        );

                    isValid = false;

                }
            }
        }


        if (
            $("#UpdateFor").val() === "Meeting"
        ) {

            if (
                $("#MeetUpdateStatus").val() === ""
            ) {

                $("#MeetUpdateStatusError")
                    .text(
                        "Meeting Update is required."
                    );

                isValid = false;

            }


            if (
                $("#MeetUpdateStatus").val() ===
                "Follow-up"
            ) {

                if (
                    $("#txtfolldate").val().trim() === ""
                ) {

                    $("#FollowDateError")
                        .text(
                            "Follow Date is required."
                        );

                    isValid = false;

                }
            }


            if (
                $("#MeetUpdateStatus").val() ===
                "Closed"
            ) {

                if (
                    $("#TypeofClient").val() === ""
                ) {

                    $("#TypeofClientError")
                        .text(
                            "Type of Client is required."
                        );

                    isValid = false;

                }


                if (
                    $("#DealDetails")
                        .val()
                        .trim() === ""
                ) {

                    $("#DealDetailsError")
                        .text(
                            "Deal Details is required."
                        );

                    isValid = false;

                }


                if (
                    $("#MeetingTime").val() === ""
                ) {

                    $("#MeetingTimeError")
                        .text(
                            "Meeting Time is required."
                        );

                    isValid = false;

                }

            }

        }


        if (!isValid) {

            var firstError =
                $(".text-danger:visible:first");


            if (firstError.length) {

                $("html, body")
                    .animate(
                        {
                            scrollTop:
                                firstError.offset().top - 100
                        },
                        500
                    );
            }

            showToast("Please fix the highlighted fields before saving.", "error");

        }


        return isValid;
    }


    $(document).ready(function () {
        hideAll();
        CheckRegistrationCategory();

        if ($("#UpdateFor").val() !== "") {
            CheckUpdateFor();
            CheckCallMeetingUpdate();
        }
    });
</script>
