@model WEBLINK_CRM.Models.CallandMeeting

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<style type="text/css">
    .form-label-custom {
        font-weight: 600;
        color: #344054;
        display: flex;
        align-items: center;
    }

    .reqcls {
        color: red;
        font-weight: bold;
        margin-left: 3px;
    }

    .form-control {
        height: 43px;
        border-radius: 15px;
        border: 1px solid #d0d5dd;
        transition: .25s;
    }

    textarea.form-control {
        height: 110px;
        resize: none;
    }

    .form-control:focus {
        border-color: #0d6efd;
        border: 4px solid #0d6efd;
        box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .15);
    }

    .btn {
        border-radius: 8px;
        height: 43px;
        font-weight: 600;
        transition: .3s;
    }

    .btn-success {
        background: #198754;
        border: none;
    }

        .btn-success:hover {
            background: #157347;
            transform: translateY(-2px);
        }

    .btn-danger {
        background: #dc3545;
        border: none;
    }

        .btn-danger:hover {
            background: #bb2d3b;
            transform: translateY(-2px);
        }

    .text-danger {
        display: block;
        font-size: 12px;
        margin-top: 5px;
    }

    .ui-autocomplete {
        max-height: 250px;
        overflow-y: auto;
        background: white;
        border-radius: 10px;
        padding: 5px;
        border: none;
        box-shadow: 0 10px 25px rgba(0, 0, 0, .15);
        z-index: 9999 !important;
    }

    .ui-menu-item-wrapper {
        padding: 10px !important;
        border-radius: 7px;
    }

    .ui-state-active {
        background: #0d6efd !important;
        color: white !important;
        border: none !important;
    }

    #DivFollowDate,
    #DivFollowDateAB {
        display: none;
    }

    .date-box {
        width: 100%;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(0, 0, 0, .08);
    }

        .date-box input {
            height: 45px;
        }

        .date-box .input-group-text {
            background: #0d6efd;
            color: white;
            border: none;
            width: 45px;
            justify-content: center;
            cursor: pointer;
        }

    #DivGSTNo {
        display: none;
    }

    #DivRegistrationFor {
        display: block;
    }

    .registration-info {
        background: #f8fafc;
        border: 1px solid #e4e7ec;
        border-radius: 10px;
        padding: 10px 14px;
        color: #475467;
        font-size: 13px;
    }

    @@media (max-width: 768px) {

        .card-body {
            padding: 18px;
        }

        .form-label-custom {
            margin-bottom: 8px;
        }

        .btn {
            width: 100%;
            margin-bottom: 10px;
        }
    }
</style>

<script type="text/javascript">
    var hasDashboardCompany =
        @(ViewBag.DashboardCompanyDetails != null ? "true" : "false");

    document.addEventListener("DOMContentLoaded", function () {
        hideAll();
        if (hasDashboardCompany) {
           var dashboardCompany = @Html.Raw(ViewBag.DashboardCompanyDetails != null?
                                                            Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.DashboardCompanyDetails) : "null");

            if (dashboardCompany != null &&
                dashboardCompany.Id != null) {

                $("#txtCompanyName")
                    .val(dashboardCompany.CompanyName);

                $("#Ccode")
                    .val(dashboardCompany.CompanyCode);

                if (dashboardCompany.Contacts &&
                    dashboardCompany.Contacts.length > 0) {

                    $("#PersonName")
                        .val(dashboardCompany.Contacts[0].Name);

                    $("#ContactNo")
                        .val(dashboardCompany.Contacts[0].MobileNo);

                    $("#ClientMail")
                        .val(dashboardCompany.Contacts[0].EmailID);
                }

                $("#Area")
                    .val(dashboardCompany.AreaNAme);

                $("#Address")
                    .val(dashboardCompany.BillAddress);
            }
        }
    });

    $(document).ready(function () {
        $("#txtCompanyName").autocomplete({
            minLength: 1,
            source: function (request, response) {
                $.ajax({
                    url: "/CallAndMeeting/GetCompanyName",
                    type: "GET",
                    dataType: "json",
                    data: {
                        Name: request.term,
                        actionby : "ddlList"
                    },
                    success: function (data) {
                        response(
                            $.map(data, function (item) {
                               return {
                                    value: item.value,
                                    code: item.code,
                                    companyCreatedby:item.companyCreatedby,
                                    companyUserName:item.companyUserName
                                };
                            })
                        );
                    },
                    error: function () {
                        response([]);
                    }
                });
            },
            select: function (event, ui) {
                if (ui.item.companyCreatedby ==="@Context.Session.GetString("UserName")")
                {
                    $("#txtCompanyName").val(ui.item.value);
                    $("#hdCompanyCode").val(ui.item.code);

                    $.ajax({
                        url: "/CallAndMeeting/GetCompanyDetails",
                        type: "GET",
                        dataType: "json",
                        data: {
                            companyCode: ui.item.code
                        },
                        success: function (data) {
                            if (!data) {
                                return;
                            }
                            $("#Ccode").val(data.cCode);
                            $("#PersonName").val(data.oName).prop("readonly", true);
                            $("#ContactNo").val(data.mobile).prop("readonly", true);
                            $("#ClientMail").val(data.email).prop("readonly", true);
                            $("#Area").val(data.area).prop("readonly", true);
                            $("#Address").val(data.address).prop("readonly", true);
                        },
                        error: function () {
                            console.log("Unable to get company details.");
                        }
                    });
                }
                else {
                    showToast(
                        "The current Sales Manager for this company is " +
                        ui.item.companyUserName +
                        ". Please connect with the Sales Manager.",
                        "warning"
                    );

                    $("#txtCompanyName").val("");
                    $("#hdCompanyCode").val("");
                }
                return false;
            }
        });
        $("#RegistrationCategory").on("change", function () {
            CheckRegistrationCategory();
        });
        CheckRegistrationCategory();
        initializeDatePicker();
    });

    function initializeDatePicker() {
        var dateElement = document.getElementById("txtfolldate");
        if (!dateElement) {
            return;
        }
        flatpickr("#txtfolldate", {
            dateFormat: "Y-m-d",
            minDate: "today",
            animate: true,
            disableMobile: true,
            monthSelectorType: "dropdown",
            allowInput: true
        });
    }
</script>

