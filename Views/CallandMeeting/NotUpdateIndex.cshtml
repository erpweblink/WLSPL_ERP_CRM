@{
    ViewData["Title"] = "NotUpdateIndex";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/assets/libs/vanilla-datatables/vanilla-dataTables.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/libs/vanilla-datatables-editable/datatable.editable.min.css" asp-append-version="true">
        <script src="~/assets/libs/vanilla-datatables/vanilla-dataTables.min.js" asp-append-version="true"></script>
        <script src="~/assets/libs/vanilla-datatables-editable/datatable.editable.min.js" asp-append-version="true"></script>
<style type="text/css">
    .modelprofile1 {
        border-radius: 5px;
    }

    .headingcls {
        background-color: #423f3f;
    }

    .reqcls {
        color: red;
    }

    hr.new1 {
        border-top: 1px dashed green !important;
        border: 0;
        margin-top: 5px !important;
        margin-bottom: 5px !important;
        width: 100%;
    }

    .lbls {
        font-size: 12px;
        text-align: left;
    }
</style>
<!-- Include SweetAlert2 CSS and JS -->
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.6.9/dist/sweetalert2.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.6.9/dist/sweetalert2.min.js"></script>


<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center text-dark text-uppercase">
        <h5 class="mb-0">Not Updated List</h5>
        <select id="ddlDays" class="form-control w-auto" onchange="OpenHistory();">
            <option value="0">All</option>
            <option value="7">7 Days</option>
            <option value="15">15 Days</option>
            <option value="30">1 Month</option>
            <option value="180">6 Month</option>
        </select>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <div class="col-md-12" id="notUpdatedList">
            </div>
        </div>

        <!--  Commnet History Modal -->
        <div class="modal fade" id="companyHistoryModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content modelprofile1">

                    <!-- HEADER -->
                    <div class="modal-header headingcls d-flex align-items-center">
                        <h4 class="modal-title mb-0">Company Comment History</h4>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <!-- BODY -->
                    <div class="modal-body">
                        <div class="row container p-0 m-0">
                            <div class="profilemodel2">
                                <!-- Company Info -->
                                <div class="row ms-2">
                                    <div class="col-md-12" style="background-color:#f9f7f7">
                                        <div class="row p-1 bg-light">
                                            <div class="col-md-4"><b>Company Name :</b></div>
                                            <div class="col-md-8 lblpopup" id="lblHistorycname"></div>
                                        </div>
                                        <div class="row p-1 bg-light">
                                            <div class="col-md-4"><b>Company Code :</b></div>
                                            <div class="col-md-8 lblpopup" id="lblHistoryccode"></div>
                                        </div>
                                    </div>
                                </div>
                                <hr class="new1" />
                                <div class="row ms-2">
                                    <div class="col-md-12" id="commentHistoryContainer">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript">

    window.onload = function(){
        OpenHistory();
    };

    function OpenHistory() {
        var Days = $('#ddlDays').val();
        $.ajax({
            url: '/CallAndMeeting/GetNotUpdatedList',
            type: 'GET',
            data: { Days: Days },
            success: function (res) {
                if (!res.success) {
                    alert(res.message);
                    return;
                }

                var container = $('#notUpdatedList');
                container.empty();

                if (!res.comments || res.comments.length === 0) {
                    container.append('<p class="text-center">No List Found.</p>');
                    return;
                }

                var table = `
                    <table class="table" id="CallMettUpdate">
                        <thead class="table-light">
                            <tr>
                                <th>Sr.No.</th>
                                <th>Customer Name</th>
                                <th>Sales Manager</th>
                                <th>Transfer To</th>
                                <th>Day Date</th>
                            </tr>
                        </thead>
                        <tbody>
                `;
                var count = 0;
                $.each(res.comments, function (i, item) {
                    count++;
                    table += `
                        <tr>
                            <td>${count}</td>
                            <td><a href="javascript:void(0)"
                                       class="open-company-modal"
                                      data-code="${item.ccode}" data-name="${item.cname}">${item.cname}</a></td>
                            <td>${item.name}</td>
                        <td><select class="form-control ddlregbypopup" style="width: 70% !important;" onchange="ChangBDE()"></select></td>
                            <td>${item.DAYDATE}</td>
                        </tr>
                    `;
                });

                table += `
                        </tbody>
                    </table>
                `;
                container.append(table);

               $('.ddlregbypopup').each(function () {

                var ddl = $(this);
                ddl.empty().append('<option value="">-- Select Sales Manager --</option>');

                $.each(res.userList, function (i, user) {
                    ddl.append(
                        $('<option>', {
                            value: user.userCode,
                            text: user.fullName
                        })
                    );
                });

                const SessionRole = "@Context.Session.GetString("Role")";
                if (SessionRole && (SessionRole === 'Admin' || SessionRole === 'Sub Admin')) {
                    ddl.prop("disabled", false);
                } else {
                    ddl.prop("disabled", true);
                }

            });




            const dataTable = new DataTable("#CallMettUpdate", {
            searchable: true,
            fixedHeight: true,
            });
            },
            error: function () {
                alert("Failed to load list.");
            }
        });
    };

           
    $(document).on("click", ".open-company-modal", function () {
        let CompanyCode = $(this).data("code");
        let CompanyName = $(this).data("name");
        $.ajax({
            url: '/CallAndMeeting/GetCommmentHistory',
            type: 'GET',
            data: { CompanyCode: CompanyCode },
            success: function (res) {
                if (!res.success) {
                    alert(res.message);
                    return;
                }

                $("#lblHistoryccode").text(CompanyCode);
                $("#lblHistorycname").text(CompanyName);

                var container = $('#commentHistoryContainer');
                container.empty();

                if (res.comments.length === 0) {
                    container.append('<p class="text-center">No comments found.</p>');
                    return;
                }

                $.each(res.comments, function (i, item) {
                    var html = `
                        <div class="row" style="background-color: rgb(193 104 62);padding: 5px;">
                            <div class="col-md-4">
                                &nbsp;- <span class="lbls">${item.Name}</span>
                            </div>
                            <div class="col-md-4">
                                <span class="lbls">${item.CommentDateTime}</span>
                            </div>
                            <div class="col-md-4">
                                <span class="lbls">${item.Typeoftbl}</span>
                            </div>
                        </div>

                        <div class="row p-1">
                            <div class="col-md-12">
                                <p>${item.Message}</p>
                            </div>
                        </div>

                        <hr class="new1" />
                    `;
                    container.append(html);
                });

                new bootstrap.Modal(
                    document.getElementById('companyHistoryModal')
                ).show();
            }
        });
    });

</script>

