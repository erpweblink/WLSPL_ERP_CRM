@model IEnumerable<WLSPL_ERP_CRM.Models.Taxinvoice.TaxInvoiceCreate>
@using WEBLINK_CRM.Helpers
@{
    ViewData["Title"] = "Tax Invoice List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var invoiceList = Model?.ToList() ?? new List<WLSPL_ERP_CRM.Models.Taxinvoice.TaxInvoiceCreate>();
    var today = DateTime.Now;
    var inCulture = System.Globalization.CultureInfo.GetCultureInfo("en-IN");

    var currentFinancialYear = today.Month >= 4
        ? $"{today.Year}-{(today.Year + 1).ToString().Substring(2)}"
        : $"{today.Year - 1}-{today.Year.ToString().Substring(2)}";

    var currentMonth = today.ToString("MM");

    var selectedFinancialYear = ViewBag.SelectedFinancialYear?.ToString() ?? currentFinancialYear;

    var selectedMonthNumber = ViewBag.SelectedMonth != null
        ? Convert.ToInt32(ViewBag.SelectedMonth)
        : Convert.ToInt32(currentMonth);

    var selectedMonth = selectedMonthNumber == 0 ? "all" : selectedMonthNumber.ToString("00");

    var financialYearSummary = ViewBag.FinancialYearSummary as List<WLSPL_ERP_CRM.Models.Taxinvoice.TaxInvoiceCreate>
        ?? new List<WLSPL_ERP_CRM.Models.Taxinvoice.TaxInvoiceCreate>();

    var financialYearTotal = financialYearSummary.Sum(x => x.GrandTotal ?? 0m);
    var financialYearTaxTotal = financialYearSummary.Sum(x => x.TotalTaxAmount ?? 0m);
    var financialYearInvoiceCount = financialYearSummary.Sum(x => x.TotalInvoice ?? 0);

    var selectedMonthSummary = selectedMonthNumber == 0
        ? null
        : financialYearSummary.FirstOrDefault(x => x.mon == selectedMonthNumber);

    var selectedMonthGrandTotal = selectedMonthNumber == 0 ? financialYearTotal : selectedMonthSummary?.GrandTotal ?? 0m;
    var selectedMonthTaxTotal = selectedMonthNumber == 0 ? financialYearTaxTotal : selectedMonthSummary?.TotalTaxAmount ?? 0m;
    var selectedMonthInvoiceCount = selectedMonthNumber == 0 ? financialYearInvoiceCount : selectedMonthSummary?.TotalInvoice ?? 0;

    var selectedMonthName = selectedMonthNumber == 0
        ? "All Months"
        : inCulture.DateTimeFormat.GetMonthName(selectedMonthNumber);

    // Dynamic FY list: starts at 2021-22, runs up to next financial year
    int firstFyStart = 2021;
    int currentFyStart = today.Month >= 4 ? today.Year : today.Year - 1;
    int lastFyStart = currentFyStart + 1;

    // if the URL asks for a later FY, still show it
    int selectedFyStart = 0;
    if (selectedFinancialYear.Length >= 4 && int.TryParse(selectedFinancialYear.Substring(0, 4), out selectedFyStart))
    {
        lastFyStart = Math.Max(lastFyStart, selectedFyStart);
    }
}

