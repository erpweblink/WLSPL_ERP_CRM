@model IEnumerable<WLSPL_ERP_CRM.Models.Taxinvoice.InvoiceList>

@{
    ViewData["Title"] = "Tax Invoice List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var invoiceList = Model?.ToList()
        ?? new List<WLSPL_ERP_CRM.Models.Taxinvoice.InvoiceList>();

    var today = DateTime.Now;

    // =========================================================
    // CURRENT FINANCIAL YEAR
    // =========================================================

    var currentFinancialYear =
        today.Month >= 4
            ? $"{today.Year}-{(today.Year + 1).ToString().Substring(2)}"
            : $"{today.Year - 1}-{today.Year.ToString().Substring(2)}";

    // =========================================================
    // CURRENT MONTH
    // =========================================================

    var currentMonth = today.ToString("MM");

    // =========================================================
    // SELECTED FINANCIAL YEAR
    // =========================================================

    var selectedFinancialYear =
        ViewBag.SelectedFinancialYear?.ToString()
        ?? currentFinancialYear;

    // =========================================================
    // SELECTED MONTH
    //
    // Controller:
    // 0 = All Months
    // 1-12 = Selected Month
    // =========================================================

    var selectedMonthNumber =
        ViewBag.SelectedMonth != null
            ? Convert.ToInt32(ViewBag.SelectedMonth)
            : Convert.ToInt32(currentMonth);

    var selectedMonth =
        selectedMonthNumber == 0
            ? "all"
            : selectedMonthNumber.ToString("00");

    // =========================================================
    // FINANCIAL YEAR SUMMARY
    // =========================================================

    var financialYearSummary =
        ViewBag.FinancialYearSummary
        as List<WLSPL_ERP_CRM.Models.Taxinvoice.InvoiceMonthSummary>
        ?? new List<WLSPL_ERP_CRM.Models.Taxinvoice.InvoiceMonthSummary>();

    // =========================================================
    // FY TOTAL
    // =========================================================

    var financialYearTotal =
        financialYearSummary.Sum(x => x.GrandTotal);

    // =========================================================
    // FY TAX TOTAL
    // =========================================================

    var financialYearTaxTotal =
        financialYearSummary.Sum(x => x.TotalTaxAmount);

    // =========================================================
    // FY INVOICE COUNT
    // =========================================================

    var financialYearInvoiceCount =
        financialYearSummary.Sum(x => x.TotalInvoice);

    // =========================================================
    // SELECTED MONTH SUMMARY
    // =========================================================

    var selectedMonthSummary =
        selectedMonthNumber == 0
            ? null
            : financialYearSummary
                .FirstOrDefault(x => x.Mon == selectedMonthNumber);

    // =========================================================
    // SELECTED MONTH TOTAL
    // =========================================================

    var selectedMonthGrandTotal =
        selectedMonthNumber == 0
            ? financialYearTotal
            : selectedMonthSummary?.GrandTotal ?? 0;

    // =========================================================
    // SELECTED MONTH TAX
    // =========================================================

    var selectedMonthTaxTotal =
        selectedMonthNumber == 0
            ? financialYearTaxTotal
            : selectedMonthSummary?.TotalTaxAmount ?? 0;

    // =========================================================
    // SELECTED MONTH COUNT
    // =========================================================

    var selectedMonthInvoiceCount =
        selectedMonthNumber == 0
            ? financialYearInvoiceCount
            : selectedMonthSummary?.TotalInvoice ?? 0;

    // =========================================================
    // MONTH NAME
    // =========================================================

    var selectedMonthName =
        selectedMonthNumber == 0
            ? "All Months"
            : System.Globalization.CultureInfo
                .GetCultureInfo("en-IN")
                .DateTimeFormat
                .GetMonthName(selectedMonthNumber);
}

