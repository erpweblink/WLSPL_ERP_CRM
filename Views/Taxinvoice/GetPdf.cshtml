            .logo-wrapper {
                width: 70px;
                height: 52px;
            }

            .company-logo img {
                width: 66px;
                max-height: 46px;
            }

            .company-name {
                font-size: 10px;
            }

            .company-address {
                font-size: 7px;
            }

            .company-contact {
                font-size: 6.5px;
            }

            .company-gstin {
                font-size: 7px;
            }

            .meta-table td {
                font-size: 8px;
                padding: 4px 5px;
            }

            .customer-table td {
                font-size: 8px;
                padding: 4px 5px;
            }

            .transaction-table td {
                font-size: 8px;
                padding: 4px 5px;
            }

            .amount-summary td {
                padding: 5px;
                font-size: 8px;
            }

            .grand-total-row td {
                font-size: 9px;
            }
        }

        /* ── PRINT ── */
        @@media print {
            html, body {
                width: 210mm !important;
                height: 297mm !important;
                margin: 0 !important;
                padding: 0 !important;
                background: #fff !important;
                overflow: hidden !important;
                font-size: 10px !important;
            }

            .toolbar {
                display: none !important;
            }

            .page-container {
                width: 210mm !important;
                height: 297mm !important;
                min-height: 297mm !important;
                margin: 0 !important;
                padding: 0 !important;
                background: #fff !important;
                box-shadow: none !important;
                border-radius: 0 !important;
                overflow: hidden !important;
            }

            .invoice {
                width: 210mm !important;
                height: 297mm !important;
                min-height: 297mm !important;
                padding: 5mm 6mm !important;
                overflow: hidden !important;
                display: flex !important;
                flex-direction: column !important;
            }
            /* flex-grow fills remaining space to push footer down */
            .flex-grow {
                flex: 1 1 auto !important;
                min-height: 0 !important;
            }

            .company-header {
                min-height: 76px !important;
            }

            .company-logo {
                padding: 5px !important;
            }

            .logo-wrapper {
                width: 112px !important;
                height: 56px !important;
            }

            .company-logo img {
                width: 104px !important;
                max-height: 50px !important;
            }

            .company-details {
                padding: 4px 10px !important;
            }

            .company-name {
                font-size: 15px !important;
                margin-bottom: 3px !important;
            }

            .company-address {
                font-size: 7.5px !important;
                line-height: 1.2 !important;
            }

            .company-contact {
                font-size: 7px !important;
                line-height: 1.2 !important;
                margin-top: 2px !important;
            }

            .company-gstin {
                font-size: 7px !important;
                margin-top: 2px !important;
                padding: 2px 8px !important;
            }

            .invoice-title {
                padding: 5px !important;
                font-size: 12px !important;
                letter-spacing: 1.5px !important;
            }

            .meta-table td {
                height: 19px !important;
                padding: 2px 5px !important;
                font-size: 7.5px !important;
            }

            .section-title {
                margin-top: 4px !important;
                padding: 3px 6px !important;
                font-size: 7.5px !important;
            }

            .customer-table td {
                padding: 3px 5px !important;
                font-size: 7.5px !important;
                line-height: 1.1 !important;
            }

            .transaction-table td {
                padding: 3px 5px !important;
                font-size: 7.5px !important;
            }

            .items-scroll {
                width: 100% !important;
                overflow: visible !important;
            }

            .items-table {
                width: 100% !important;
                min-width: 0 !important;
                margin-top: 4px !important;
                table-layout: fixed !important;
            }

                .items-table th {
                    padding: 3px 2px !important;
                    font-size: 6.5px !important;
                    line-height: 1.1 !important;
                }

                .items-table td {
                    padding: 3px 2px !important;
                    height: 20px !important;
                    font-size: 7px !important;
                    line-height: 1.1 !important;
                }

            .description {
                line-height: 1.1 !important;
            }

            .items-table .right {
                white-space: nowrap !important;
            }

            .total-row td {
                font-size: 7.5px !important;
                padding: 3px 2px !important;
            }

            .spacer-row td {
                height: 8px !important;
            }

            .summary-grid {
                grid-template-columns: minmax(0,1fr) minmax(0,1fr) !important;
                width: 100% !important;
            }

            .amount-words {
                padding: 6px 8px !important;
            }

            .amount-words-title {
                font-size: 6.5px !important;
                margin-bottom: 3px !important;
            }

            .amount-words-value {
                font-size: 7.5px !important;
                line-height: 1.2 !important;
            }

            .amount-summary td {
                height: 19px !important;
                padding: 2px 5px !important;
                font-size: 7.5px !important;
            }

            .grand-total-row td {
                font-size: 8.5px !important;
            }

            .remark-box {
                min-height: 28px !important;
                padding: 4px 6px !important;
                font-size: 7.5px !important;
            }

            .remark-title {
                margin-bottom: 2px !important;
            }

            .footer-spacer {
                height: 0 !important;
            }

            .footer-grid {
                grid-template-columns: minmax(0,1fr) 95px minmax(0,1fr) !important;
                min-height: 72px !important;
                height: 72px !important;
                margin-top: 0 !important;
            }

            .footer-title {
                padding: 4px !important;
                font-size: 7px !important;
            }

            .bank-content {
                padding: 5px !important;
                font-size: 6.5px !important;
                line-height: 1.35 !important;
            }

            .seal {
                width: 44px !important;
                height: 44px !important;
                font-size: 5px !important;
            }

            .seal-text {
                font-size: 5.5px !important;
                margin-top: 2px !important;
            }

            .signature-area {
                padding-top: 5px !important;
            }

            .signature-for {
                font-size: 7px !important;
            }

            .signature-space {
                height: 26px !important;
            }

            .signature-line {
                width: 70% !important;
                margin-bottom: 2px !important;
            }

            .authorized {
                font-size: 7px !important;
            }

            .bottom-note {
                margin-top: 3px !important;
                font-size: 6px !important;
            }
        }

        @@page {
            size: A4 portrait;
            margin: 0;
        }
    </style>
</head>
<body>

    <div class="toolbar">
        <button type="button" class="btn-back" onclick="history.back()">← Back</button>
        <button type="button" class="btn-print" onclick="window.print()">🖨 Print / Save PDF</button>
    </div>

    <div class="page-container">
        <div class="invoice">

            <div class="company-header">
                <div class="company-logo">
                    <div class="logo-wrapper">
                        <img src="@Url.Content("~/assets/images/logo-dark.png")" alt="Web Link Services Pvt. Ltd." onerror="this.style.display='none';" />
                    </div>
                </div>
                <div class="company-details">
                    <div class="company-name">@companyName</div>
                    <div class="company-address">@companyAddress</div>
                    <div class="company-contact">Mobile :- @companyMobile &nbsp;|&nbsp; @companyEmail</div>
                    <div class="company-gstin">GSTIN : @companyGstin</div>
                </div>
            </div>

            <div class="invoice-title">TAX INVOICE</div>

            <table class="meta-table">
                <tr>
                    <td class="meta-label">Invoice No.</td>
                    <td class="meta-value">@invoiceNo</td>
                </tr>
                <tr>
                    <td class="meta-label">Invoice Date</td>
                    <td class="meta-value">@invoiceDate</td>
                </tr>
                <tr>
                    <td class="meta-label">Invoice Type</td>
                    <td class="meta-value">@invoiceType</td>
                </tr>
                <tr>
                    <td class="meta-label">Reverse Charge (Y/N)</td>
                    <td class="meta-value">@reverseCharge</td>
                </tr>
                <tr>
                    <td class="meta-label">State</td>
                    <td class="meta-value">
                        @state
                        @if (!string.IsNullOrWhiteSpace(stateCode))
                        {
                            <text>&nbsp;&nbsp;(Code: @stateCode)</text>
                        }
                    </td>
                </tr>
            </table>

            <div class="section-title">Bill To Party</div>

            <table class="customer-table">
                <tr>
                    <td class="customer-label">Company Name</td>
                    <td class="customer-value">@customerName</td>
                </tr>
                <tr>
                    <td class="customer-label">Address</td>
                    <td class="customer-value">@customerAddress</td>
                </tr>
                <tr>
                    <td class="customer-label">Location</td>
                    <td class="customer-value">@customerLocation</td>
                </tr>
                <tr>
                    <td class="customer-label">GSTIN</td>
                    <td class="customer-value">@customerGstin</td>
                </tr>
                <tr>
                    <td class="customer-label">Pincode</td>
                    <td class="customer-value">@customerPinCode</td>
                </tr>
                <tr>
                    <td class="customer-label">State / State Code</td>
                    <td class="customer-value">@customerState</td>
                </tr>
            </table>

            @if (!string.IsNullOrWhiteSpace(transMode) || !string.IsNullOrWhiteSpace(transNo) || !string.IsNullOrWhiteSpace(transDate) || !string.IsNullOrWhiteSpace(transAmount))
            {
                <div class="section-title">Transaction Details</div>
                <table class="transaction-table">
                    <tr>
                        <td class="transaction-label">Transport Mode</td>
                        <td class="transaction-value">@transMode</td>
                        <td class="transaction-label">Transaction No.</td>
                        <td class="transaction-value">@transNo</td>
                    </tr>
                    <tr>
                        <td class="transaction-label">Transaction Date</td>
                        <td class="transaction-value">@transDate</td>
                        <td class="transaction-label">Transaction Amount</td>
                        <td class="transaction-value">@transAmount</td>
                    </tr>
                </table>
            }

            <div class="items-scroll">
                <table class="items-table">
                    <colgroup>
                        <col style="width:4%;" />
                        <col style="width:18%;" />
                        <col style="width:7%;" />
                        <col style="width:5%;" />
                        <col style="width:8%;" />
                        <col style="width:10%;" />
                        <col style="width:6%;" />
                        <col style="width:9%;" />
                        <col style="width:6%;" />
                        <col style="width:9%;" />
                        <col style="width:6%;" />
                        <col style="width:9%;" />
                        <col style="width:10%;" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th rowspan="2">Sr.<br />No.</th>
                            <th rowspan="2">Description</th>
                            <th rowspan="2">SAC<br />Code</th>
                            <th rowspan="2">Qty</th>
                            <th rowspan="2">Rate</th>
                            <th rowspan="2">Taxable<br />Value</th>
                            <th colspan="2">CGST</th>
                            <th colspan="2">SGST</th>
                            <th colspan="2">IGST</th>
                            <th rowspan="2">Total</th>
                        </tr>
                        <tr>
                            <th>Rate</th>
                            <th>Amount</th>
                            <th>Rate</th>
                            <th>Amount</th>
                            <th>Rate</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var srNo = 1;
                        }

                        @if (Model.details != null && Model.details.Count > 0)
                        {
                            foreach (var item in Model.details)
                            {
                                <tr>
                                    <td class="center">@srNo</td>
                                    <td class="description">@item.productdescription</td>
                                    <td class="center">@item.saccode</td>
                                    <td class="center">@(item.qty.HasValue? item.qty.Value.ToString("0.##") : "0")</td>
                                    <td class="right">₹@(item.rate.HasValue? item.rate.Value.ToString("N2") : "0.00")</td>
                                    <td class="right">₹@(item.taxablevalue.HasValue? item.taxablevalue.Value.ToString("N2") : "0.00")</td>
                                    <td class="center">@(item.cgstrate.HasValue? item.cgstrate.Value.ToString("0.##") : "0")%</td>
                                    <td class="right">₹@(item.cgstamt.HasValue? item.cgstamt.Value.ToString("N2") : "0.00")</td>
                                    <td class="center">@(item.sgstrate.HasValue? item.sgstrate.Value.ToString("0.##") : "0")%</td>
                                    <td class="right">₹@(item.sgstamt.HasValue? item.sgstamt.Value.ToString("N2") : "0.00")</td>
                                    <td class="center">@(item.igstrate.HasValue? item.igstrate.Value.ToString("0.##") : "0")%</td>
                                    <td class="right">₹@(item.igstamt.HasValue? item.igstamt.Value.ToString("N2") : "0.00")</td>
                                    <td class="right">₹@(item.total.HasValue? item.total.Value.ToString("N2") : "0.00")</td>
                                </tr>
                                srNo++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="13" class="empty-row">No invoice details available.</td>
                            </tr>
                        }

                        <!-- blank spacer row between items and total -->
                        <tr class="spacer-row">
                            <td colspan="13"></td>
                        </tr>

                        <tr class="total-row">
                            <td colspan="3" class="right">TOTAL</td>
                            <td class="center">@totalQuantity.ToString("0.##")</td>
                            <td class="right">₹@totalRate.ToString("N2")</td>
                            <td class="right">₹@totalTaxableValue.ToString("N2")</td>
                            <td class="center">@cgstRate.ToString("0.##")%</td>
                            <td class="right">₹@cgstAmount.ToString("N2")</td>
                            <td class="center">@sgstRate.ToString("0.##")%</td>
                            <td class="right">₹@sgstAmount.ToString("N2")</td>
                            <td class="center">@igstRate.ToString("0.##")%</td>
                            <td class="right">₹@igstAmount.ToString("N2")</td>
                            <td class="right">₹@grandTotal.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="summary-grid">
                <div class="amount-words">
                    <div class="amount-words-title">Total Invoice Amount in Words</div>
                    <div class="amount-words-value">@amountInWords</div>
                </div>
                <div>
                    <table class="amount-summary">
                        <tr>
                            <td>Total Amount Before Tax</td>
                            <td>₹@totalAmountBeforeTax.ToString("N2")</td>
                        </tr>
                        @if (cgstAmount > 0)
                        {
                            <tr>
                                <td>Add: CGST (@cgstRate.ToString("0.##")%)</td>
                                <td>₹@cgstAmount.ToString("N2")</td>
                            </tr>
                        }
                        @if (sgstAmount > 0)
                        {
                            <tr>
                                <td>Add: SGST (@sgstRate.ToString("0.##")%)</td>
                                <td>₹@sgstAmount.ToString("N2")</td>
                            </tr>
                        }
                        @if (igstAmount > 0)
                        {
                            <tr>
                                <td>Add: IGST (@igstRate.ToString("0.##")%)</td>
                                <td>₹@igstAmount.ToString("N2")</td>
                            </tr>
                        }
                        <tr>
                            <td>Total Tax Amount</td>
                            <td>₹@totalTaxAmount.ToString("N2")</td>
                        </tr>
                        <tr class="grand-total-row">
                            <td>TOTAL AMOUNT AFTER TAX</td>
                            <td>₹@totalAmountAfterTax.ToString("N2")</td>
                        </tr>
                        <tr class="round-row">
                            <td>Round Off</td>
                            <td>₹0.00</td>
                        </tr>
                    </table>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(main.AckNo) || main.AckDt.HasValue || !string.IsNullOrWhiteSpace(main.Irn) || !string.IsNullOrWhiteSpace(main.Status) || !string.IsNullOrWhiteSpace(main.e_invoice_status))
            {
                <div class="section-title">E-Invoice Details</div>
                <table class="customer-table">
                    @if (!string.IsNullOrWhiteSpace(main.AckNo))
                    {
                        <tr>
                            <td class="customer-label">Acknowledgement No.</td>
                            <td class="customer-value">@main.AckNo</td>
                        </tr>
                    }
                    @if (main.AckDt.HasValue)
                    {
                        <tr>
                            <td class="customer-label">Acknowledgement Date</td>
                            <td class="customer-value">@main.AckDt.Value.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                    @if (!string.IsNullOrWhiteSpace(main.Irn))
                    {
                        <tr>
                            <td class="customer-label">IRN</td>
                            <td class="customer-value">@main.Irn</td>
                        </tr>
                    }
                    @if (!string.IsNullOrWhiteSpace(main.Status))
                    {
                        <tr>
                            <td class="customer-label">Status</td>
                            <td class="customer-value">@main.Status</td>
                        </tr>
                    }
                    @if (!string.IsNullOrWhiteSpace(main.e_invoice_status))
                    {
                        <tr>
                            <td class="customer-label">E-Invoice Status</td>
                            <td class="customer-value">@main.e_invoice_status</td>
                        </tr>
                    }
                </table>
            }

            <div class="remark-box">
                <div class="remark-title">Remark :</div>
                <div>@remark</div>
            </div>

            <!-- flex spacer: pushes footer to bottom of page -->
            <div class="flex-grow"></div>

            <!-- visible spacer gap above footer -->
            <div class="footer-spacer"></div>

            <div class="footer-grid">
                <div class="bank-details">
                    <div class="footer-title">Bank Details</div>
                    <div class="bank-content">
                        <div class="not-available">Bank details not available in the current DTO.</div>
                    </div>
                </div>
                <div class="seal-area">
                    <div class="seal">WEB LINK<br />SERVICES<br />PVT. LTD.</div>
                    <div class="seal-text">Common Seal</div>
                </div>
                <div class="signature-area">
                    <div class="signature-for">For,<br />Web Link Services Pvt. Ltd.</div>
                    <div class="signature-space"></div>
                    <div class="signature-line"></div>
                    <div class="authorized">Authorized Signatory</div>
                </div>
            </div>

            <div class="bottom-note">This is a computer generated tax invoice.</div>

        </div>
    </div>

</body>
</html>
