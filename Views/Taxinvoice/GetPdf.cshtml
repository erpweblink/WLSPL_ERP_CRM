            }

            .amount-words-title {
                font-size: 8px;
                margin-bottom: 6px;
            }

            .amount-words-value {
                font-size: 10px;
                line-height: 1.45;
            }

            .amount-summary {
                width: 100%;
            }

                .amount-summary td {
