@model WLSPL_ERP_CRM.Models.Taxinvoice.TaxInvoiceCreateVM

@{
    Layout = null;

    // =========================================================
    // MAIN INVOICE DTO — DO NOT CHANGE DTO
    // =========================================================

    var main = Model.main ?? new WLSPL_ERP_CRM.Models.Taxinvoice.TaxInvoiceCreate();

    // =========================================================
    // INVOICE DETAILS
    // =========================================================

    var invoiceNo = main.invoiceno ?? "";

    var invoiceDate = main.invoicedate.HasValue
        ? main.invoicedate.Value.ToString("dd/MM/yyyy")
        : "";

    var reverseCharge = main.reversecharge ?? "";
    var invoiceType = main.InvoiceType ?? "";
    var state = main.state ?? "";
    var stateCode = main.statecode ?? "";

    // =========================================================
    // FIXED COMPANY DETAILS
    // =========================================================

    var companyName = "Web Link Services Pvt. Ltd.";

    var companyAddress =
        "12th Floor, Vintage 21 Commercial Complex, Above Max Showroom, P.K. Chowk, Pimple Saudagar, Pune, Maharashtra";

    var companyMobile = "8421060192";
    var companyEmail = "info@weblinkservices.net";
    var companyGstin = "27AABCW8929J2ZP";

    // =========================================================
    // CUSTOMER / BILLING DETAILS
    // =========================================================

    var customerName = main.companyName ?? "";

    var customerAddress =
        main.BillingAddress
        ?? main.Address
        ?? "";

    var customerLocation =
        main.BillingLocation
        ?? main.Location
        ?? "";

    var customerGstin =
        main.BillingGST
        ?? main.gstIn
        ?? "";

    var customerPinCode =
        main.BillingPincode
        ?? main.PinCode
        ?? "";

    var customerState =
        main.BillingStatecode
        ?? main.state
        ?? "";

    // =========================================================
    // TRANSACTION DETAILS
    // =========================================================

    var transMode = main.TransMode ?? "";
    var transNo = main.TransNo ?? "";

    var transDate = main.TransDate.HasValue
        ? main.TransDate.Value.ToString("dd/MM/yyyy")
        : "";

    var transAmount = main.TransAmt ?? "";

    // =========================================================
    // GST DETAILS
    // =========================================================

    var cgstRate = main.cgst ?? 0;
    var cgstAmount = main.cgstamt ?? 0;

    var sgstRate = main.sgst ?? 0;
    var sgstAmount = main.sgstamt ?? 0;

    var igstRate = main.igst ?? 0;
    var igstAmount = main.igstamt ?? 0;

    var reverseChargeGst = main.gstonreversecharge ?? "";

    // =========================================================
    // TOTALS
    // =========================================================

    var totalQuantity = main.totalqty ?? 0;
    var totalRate = main.totalrate ?? 0;
    var totalTaxableValue = main.taxablevalue ?? 0;

    var totalAmountBeforeTax = main.totalamtbeforetax ?? 0;
    var totalAmountAfterTax = main.totalamtaftertax ?? 0;

    decimal totalTaxAmount = 0;

    if (decimal.TryParse(main.total_tax_amount, out var parsedTax))
    {
        totalTaxAmount = parsedTax;
    }
    else
    {
        totalTaxAmount = cgstAmount + sgstAmount + igstAmount;
    }

    var grandTotal = main.totalamtaftertax ?? 0;

    var amountInWords = main.amtinwords ?? "";

    // =========================================================
    // REMARK
    // =========================================================

    var remark =
        main.Remarks
        ?? main.Remarkss
        ?? "Thank you for your business.";

    // =========================================================
    // DETAILS COUNT
    // =========================================================

    var detailsCount =
        Model.details == null
            ? 0
            : Model.details.Count;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Tax Invoice - @invoiceNo</title>

    <style>

        /* =========================================================
                   PREMIUM RED + WHITE INVOICE THEME
                ========================================================= */

        :root {
            --red-dark: #8f111b;
            --red: #b91c2b;
            --red-bright: #dc2638;
            --red-light: #fff1f2;
            --red-soft: #ffe4e6;
            --red-border: #d88a92;
            --red-border-dark: #9f1d29;
            --white: #ffffff;
            --black: #171717;
            --dark: #2b1114;
            --gray: #666666;
            --gray-light: #f8f8f8;
            --gray-border: #d6d6d6;
            --shadow: 0 12px 35px rgba(95, 10, 20, .16);
        }


        /* =========================================================
                   RESET
                ========================================================= */

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: radial-gradient(circle at top left, #fff5f5 0, transparent 35%), linear-gradient(135deg, #f5f5f5, #eeeeee);
            color: var(--black);
            font-size: 11px;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }


        /* =========================================================
                   TOOLBAR
                ========================================================= */

        .toolbar {
            width: 210mm;
            margin: 18px auto 12px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 9px;
        }

            .toolbar button {
                border: 0;
                border-radius: 7px;
                padding: 10px 17px;
                color: #ffffff;
                font-size: 12px;
                font-weight: 700;
                cursor: pointer;
                transition: .2s ease;
            }

        .btn-back {
            background: #3f3f46;
        }

            .btn-back:hover {
                background: #27272a;
                transform: translateY(-1px);
            }

        .btn-print {
            background: linear-gradient(135deg, #b91c2b, #8f111b);
            box-shadow: 0 5px 14px rgba(143, 17, 27, .28);
        }

            .btn-print:hover {
                background: linear-gradient(135deg, #dc2638, #9f1621);
                transform: translateY(-1px);
            }


        /* =========================================================
                   A4 PAGE
                ========================================================= */

        .page-container {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto 25px;
            background: #ffffff;
            box-shadow: var(--shadow);
            border-radius: 8px;
            overflow: hidden;
        }

        .invoice {
            width: 100%;
            min-height: 297mm;
            padding: 8mm;
            background: #ffffff;
        }


        /* =========================================================
                   COMPANY HEADER
                ========================================================= */

        .company-header {
            position: relative;
            display: grid;
            grid-template-columns: 150px minmax(0, 1fr);
            min-height: 108px;
            border: 1.5px solid var(--red-dark);
            border-radius: 6px 6px 0 0;
            overflow: hidden;
            background: #ffffff;
        }

            .company-header::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 5px;
                background: linear-gradient( 90deg, #7f1019, #b91c2b, #dc2638, #b91c2b, #7f1019 );
            }

        .company-logo {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 10px;
            border-right: 1px solid var(--red-border);
            background: linear-gradient( 145deg, #ffffff 0%, #fff7f7 100% );
        }

            .company-logo::after {
                content: "";
                position: absolute;
                right: -1px;
                top: 17px;
                bottom: 17px;
                width: 3px;
                background: var(--red);
            }

        .logo-wrapper {
            width: 130px;
            height: 78px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .company-logo img {
            display: block;
            width: 120px;
            max-width: 100%;
            height: auto;
            max-height: 72px;
            object-fit: contain;
        }

        .company-details {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 10px 20px;
            min-width: 0;
        }

        .company-name {
            font-size: 20px;
            font-weight: 900;
            color: var(--red-dark);
            letter-spacing: .3px;
            margin-bottom: 7px;
            text-transform: uppercase;
        }

        .company-address {
            max-width: 720px;
            font-size: 9.5px;
            line-height: 1.5;
            color: #4b4b4b;
            word-break: break-word;
        }

        .company-contact {
            margin-top: 5px;
            font-size: 9px;
            line-height: 1.4;
            color: #4b4b4b;
        }

            .company-contact::first-letter {
                color: var(--red);
            }

        .company-gstin {
            display: inline-block;
            margin-top: 6px;
            padding: 3px 12px;
            border-radius: 20px;
            background: var(--red-light);
            border: 1px solid #efb0b6;
            color: var(--red-dark);
            font-size: 9px;
            font-weight: 900;
            letter-spacing: .3px;
        }


        /* =========================================================
                   INVOICE TITLE
                ========================================================= */

        .invoice-title {
            position: relative;
            text-align: center;
            padding: 10px;
            background: linear-gradient( 135deg, #8f111b 0%, #b91c2b 50%, #8f111b 100% );
            color: #ffffff;
            font-size: 17px;
            font-weight: 900;
            letter-spacing: 2px;
            border-left: 1.5px solid var(--red-dark);
            border-right: 1.5px solid var(--red-dark);
            border-bottom: 1.5px solid var(--red-dark);
            box-shadow: inset 0 -2px 0 rgba(255,255,255,.13);
        }

            .invoice-title::before,
            .invoice-title::after {
                content: "";
                position: absolute;
                top: 50%;
                width: 20%;
                height: 1px;
                background: rgba(255,255,255,.45);
            }

            .invoice-title::before {
                left: 8%;
            }

            .invoice-title::after {
                right: 8%;
            }


        /* =========================================================
                   META TABLE
                ========================================================= */

        .meta-table {
            width: 100%;
            border-collapse: collapse;
        }

            .meta-table td {
                border: 1px solid #c99aa0;
                padding: 6px 9px;
                height: 28px;
            }

        .meta-label {
            width: 50%;
            background: #fff7f7;
            color: var(--red-dark);
            font-weight: 800;
        }

        .meta-value {
            background: #ffffff;
            font-weight: 700;
            color: #242424;
        }


        /* =========================================================
                   SECTION TITLE
                ========================================================= */

        .section-title {
            position: relative;
            margin-top: 10px;
            padding: 7px 10px 7px 14px;
            color: #ffffff;
            background: linear-gradient( 90deg, #8f111b, #b91c2b 70%, #a91422 );
            border: 1px solid #8f111b;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 1px;
            text-transform: uppercase;
            overflow: hidden;
        }

            .section-title::before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 5px;
                background: #ffffff;
            }

            .section-title::after {
                content: "";
                position: absolute;
                right: 0;
                top: 0;
                width: 35px;
                height: 100%;
                background: rgba(255,255,255,.08);
                transform: skewX(-25deg);
            }


        /* =========================================================
                   CUSTOMER
                ========================================================= */

        .customer-table {
            width: 100%;
            border-collapse: collapse;
        }

            .customer-table td {
                border: 1px solid #c99aa0;
                padding: 7px 9px;
                vertical-align: middle;
                line-height: 1.4;
            }

        .customer-label {
            width: 32%;
            background: #fff7f7;
            color: var(--red-dark);
            font-weight: 800;
        }

        .customer-value {
            width: 68%;
            color: #202020;
            font-weight: 600;
            background: #ffffff;
            word-break: break-word;
        }


        /* =========================================================
                   TRANSACTION
                ========================================================= */

        .transaction-table {
            width: 100%;
            border-collapse: collapse;
        }

            .transaction-table td {
                border: 1px solid #c99aa0;
                padding: 6px 8px;
            }

        .transaction-label {
            background: #fff7f7;
            color: var(--red-dark);
            font-weight: 800;
        }

        .transaction-value {
            color: #222222;
            font-weight: 600;
        }


        /* =========================================================
                   ITEMS TABLE
                ========================================================= */

        .items-scroll {
            width: 100%;
        }

        .items-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            margin-top: 10px;
            table-layout: fixed;
            overflow: hidden;
            border: 1px solid #8f111b;
        }

            .items-table th {
                border-right: 1px solid #d9969d;
                border-bottom: 1px solid #8f111b;
                padding: 6px 3px;
                background: linear-gradient( 180deg, #b91c2b, #8f111b );
                color: #ffffff;
                font-size: 8px;
                font-weight: 900;
                text-align: center;
                vertical-align: middle;
                line-height: 1.15;
                text-transform: uppercase;
            }

                .items-table th:last-child {
                    border-right: 0;
                }

            .items-table td {
                border-right: 1px solid #d5b1b5;
                border-bottom: 1px solid #dfc5c8;
                padding: 7px 4px;
                font-size: 8.5px;
                color: #222222;
                vertical-align: middle;
                height: 32px;
                overflow-wrap: anywhere;
                background: #ffffff;
            }

                .items-table td:last-child {
                    border-right: 0;
                }

            .items-table tbody tr:nth-child(even):not(.total-row) td {
                background: #fff8f8;
            }

            .items-table tbody tr:hover:not(.total-row) td {
                background: #fff0f1;
            }

            .items-table .center {
                text-align: center;
            }

            .items-table .right {
                text-align: right;
                white-space: nowrap;
            }

        .description {
            font-weight: 700;
            line-height: 1.4;
            text-align: left;
            word-break: break-word;
            color: #421216;
        }

        .total-row td {
            background: linear-gradient( 90deg, #fff0f1, #ffe1e4 ) !important;
            color: var(--red-dark);
            font-weight: 900;
            font-size: 9px;
            border-bottom: 0;
        }


        /* =========================================================
                   EMPTY DETAILS
                ========================================================= */

        .empty-row {
            text-align: center;
            padding: 16px !important;
            color: #888888 !important;
            font-style: italic;
            background: #ffffff !important;
        }


        /* =========================================================
                   SUMMARY
                ========================================================= */

        .summary-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            border-left: 1px solid #a66c73;
            border-right: 1px solid #a66c73;
            border-bottom: 1px solid #a66c73;
        }

        .amount-words {
            min-width: 0;
            padding: 12px;
            border-right: 1px solid #c99aa0;
            background: linear-gradient( 145deg, #ffffff, #fff7f7 );
        }

        .amount-words-title {
            display: inline-block;
            padding-bottom: 4px;
            border-bottom: 2px solid var(--red);
            color: var(--red-dark);
            font-size: 9px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .5px;
            margin-bottom: 9px;
        }

        .amount-words-value {
            color: #251114;
            font-size: 10px;
            font-weight: 800;
            line-height: 1.55;
            word-break: break-word;
        }


        /* =========================================================
                   AMOUNT SUMMARY
                ========================================================= */

        .amount-summary {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .amount-summary td {
                padding: 6px 8px;
                border-bottom: 1px solid #e1c5c8;
                height: 27px;
                word-break: break-word;
            }

                .amount-summary td:first-child {
                    width: 65%;
                    color: #5b3539;
                    font-weight: 700;
                }

                .amount-summary td:last-child {
                    width: 35%;
                    text-align: right;
                    color: #281215;
                    font-weight: 800;
                    white-space: nowrap;
                }

        .grand-total-row td {
            background: linear-gradient( 135deg, #8f111b, #b91c2b ) !important;
            color: #ffffff !important;
            font-size: 12px;
            font-weight: 900 !important;
            border-bottom: 0;
        }

        .round-row td {
            background: #fff8f8;
        }


        /* =========================================================
                   REMARK
                ========================================================= */

        .remark-box {
            border: 1px solid #a66c73;
            border-top: 0;
            padding: 9px 10px;
            min-height: 48px;
            background: #ffffff;
            word-break: break-word;
        }

        .remark-title {
            color: var(--red-dark);
            font-weight: 900;
            margin-bottom: 5px;
        }


        /* =========================================================
                   FOOTER
                ========================================================= */

        .footer-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 140px minmax(0, 1fr);
            min-height: 120px;
            margin-top: 10px;
            border: 1px solid #a66c73;
            border-radius: 4px;
            overflow: hidden;
        }


        /* =========================================================
                   BANK
                ========================================================= */

        .bank-details {
            min-width: 0;
            border-right: 1px solid #c99aa0;
        }

        .footer-title {
            padding: 7px;
            text-align: center;
            background: linear-gradient( 90deg, #fff0f1, #ffe2e5 );
            color: var(--red-dark);
            border-bottom: 1px solid #c99aa0;
            font-weight: 900;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .bank-content {
            padding: 9px;
            line-height: 1.75;
            color: #5d4a4d;
            font-size: 9px;
            word-break: break-word;
        }

            .bank-content strong {
                color: var(--red-dark);
            }

        .not-available {
            color: #9a8588;
            font-style: italic;
        }


        /* =========================================================
                   SEAL
                ========================================================= */

        .seal-area {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            text-align: center;
            border-right: 1px solid #c99aa0;
            background: radial-gradient( circle, #fffafa, #fff0f1 );
        }

        .seal {
            position: relative;
            width: 67px;
            height: 67px;
            border: 2px solid var(--red);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: var(--red-dark);
            font-size: 7px;
            line-height: 1.35;
            font-weight: 900;
            transform: rotate(-12deg);
            box-shadow: inset 0 0 0 2px #ffffff, inset 0 0 0 4px #efb0b6;
        }

            .seal::before {
                content: "";
                position: absolute;
                inset: 5px;
                border: 1px dashed var(--red);
                border-radius: 50%;
            }

        .seal-text {
            margin-top: 5px;
            color: #80545a;
            font-size: 7px;
            font-weight: 800;
        }


        /* =========================================================
                   SIGNATURE
                ========================================================= */

        .signature-area {
            position: relative;
            text-align: center;
            padding-top: 9px;
            min-width: 0;
            background: #ffffff;
        }

        .signature-for {
            color: var(--red-dark);
            font-size: 9px;
            font-weight: 900;
            line-height: 1.4;
            word-break: break-word;
        }

        .signature-space {
            height: 54px;
        }

        .signature-line {
            width: 78%;
            margin: 0 auto 5px;
            border-top: 1px solid #6f5559;
        }

        .authorized {
            color: var(--red-dark);
            font-size: 9px;
            font-weight: 900;
        }


        /* =========================================================
                   BOTTOM NOTE
                ========================================================= */

        .bottom-note {
            text-align: center;
            margin-top: 7px;
            color: #8c7074;
            font-size: 8px;
            font-style: italic;
        }


        /* =========================================================
                   MOBILE
                ========================================================= */

        @@media (max-width: 900px) {

            body {
                background: #ffffff;
            }

            .toolbar {
                width: 100%;
                padding: 10px;
                margin: 0;
