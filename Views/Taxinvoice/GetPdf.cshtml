            }

            .signature-space {
                height: 45px;
            }
        }


        /* =========================================================
                   SMALL MOBILE
                ========================================================= */

        @@media (max-width: 480px) {

            .invoice {
                padding: 7px;
            }

            .company-header {
                grid-template-columns: 85px minmax(0, 1fr);
            }

            .logo-wrapper {
                width: 75px;
                height: 50px;
            }

            .company-logo img {
                width: 72px;
                max-height: 45px;
            }

            .company-name {
                font-size: 12px;
            }

            .company-address {
                font-size: 7px;
            }

            .company-location {
                font-size: 6.5px;
            }

            .company-gstin {
                font-size: 7px;
            }

            .meta-table td {
                font-size: 9px;
                padding: 5px;
            }

            .customer-table td {
                font-size: 8px;
                padding: 5px;
            }

            .transaction-table td {
                font-size: 8px;
                padding: 5px;
            }

            .amount-summary td {
                padding: 6px;
                font-size: 8px;
            }

            .grand-total-row td {
                font-size: 10px;
            }
        }


        /* =========================================================
                   PRINT / A4
                ========================================================= */

        @@media print {

            html,
            body {
                width: 210mm !important;
                height: 297mm !important;
                margin: 0 !important;
                padding: 0 !important;
                background: #ffffff !important;
                overflow: hidden !important;
            }

            body {
                font-size: 9px !important;
            }

            .toolbar {
                display: none !important;
            }

            .page-container {
                width: 210mm !important;
                height: 297mm !important;
                min-height: 297mm !important;
                margin: 0 !important;
                padding: 0 !important;
                background: #ffffff !important;
                box-shadow: none !important;
                border-radius: 0 !important;
                overflow: hidden !important;
            }

            .invoice {
                width: 210mm !important;
                height: 297mm !important;
                min-height: 297mm !important;
                padding: 6mm !important;
                overflow: hidden !important;
            }
            /* HEADER */

            .company-header {
                min-height: 78px !important;
            }

            .company-logo {
                padding: 6px !important;
            }

            .logo-wrapper {
                width: 120px !important;
                height: 60px !important;
            }

            .company-logo img {
                width: 110px !important;
                max-height: 55px !important;
            }

            .company-details {
                padding: 6px 12px !important;
            }

            .company-name {
                font-size: 17px !important;
                margin-bottom: 3px !important;
            }

            .company-address {
                font-size: 8px !important;
                line-height: 1.25 !important;
            }

            .company-location {
                font-size: 7px !important;
            }

            .company-gstin {
                font-size: 8px !important;
                margin-top: 2px !important;
            }
            /* TITLE */

            .invoice-title {
                padding: 6px !important;
                font-size: 14px !important;
            }
            /* META */

            .meta-table td {
                height: 22px !important;
                padding: 4px 7px !important;
                font-size: 8px !important;
            }
            /* CUSTOMER */

            .section-title {
                margin-top: 6px !important;
                padding: 5px !important;
                font-size: 9px !important;
            }

            .customer-table td {
                padding: 5px 7px !important;
                font-size: 8px !important;
                line-height: 1.2 !important;
            }
            /* TRANSACTION */

            .transaction-table td {
                padding: 4px 7px !important;
                font-size: 8px !important;
            }
            /* ITEMS */

            .items-scroll {
                width: 100% !important;
                overflow: visible !important;
                border-bottom: 0 !important;
            }

            .items-table {
                width: 100% !important;
                min-width: 0 !important;
                margin-top: 6px !important;
                table-layout: fixed !important;
                page-break-inside: avoid !important;
                break-inside: avoid !important;
            }

                .items-table th {
                    padding: 4px 2px !important;
                    font-size: 7px !important;
                    line-height: 1.1 !important;
                }

                .items-table td {
                    padding: 4px 3px !important;
                    height: 24px !important;
                    font-size: 7.5px !important;
                    line-height: 1.15 !important;
                }

            .description {
                line-height: 1.15 !important;
            }

            .items-table .right {
                white-space: nowrap !important;
            }

            .total-row td {
                font-size: 8px !important;
                padding: 4px 3px !important;
            }
            /* SUMMARY */

            .summary-grid {
                grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) !important;
                width: 100% !important;
                page-break-inside: avoid !important;
                break-inside: avoid !important;
            }

            .amount-words {
                padding: 8px !important;
            }

            .amount-words-title {
                font-size: 7px !important;
                margin-bottom: 5px !important;
            }

            .amount-words-value {
                font-size: 8px !important;
                line-height: 1.25 !important;
            }

            .amount-summary td {
                height: 21px !important;
                padding: 4px 6px !important;
                font-size: 8px !important;
            }

            .grand-total-row td {
                font-size: 9px !important;
            }
            /* REMARK */

            .remark-box {
                min-height: 35px !important;
                padding: 6px 8px !important;
                font-size: 8px !important;
                page-break-inside: avoid !important;
                break-inside: avoid !important;
            }

            .remark-title {
                margin-bottom: 3px !important;
            }
            /* FOOTER */

            .footer-grid {
                grid-template-columns: minmax(0, 1fr) 110px minmax(0, 1fr) !important;
                min-height: 85px !important;
                height: 85px !important;
                margin-top: 6px !important;
                page-break-inside: avoid !important;
                break-inside: avoid !important;
            }

            .footer-title {
                padding: 5px !important;
                font-size: 8px !important;
            }

            .bank-content {
                padding: 6px !important;
                font-size: 7px !important;
                line-height: 1.45 !important;
            }

            .seal {
                width: 50px !important;
                height: 50px !important;
                font-size: 5.5px !important;
            }

            .seal-text {
                font-size: 6px !important;
                margin-top: 3px !important;
            }

            .signature-area {
                padding-top: 6px !important;
            }

            .signature-for {
                font-size: 7px !important;
            }

            .signature-space {
                height: 32px !important;
            }

            .signature-line {
                width: 70% !important;
                margin-bottom: 3px !important;
            }

            .authorized {
                font-size: 7px !important;
            }
            /* FOOT NOTE */

            .bottom-note {
                margin-top: 4px !important;
                font-size: 6.5px !important;
            }
            /* PREVENT BREAKS */

            .invoice,
            .page-container,
            .items-table,
            .summary-grid,
            .remark-box,
            .footer-grid {
                page-break-before: auto !important;
                page-break-after: auto !important;
            }
        }


        /* =========================================================
                   A4 PAGE SETTINGS
                ========================================================= */

        @@page {
            size: A4 portrait;
            margin: 0;
        }

    </style>

</head>

<body>


    <!-- =========================================================
         TOOLBAR
    ========================================================= -->

    <div class="toolbar">

        <button type="button"
                class="btn-back"
                onclick="history.back()">

            ← Back

        </button>

        <button type="button"
                class="btn-print"
                onclick="window.print()">

            🖨 Print / Save PDF

        </button>

    </div>


    <!-- =========================================================
         A4 PAGE
    ========================================================= -->

    <div class="page-container">

        <div class="invoice">


            <!-- =================================================
                 COMPANY HEADER
            ================================================== -->

            <div class="company-header">

                <div class="company-logo">

                    <div class="logo-wrapper">

                        <img src="@Url.Content("~/assets/images/logo-dark.png")"
                             alt="@companyName"
                             onerror="this.style.display='none';" />

                    </div>

                </div>


                <div class="company-details">

                    <div class="company-name">

                        @companyName

                    </div>


                    <div class="company-address">

                        @companyAddress

                    </div>


                    @if (!string.IsNullOrWhiteSpace(companyLocation))
                    {
                        <div class="company-location">

                            @companyLocation

                            @if (!string.IsNullOrWhiteSpace(companyPinCode))
                            {
                                <text> - @companyPinCode</text>
                            }

                        </div>
                    }


                    <div class="company-gstin">

                        GSTIN :
                        @companyGstin

                        @if (!string.IsNullOrWhiteSpace(stateCode))
                        {
                            <text>
                                &nbsp;&nbsp; | &nbsp;&nbsp;
                                State Code : @stateCode
                            </text>
                        }

                    </div>

                </div>

            </div>


            <!-- =================================================
                 INVOICE TITLE
            ================================================== -->

            <div class="invoice-title">

                TAX INVOICE

            </div>


            <!-- =================================================
                 INVOICE INFORMATION
            ================================================== -->

            <table class="meta-table">

                <tr>

                    <td class="meta-label">
                        Invoice No.
                    </td>

                    <td class="meta-value">
                        @invoiceNo
                    </td>

                </tr>


                <tr>

                    <td class="meta-label">
                        Invoice Date
                    </td>

                    <td class="meta-value">
                        @invoiceDate
                    </td>

                </tr>


                <tr>

                    <td class="meta-label">
                        Invoice Type
                    </td>

                    <td class="meta-value">
                        @invoiceType
                    </td>

                </tr>


                <tr>

                    <td class="meta-label">
                        Reverse Charge (Y/N)
                    </td>

                    <td class="meta-value">
                        @reverseCharge
                    </td>

                </tr>


                <tr>

                    <td class="meta-label">
                        State
                    </td>

                    <td class="meta-value">

                        @state

                        @if (!string.IsNullOrWhiteSpace(stateCode))
                        {
                            <text>
                                &nbsp;&nbsp; (Code: @stateCode)
                            </text>
                        }

                    </td>

                </tr>

            </table>


            <!-- =================================================
                 BILL TO PARTY
            ================================================== -->

            <div class="section-title">

                Bill To Party

            </div>


            <table class="customer-table">

                <tr>

                    <td class="customer-label">
                        Company Name
                    </td>

                    <td class="customer-value">
                        @customerName
                    </td>

                </tr>


                <tr>

                    <td class="customer-label">
                        Address
                    </td>

                    <td class="customer-value">
                        @customerAddress
                    </td>

                </tr>


                <tr>

                    <td class="customer-label">
                        Location
                    </td>

                    <td class="customer-value">
                        @customerLocation
                    </td>

                </tr>


                <tr>

                    <td class="customer-label">
                        GSTIN
                    </td>

                    <td class="customer-value">
                        @customerGstin
                    </td>

                </tr>


                <tr>

                    <td class="customer-label">
                        Pincode
                    </td>

                    <td class="customer-value">
                        @customerPinCode
                    </td>

                </tr>


                <tr>

                    <td class="customer-label">
                        State / State Code
                    </td>

                    <td class="customer-value">

                        @customerState

                    </td>

                </tr>

            </table>


            <!-- =================================================
                 TRANSACTION DETAILS
            ================================================== -->
            @if (!string.IsNullOrWhiteSpace(transMode)
                        || !string.IsNullOrWhiteSpace(transNo)
                        || !string.IsNullOrWhiteSpace(transDate)
                        || !string.IsNullOrWhiteSpace(transAmount))
            {

                <div class="section-title">

                    Transaction Details

                </div>


                <table class="transaction-table">

                    <tr>

                        <td class="transaction-label">
                            Transport Mode
                        </td>

                        <td class="transaction-value">
                            @transMode
                        </td>

                        <td class="transaction-label">
                            Transaction No.
                        </td>

                        <td class="transaction-value">
                            @transNo
                        </td>

                    </tr>


                    <tr>

                        <td class="transaction-label">
                            Transaction Date
                        </td>

                        <td class="transaction-value">
                            @transDate
                        </td>

                        <td class="transaction-label">
                            Transaction Amount
                        </td>

                        <td class="transaction-value">
                            @transAmount
                        </td>

                    </tr>

                </table>

            }


            <!-- =================================================
                 ITEMS
            ================================================== -->

            <div class="items-scroll">

                <table class="items-table">

                    <colgroup>

                        <col style="width:5%;" />
                        <col style="width:19%;" />
                        <col style="width:8%;" />
                        <col style="width:5%;" />
                        <col style="width:8%;" />
                        <col style="width:9%;" />
                        <col style="width:10%;" />
                        <col style="width:6%;" />
                        <col style="width:9%;" />
                        <col style="width:6%;" />
                        <col style="width:9%;" />
                        <col style="width:10%;" />

                    </colgroup>


                    <thead>

                        <tr>

                            <th rowspan="2">
                                Sr.<br />No.
                            </th>

                            <th rowspan="2">
                                Description
                            </th>

                            <th rowspan="2">
                                SAC<br />Code
                            </th>

                            <th rowspan="2">
                                Qty
                            </th>

                            <th rowspan="2">
                                Rate
                            </th>

                            <th rowspan="2">
                                Amount
                            </th>

                            <th rowspan="2">
                                Taxable<br />Value
                            </th>

                            <th colspan="2">
                                CGST
                            </th>

                            <th colspan="2">
                                SGST
                            </th>

                            <th rowspan="2">
                                Total
                            </th>

                        </tr>


                        <tr>

                            <th>
                                Rate
                            </th>

                            <th>
                                Amount
                            </th>

                            <th>
                                Rate
                            </th>

                            <th>
                                Amount
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            var srNo = 1;
                        }


                        @if (Model.details != null && Model.details.Count > 0)
                        {

                            foreach (var item in Model.details)
                            {

                                <tr>

                                    <td class="center">
                                        @srNo
                                    </td>


                                    <td class="description">
                                        @item.productdescription
                                    </td>


                                    <td class="center">
                                        @item.saccode
                                    </td>


                                    <td class="center">

                                        @(item.qty.HasValue
                                                                        ? item.qty.Value.ToString("0.##")
                                                                        : "0")

                            </td>


                                    <td class="right">

                                        ₹@(item.rate.HasValue
                                                                ? item.rate.Value.ToString("N2")
                                                                : "0.00")

                            </td>


                                    <td class="right">

                                        ₹@(item.amount.HasValue
                                                                ? item.amount.Value.ToString("N2")
                                                                : "0.00")

                            </td>


                                    <td class="right">

                                        ₹@(item.taxablevalue.HasValue
                                                                ? item.taxablevalue.Value.ToString("N2")
                                                                : "0.00")

                            </td>


                            <td class="center">

                                @(item.cgstrate.HasValue
                                                                ? item.cgstrate.Value.ToString("0.##")
                                                                : "0")%

                            </td>


                            <td class="right">

                                ₹@(item.cgstamt.HasValue
                                                                ? item.cgstamt.Value.ToString("N2")
                                                                : "0.00")

                            </td>


                            <td class="center">

                                @(item.sgstrate.HasValue
                                                                ? item.sgstrate.Value.ToString("0.##")
                                                                : "0")%

                            </td>


                            <td class="right">

                                ₹@(item.sgstamt.HasValue
                                                                ? item.sgstamt.Value.ToString("N2")
                                                                : "0.00")

                            </td>


                            <td class="right">

                                ₹@(item.total.HasValue
                                                                ? item.total.Value.ToString("N2")
                                                                : "0.00")

                            </td>

                                                </tr>


                                                srNo++;
                            }

                        }
                        else
                        {

                            <tr>

                                <td colspan="12"
                                    class="empty-row">

                                    No invoice details available.

                                </td>

                            </tr>

                        }


                        <!-- =================================================
                             TOTAL
                        ================================================== -->

                        <tr class="total-row">

                            <td colspan="3"
                                class="right">

                                Total

                            </td>


                            <td class="center">

                                @totalQuantity.ToString("0.##")

                            </td>


                            <td class="right">

                                ₹@totalRate.ToString("N2")

                            </td>


                            <td class="right">

                                ₹@totalAmountBeforeTax.ToString("N2")

                            </td>


                            <td class="right">

                                ₹@totalTaxableValue.ToString("N2")

                            </td>


                            <td class="center">

                                @(cgstRate.ToString("0.##"))%

                            </td>


                            <td class="right">

                                ₹@cgstAmount.ToString("N2")

                            </td>


                            <td class="center">

                                @(sgstRate.ToString("0.##"))%

                            </td>


                            <td class="right">

                                ₹@sgstAmount.ToString("N2")

                            </td>


                            <td class="right">

                                ₹@grandTotal.ToString("N2")

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>


            <!-- =================================================
                 SUMMARY
            ================================================== -->

            <div class="summary-grid">


                <!-- AMOUNT IN WORDS -->

                <div class="amount-words">

                    <div class="amount-words-title">

                        Total Invoice Amount in Words

                    </div>


                    <div class="amount-words-value">

                        @amountInWords

                    </div>

                </div>


                <!-- AMOUNT SUMMARY -->

                <div>

                    <table class="amount-summary">


                        <tr>

                            <td>
                                Total Amount Before Tax
                            </td>

                            <td>
                                ₹@totalAmountBeforeTax.ToString("N2")
                            </td>

                        </tr>


                        @if (cgstAmount > 0)
                        {

                            <tr>

                                <td>
                                    Add: CGST (@cgstRate.ToString("0.##")%)
                                </td>

                                <td>
                                    ₹@cgstAmount.ToString("N2")
                                </td>

                            </tr>

                        }


                        @if (sgstAmount > 0)
                        {

                            <tr>

                                <td>
                                    Add: SGST (@sgstRate.ToString("0.##")%)
                                </td>

                                <td>
                                    ₹@sgstAmount.ToString("N2")
                                </td>

                            </tr>

                        }


                        @if (igstAmount > 0)
                        {

                            <tr>

                                <td>
                                    Add: IGST (@igstRate.ToString("0.##")%)
                                </td>

                                <td>
                                    ₹@igstAmount.ToString("N2")
                                </td>

                            </tr>

                        }


                        <tr>

                            <td>
                                Total Tax Amount
                            </td>

                            <td>
                                ₹@totalTaxAmount.ToString("N2")
                            </td>

                        </tr>


                        <tr class="grand-total-row">

                            <td>
                                Total Amount After Tax
                            </td>

                            <td>
                                ₹@totalAmountAfterTax.ToString("N2")
                            </td>

                        </tr>


                        <tr class="round-row">

                            <td>
                                Round Off
                            </td>

                            <td>
                                ₹0.00
                            </td>

                        </tr>


                    </table>

                </div>

            </div>


            <!-- =================================================
                 GST / E-INVOICE STATUS
            ================================================== -->
            @if (!string.IsNullOrWhiteSpace(main.AckNo)
                        || main.AckDt.HasValue
                        || !string.IsNullOrWhiteSpace(main.Irn)
                        || !string.IsNullOrWhiteSpace(main.Status)
                        || !string.IsNullOrWhiteSpace(main.e_invoice_status))
            {

                <div class="section-title">

                    E-Invoice Details

                </div>


                <table class="customer-table">

                    @if (!string.IsNullOrWhiteSpace(main.AckNo))
                    {

                        <tr>

                            <td class="customer-label">
                                Acknowledgement No.
                            </td>

                            <td class="customer-value">
                                @main.AckNo
                            </td>

                        </tr>

                    }


                    @if (main.AckDt.HasValue)
                    {

                        <tr>

                            <td class="customer-label">
                                Acknowledgement Date
                            </td>

                            <td class="customer-value">
                                @main.AckDt.Value.ToString("dd/MM/yyyy HH:mm")
                            </td>

                        </tr>

                    }


                    @if (!string.IsNullOrWhiteSpace(main.Irn))
                    {

                        <tr>

                            <td class="customer-label">
                                IRN
                            </td>

                            <td class="customer-value">
                                @main.Irn
                            </td>

                        </tr>

                    }


                    @if (!string.IsNullOrWhiteSpace(main.Status))
                    {

                        <tr>

                            <td class="customer-label">
                                Status
                            </td>

                            <td class="customer-value">
                                @main.Status
                            </td>

                        </tr>

                    }


                    @if (!string.IsNullOrWhiteSpace(main.e_invoice_status))
                    {

                        <tr>

                            <td class="customer-label">
                                E-Invoice Status
                            </td>

                            <td class="customer-value">
                                @main.e_invoice_status
                            </td>

                        </tr>

                    }

                </table>

            }


            <!-- =================================================
                 REMARK
            ================================================== -->

            <div class="remark-box">

                <div class="remark-title">
                    Remark :
                </div>

                <div>
                    @remark
                </div>

            </div>


            <!-- =================================================
                 FOOTER
            ================================================== -->

            <div class="footer-grid">


                <!-- BANK DETAILS -->

                <div class="bank-details">

                    <div class="footer-title">
                        Bank Details
                    </div>


                    <div class="bank-content">

                        <div class="not-available">
                            Bank details not available in the current DTO.
                        </div>

                    </div>

                </div>


                <!-- SEAL -->

                <div class="seal-area">

                    <div class="seal">

                        WEB LINK<br />
                        SERVICES<br />
                        PVT. LTD.

                    </div>


                    <div class="seal-text">
                        Common Seal
                    </div>

                </div>


                <!-- SIGNATURE -->

                <div class="signature-area">

                    <div class="signature-for">

                        For,<br />

                        @companyName

                    </div>


                    <div class="signature-space">
                    </div>


                    <div class="signature-line">
                    </div>


                    <div class="authorized">

                        Authorized Signatory

                    </div>

                </div>

            </div>


            <!-- =================================================
                 FOOT NOTE
            ================================================== -->

            <div class="bottom-note">

                This is a computer generated tax invoice.

            </div>

        </div>

    </div>


</body>

</html>
