@model WLSPL_ERP_CRM.Models.Taxinvoice.TaxInvoiceCreateVM

@{
    Layout = null;

    // =========================================================
    // MAIN DTO - DO NOT CHANGE
    // =========================================================

    var main = Model.main ?? new WLSPL_ERP_CRM.Models.Taxinvoice.TaxInvoiceCreate();

    // =========================================================
    // INVOICE DETAILS
    // =========================================================

    var invoiceNo = main.invoiceno ?? "";

    var invoiceDate = main.invoicedate.HasValue
        ? main.invoicedate.Value.ToString("dd/MM/yyyy")
        : "";

    var reverseCharge = main.reversecharge ?? "";
    var invoiceType = main.InvoiceType ?? "";
    var state = main.state ?? "";
    var stateCode = main.statecode ?? "";

    // =========================================================
    // COMPANY DETAILS
    // =========================================================

    var companyName = "Web Link Services Pvt. Ltd.";

    var companyAddress =
        "12th Floor, Vintage 21 Commercial Complex, Above Max Showroom, P.K. Chowk, Pimple Saudagar, Pune, Maharashtra";

    var companyMobile = "8421060192";
    var companyEmail = "info@weblinkservices.net";
    var companyGstin = "27AABCW8929J2ZP";

    // =========================================================
    // CUSTOMER DETAILS
    // =========================================================

    var customerName = main.companyName ?? "";

    var customerAddress =
        main.BillingAddress
        ?? main.Address
        ?? "";

    var customerLocation =
        main.BillingLocation
        ?? main.Location
        ?? "";

    var customerGstin =
        main.BillingGST
        ?? main.gstIn
        ?? "";

    var customerPinCode =
        main.BillingPincode
        ?? main.PinCode
        ?? "";

    var customerState =
        main.BillingStatecode
        ?? main.state
        ?? "";

    // =========================================================
    // TRANSACTION DETAILS
    // =========================================================

    var transMode = main.TransMode ?? "";
    var transNo = main.TransNo ?? "";

    var transDate = main.TransDate.HasValue
        ? main.TransDate.Value.ToString("dd/MM/yyyy")
        : "";

    var transAmount = main.TransAmt ?? "";

    // =========================================================
    // GST DETAILS
    // =========================================================

    var cgstRate = main.cgst ?? 0;
    var cgstAmount = main.cgstamt ?? 0;

    var sgstRate = main.sgst ?? 0;
    var sgstAmount = main.sgstamt ?? 0;

    var igstRate = main.igst ?? 0;
    var igstAmount = main.igstamt ?? 0;

    var reverseChargeGst = main.gstonreversecharge ?? "";

    // =========================================================
    // TOTALS
    // =========================================================

    var totalQuantity = main.totalqty ?? 0;
    var totalRate = main.totalrate ?? 0;
    var totalTaxableValue = main.taxablevalue ?? 0;

    var totalAmountBeforeTax = main.totalamtbeforetax ?? 0;
    var totalAmountAfterTax = main.totalamtaftertax ?? 0;

    decimal totalTaxAmount = 0;

    if (decimal.TryParse(main.total_tax_amount, out var parsedTax))
    {
        totalTaxAmount = parsedTax;
    }
    else
    {
        totalTaxAmount = cgstAmount + sgstAmount + igstAmount;
    }

    var grandTotal = main.totalamtaftertax ?? 0;

    var amountInWords = main.amtinwords ?? "";

    // =========================================================
    // REMARK
    // =========================================================

    var remark =
        main.Remarks
        ?? main.Remarkss
        ?? "Thank you for your business.";

    // =========================================================
    // E-INVOICE
    // =========================================================

    var hasEInvoice =
        !string.IsNullOrWhiteSpace(main.AckNo)
        || main.AckDt.HasValue
        || !string.IsNullOrWhiteSpace(main.Irn)
        || !string.IsNullOrWhiteSpace(main.Status)
        || !string.IsNullOrWhiteSpace(main.e_invoice_status);

    // =========================================================
    // TRANSACTION
    // =========================================================

    var hasTransaction =
        !string.IsNullOrWhiteSpace(transMode)
        || !string.IsNullOrWhiteSpace(transNo)
        || !string.IsNullOrWhiteSpace(transDate)
        || !string.IsNullOrWhiteSpace(transAmount);
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Tax Invoice - @invoiceNo</title>

    <style>

        /* =========================================================
                                           GLOBAL
                                        ========================================================= */

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        :root {
            --red: #ed1b2f;
            --red-dark: #c81025;
            --red-light: #fff1f3;
            --black: #4b5563;
            --dark: #374151;
            --dark-2: #6b7280;
            --text: #24272c;
            --muted: #727780;
            --border: #e5e7eb;
            --border-dark: #cfd3d8;
            --light: #f7f7f8;
            --white: #ffffff;
            --green: #198754;
        }

        html,
        body {
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #e9eaec;
            color: var(--text);
            font-size: 9px;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }


        /* =========================================================
                                           TOOLBAR
                                        ========================================================= */

        .toolbar {
            width: 210mm;
            margin: 18px auto;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }

            .toolbar button {
                border: 0;
                padding: 10px 18px;
                border-radius: 6px;
                font-size: 12px;
                font-weight: 700;
                cursor: pointer;
                transition: all .2s ease;
            }

        .btn-back {
            background: #6b7280;
            color: white;
        }

            .btn-back:hover {
                background: #4b5563;
            }

        .btn-print {
            background: var(--red);
            color: white;
            box-shadow: 0 3px 10px rgba(237,27,47,.25);
        }

            .btn-print:hover {
                background: var(--red-dark);
            }


        /* =========================================================
                                           PAGE
                                        ========================================================= */

        .page {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto 25px;
            background: white;
            box-shadow: 0 10px 35px rgba(0,0,0,.16);
        }

        .invoice {
            width: 100%;
            min-height: 297mm;
            padding: 7mm;
            background: white;
            position: relative;
            overflow: visible;
            display: flex;
            flex-direction: column;
        }


        /* =========================================================
                                           TOP DECORATION
                                        ========================================================= */

        .top-decoration {
            height: 7px;
            width: 100%;
            background: var(--red);
            position: relative;
            flex-shrink: 0;
        }

            .top-decoration::after {
                content: "";
                position: absolute;
                right: 0;
                top: 0;
                width: 34%;
                height: 7px;
                background: var(--black);
            }


        /* =========================================================
                                           HEADER
                                        ========================================================= */

        .header {
            display: grid;
            grid-template-columns: 48% 52%;
            min-height: 105px;
            border-left: 1px solid var(--border);
            border-right: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            background: #fff;
            flex-shrink: 0;
        }

        .header-left {
            background: var(--black);
            color: white;
            padding: 18px 20px;
            position: relative;
            overflow: hidden;
        }

            .header-left::after {
                content: "";
                position: absolute;
                width: 150px;
                height: 150px;
                right: -80px;
                top: -90px;
                border-radius: 50%;
                background: var(--red);
                opacity: .9;
            }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            position: relative;
            z-index: 2;
        }

        .logo {
            width: 55px;
            height: 55px;
            background: white;
            border-radius: 8px;
            padding: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .logo img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }

        .brand-text {
            min-width: 0;
        }

        .company-name {
            color: white;
            font-size: 17px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .5px;
            line-height: 1.15;
        }

        .company-tagline {
            margin-top: 5px;
            color: #e5e7eb;
            font-size: 7px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .header-right {
            padding: 16px 20px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-end;
            text-align: right;
        }

        .invoice-word {
            font-size: 25px;
            font-weight: 900;
            color: var(--black);
            letter-spacing: 1.5px;
        }

            .invoice-word span {
                color: var(--red);
            }

        .company-address {
            max-width: 420px;
            margin-top: 7px;
            color: var(--muted);
            line-height: 1.45;
            font-size: 7.5px;
        }

        .company-contact {
            margin-top: 5px;
            color: #555b64;
            font-size: 7.5px;
        }

        .company-gstin {
            margin-top: 6px;
            color: var(--red-dark);
            font-weight: 800;
            font-size: 8px;
        }


        /* =========================================================
                                           INVOICE META
                                        ========================================================= */

        .invoice-meta {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            border-left: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

        .meta-box {
            padding: 8px 10px;
            border-right: 1px solid var(--border);
            min-height: 42px;
        }

            .meta-box:nth-child(even) {
                background: #f9fafb;
            }

        .meta-label {
            font-size: 6.5px;
            color: var(--muted);
            text-transform: uppercase;
            font-weight: 800;
            letter-spacing: .5px;
            margin-bottom: 4px;
        }

        .meta-value {
            font-size: 8.5px;
            color: var(--black);
            font-weight: 800;
        }

            .meta-value.red {
                color: var(--red);
            }


        /* =========================================================
                                           SECTION
                                        ========================================================= */

        .section {
            margin-top: 8px;
            flex-shrink: 0;
        }

        .section-heading {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 0;
            padding: 6px 9px;
            background: var(--red);
            color: white;
            font-size: 7.5px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .8px;
        }

            .section-heading::before {
                content: "";
                width: 4px;
                height: 12px;
                background: white;
                border-radius: 2px;
            }


        /* =========================================================
                                           BILL TO
                                        ========================================================= */

        .party-table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid var(--border);
        }

            .party-table td {
                border: 1px solid var(--border);
                padding: 6px 8px;
                vertical-align: top;
                line-height: 1.35;
            }

        .party-label {
            width: 15%;
            background: #f7f7f8;
            color: var(--muted);
            font-size: 6.5px;
            text-transform: uppercase;
            font-weight: 800;
        }

        .party-value {
            width: 35%;
            color: #34383f;
            font-size: 7.5px;
            font-weight: 600;
        }

        .customer-name {
            color: var(--black);
            font-size: 9px;
            font-weight: 900;
        }

        .gst-highlight {
            color: var(--red);
            font-weight: 800;
        }


        /* =========================================================
                                           TRANSACTION
                                        ========================================================= */

        .transaction-table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid var(--border);
        }

            .transaction-table td {
                border: 1px solid var(--border);
                padding: 6px 8px;
            }

        .transaction-label {
            width: 18%;
            background: #f7f7f8;
            color: var(--muted);
            font-size: 6.5px;
            text-transform: uppercase;
            font-weight: 800;
        }

        .transaction-value {
            width: 32%;
            font-size: 7.5px;
            font-weight: 700;
            color: #34383f;
        }


        /* =========================================================
                                           ITEMS
                                        ========================================================= */

        .items-wrapper {
            margin-top: 8px;
            width: 100%;
            flex-shrink: 0;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            border: 1px solid var(--dark);
        }

            .items-table th {
                padding: 5px 2px;
                font-size: 6px;
                line-height: 1.1;
                text-align: center;
                vertical-align: middle;
                font-weight: 900;
                color: white;
                background: var(--black);
                border: 1px solid #6b7280;
            }

            .items-table thead tr:nth-child(2) th {
                background: var(--dark-2);
                color: #fff;
                font-size: 5.8px;
            }

            .items-table td {
                padding: 5px 3px;
                border: 1px solid var(--border);
                font-size: 6.5px;
                line-height: 1.2;
                vertical-align: middle;
                color: #30343a;
            }

            .items-table tbody tr:nth-child(even) td {
                background: #fafafa;
            }

            .items-table tbody tr:hover td {
                background: #fff5f6;
            }

        .center {
            text-align: center;
        }

        .right {
            text-align: right;
            white-space: nowrap;
        }

        .description {
            text-align: left;
            font-weight: 700;
        }

        .amount {
            font-weight: 700;
        }

        .total-row td {
            background: var(--red) !important;
            color: white !important;
            border-color: var(--red-dark);
            font-weight: 900;
        }


        /* =========================================================
                                           SUMMARY
                                        ========================================================= */

        .summary {
            margin-top: 8px;
            display: grid;
            grid-template-columns: 58% 42%;
            border: 1px solid var(--border);
            flex-shrink: 0;
        }

        .amount-words {
            padding: 11px;
            background: #fafafa;
            border-right: 1px solid var(--border);
            min-height: 125px;
        }

        .small-title {
            color: var(--red);
            font-size: 6.5px;
            text-transform: uppercase;
            letter-spacing: .7px;
            font-weight: 900;
            margin-bottom: 7px;
        }

        .amount-words-value {
            font-size: 8px;
            font-weight: 700;
            color: #30343a;
            line-height: 1.5;
        }

        .summary-table {
            width: 100%;
            border-collapse: collapse;
        }

            .summary-table td {
                padding: 5px 8px;
                height: 22px;
                border-bottom: 1px solid var(--border);
                font-size: 7px;
            }

                .summary-table td:first-child {
                    color: var(--muted);
                    font-weight: 700;
                }

                .summary-table td:last-child {
                    text-align: right;
                    font-weight: 800;
                    white-space: nowrap;
                }

            .summary-table .total-tax td {
                color: var(--red-dark);
                font-weight: 900;
            }

            .summary-table .grand-total td {
                background: var(--red);
                color: white !important;
                font-size: 9px;
                font-weight: 900;
                padding: 8px;
                border-color: var(--red);
            }


        /* =========================================================
                                           TAX SUMMARY
                                        ========================================================= */

        .tax-box {
            margin-top: 8px;
            border: 1px solid var(--border);
            flex-shrink: 0;
        }

        .tax-heading {
            background: var(--black);
            color: white;
            padding: 6px 9px;
            font-size: 7px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .7px;
        }

        .tax-table {
            width: 100%;
            border-collapse: collapse;
        }

            .tax-table th,
            .tax-table td {
                border: 1px solid var(--border);
                padding: 5px 5px;
                font-size: 6.5px;
                text-align: right;
            }

            .tax-table th {
                background: #f4f4f5;
                color: var(--muted);
                text-align: center;
                font-weight: 900;
            }

            .tax-table td {
                color: #34383f;
                font-weight: 700;
            }


        /* =========================================================
                                           E-INVOICE
                                        ========================================================= */

        .einvoice-table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid var(--border);
        }

            .einvoice-table td {
                border: 1px solid var(--border);
                padding: 5px 7px;
                font-size: 6.5px;
                word-break: break-word;
            }

        .einvoice-label {
            width: 25%;
            background: #f7f7f8;
            color: var(--muted);
            font-weight: 800;
        }

        .einvoice-value {
            width: 75%;
            color: var(--black);
            font-weight: 700;
        }

        .status-badge {
            display: inline-block;
            background: #e9f8ef;
            color: var(--green);
            border-radius: 12px;
            padding: 3px 8px;
            font-size: 6px;
            font-weight: 900;
        }


        /* =========================================================
                                           REMARK
                                        ========================================================= */

        .remark {
            margin-top: 8px;
            border: 1px solid var(--border);
            flex-shrink: 0;
        }

        .remark-heading {
            background: #f7f7f8;
            color: var(--red);
            padding: 5px 8px;
            font-size: 7px;
            font-weight: 900;
            text-transform: uppercase;
            border-bottom: 1px solid var(--border);
        }

        .remark-text {
            padding: 7px 8px;
            min-height: 35px;
            font-size: 7px;
            color: #4b5057;
            line-height: 1.45;
        }


        /* =========================================================
                                           FOOTER
                                        ========================================================= */

        .footer {
            margin-top: 8px;
            display: grid;
            grid-template-columns: 55% 45%;
            border: 1px solid var(--border);
            flex-shrink: 0;
        }

        .bank-section {
            border-right: 1px solid var(--border);
        }

        .footer-heading {
            background: var(--black);
            color: white;
            padding: 6px 8px;
            font-size: 7px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .6px;
        }

        .bank-content {
            padding: 8px;
            min-height: 75px;
            color: #555b64;
            font-size: 6.5px;
            line-height: 1.65;
        }

            .bank-content strong {
                color: var(--black);
            }

        .signature-section {
            text-align: right;
        }

        .signature-content {
            min-height: 75px;
            padding: 8px;
            position: relative;
        }

        .signature-company {
            color: var(--red);
            font-size: 7.5px;
            font-weight: 900;
        }

        .signature-space {
            height: 35px;
        }

        .signature-line {
            width: 130px;
            margin-left: auto;
            border-top: 1px solid #777;
        }

        .authorized {
            margin-top: 4px;
            color: #555b64;
            font-size: 6.5px;
            font-weight: 800;
        }


        /* =========================================================
                                           BOTTOM
                                        ========================================================= */

        .bottom-area {
            margin-top: 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            flex-shrink: 0;
        }

        .thank-you {
            color: var(--red);
            font-size: 8px;
            font-weight: 900;
        }

        .computer-note {
            color: #92969c;
            font-size: 5.8px;
            text-align: right;
        }


        /* =========================================================
                                           REMAINING A4 BLANK SPACE

                                           This automatically fills the unused area below
                                           the invoice content.
                                        ========================================================= */

        .remaining-space {
            flex: 1;
            width: 100%;
            min-height: 10px;
            background: #ffffff;
        }


        /* =========================================================
                                           DECORATIVE CORNER
                                        ========================================================= */

        .bottom-decoration {
            position: absolute;
            right: -45px;
            bottom: -50px;
            width: 150px;
            height: 100px;
            background: #e5e7e9;
            border-radius: 70% 0 0 0;
            pointer-events: none;
        }

            .bottom-decoration::before {
                content: "";
                position: absolute;
                width: 100px;
                height: 70px;
                right: 30px;
                bottom: 30px;
                background: var(--red);
                border-radius: 70% 0 0 0;
                opacity: .15;
            }


        /* =========================================================
                                           MOBILE
                                        ========================================================= */

        @@media (max-width: 900px) {

            body {
                background: white;
            }

            .toolbar {
                width: 100%;
                margin: 0;
                padding: 10px;
                position: sticky;
                top: 0;
                z-index: 100;
                background: white;
                box-shadow: 0 2px 10px rgba(0,0,0,.1);
            }

            .page {
                width: 100%;
                margin: 0;
                box-shadow: none;
            }

            .invoice {
                padding: 8px;
                min-height: auto;
                display: block;
            }

            .header {
                grid-template-columns: 1fr;
            }

            .header-left {
                min-height: 85px;
            }

            .header-right {
                align-items: flex-start;
                text-align: left;
            }

            .invoice-meta {
                grid-template-columns: 1fr 1fr;
            }

            .summary {
                grid-template-columns: 1fr;
            }

            .amount-words {
                border-right: none;
                border-bottom: 1px solid var(--border);
            }

            .footer {
                grid-template-columns: 1fr;
            }

            .bank-section {
                border-right: none;
                border-bottom: 1px solid var(--border);
            }

            .signature-section {
                text-align: center;
            }

            .signature-line {
                margin: 0 auto;
            }

            .items-wrapper {
                overflow-x: auto;
            }

            .items-table {
                min-width: 900px;
            }

            .remaining-space {
                display: none;
            }

            .bottom-decoration {
                display: none;
            }
        }


        /* =========================================================
                                           PRINT - A4 FULL PAGE
                                        ========================================================= */

        @@media print {

            @@page {
                size: A4 portrait;
                /*
                                                   Small printer margin.
                                                   Browser print dialog should also use:
                                                   Paper = A4
                                                   Scale = 100%
                                                */
                margin: 5mm;
            }

            html,
            body {
                width: 100% !important;
                min-height: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
                background: white !important;
            }

            body {
                font-size: 9px !important;
            }

            .toolbar {
                display: none !important;
            }

            .page {
                width: 100% !important;
                min-height: 287mm !important;
                height: auto !important;
                margin: 0 !important;
                padding: 0 !important;
                box-shadow: none !important;
                background: white !important;
                overflow: visible !important;
            }

            .invoice {
                width: 100% !important;
                min-height: 287mm !important;
                height: auto !important;
                padding: 5mm !important;
                overflow: visible !important;
                display: flex !important;
                flex-direction: column !important;
                background: white !important;
            }
            /* =====================================================
                                               TOP LINE
                                            ===================================================== */

            .top-decoration {
                height: 6px !important;
            }

                .top-decoration::after {
                    height: 6px !important;
                }
            /* =====================================================
                                               HEADER
                                            ===================================================== */

            .header {
                min-height: 100px !important;
                grid-template-columns: 48% 52% !important;
            }

            .header-left {
                padding: 15px 18px !important;
            }

            .logo {
                width: 52px !important;
                height: 52px !important;
            }

            .brand {
                gap: 10px !important;
            }

            .company-name {
                font-size: 16px !important;
                line-height: 1.15 !important;
            }

            .company-tagline {
                font-size: 7px !important;
                margin-top: 5px !important;
            }

            .header-right {
                padding: 13px 18px !important;
            }

            .invoice-word {
                font-size: 24px !important;
            }

            .company-address {
                font-size: 7px !important;
                line-height: 1.4 !important;
                margin-top: 5px !important;
            }

            .company-contact {
                font-size: 7px !important;
                margin-top: 4px !important;
            }

            .company-gstin {
                font-size: 8px !important;
                margin-top: 5px !important;
            }
            /* =====================================================
                                               META
                                            ===================================================== */

            .meta-box {
                padding: 8px 10px !important;
                min-height: 43px !important;
            }

            .meta-label {
                font-size: 6px !important;
                margin-bottom: 4px !important;
            }

            .meta-value {
                font-size: 8px !important;
            }
            /* =====================================================
                                               SECTION
                                            ===================================================== */

            .section {
                margin-top: 7px !important;
            }

            .section-heading {
                padding: 6px 9px !important;
                font-size: 7px !important;
            }

                .section-heading::before {
                    width: 4px !important;
                    height: 12px !important;
                }
            /* =====================================================
                                               PARTY
                                            ===================================================== */

            .party-table td {
                padding: 6px 8px !important;
                font-size: 7.5px !important;
                line-height: 1.35 !important;
            }

            .party-label {
                font-size: 6.5px !important;
            }

            .party-value {
                font-size: 7.5px !important;
            }

            .customer-name {
                font-size: 9px !important;
            }
            /* =====================================================
                                               TRANSACTION
                                            ===================================================== */

            .transaction-table td {
                padding: 6px 8px !important;
                font-size: 7.5px !important;
            }

            .transaction-label {
                font-size: 6.5px !important;
            }

            .transaction-value {
                font-size: 7.5px !important;
            }
            /* =====================================================
                                               ITEMS
                                            ===================================================== */

            .items-wrapper {
                margin-top: 7px !important;
                overflow: visible !important;
            }

            .items-table {
                width: 100% !important;
                min-width: 0 !important;
                table-layout: fixed !important;
            }

                .items-table th {
                    padding: 5px 2px !important;
                    font-size: 6px !important;
                    line-height: 1.1 !important;
                }

                .items-table thead tr:nth-child(2) th {
                    font-size: 5.8px !important;
                }

                .items-table td {
                    padding: 5px 3px !important;
                    font-size: 6.5px !important;
                    line-height: 1.2 !important;
                    height: 25px !important;
                }
            /* =====================================================
                                               SUMMARY
                                            ===================================================== */

            .summary {
                margin-top: 7px !important;
                grid-template-columns: 58% 42% !important;
            }

            .amount-words {
                min-height: 115px !important;
                padding: 10px !important;
            }

            .small-title {
                font-size: 6px !important;
                margin-bottom: 6px !important;
            }

            .amount-words-value {
                font-size: 7.5px !important;
                line-height: 1.45 !important;
            }

            .summary-table td {
                padding: 5px 8px !important;
                height: 23px !important;
                font-size: 6.8px !important;
            }

            .summary-table .grand-total td {
                font-size: 8px !important;
                padding: 7px !important;
            }
            /* =====================================================
                                               TAX
                                            ===================================================== */

            .tax-box {
                margin-top: 7px !important;
            }

            .tax-heading {
                padding: 6px 8px !important;
                font-size: 6.5px !important;
            }

            .tax-table th,
            .tax-table td {
                padding: 5px !important;
                font-size: 6.5px !important;
            }
            /* =====================================================
                                               E-INVOICE
                                            ===================================================== */

            .einvoice-table td {
                padding: 5px 7px !important;
                font-size: 6.5px !important;
            }
            /* =====================================================
                                               REMARK
                                            ===================================================== */

            .remark {
                margin-top: 7px !important;
            }

            .remark-heading {
                padding: 5px 8px !important;
                font-size: 6.5px !important;
            }

            .remark-text {
                min-height: 32px !important;
                padding: 6px 8px !important;
                font-size: 6.8px !important;
                line-height: 1.4 !important;
            }
            /* =====================================================
                                               FOOTER
                                            ===================================================== */

            .footer {
                margin-top: 7px !important;
                grid-template-columns: 55% 45% !important;
            }

            .footer-heading {
                padding: 6px 8px !important;
                font-size: 6.5px !important;
            }

            .bank-content {
                min-height: 72px !important;
                padding: 7px !important;
                font-size: 6.5px !important;
                line-height: 1.55 !important;
            }

            .signature-content {
                min-height: 72px !important;
                padding: 7px !important;
            }

            .signature-company {
                font-size: 7px !important;
            }

            .signature-space {
                height: 34px !important;
            }

            .signature-line {
                width: 120px !important;
            }

            .authorized {
                margin-top: 4px !important;
                font-size: 6px !important;
            }
            /* =====================================================
                                               BOTTOM
                                            ===================================================== */

            .bottom-area {
                margin-top: 7px !important;
                flex-shrink: 0 !important;
            }

            .thank-you {
                font-size: 7.5px !important;
            }

            .computer-note {
                font-size: 5.5px !important;
            }
            /* =====================================================
                                               BLANK SPACE BELOW BOTTOM AREA

                                               This uses the remaining A4 height.
                                            ===================================================== */

            .remaining-space {
                display: block !important;
                flex: 1 !important;
                width: 100% !important;
                min-height: 10mm !important;
                background: white !important;
            }
            /* =====================================================
                                               KEEP CONTENT TOGETHER
                                            ===================================================== */

            .top-decoration,
            .header,
            .invoice-meta,
            .section,
            .items-wrapper,
            .summary,
            .tax-box,
            .remark,
            .footer,
            .bottom-area {
                break-inside: avoid !important;
                page-break-inside: avoid !important;
            }
            /* =====================================================
                                               DECORATION
                                            ===================================================== */

            .bottom-decoration {
                display: block !important;
                pointer-events: none !important;
            }
        }

    </style>

</head>


<body>


    <!-- =========================================================
         TOOLBAR
    ========================================================== -->

    <div class="toolbar">

        <button type="button"
                class="btn-back"
                onclick="history.back()">

            &#8592; Back

        </button>


        <button type="button"
                class="btn-print"
                onclick="window.print()">
            &#128424;  Print / Save PDF
        </button>

    </div>


    <!-- =========================================================
         PAGE
    ========================================================== -->

    <div class="page">

        <div class="invoice">


            <!-- =================================================
                 TOP RED / GREY LINE
            ================================================== -->

            <div class="top-decoration"></div>


            <!-- =================================================
                 HEADER
            ================================================== -->

            <div class="header">

                <div class="header-left">

                    <div class="brand">

                        <div class="logo">

                            <img src="@Url.Content("~/assets/images/logo-dark.png")"
                                 alt="Web Link Services Pvt. Ltd."
                                 onerror="this.style.display='none';" />

                        </div>


                        <div class="brand-text">

                            <div class="company-name">

                                Web Link Services Pvt. Ltd.

                            </div>


                            <div class="company-tagline">

                                Technology • Digital • Business Solutions

                            </div>

                        </div>

                    </div>

                </div>


                <div class="header-right">

                    <div class="invoice-word">

                        IN<span>VOICE</span>

                    </div>


                    <div class="company-address">

                        @companyAddress

                    </div>


                    <div class="company-contact">

                        Mobile: @companyMobile

                        &nbsp; | &nbsp;

                        @companyEmail

                    </div>


                    <div class="company-gstin">

                        GSTIN: @companyGstin

                    </div>

                </div>

            </div>


            <!-- =================================================
                 INVOICE META
            ================================================== -->

            <div class="invoice-meta">

                <div class="meta-box">

                    <div class="meta-label">
                        Invoice Number
                    </div>

                    <div class="meta-value red">
                        @invoiceNo
                    </div>

                </div>


                <div class="meta-box">

                    <div class="meta-label">
                        Invoice Date
                    </div>

                    <div class="meta-value">
                        @invoiceDate
                    </div>

                </div>


                <div class="meta-box">

                    <div class="meta-label">
                        Invoice Type
                    </div>

                    <div class="meta-value">
                        @invoiceType
                    </div>

                </div>


                <div class="meta-box">

                    <div class="meta-label">
                        Reverse Charge
                    </div>

                    <div class="meta-value">
                        @reverseCharge
                    </div>

                </div>

            </div>


            <!-- =================================================
                 BILL TO
            ================================================== -->

            <div class="section">

                <div class="section-heading">
                    Bill To Party
                </div>


                <table class="party-table">

                    <tr>

                        <td class="party-label">
                            Company Name
                        </td>

                        <td class="party-value">

                            <span class="customer-name">
                                @customerName
                            </span>

                        </td>

                        <td class="party-label">
                            GSTIN
                        </td>

                        <td class="party-value">

                            <span class="gst-highlight">
                                @customerGstin
                            </span>

                        </td>

                    </tr>


                    <tr>

                        <td class="party-label">
                            Address
                        </td>

                        <td class="party-value">
                            @customerAddress
                        </td>

                        <td class="party-label">
                            Location
                        </td>

                        <td class="party-value">
                            @customerLocation
                        </td>

                    </tr>


                    <tr>

                        <td class="party-label">
                            Pincode
                        </td>

                        <td class="party-value">
                            @customerPinCode
                        </td>

                        <td class="party-label">
                            State / Code
                        </td>

                        <td class="party-value">

                            @state

                            @if (!string.IsNullOrWhiteSpace(stateCode))
                            {
                                <text>
                                    (@stateCode)
                                </text>
                            }

                        </td>

                    </tr>

                </table>

            </div>


            <!-- =================================================
                 TRANSACTION
            ================================================== -->
            @if (hasTransaction)
            {

                <div class="section">

                    <div class="section-heading">
                        Transaction Details
                    </div>


                    <table class="transaction-table">

                        <tr>

                            <td class="transaction-label">
                                Transport Mode
                            </td>

                            <td class="transaction-value">
                                @transMode
                            </td>

                            <td class="transaction-label">
                                Transaction No.
                            </td>

                            <td class="transaction-value">
                                @transNo
                            </td>

                        </tr>


                        <tr>

                            <td class="transaction-label">
                                Transaction Date
                            </td>

                            <td class="transaction-value">
                                @transDate
                            </td>

                            <td class="transaction-label">
                                Transaction Amount
                            </td>

                            <td class="transaction-value">
                                @transAmount
                            </td>

                        </tr>

                    </table>

                </div>

            }


            <!-- =================================================
                 ITEMS
            ================================================== -->

            <div class="items-wrapper">

                <table class="items-table">

                    <colgroup>

                        <col style="width:4%;" />
                        <col style="width:20%;" />
                        <col style="width:7%;" />
                        <col style="width:5%;" />
                        <col style="width:8%;" />
                        <col style="width:10%;" />
                        <col style="width:5%;" />
                        <col style="width:8%;" />
                        <col style="width:5%;" />
                        <col style="width:8%;" />
                        <col style="width:5%;" />
                        <col style="width:8%;" />
                        <col style="width:7%;" />

                    </colgroup>


                    <thead>

                        <tr>

                            <th rowspan="2">
                                Sr.<br />No.
                            </th>

                            <th rowspan="2">
                                Description
                            </th>

                            <th rowspan="2">
                                SAC<br />Code
                            </th>

                            <th rowspan="2">
                                Qty
                            </th>

                            <th rowspan="2">
                                Rate
                            </th>

                            <th rowspan="2">
                                Taxable<br />Value
                            </th>

                            <th colspan="2">
                                CGST
                            </th>

                            <th colspan="2">
                                SGST
                            </th>

                            <th colspan="2">
                                IGST
                            </th>

                            <th rowspan="2">
                                Total
                            </th>

                        </tr>


                        <tr>

                            <th>%</th>
                            <th>Amount</th>

                            <th>%</th>
                            <th>Amount</th>

                            <th>%</th>
                            <th>Amount</th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            var srNo = 1;
                        }


                        @if (Model.details != null && Model.details.Count > 0)
                        {

                            foreach (var item in Model.details)
                            {

                                <tr>

                                    <td class="center">
                                        @srNo
                                    </td>


                                    <td class="description">
                                        @item.productdescription
                                    </td>


                                    <td class="center">
                                        @item.saccode
                                    </td>


                                    <td class="center">

                                        @(item.qty.HasValue
                                                                        ? item.qty.Value.ToString("0.##")
                                                                        : "0")

                            </td>


                                    <td class="right">

                                        ₹@(item.rate.HasValue
                                                                ? item.rate.Value.ToString("N2")
                                                                : "0.00")

                            </td>


                                    <td class="right amount">

                                        ₹@(item.taxablevalue.HasValue
                                                                ? item.taxablevalue.Value.ToString("N2")
                                                                : "0.00")

                            </td>


                            <td class="center">

                                @(item.cgstrate.HasValue
                                                                ? item.cgstrate.Value.ToString("0.##")
                                                                : "0")%

                            </td>


                            <td class="right">

                                ₹@(item.cgstamt.HasValue
                                                                ? item.cgstamt.Value.ToString("N2")
                                                                : "0.00")

                            </td>


                            <td class="center">

                                @(item.sgstrate.HasValue
                                                                ? item.sgstrate.Value.ToString("0.##")
                                                                : "0")%

                            </td>


                            <td class="right">

                                ₹@(item.sgstamt.HasValue
                                                                ? item.sgstamt.Value.ToString("N2")
                                                                : "0.00")

                            </td>


                            <td class="center">

                                @(item.igstrate.HasValue
                                                                ? item.igstrate.Value.ToString("0.##")
                                                                : "0")%

                            </td>


                            <td class="right">

                                ₹@(item.igstamt.HasValue
                                                                ? item.igstamt.Value.ToString("N2")
                                                                : "0.00")

                            </td>


                            <td class="right amount">

                                ₹@(item.total.HasValue
                                                                ? item.total.Value.ToString("N2")
                                                                : "0.00")

                            </td>

                                                </tr>

                                                srNo++;
                            }

                        }
                        else
                        {

                            <tr>

                                <td colspan="13"
                                    style="text-align:center;padding:12px;color:#777;">

                                    No invoice details available.

                                </td>

                            </tr>

                        }


                        <!-- TOTAL -->

                        <tr class="total-row">

                            <td colspan="3"
                                class="right">

                                TOTAL

                            </td>


                            <td class="center">

                                @totalQuantity.ToString("0.##")

                            </td>


                            <td class="right">

                                ₹@totalRate.ToString("N2")

                            </td>


                            <td class="right">

                                ₹@totalTaxableValue.ToString("N2")

                            </td>


                            <td class="center">

                                @cgstRate.ToString("0.##")%

                            </td>


                            <td class="right">

                                ₹@cgstAmount.ToString("N2")

                            </td>


                            <td class="center">

                                @sgstRate.ToString("0.##")%

                            </td>


                            <td class="right">

                                ₹@sgstAmount.ToString("N2")

                            </td>


                            <td class="center">

                                @igstRate.ToString("0.##")%

                            </td>


                            <td class="right">

                                ₹@igstAmount.ToString("N2")

                            </td>


                            <td class="right">

                                ₹@grandTotal.ToString("N2")

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>


            <!-- =================================================
                 SUMMARY
            ================================================== -->

            <div class="summary">

                <div class="amount-words">

                    <div class="small-title">
                        Total Invoice Amount in Words
                    </div>

                    <div class="amount-words-value">
                        @amountInWords
                    </div>

                </div>


                <div>

                    <table class="summary-table">

                        <tr>

                            <td>
                                Total Amount Before Tax
                            </td>

                            <td>
                                ₹@totalAmountBeforeTax.ToString("N2")
                            </td>

                        </tr>


                        @if (cgstAmount > 0)
                        {

                            <tr>

                                <td>
                                    Add: CGST (@cgstRate.ToString("0.##")%)
                                </td>

                                <td>
                                    ₹@cgstAmount.ToString("N2")
                                </td>

                            </tr>

                        }


                        @if (sgstAmount > 0)
                        {

                            <tr>

                                <td>
                                    Add: SGST (@sgstRate.ToString("0.##")%)
                                </td>

                                <td>
                                    ₹@sgstAmount.ToString("N2")
                                </td>

                            </tr>

                        }


                        @if (igstAmount > 0)
                        {

                            <tr>

                                <td>
                                    Add: IGST (@igstRate.ToString("0.##")%)
                                </td>

                                <td>
                                    ₹@igstAmount.ToString("N2")
                                </td>

                            </tr>

                        }


                        <tr class="total-tax">

                            <td>
                                Total Tax Amount
                            </td>

                            <td>
                                ₹@totalTaxAmount.ToString("N2")
                            </td>

                        </tr>


                        <tr class="grand-total">

                            <td>
                                TOTAL AMOUNT AFTER TAX
                            </td>

                            <td>
                                ₹@totalAmountAfterTax.ToString("N2")
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Round Off
                            </td>

                            <td>
                                ₹0.00
                            </td>

                        </tr>

                    </table>

                </div>

            </div>


            <!-- =================================================
                 TAX SUMMARY
            ================================================== -->

            <div class="tax-box">

                <div class="tax-heading">
                    Tax Summary
                </div>


                <table class="tax-table">

                    <thead>

                        <tr>

                            <th>Taxable Value</th>

                            <th>CGST Rate</th>
                            <th>CGST Amount</th>

                            <th>SGST Rate</th>
                            <th>SGST Amount</th>

                            <th>IGST Rate</th>
                            <th>IGST Amount</th>

                            <th>Total Tax</th>

                        </tr>

                    </thead>


                    <tbody>

                        <tr>

                            <td>
                                ₹@totalTaxableValue.ToString("N2")
                            </td>

                            <td>
                                @cgstRate.ToString("0.##")%
                            </td>

                            <td>
                                ₹@cgstAmount.ToString("N2")
                            </td>

                            <td>
                                @sgstRate.ToString("0.##")%
                            </td>

                            <td>
                                ₹@sgstAmount.ToString("N2")
                            </td>

                            <td>
                                @igstRate.ToString("0.##")%
                            </td>

                            <td>
                                ₹@igstAmount.ToString("N2")
                            </td>

                            <td>
                                ₹@totalTaxAmount.ToString("N2")
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>


            <!-- =================================================
                 E-INVOICE
            ================================================== -->
            @if (hasEInvoice)
            {

                <div class="section">

                    <div class="section-heading">
                        E-Invoice Details
                    </div>


                    <table class="einvoice-table">

                        @if (!string.IsNullOrWhiteSpace(main.AckNo))
                        {

                            <tr>

                                <td class="einvoice-label">
                                    Acknowledgement No.
                                </td>

                                <td class="einvoice-value">
                                    @main.AckNo
                                </td>

                            </tr>

                        }


                        @if (main.AckDt.HasValue)
                        {

                            <tr>

                                <td class="einvoice-label">
                                    Acknowledgement Date
                                </td>

                                <td class="einvoice-value">

                                    @main.AckDt.Value.ToString("dd/MM/yyyy HH:mm")

                                </td>

                            </tr>

                        }


                        @if (!string.IsNullOrWhiteSpace(main.Irn))
                        {

                            <tr>

                                <td class="einvoice-label">
                                    IRN
                                </td>

                                <td class="einvoice-value">
                                    @main.Irn
                                </td>

                            </tr>

                        }


                        @if (!string.IsNullOrWhiteSpace(main.Status))
                        {

                            <tr>

                                <td class="einvoice-label">
                                    Status
                                </td>

                                <td class="einvoice-value">

                                    <span class="status-badge">
                                        @main.Status
                                    </span>

                                </td>

                            </tr>

                        }


                        @if (!string.IsNullOrWhiteSpace(main.e_invoice_status))
                        {

                            <tr>

                                <td class="einvoice-label">
                                    E-Invoice Status
                                </td>

                                <td class="einvoice-value">

                                    <span class="status-badge">
                                        @main.e_invoice_status
                                    </span>

                                </td>

                            </tr>

                        }

                    </table>

                </div>

            }


            <!-- =================================================
                 REMARK
            ================================================== -->

            <div class="remark">

                <div class="remark-heading">
                    Remark
                </div>

                <div class="remark-text">
                    @remark
                </div>

            </div>


            <!-- =================================================
                 FOOTER
            ================================================== -->

            <div class="footer">

                <div class="bank-section">

                    <div class="footer-heading">
                        Bank Details
                    </div>


                    <div class="bank-content">

                        <div>
                            <strong>Account Name:</strong>
                            Web Link Services Pvt. Ltd.
                        </div>

                        <div>
                            <strong>Bank A/C:</strong>
                            916020085136854
                        </div>

                        <div>
                            <strong>Bank IFSC:</strong>
                            UTIB0001641
                        </div>

                        <div>
                            <strong>Bank:</strong>
                            Axis Bank Ltd - Rahatani Branch, Pune
                        </div>

                    </div>

                </div>


                <div class="signature-section">

                    <div class="footer-heading">
                        Authorized Signatory
                    </div>


                    <div class="signature-content">

                        <div class="signature-company">

                            For, @companyName

                        </div>


                        <div class="signature-space"></div>


                        <div class="signature-line"></div>


                        <div class="authorized">

                            Authorized Signatory

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 BOTTOM
            ================================================== -->

            <div class="bottom-area">

                <div class="thank-you">

                    Thank you for doing business with us.

