            }
            /* TITLE */

            .invoice-title {
                padding: 7px;
                font-size: 14px;
            }
            /* META */

            .meta-table td {
                padding: 6px;
                height: auto;
                font-size: 10px;
            }
            /* CUSTOMER */

            .section-title {
                margin-top: 7px;
                padding: 6px;
                font-size: 10px;
            }

            .customer-table td {
                padding: 6px;
                font-size: 9px;
                line-height: 1.3;
            }
            /* TRANSACTION */

            .transaction-table td {
