@model WLSPL_ERP_CRM.Models.Taxinvoice.TaxInvoiceCreateVM

@{
    Layout = null;

    // =========================================================
    // MAIN INVOICE DTO — DO NOT CHANGE DTO
    // =========================================================

    var main = Model.main ?? new WLSPL_ERP_CRM.Models.Taxinvoice.TaxInvoiceCreate();

    // =========================================================
    // INVOICE DETAILS
    // =========================================================

    var invoiceNo = main.invoiceno ?? "";

    var invoiceDate = main.invoicedate.HasValue
        ? main.invoicedate.Value.ToString("dd/MM/yyyy")
        : "";

    var reverseCharge = main.reversecharge ?? "";
    var invoiceType = main.InvoiceType ?? "";
    var state = main.state ?? "";
    var stateCode = main.statecode ?? "";

    // =========================================================
    // COMPANY / SELLER DETAILS
    // =========================================================

    var companyName = main.companyName ?? "";
    var companyGstin = main.gstIn ?? "";
    var companyAddress = main.Address ?? "";
    var companyLocation = main.Location ?? "";
    var companyPinCode = main.PinCode ?? "";

    // =========================================================
    // CUSTOMER / BILLING DETAILS
    // =========================================================

    var customerName = main.companyName ?? "";

    var customerAddress =
        main.BillingAddress
        ?? main.Address
        ?? "";

    var customerLocation =
        main.BillingLocation
        ?? main.Location
        ?? "";

    var customerGstin =
        main.BillingGST
        ?? main.gstIn
        ?? "";

    var customerPinCode =
        main.BillingPincode
        ?? main.PinCode
        ?? "";

    var customerState =
        main.BillingStatecode
        ?? main.state
        ?? "";

    // =========================================================
    // TRANSACTION DETAILS
    // =========================================================

    var transMode = main.TransMode ?? "";
    var transNo = main.TransNo ?? "";

    var transDate = main.TransDate.HasValue
        ? main.TransDate.Value.ToString("dd/MM/yyyy")
        : "";

    var transAmount = main.TransAmt ?? "";

    // =========================================================
    // GST DETAILS
    // =========================================================

    var cgstRate = main.cgst ?? 0;
    var cgstAmount = main.cgstamt ?? 0;

    var sgstRate = main.sgst ?? 0;
    var sgstAmount = main.sgstamt ?? 0;

    var igstRate = main.igst ?? 0;
    var igstAmount = main.igstamt ?? 0;

    var reverseChargeGst = main.gstonreversecharge ?? "";

    // =========================================================
    // TOTALS
    // =========================================================

    var totalQuantity = main.totalqty ?? 0;
    var totalRate = main.totalrate ?? 0;
    var totalTaxableValue = main.taxablevalue ?? 0;

    var totalAmountBeforeTax = main.totalamtbeforetax ?? 0;
    var totalAmountAfterTax = main.totalamtaftertax ?? 0;

    decimal totalTaxAmount = 0;

    if (decimal.TryParse(main.total_tax_amount, out var parsedTax))
    {
        totalTaxAmount = parsedTax;
    }
    else
    {
        totalTaxAmount = cgstAmount + sgstAmount + igstAmount;
    }

    var grandTotal = main.totalamtaftertax ?? 0;

    var amountInWords = main.amtinwords ?? "";

    // =========================================================
    // REMARK
    // =========================================================

    var remark =
        main.Remarks
        ?? main.Remarkss
        ?? "Thank you for your business.";

    // =========================================================
    // DETAILS COUNT
    // =========================================================

    var detailsCount =
        Model.details == null
            ? 0
            : Model.details.Count;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Tax Invoice - @invoiceNo
    </title>

    <style>

        /* =========================================================
                   RESET
                ========================================================= */

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #eef2f7;
            color: #172033;
            font-size: 11px;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }


        /* =========================================================
                   TOOLBAR
                ========================================================= */

        .toolbar {
            width: 210mm;
            margin: 15px auto 10px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 8px;
        }

            .toolbar button {
                border: 0;
                border-radius: 7px;
                padding: 9px 16px;
                color: #ffffff;
                font-size: 12px;
                font-weight: 700;
                cursor: pointer;
                transition: all .2s ease;
            }

        .btn-back {
            background: #475569;
        }

            .btn-back:hover {
                background: #334155;
            }

        .btn-print {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            box-shadow: 0 4px 10px rgba(37, 99, 235, .25);
        }

            .btn-print:hover {
                background: linear-gradient(135deg, #1d4ed8, #1e40af);
                transform: translateY(-1px);
            }


        /* =========================================================
                   A4 PAGE
                ========================================================= */

        .page-container {
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto 25px;
            background: #ffffff;
            box-shadow: 0 12px 35px rgba(15, 23, 42, .14);
            border-radius: 5px;
            overflow: hidden;
        }

        .invoice {
            width: 100%;
            min-height: 297mm;
            padding: 9mm;
            background: #ffffff;
        }


        /* =========================================================
                   COMPANY HEADER
                ========================================================= */

        .company-header {
            display: grid;
            grid-template-columns: 155px minmax(0, 1fr);
            min-height: 92px;
            border: 1px solid #172033;
            background: #ffffff;
        }

        .company-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 10px;
            border-right: 1px solid #172033;
            background: linear-gradient(145deg, #ffffff, #f8fafc);
        }

        .logo-wrapper {
            width: 135px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .company-logo img {
            display: block;
            width: 125px;
            max-width: 100%;
            height: auto;
            max-height: 65px;
            object-fit: contain;
        }

        .company-logo-placeholder {
            width: 125px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #64748b;
            font-size: 8px;
            font-weight: 700;
            border: 1px dashed #cbd5e1;
        }

        .company-details {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 8px 20px;
            min-width: 0;
        }

        .company-name {
            font-size: 20px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: .2px;
            margin-bottom: 5px;
        }

        .company-address {
            max-width: 720px;
            font-size: 10px;
            line-height: 1.45;
            color: #475569;
            word-break: break-word;
        }

        .company-location {
            margin-top: 3px;
            font-size: 9px;
            color: #475569;
        }

        .company-gstin {
            margin-top: 5px;
            font-size: 10px;
            font-weight: 800;
            color: #1d4ed8;
        }


        /* =========================================================
                   INVOICE TITLE
                ========================================================= */

        .invoice-title {
            position: relative;
            text-align: center;
            padding: 9px;
            background: linear-gradient( 90deg, #1d4ed8, #2563eb, #1d4ed8 );
            color: #ffffff;
            font-size: 17px;
            font-weight: 800;
            letter-spacing: 1.2px;
            border-left: 1px solid #172033;
            border-right: 1px solid #172033;
            border-bottom: 1px solid #172033;
        }

            .invoice-title::before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                width: 5px;
                height: 100%;
                background: #f59e0b;
            }


        /* =========================================================
                   META TABLE
                ========================================================= */

        .meta-table {
            width: 100%;
            border-collapse: collapse;
        }

            .meta-table td {
                border: 1px solid #334155;
                padding: 6px 8px;
                height: 28px;
            }

        .meta-label {
            width: 50%;
            background: #f1f5f9;
            color: #334155;
            font-weight: 700;
        }

        .meta-value {
            font-weight: 700;
            color: #0f172a;
        }


        /* =========================================================
                   SECTION TITLE
                ========================================================= */

        .section-title {
            margin-top: 10px;
            padding: 7px;
            text-align: center;
            color: #ffffff;
            background: linear-gradient( 90deg, #0f3f8f, #2563eb );
            border: 1px solid #172033;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .5px;
            text-transform: uppercase;
        }


        /* =========================================================
                   CUSTOMER
                ========================================================= */

        .customer-table {
            width: 100%;
            border-collapse: collapse;
        }

            .customer-table td {
                border: 1px solid #334155;
                padding: 7px 8px;
                vertical-align: middle;
                line-height: 1.4;
            }

        .customer-label {
            width: 32%;
            background: #f8fafc;
            color: #334155;
            font-weight: 700;
        }

        .customer-value {
            width: 68%;
            color: #0f172a;
            font-weight: 600;
            word-break: break-word;
        }


        /* =========================================================
                   TRANSACTION
                ========================================================= */

        .transaction-table {
            width: 100%;
            border-collapse: collapse;
        }

            .transaction-table td {
                border: 1px solid #334155;
                padding: 6px 8px;
            }

        .transaction-label {
            background: #f8fafc;
            color: #334155;
            font-weight: 700;
        }

        .transaction-value {
            color: #0f172a;
            font-weight: 600;
        }


        /* =========================================================
                   ITEMS
                ========================================================= */

        .items-scroll {
            width: 100%;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            table-layout: fixed;
        }

            .items-table th {
                border: 1px solid #1e293b;
                padding: 6px 3px;
                background: linear-gradient( 180deg, #dbeafe, #bfdbfe );
                color: #0f172a;
                font-size: 8.5px;
                font-weight: 800;
                text-align: center;
                vertical-align: middle;
                line-height: 1.15;
            }

            .items-table td {
                border: 1px solid #64748b;
                padding: 7px 4px;
                font-size: 9px;
                color: #172033;
                vertical-align: middle;
                height: 32px;
                overflow-wrap: anywhere;
            }

            .items-table tbody tr:nth-child(even):not(.total-row) td {
                background: #f8fafc;
            }

            .items-table tbody tr:hover:not(.total-row) td {
                background: #eff6ff;
            }

            .items-table .center {
                text-align: center;
            }

            .items-table .right {
                text-align: right;
                white-space: nowrap;
            }

        .description {
            font-weight: 600;
            line-height: 1.4;
            text-align: left;
            word-break: break-word;
        }

        .total-row td {
            background: linear-gradient( 90deg, #eff6ff, #dbeafe );
            color: #0f172a;
            font-weight: 800;
            font-size: 9.5px;
        }


        /* =========================================================
                   EMPTY DETAILS
                ========================================================= */

        .empty-row {
            text-align: center;
            padding: 15px !important;
            color: #64748b !important;
            font-style: italic;
            background: #ffffff !important;
        }


        /* =========================================================
                   SUMMARY
                ========================================================= */

        .summary-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            border-left: 1px solid #334155;
            border-right: 1px solid #334155;
            border-bottom: 1px solid #334155;
        }

        .amount-words {
            min-width: 0;
            padding: 12px;
            border-right: 1px solid #334155;
            background: linear-gradient( 145deg, #ffffff, #f8fafc );
        }

        .amount-words-title {
            color: #64748b;
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .4px;
            margin-bottom: 9px;
        }

        .amount-words-value {
            color: #0f172a;
            font-size: 11px;
            font-weight: 800;
            line-height: 1.55;
            word-break: break-word;
        }


        /* =========================================================
                   AMOUNT SUMMARY
                ========================================================= */

        .amount-summary {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .amount-summary td {
                padding: 6px 8px;
                border-bottom: 1px solid #cbd5e1;
                height: 27px;
                word-break: break-word;
            }

                .amount-summary td:first-child {
                    width: 65%;
                    color: #475569;
                    font-weight: 700;
                }

                .amount-summary td:last-child {
                    width: 35%;
                    text-align: right;
                    color: #0f172a;
                    font-weight: 700;
                    white-space: nowrap;
                }

        .grand-total-row td {
            background: linear-gradient( 90deg, #1d4ed8, #2563eb );
            color: #ffffff !important;
            font-size: 12px;
            font-weight: 800 !important;
        }

        .round-row td {
            background: #f8fafc;
        }


        /* =========================================================
                   REMARK
                ========================================================= */

        .remark-box {
            border: 1px solid #334155;
            border-top: 0;
            padding: 9px 10px;
            min-height: 48px;
            background: #ffffff;
            word-break: break-word;
        }

        .remark-title {
            color: #1d4ed8;
            font-weight: 800;
            margin-bottom: 5px;
        }


        /* =========================================================
                   FOOTER
                ========================================================= */

        .footer-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 140px minmax(0, 1fr);
            min-height: 120px;
            margin-top: 10px;
            border: 1px solid #334155;
        }


        /* =========================================================
                   BANK DETAILS
                ========================================================= */

        .bank-details {
            min-width: 0;
            border-right: 1px solid #334155;
        }

        .footer-title {
            padding: 7px;
            text-align: center;
            background: linear-gradient( 90deg, #dbeafe, #bfdbfe );
            color: #0f172a;
            border-bottom: 1px solid #334155;
            font-weight: 800;
            font-size: 10px;
            text-transform: uppercase;
        }

        .bank-content {
            padding: 9px;
            line-height: 1.75;
            color: #475569;
            font-size: 9px;
            word-break: break-word;
        }

            .bank-content strong {
                color: #0f172a;
            }

        .not-available {
            color: #94a3b8;
            font-style: italic;
        }


        /* =========================================================
                   SEAL
                ========================================================= */

        .seal-area {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            text-align: center;
            border-right: 1px solid #334155;
        }

        .seal {
            width: 64px;
            height: 64px;
            border: 2px solid #2563eb;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #2563eb;
            font-size: 7px;
            line-height: 1.35;
            font-weight: 800;
            transform: rotate(-12deg);
            box-shadow: inset 0 0 0 2px #dbeafe;
        }

        .seal-text {
            margin-top: 5px;
            color: #64748b;
            font-size: 7px;
            font-weight: 700;
        }


        /* =========================================================
                   SIGNATURE
                ========================================================= */

        .signature-area {
            position: relative;
            text-align: center;
            padding-top: 9px;
            min-width: 0;
        }

        .signature-for {
            color: #0f172a;
            font-size: 9px;
            font-weight: 800;
            line-height: 1.4;
            word-break: break-word;
        }

        .signature-space {
            height: 54px;
        }

        .signature-line {
            width: 78%;
            margin: 0 auto 5px;
            border-top: 1px solid #64748b;
        }

        .authorized {
            color: #334155;
            font-size: 9px;
            font-weight: 800;
        }


        /* =========================================================
                   BOTTOM NOTE
                ========================================================= */

        .bottom-note {
            text-align: center;
            margin-top: 7px;
            color: #64748b;
            font-size: 8px;
            font-style: italic;
        }


        /* =========================================================
                   MOBILE
                ========================================================= */

        @@media (max-width: 900px) {

            body {
                background: #ffffff;
            }

            .toolbar {
                width: 100%;
                padding: 10px;
                margin: 0;
                position: sticky;
                top: 0;
                z-index: 100;
                background: #ffffff;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
            }

                .toolbar button {
                    padding: 9px 13px;
                    font-size: 11px;
                }

            .page-container {
                width: 100%;
                min-height: auto;
                margin: 0;
                border-radius: 0;
                box-shadow: none;
            }

            .invoice {
                width: 100%;
