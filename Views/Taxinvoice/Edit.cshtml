            $('#transNo').val() || null,

        TransDate:
            $('#transDate').val() || null,

        TransAmt:
            $('#TransAmt').val() || null,


        // =====================================================
        // GST RATE / PERCENTAGE
        // =====================================================
    cgst: parseFloat($('.cgst-rate').first().val()) || 0,
    sgst: parseFloat($('.sgst-rate').first().val()) || 0,
    igst: parseFloat($('.igst-rate').first().val()) || 0,





        // =====================================================
        // GST AMOUNT
        // =====================================================

        cgstamt:
            parseFloat(
                $('#summaryCGST').val()
            ) || 0,

        sgstamt:
            parseFloat(
                $('#summarySGST').val()
            ) || 0,

        igstamt:
            parseFloat(
                $('#summaryIGST').val()
            ) || 0,


        // =====================================================
        // TOTALS
