        totalqty:
            parseFloat(
                $('#totalQty').val()
            ) || 0,

        totalrate:
            parseFloat(
                $('#summaryBeforeTax').val()
            ) || 0,

        taxablevalue:
            parseFloat(
                $('#summaryBeforeTax').val()
            ) || 0,

        totalamtbeforetax:
            parseFloat(
                $('#summaryBeforeTax').val()
            ) || 0,

        totalamtaftertax:
