@model WLSPL_ERP_CRM.Models.Taxinvoice.TaxInvoiceCreateVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isEdit = Model?.main != null;

    var companyList = Model?.companies
        ?? new List<WLSPL_ERP_CRM.Models.Taxinvoice.TaxInvoiceCreate>();

    var invoiceDetails = Model?.details
        ?? new List<WLSPL_ERP_CRM.Models.Taxinvoice.InvoiceDetails>();
}

<style type="text/css">
    .required::after {
        content: " *";
        color: red;
    }

    /* ── All form inputs / selects / textareas — light grey like screenshot ── */
    .form-control {
        border: 1px solid gray !important;
    }

        .form-control,
        .form-control:focus {
            background-color: #f4f5f6 !important;
            border: 1px solid #ced4da;
            color: #444;
            border-radius: 3px;
        }

            .form-control[readonly],
            .form-control:disabled {
                background-color: #e8eaeb !important;
                color: #6c757d;
                cursor: default;
            }

    /* Select2 match */
    .select2-container .select2-selection--single {
        background-color: #f4f5f6 !important;
        border: 1px solid #343434 !important;
        border-radius: 3px !important;
        height: 38px !important;
    }

        .select2-container .select2-selection--single .select2-selection__rendered {
            line-height: 36px !important;
            color: #444 !important;
        }

        .select2-container .select2-selection--single .select2-selection__arrow {
            height: 36px !important;
        }

    /* ── Consistent card-body row spacing ── */
    .card-body .row.form-row-item {
        margin-bottom: 16px;
    }

        .card-body .row.form-row-item:last-child {
            margin-bottom: 0;
        }

    /* ── Table ── */
    .invoice-table {
        width: 100%;
        height: 170px;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .invoice-table th,
        .invoice-table td {
            border: 1px solid #dee2e6;
            padding: 4px 6px;
            vertical-align: middle;
            text-align: center;
        }

        .invoice-table th {
            background: linear-gradient(314deg, #0b0f14, #1a3e66);
            color: #fff;
            font-size: 11px;
            font-weight: 600;
            white-space: normal;
        }

        .invoice-table td input,
        .invoice-table td select,
        .invoice-table td textarea {
            width: 100%;
            font-size: 11px;
            border: 1px solid gray;
            border-radius: 3px;
            padding: 2px 4px;
            background: #f4f5f6;
            color: #444;
        }

            .invoice-table td input[readonly],
            .invoice-table td input:disabled {
                background: #e8eaeb !important;
                color: #6c757d;
                cursor: default;
            }

        .invoice-table td textarea {
            min-height: 60px;
            resize: vertical;
        }

    /* column widths */
    .col-sn {
        width: 35px;
    }

    .col-qty {
        width: 100px;
    }

    .col-rate {
        width: 90px;
    }

    .col-taxable {
        width: 90px;
    }

    .col-tax {
        width: 110px;
    }

    .col-total {
        width: 95px;
    }

    .col-action {
        width: 36px;
    }

    .tax-pair {
        display: grid;
        grid-template-columns: 44px 1fr;
        gap: 3px;
    }

    .tfoot-row td {
        background: #f1f3f5;
        font-weight: 600;
    }

    /* ── Summary grid ── */
    .summary-grid {
        display: grid;
        grid-template-columns: 60% 40%;
    }

    .summary-right .summary-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #dee2e6;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 600;
    }

        .summary-right .summary-row input {
            width: 130px;
            text-align: right;
            border: 1px solid #ced4da;
            border-radius: 3px;
            background: #e8eaeb !important;
            color: #444;
            font-size: 11px;
            padding: 2px 6px;
            height: 28px;
        }

    .words-box {
        padding: 12px;
        min-height: 90px;
    }

        .words-box textarea {
            width: 100%;
            min-height: 55px;
            border: 1px solid #ced4da;
            border-radius: 3px;
            font-size: 11px;
            padding: 4px 6px;
            resize: vertical;
            background: #f4f5f6;
            color: #444;
        }

    /* ── Bank / Signature ── */
    .bottom-grid {
        display: grid;
        grid-template-columns: 60% 40%;
    }

    .bank-info p {
        margin: 0;
        font-size: 12px;
        padding: 6px 14px;
        border-bottom: 1px solid #343434;
    }

    .signature-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .seal-box,
    .sig-box {
        min-height: 120px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        font-size: 11px;
    }

    .seal {
        width: 72px;
        height: 72px;
        border: 2px solid #7186a2;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        color: #7186a2;
        transform: rotate(-15deg);
        text-align: center;
        font-size: 9px;
    }

    .seal-inner {
        width: 52px;
        height: 52px;
        border: 1px solid #7186a2;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* ── Validation ── */
    .field-error {
        border-color: #dc3545 !important;
        background-color: #fff5f5 !important;
        box-shadow: 0 0 0 0.15rem rgba(220,53,69,.15);
    }

    .err-msg {
        font-size: 10px;
        color: #dc3545;
        display: block;
        margin-top: 2px;
    }

    /* ── Print ── */
    @@media print {
        .add-row-btn, .remove-row, .action-btns {
            display: none !important;
        }

        @@page {
            size: A4 landscape;
            margin: 8mm;
        }
    }
</style>


<style type="text/css">
    .sd-top {
        display: grid;
        grid-template-columns: 1fr 100px;
        border-bottom: 1px solid #dee2e6;
    }

    .sd-service {
        padding: 6px 8px;
        border-right: 1px solid #dee2e6;
    }

    .sd-sac {
        padding: 6px 8px;
    }

    .sd-bottom {
        padding: 6px 8px;
    }

    .service-wrapper {
        position: relative;
    }

    .service-dropdown {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 9999;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 4px;
        max-height: 200px;
        overflow-y: auto;
        list-style: none;
        margin: 2px 0 0;
        padding: 0;
        box-shadow: 0 4px 12px rgba(0,0,0,.12);
    }
</style>

<form id="frmTaxInvoice">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="card">

        <div class="card-header d-flex align-items-center justify-content-between"
             style="background:linear-gradient(314deg,#0b0f14,#1a3e66);">

            <h5 style="margin:0;color:#fff;">
                @(isEdit ? "Edit Tax Invoice" : "Tax Invoice")
            </h5>

            <button type="button"
                    class="btn btn-primary btn-sm"
                    onclick="window.history.back();">

                <i class="fa fa-arrow-left"></i>
                Back

            </button>

        </div>

        <div class="card-body">

            <div class="row form-row-item">

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold required">
                            Invoice No
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.invoiceno"
                                   type="text"
                                   class="form-control"
                                   id="invoiceNo"
                                   readonly />

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold required">
                            Invoice Date
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.invoicedate"
                                   type="date"
                                   class="form-control"
                                   id="invoiceDate" />

                            <span class="err-msg"
                                  id="err-invoiceDate"></span>

                        </div>

                    </div>

                </div>

            </div>

            <div class="row form-row-item">

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Reverse Charge
                        </label>

                        <div class="col-md-8">

                            <select asp-for="main.reversecharge"
                                    class="form-control"
                                    id="reverseCharge">

                                <option value="N">N</option>
                                <option value="Y">Y</option>

                            </select>

                        </div>

                    </div>

                </div>
                
            </div>

        </div>

    </div>

    <!-- =====================================================
         BILL TO
    ====================================================== -->

    <div class="card mt-3">

        <div class="card-header"
             style="background:linear-gradient(314deg,#0b0f14,#1a3e66);">

            <h5 style="margin:0;color:#fff;">
                Bill To
            </h5>

        </div>

        <div class="card-body">

            <div class="row form-row-item">

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold required">
                            Company Name
                        </label>

                        <div class="col-md-8">

                            <select asp-for="main.companyName"
                                    class="form-control ddlselect"
                                    id="companyName" disabled>

                                <option value="">
                                    Select Company
                                </option>

                                @foreach (var company in companyList)
                                {
                                    <option value="@company.companyName">
                                        @company.companyName
                                    </option>
                                }

                            </select>
                            <input type="hidden" id="companyNameHidden" value="@(Model?.main?.companyName ?? "")" />

                            <span class="err-msg"
                                  id="err-companyName"></span>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Billing GST
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.gstIn"
                                   type="text"
                                   class="form-control"
                                   id="gstin" readonly />

                        </div>

                    </div>

                </div>

            </div>

            <div class="row form-row-item">

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Billing Address
                        </label>

                        <div class="col-md-8">

                            <textarea asp-for="main.Address"
                                      class="form-control"
                                      id="address"
                                      rows="2" readonly></textarea>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Billing Location
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.BillingLocation"
                                   type="text"
                                   class="form-control"
                                   id="Location" readonly />

                        </div>

                    </div>

                </div>

            </div>

            <div class="row form-row-item">

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Pincode
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.PinCode"
                                   type="text"
                                   class="form-control"
                                   id="billingPincode" readonly />

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Billing State
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.state"
                                   type="text"
                                   class="form-control"
                                   id="billingState" readonly />

                        </div>

                    </div>

                </div>

            </div>

            <div class="row form-row-item">

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Billing State Code
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.statecode"
                                   type="text"
                                   class="form-control"
                                   id="billingStateCode" readonly />

                        </div>

                    </div>

                </div>

            </div>

            <div class="row form-row-item">

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Transaction Mode
                        </label>

                        <div class="col-md-8">

                            <select asp-for="main.TransMode"
                                    class="form-control"
                                    id="Transaction">

                                <option value="">
                                    Select Transaction Mode
                                </option>

                                <option value="Cheque">
                                    Cheque
                                </option>

                                <option value="Online/UPI">
                                    Online/UPI
                                </option>

                                <option value="Cash">
                                    Cash
                                </option>

                            </select>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Transaction No
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.TransNo"
                                   type="text"
                                   class="form-control"
                                   id="transNo" />

                        </div>

                    </div>

                </div>

            </div>

            <div class="row form-row-item">

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Transaction Date
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.TransDate"
                                   type="date"
                                   class="form-control"
                                   id="transDate" />

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Transaction Amount
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.TransAmt"
                                   type="text"
                                   class="form-control"
                                   id="TransAmt" />

                        </div>

                    </div>

                </div>

            </div>

            <div class="row form-row-item">
                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold">Against By</label>
                        <div class="col-md-8">
                            <select asp-for="main.AgainstBy" type="text" class="form-control" id="AgainstBy" disabled>
                                <option value="Direct">Direct</option>
                                <option value="Quotation">Quotation</option>
                                <option value="Proforma">Proforma</option>
                            </select>
                            <input type="hidden" id="AgainstByHidden" value="@(Model?.main?.AgainstBy ?? "Direct")" />
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold">Against By Value</label>
                        <div class="col-md-8">
                            <select asp-for="main.AgainstByValue" type="text" class="form-control" id="AgainstByValue" disabled>
                            </select>
                            <input type="hidden" id="AgainstByValueHidden" value="@(Model?.main?.AgainstByValue ?? "")" />
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>


    <!-- =====================================================
         ITEM DETAILS
    ====================================================== -->

    <div class="card mt-3">

        <div class="card-header"
             style="background:linear-gradient(314deg,#0b0f14,#1a3e66);">

            <h5 style="margin:0;color:#fff;">
                Item Details
            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="invoice-table" id="invoiceTable">
                    <thead>
                        <tr>
                            <th class="col-sn" rowspan="3">S.No</th>
                            <th colspan="2" style="width:280px;"></th>
                            <th class="col-qty" rowspan="3">Service Till</th>
                            <th class="col-rate" rowspan="3">Rate</th>
                            <th class="col-taxable" rowspan="3">Taxable Value</th>
                            <th class="col-tax" rowspan="3">CGST % | Amt</th>
                            <th class="col-tax" rowspan="3">SGST % | Amt</th>
                            <th class="col-tax" rowspan="3">IGST % | Amt</th>
                            <th class="col-total" rowspan="3">Total</th>
                            <th class="col-action" rowspan="3">#</th>
                        </tr>
                        <tr>
                            <th style="width:160px; border-right:1px solid rgba(255,255,255,0.2); border-bottom:1px solid rgba(255,255,255,0.2); font-size:10px; letter-spacing:.5px;">SERVICE</th>
                            <th style="width:100px; border-bottom:1px solid rgba(255,255,255,0.2); font-size:10px; letter-spacing:.5px;">SAC CODE</th>
                        </tr>
                        <tr>
                            <th colspan="2" style="font-size:10px; letter-spacing:.5px;">SERVICE DESCRIPTION</th>
                        </tr>
                    </thead>
                    <tbody id="invoiceItems"></tbody>
                    <tfoot>
                        <tr class="tfoot-row">
                            <td></td>
                            <td colspan="3" style="text-align:right; padding-right:10px; font-weight:700;">TOTAL</td>
                            <td></td>
                            <td><input type="text" id="totalTaxable" readonly class="form-control form-control-sm text-right" /></td>
                            <td><input type="text" id="totalCGST" readonly class="form-control form-control-sm text-right" /></td>
                            <td><input type="text" id="totalSGST" readonly class="form-control form-control-sm text-right" /></td>
                            <td><input type="text" id="totalIGST" readonly class="form-control form-control-sm text-right" /></td>
                            <td><input type="text" id="grandTotalTable" readonly class="form-control form-control-sm text-right" /></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>

            </div>

            <div class="p-2 pt-3">

                <button type="button"
                        class="btn btn-success btn-sm add-row-btn"
                        onclick="addInvoiceRow()">

                    + Add New Row

                </button>

                <span class="err-msg d-inline-block ml-2"
                      id="err-items"></span>

            </div>

        </div>

    </div>


    <!-- =====================================================
         SUMMARY
    ====================================================== -->

    <div class="card mt-3">

        <div class="card-header"
             style="background:linear-gradient(314deg,#0b0f14,#1a3e66);">

            <h5 style="margin:0;color:#fff;">
                Summary
            </h5>

        </div>

        <div class="card-body p-0">

            <div class="summary-grid">

                <div style="border-right:1px solid #dee2e6;">

                    <div style="padding:10px 12px;font-size:12px;font-weight:700;border-bottom:1px solid #dee2e6;">

                        Amount in Words

                    </div>

                    <div class="words-box">

                        <label class="font-weight-bold mb-1"
                               style="font-size:12px;">

                            Total Amount (in words)

                        </label>

                        <textarea id="amountInWords"
                                  asp-for="main.amtinwords"
                                  style="color:red;font-size:large;font-weight:600;"
                                  readonly></textarea>

                    </div>

                </div>

                <div class="summary-right">

                    <div style="padding:10px 12px;font-size:12px;font-weight:700;border-bottom:1px solid #dee2e6;">

                        Tax Summary

                    </div>

                    <div class="summary-row">
                        <span>Total Amount Before Tax</span>
                        <input type="text" id="summaryBeforeTax" readonly />
                    </div>

                    <div class="summary-row">
                        <span>Total CGST</span>
                        <input type="text" id="summaryCGST" readonly />
                    </div>

                    <div class="summary-row">
                        <span>Total SGST</span>
                        <input type="text" id="summarySGST" readonly />
                    </div>

                    <div class="summary-row">
                        <span>Total IGST</span>
                        <input type="text" id="summaryIGST" readonly />
                    </div>

                    <div class="summary-row">
                        <span>Total Tax Amount</span>
                        <input type="text" id="summaryTax" readonly />
                    </div>

                    <div class="summary-row">
                        <span>Grand Total</span>
                        <input type="text" id="summaryGrandTotal" readonly />
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         BUTTONS
    ====================================================== -->

    <div class="row justify-content-center mt-3 mb-4 action-btns">

        <div class="col-auto">

            <button type="button"
                    id="saveBtn"
                    class="btn btn-primary px-4"
                    onclick="saveInvoice()">

                   @(isEdit ? "Update" : "Save")

            </button>

        </div>

        <div class="col-auto">



        </div>

        <div class="col-auto">

            <button type="button"
                    class="btn btn-danger px-4"
                    onclick="clearInvoice()">

                Clear

            </button>

        </div>

    </div>

</form>


<script type="text/javascript">

    let rowCounter = 0;

    const isEdit = @(isEdit ? "true" : "false");
    const invoiceId = @(isEdit ? Model.main.Id : "0");

    const existingDetails = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(invoiceDetails));

    const existingCompany = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.main?.companyName ?? ""));

 
    // =========================================================
    // DOCUMENT READY
    // =========================================================

    $(document).ready(function () {
        $('#companyName').select2({
            placeholder: 'Select Company',
            allowClear: true,
            width: '100%'
        });

        loadExistingInvoice();

      // ── Set today if new, else keep server date ──
        if (!isEdit) setTodayDate();

      
        // ── AgainstBy: disable AgainstByValue initially if Direct ──
        const initAgainst = $('#AgainstBy').val();
        if (initAgainst === 'Direct' || !initAgainst) {
            $('#AgainstByValue').prop('disabled', true)
                .html('<option value="">N/A</option>');
        }

        // ── If edit mode and AgainstBy is Quotation/Proforma, load the options then re-select ──
        if (isEdit && (initAgainst === 'Quotation' || initAgainst === 'Proforma')) {
            const savedAgainstByValue = '@Html.Raw(Model?.main?.AgainstByValue ?? "")';
            const companyName = $('#companyName').val();

            $.ajax({
                url: '@Url.Action("GetQuotationsByCompany", "Taxinvoice")',
                type: 'GET',
                data: { companyName: companyName, type: initAgainst },
                success: function (response) {
                    $('#AgainstByValue').html('<option value="">-- Select --</option>');
                    if (response && response.length > 0) {
                        response.forEach(function (item) {
                            $('#AgainstByValue').append(
                                $('<option>').val(item.id).text(item.displayText)
                            );
                        });
                        if (savedAgainstByValue) {
                            $('#AgainstByValue').val(savedAgainstByValue);
                        }
                    }
                    $('#AgainstByValue').prop('disabled', true);
                }
            });
        }

        // ── AgainstBy change ──
        $('#AgainstBy').on('change', function () {
            const selected    = $(this).val();
            const companyName = $('#companyName').val();

            $('#AgainstByValue').html('<option value="">-- Select --</option>').prop('disabled', true);

            if (selected === 'Quotation' || selected === 'Proforma') {
                if (!companyName) {
                    showToast('Please select a Company first.', 'warning');
                    $(this).val('Direct');
                    $('#AgainstByValue').html('<option value="">N/A</option>').prop('disabled', true);
                    return;
                }

                $('#AgainstByValue').html('<option value="">Loading...</option>');

                $.ajax({
                    url: '@Url.Action("GetQuotationsByCompany", "Taxinvoice")',
                    type: 'GET',
                    data: { companyName: companyName, type: selected },
                    success: function (response) {
                        $('#AgainstByValue').html('<option value="">-- Select --</option>');
                        if (!response || response.length === 0) {
                            $('#AgainstByValue').html('<option value="">No records found</option>');
                            return;
                        }
                        response.forEach(function (item) {
                            $('#AgainstByValue').append(
                                $('<option>').val(item.id).text(item.displayText)
                            );
                        });
                        $('#AgainstByValue').prop('disabled', false);
                    },
                    error: function () {
                        $('#AgainstByValue').html('<option value="">No data</option>');
                    }
                });
            } else {
                $('#AgainstByValue').html('<option value="">N/A</option>').prop('disabled', true);
            }
        });
    });

    // =========================================================
    // LOAD EXISTING INVOICE
    // =========================================================

    function loadExistingInvoice() {

        const tbody = document.getElementById('invoiceItems');
        if (!tbody) return;

        tbody.innerHTML = '';
        rowCounter = 0;

        if (!existingDetails || !Array.isArray(existingDetails) || existingDetails.length === 0) {
            addInvoiceRow();
            calculateAll();
            updateAmountInWords();
            return;
        }

        existingDetails.forEach(function (item) {
            
            const row = addInvoiceRow();
            if (!row) return;

            row.dataset.detailId = item.id ?? item.Id ?? 0;

            // ── Service name & hidden fields ──
            const serviceName = item.serviceName ?? item.ServiceName ?? '';
            row.querySelector('.service').value             = serviceName;
            row.querySelector('.service-name-hidden').value = serviceName;
            row.querySelector('.service-id').value          = item.serviceId ?? item.ServiceId ?? '';

            // ── SAC / Description ──
            row.querySelector('.sac-code').value    = item.saccode    ?? item.SacCode    ?? '';
            row.querySelector('.description').value = item.productdescription ?? item.ProductDescription ?? '';

            // ── Service Till ──
            const validTillSel = row.querySelector('.validTill');
            const serviceTill  = item.serviceTill ?? item.ServiceTill ?? '1 Year';
            if (validTillSel) {
                const opt = [...validTillSel.options].find(o => o.value === serviceTill);
                validTillSel.value = opt ? serviceTill : validTillSel.options[0].value;
            }

            // ── Rate ──
            row.querySelector('.rate').value = item.rate ?? item.rate ?? 0;

            // ── Tax rates (set BEFORE calculateRow so amounts compute correctly) ──
            row.querySelector('.cgst-rate').value = item.cgstrate ?? item.CgstRate ?? 0;
            row.querySelector('.sgst-rate').value = item.sgstrate ?? item.SgstRate ?? 0;
            row.querySelector('.igst-rate').value = item.igstrate ?? item.IgstRate ?? 0;

            // ── Apply disabled state based on which tax is active ──
            applyTaxState(row);

            // ── NOW recalculate this row so taxable, amounts, total are computed fresh ──
            calculateRow(row.querySelector('.rate'));
        });

        refreshSerialNumbers();

        // ── Final pass: recalculate all summary totals and words ──
        calculateAll();
        updateAmountInWords();
    }

    // =========================================================
    // COMPANY DETAILS
    // =========================================================

    function getCompanyDetails(cname) {
        $.ajax({
            url: '@Url.Action("Getcomapnybycname", "Taxinvoice")',
            type: 'GET',
            data: { cname: cname },
            success: function (data) {
                if (!data) return;
                $('#gstin').val(data.gstIn || '');
                $('#address').val(data.address || '');
                $('#Location').val(data.location || '');
                $('#billingState').val(data.state || '');
                $('#billingPincode').val(data.pinCode || '');
                $('#billingStateCode').val(data.statecode || '');
            },
            error: function () {
                showToast("Error while loading company details.", "error");
            }
        });
    }

    // =========================================================
    // TODAY
    // =========================================================

    function setTodayDate() {
        const d = new Date();
        const date = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
        $('#invoiceDate').val(date);
    }

    // =========================================================
    // ADD ROW
    // =========================================================

    function addInvoiceRow() {
        rowCounter++;

        const row = document.createElement('tr');
        row.className = 'invoice-item-row';
        row.dataset.detailId = 0;

        row.innerHTML = `
            <td><input type="text" value="${rowCounter}" readonly class="serial-number" /></td>
            <td class="service-desc-cell" colspan="2">
                <div class="sd-top">
                    <div class="sd-service">
                        <div class="service-wrapper" style="position:relative;">
                            <input type="text" placeholder="Search service..." class="service"
                                   autocomplete="off"
                                   oninput="searchService(this)"
                                   onkeydown="handleServiceKeydown(event,this)" />
                            <input type="hidden" class="service-id" />
                            <input type="hidden" class="service-name-hidden" />
                            <ul class="service-dropdown"></ul>
                        </div>
                    </div>
                    <div class="sd-sac">
                        <input type="text" class="sac-code" placeholder="SAC Code" />
