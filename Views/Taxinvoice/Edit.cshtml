@model WLSPL_ERP_CRM.Models.Taxinvoice.TaxInvoiceCreateVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isEdit = Model?.main != null && Model.main.Id > 0;

    var companyList = Model?.companies
        ?? new List<WLSPL_ERP_CRM.Models.Taxinvoice.TaxInvoiceCreate>();

    var invoiceDetails = Model?.details
        ?? new List<WLSPL_ERP_CRM.Models.Taxinvoice.InvoiceDetails>();
}

<style>

    .required::after {
        content: " *";
        color: red;
    }

    .form-control {
        border: 1px solid gray !important;
    }

        .form-control,
        .form-control:focus {
            background-color: #f4f5f6 !important;
            border: 1px solid #ced4da;
            color: #444;
            border-radius: 3px;
        }

            .form-control[readonly],
            .form-control:disabled {
                background-color: #e8eaeb !important;
                color: #6c757d;
                cursor: default;
            }

    .select2-container .select2-selection--single {
        background-color: #f4f5f6 !important;
        border: 1px solid #343434 !important;
        border-radius: 3px !important;
        height: 38px !important;
    }

        .select2-container .select2-selection--single
        .select2-selection__rendered {
            line-height: 36px !important;
            color: #444 !important;
        }

        .select2-container .select2-selection--single
        .select2-selection__arrow {
            height: 36px !important;
        }

    .card-body .row.form-row-item {
        margin-bottom: 16px;
    }

    .invoice-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .invoice-table th,
        .invoice-table td {
            border: 1px solid #dee2e6;
            padding: 4px 6px;
            vertical-align: middle;
            text-align: center;
        }

        .invoice-table th {
            background: linear-gradient(314deg, #0b0f14, #1a3e66);
            color: #fff;
            font-size: 11px;
            font-weight: 600;
        }

        .invoice-table td input,
        .invoice-table td textarea {
            width: 100%;
            font-size: 11px;
            border: 1px solid gray;
            border-radius: 3px;
            padding: 2px 4px;
            background: #f4f5f6;
            color: #444;
        }

            .invoice-table td input[readonly],
            .invoice-table td input:disabled {
                background: #e8eaeb !important;
                color: #6c757d;
                cursor: default;
            }

        .invoice-table td textarea {
            min-height: 38px;
            resize: vertical;
        }

    .col-sn {
        width: 42px;
    }

    .col-desc {
        width: 175px;
    }

    .col-sac {
        width: 75px;
    }

    .col-qty {
        width: 60px;
    }

    .col-rate {
        width: 80px;
    }

    .col-taxable {
        width: 90px;
    }

    .col-tax {
        width: 110px;
    }

    .col-total {
        width: 95px;
    }

    .col-action {
        width: 36px;
    }

    .tax-pair {
        display: grid;
        grid-template-columns: 44px 1fr;
        gap: 3px;
    }

    .tfoot-row td {
        background: #f1f3f5;
        font-weight: 600;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: 60% 40%;
    }

    .summary-right .summary-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #dee2e6;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 600;
    }

        .summary-right .summary-row input {
            width: 130px;
            text-align: right;
            border: 1px solid #ced4da;
            border-radius: 3px;
            background: #e8eaeb !important;
            color: #444;
            font-size: 11px;
            padding: 2px 6px;
            height: 28px;
        }

    .words-box {
        padding: 12px;
        min-height: 90px;
    }

        .words-box textarea {
            width: 100%;
            min-height: 55px;
            border: 1px solid #ced4da;
            border-radius: 3px;
            font-size: 11px;
            padding: 4px 6px;
            resize: vertical;
            background: #f4f5f6;
            color: #444;
        }

    .field-error {
        border-color: #dc3545 !important;
        background-color: #fff5f5 !important;
        box-shadow: 0 0 0 0.15rem rgba(220,53,69,.15);
    }

    .err-msg {
        font-size: 10px;
        color: #dc3545;
        display: block;
        margin-top: 2px;
    }

    @@media print {

        .add-row-btn,
        .remove-row,
        .action-btns {
            display: none !important;
        }

        @@page {
            size: A4 landscape;
            margin: 8mm;
        }
    }

</style>

<form id="frmTaxInvoice">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="card">

        <div class="card-header d-flex align-items-center justify-content-between"
             style="background:linear-gradient(314deg,#0b0f14,#1a3e66);">

            <h5 style="margin:0;color:#fff;">
                @(isEdit ? "Edit Tax Invoice" : "Tax Invoice")
            </h5>

            <button type="button"
                    class="btn btn-primary btn-sm"
                    onclick="window.history.back();">

                <i class="fa fa-arrow-left"></i>
                Back

            </button>

        </div>

        <div class="card-body">

            <div class="row form-row-item">

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold required">
                            Invoice No
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.invoiceno"
                                   type="text"
                                   class="form-control"
                                   id="invoiceNo"
                                   readonly />

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold required">
                            Invoice Date
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.invoicedate"
                                   type="date"
                                   class="form-control"
                                   id="invoiceDate" />

                            <span class="err-msg"
                                  id="err-invoiceDate"></span>

                        </div>

                    </div>

                </div>

            </div>

            <div class="row form-row-item">

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Reverse Charge
                        </label>

                        <div class="col-md-8">

                            <select asp-for="main.reversecharge"
                                    class="form-control"
                                    id="reverseCharge">

                                <option value="N">N</option>
                                <option value="Y">Y</option>

                            </select>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Against By
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.InvoiceType"
                                   type="text"
                                   class="form-control"
                                   id="InvoiceType"
                                   placeholder="Against By" />

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         BILL TO
    ====================================================== -->

    <div class="card mt-3">

        <div class="card-header"
             style="background:linear-gradient(314deg,#0b0f14,#1a3e66);">

            <h5 style="margin:0;color:#fff;">
                Bill To
            </h5>

        </div>

        <div class="card-body">

            <div class="row form-row-item">

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold required">
                            Company Name
                        </label>

                        <div class="col-md-8">

                            <select asp-for="main.companyName"
                                    class="form-control ddlselect"
                                    id="companyName">

                                <option value="">
                                    Select Company
                                </option>

                                @foreach (var company in companyList)
                                {
                                    <option value="@company.companyName">
                                        @company.companyName
                                    </option>
                                }

                            </select>

                            <span class="err-msg"
                                  id="err-companyName"></span>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Billing GST
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.gstIn"
                                   type="text"
                                   class="form-control"
                                   id="gstin" />

                        </div>

                    </div>

                </div>

            </div>

            <div class="row form-row-item">

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Billing Address
                        </label>

                        <div class="col-md-8">

                            <textarea asp-for="main.Address"
                                      class="form-control"
                                      id="address"
                                      rows="2"></textarea>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Billing Location
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.BillingLocation"
                                   type="text"
                                   class="form-control"
                                   id="Location" />

                        </div>

                    </div>

                </div>

            </div>

            <div class="row form-row-item">

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Pincode
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.PinCode"
                                   type="text"
                                   class="form-control"
                                   id="billingPincode" />

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Billing State
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.state"
                                   type="text"
                                   class="form-control"
                                   id="billingState" />

                        </div>

                    </div>

                </div>

            </div>

            <div class="row form-row-item">

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Billing State Code
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.statecode"
                                   type="text"
                                   class="form-control"
                                   id="billingStateCode" />

                        </div>

                    </div>

                </div>

            </div>

            <div class="row form-row-item">

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Transaction Mode
                        </label>

                        <div class="col-md-8">

                            <select asp-for="main.TransMode"
                                    class="form-control"
                                    id="Transaction">

                                <option value="">
                                    Select Transaction Mode
                                </option>

                                <option value="Cheque">
                                    Cheque
                                </option>

                                <option value="Online/UPI">
                                    Online/UPI
                                </option>

                                <option value="Cash">
                                    Cash
                                </option>

                            </select>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Transaction No
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.TransNo"
                                   type="text"
                                   class="form-control"
                                   id="transNo" />

                        </div>

                    </div>

                </div>

            </div>

            <div class="row form-row-item">

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Transaction Date
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.TransDate"
                                   type="date"
                                   class="form-control"
                                   id="transDate" />

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="form-group row">

                        <label class="col-md-4 col-form-label font-weight-bold">
                            Transaction Amount
                        </label>

                        <div class="col-md-8">

                            <input asp-for="main.TransAmt"
                                   type="text"
                                   class="form-control"
                                   id="TransAmt" />

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         ITEM DETAILS
    ====================================================== -->

    <div class="card mt-3">

        <div class="card-header"
             style="background:linear-gradient(314deg,#0b0f14,#1a3e66);">

            <h5 style="margin:0;color:#fff;">
                Item Details
            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="invoice-table"
                       id="invoiceTable">

                    <thead>

                        <tr>

                            <th class="col-sn">S.No</th>
                            <th class="col-desc">Description</th>
                            <th class="col-sac">SAC Code</th>
                            <th class="col-qty">Qty</th>
                            <th class="col-rate">Rate</th>
                            <th class="col-taxable">Taxable Value</th>
                            <th class="col-tax">CGST % | Amt</th>
                            <th class="col-tax">SGST % | Amt</th>
                            <th class="col-tax">IGST % | Amt</th>
                            <th class="col-total">Total</th>
                            <th class="col-action">#</th>

                        </tr>

                    </thead>

                    <tbody id="invoiceItems">
                    </tbody>

                    <tfoot>

                        <tr class="tfoot-row">

                            <td colspan="3"
                                style="text-align:right;padding-right:10px;">
                                TOTAL
                            </td>

                            <td>
                                <input type="text"
                                       id="totalQty"
                                       readonly
                                       class="form-control form-control-sm text-right" />
                            </td>

                            <td></td>

                            <td>
                                <input type="text"
                                       id="totalTaxable"
                                       readonly
                                       class="form-control form-control-sm text-right" />
                            </td>

                            <td>
                                <input type="text"
                                       id="totalCGST"
                                       readonly
                                       class="form-control form-control-sm text-right" />
                            </td>

                            <td>
                                <input type="text"
                                       id="totalSGST"
                                       readonly
                                       class="form-control form-control-sm text-right" />
                            </td>

                            <td>
                                <input type="text"
                                       id="totalIGST"
                                       readonly
                                       class="form-control form-control-sm text-right" />
                            </td>

                            <td>
                                <input type="text"
                                       id="grandTotalTable"
                                       readonly
                                       class="form-control form-control-sm text-right" />
                            </td>

                            <td></td>

                        </tr>

                    </tfoot>

                </table>

            </div>

            <div class="p-2 pt-3">

                <button type="button"
                        class="btn btn-success btn-sm add-row-btn"
                        onclick="addInvoiceRow()">

                    + Add New Row

                </button>

                <span class="err-msg d-inline-block ml-2"
                      id="err-items"></span>

            </div>

        </div>

    </div>


    <!-- =====================================================
         SUMMARY
    ====================================================== -->

    <div class="card mt-3">

        <div class="card-header"
             style="background:linear-gradient(314deg,#0b0f14,#1a3e66);">

            <h5 style="margin:0;color:#fff;">
                Summary
            </h5>

        </div>

        <div class="card-body p-0">

            <div class="summary-grid">

                <div style="border-right:1px solid #dee2e6;">

                    <div style="padding:10px 12px;font-size:12px;font-weight:700;border-bottom:1px solid #dee2e6;">

                        Amount in Words

                    </div>

                    <div class="words-box">

                        <label class="font-weight-bold mb-1"
                               style="font-size:12px;">

                            Total Amount (in words)

                        </label>

                        <textarea id="amountInWords"
                                  asp-for="main.amtinwords"
                                  style="color:red;font-size:large;font-weight:600;"
                                  readonly></textarea>

                    </div>

                </div>

                <div class="summary-right">

                    <div style="padding:10px 12px;font-size:12px;font-weight:700;border-bottom:1px solid #dee2e6;">

                        Tax Summary

                    </div>

                    <div class="summary-row">
                        <span>Total Amount Before Tax</span>
                        <input type="text" id="summaryBeforeTax" readonly />
                    </div>

                    <div class="summary-row">
                        <span>Total CGST</span>
                        <input type="text" id="summaryCGST" readonly />
                    </div>

                    <div class="summary-row">
                        <span>Total SGST</span>
                        <input type="text" id="summarySGST" readonly />
                    </div>

                    <div class="summary-row">
                        <span>Total IGST</span>
                        <input type="text" id="summaryIGST" readonly />
                    </div>

                    <div class="summary-row">
                        <span>Total Tax Amount</span>
                        <input type="text" id="summaryTax" readonly />
                    </div>

                    <div class="summary-row">
                        <span>Grand Total</span>
                        <input type="text" id="summaryGrandTotal" readonly />
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         BUTTONS
    ====================================================== -->

    <div class="row justify-content-center mt-3 mb-4 action-btns">

        <div class="col-auto">

            <button type="button"
                    id="saveBtn"
                    class="btn btn-primary px-4"
                    onclick="saveInvoice()">

                   @(isEdit ? "Update" : "Save")

            </button>

        </div>

        <div class="col-auto">



        </div>

        <div class="col-auto">

            <button type="button"
                    class="btn btn-danger px-4"
                    onclick="clearInvoice()">

                Clear

            </button>

        </div>

    </div>

</form>


<script>

    let rowCounter = 0;


    // =========================================================
    // SERVER VALUES
    // =========================================================

    const isEdit = @(isEdit ? "true" : "false");

    const invoiceId = @(isEdit? Model.main.Id : 0);


    // =========================================================
    // IMPORTANT:
    // SERIALIZE ONLY Model.details
    // =========================================================

    const existingDetails =
        @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                    invoiceDetails
            )
                );


    const existingCompany =
        @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                Model?.main?.companyName ?? ""
                        )
                );


    // =========================================================
    // DOCUMENT READY
    // =========================================================

    $(document).ready(function () {
        // Select2
        $('#companyName').select2({
            placeholder: 'Select Company',
            allowClear: true,
            width: '100%'
        });

        // FORCE CALL
        loadExistingInvoice();
    });




    // =========================================================
    // LOAD EXISTING INVOICE
    // =========================================================

    function loadExistingInvoice() {

        debugger;

        console.log("========== LOAD EXISTING INVOICE ==========");
        console.log("existingDetails:", existingDetails);
        console.log("Is Array:", Array.isArray(existingDetails));

        const tbody = document.getElementById('invoiceItems');

        if (!tbody) {
            console.error("invoiceItems tbody not found.");
            return;
        }

        tbody.innerHTML = '';
        rowCounter = 0;

        if (!existingDetails || !Array.isArray(existingDetails) || existingDetails.length === 0) {

            console.log("No existing details found.");

            addInvoiceRow();
            calculateAll();

            return;
        }

        existingDetails.forEach(function (item, index) {

            console.log("========== ITEM " + index + " ==========");
            console.log(item);

            const row = addInvoiceRow();

            if (!row) {
                console.error("addInvoiceRow() did not return row.");
                return;
            }

            // ==========================================
            // DETAIL ID
            // ==========================================

            row.dataset.detailId =
                item.id ??
                item.Id ??
                0;


            // ==========================================
            // DESCRIPTION
            // ==========================================

            row.querySelector('.description').value =
                item.productdescription ??
                item.ProductDescription ??
                '';


            // ==========================================
            // SAC CODE
            // ==========================================

            row.querySelector('.sac-code').value =
                item.saccode ??
                item.SacCode ??
                '';


            // ==========================================
            // QTY
            // ==========================================

            row.querySelector('.qty').value =
                item.qty ??
                item.Qty ??
                0;


            // ==========================================
            // RATE
            // ==========================================

            row.querySelector('.rate').value =
                item.rate ??
                item.Rate ??
                0;


            // ==========================================
            // TAXABLE VALUE
            // ==========================================

            row.querySelector('.taxable-value').value =
                Number(
                    item.taxablevalue ??
                    item.TaxableValue ??
                    item.amount ??
                    item.Amount ??
                    0
                ).toFixed(2);


            // ==========================================
            // CGST RATE
            // ==========================================

            row.querySelector('.cgst-rate').value =
                item.cgstrate ??
                item.CgstRate ??
                0;


            // ==========================================
            // CGST AMOUNT
            // ==========================================

            row.querySelector('.cgst-amount').value =
                Number(
                    item.cgstamt ??
                    item.CgstAmt ??
                    0
                ).toFixed(2);


            // ==========================================
            // SGST RATE
            // ==========================================

            row.querySelector('.sgst-rate').value =
                item.sgstrate ??
                item.SgstRate ??
                0;


            // ==========================================
            // SGST AMOUNT
            // ==========================================

            row.querySelector('.sgst-amount').value =
                Number(
                    item.sgstamt ??
                    item.SgstAmt ??
                    0
                ).toFixed(2);


            // ==========================================
            // IGST RATE
            // ==========================================

            row.querySelector('.igst-rate').value =
                item.igstrate ??
                item.IgstRate ??
                0;


            // ==========================================
            // IGST AMOUNT
            // ==========================================

            row.querySelector('.igst-amount').value =
                Number(
                    item.igstamt ??
                    item.IgstAmt ??
                    0
                ).toFixed(2);


            // ==========================================
            // TOTAL
            // ==========================================

            row.querySelector('.row-total').value =
                Number(
                    item.total ??
                    item.Total ??
                    0
                ).toFixed(2);


            // ==========================================
            // APPLY TAX STATE
            // ==========================================

            applyTaxState(row);


            console.log("BOUND ROW:", {
                id: row.dataset.detailId,
                description: row.querySelector('.description').value,
                sac: row.querySelector('.sac-code').value,
                qty: row.querySelector('.qty').value,
                rate: row.querySelector('.rate').value,
                taxable: row.querySelector('.taxable-value').value,
                cgstRate: row.querySelector('.cgst-rate').value,
                cgstAmount: row.querySelector('.cgst-amount').value,
                sgstRate: row.querySelector('.sgst-rate').value,
                sgstAmount: row.querySelector('.sgst-amount').value,
                igstRate: row.querySelector('.igst-rate').value,
                igstAmount: row.querySelector('.igst-amount').value,
                total: row.querySelector('.row-total').value
            });

        });

        refreshSerialNumbers();

        calculateAll();

        console.log(
            "Total rows:",
            document.querySelectorAll('.invoice-item-row').length
        );
    }


    // =========================================================
    // COMPANY DETAILS
    // =========================================================

    function getCompanyDetails(cname) {

        $.ajax({

            url:
                '@Url.Action("Getcomapnybycname", "Taxinvoice")',

            type: 'GET',

            data: {
                cname: cname
            },

            success: function (data) {

                if (!data) {
                    return;
                }

                $('#gstin').val(data.gstIn || '');

                $('#address').val(data.address || '');

                $('#Location').val(data.location || '');

                $('#billingState').val(data.state || '');

                $('#billingPincode').val(data.pinCode || '');

                $('#billingStateCode').val(data.statecode || '');

            },

            error: function () {

                console.log(
                    'Error while loading company details.'
                );

            }

        });

    }


    // =========================================================
    // TODAY
    // =========================================================

    function setTodayDate() {

        const d = new Date();

        const date =
            d.getFullYear() +
            '-' +
            String(d.getMonth() + 1).padStart(2, '0') +
            '-' +
            String(d.getDate()).padStart(2, '0');

        $('#invoiceDate').val(date);

    }


