    // =========================================================
    // REMOVE ROW
    // =========================================================

    function removeRow(btn) {

        const rows =
            document.querySelectorAll(
                '.invoice-item-row'
            );


        if (rows.length <= 1) {

            alert(
                'At least one item row is required.'
            );

            return;

        }


        btn.closest('tr').remove();


        refreshSerialNumbers();

        calculateAll();

    }


    // =========================================================
    // SERIAL NUMBERS
    // =========================================================

    function refreshSerialNumbers() {

        document
            .querySelectorAll('.invoice-item-row')
            .forEach(function (row, index) {

                row.querySelector(
                    '.serial-number'
                ).value = index + 1;

            });

    }


    // =========================================================
    // TAX STATE
    // =========================================================

    function applyTaxState(row) {

        const cgstInput =
            row.querySelector('.cgst-rate');

        const sgstInput =
            row.querySelector('.sgst-rate');

        const igstInput =
            row.querySelector('.igst-rate');


        const cgst =
            parseFloat(cgstInput.value) || 0;

        const sgst =
            parseFloat(sgstInput.value) || 0;

        const igst =
            parseFloat(igstInput.value) || 0;


        if (igst > 0) {

            cgstInput.disabled = true;

            sgstInput.disabled = true;

            igstInput.disabled = false;

        }

        else if (
            cgst > 0 ||
            sgst > 0
        ) {

            igstInput.disabled = true;

            cgstInput.disabled = false;

            sgstInput.disabled = false;

        }

        else {

            cgstInput.disabled = false;

            sgstInput.disabled = false;

            igstInput.disabled = false;

        }

    }


    // =========================================================
    // TAX CHANGE
    // =========================================================

    function taxChanged(input, taxType) {

        const row =
            input.closest('tr');


        const cgst =
            row.querySelector('.cgst-rate');

        const sgst =
            row.querySelector('.sgst-rate');

        const igst =
            row.querySelector('.igst-rate');


        let value =
            parseFloat(input.value) || 0;


        if (value < 0) {

            input.value = 0;

            value = 0;

        }


        if (
            taxType === 'CGST' ||
            taxType === 'SGST'
        ) {

            if (value > 0) {

                igst.value = 0;

                igst.disabled = true;

            }

            else if (
                (parseFloat(cgst.value) || 0) === 0 &&
                (parseFloat(sgst.value) || 0) === 0
            ) {

                igst.disabled = false;

            }

        }


        if (taxType === 'IGST') {

            if (value > 0) {

                cgst.value = 0;

                sgst.value = 0;

                cgst.disabled = true;

                sgst.disabled = true;

            }

            else {

                cgst.disabled = false;

                sgst.disabled = false;

            }

        }


        calculateRow(input);

    }


    // =========================================================
    // CALCULATE ROW
    // =========================================================

    function calculateRow(el) {

        const row =
            el.closest('tr');


        if (!row) {
            return;
        }


        const qty =
            parseFloat(
                row.querySelector('.qty').value
            ) || 0;


        const rate =
            parseFloat(
                row.querySelector('.rate').value
            ) || 0;


        const taxable =
            qty * rate;


        row.querySelector(
            '.taxable-value'
        ).value =
            taxable.toFixed(2);


        const cgstRate =
            parseFloat(
                row.querySelector('.cgst-rate').value
            ) || 0;


        const sgstRate =
            parseFloat(
                row.querySelector('.sgst-rate').value
            ) || 0;


        const igstRate =
            parseFloat(
                row.querySelector('.igst-rate').value
            ) || 0;


        const cgst =
            taxable * cgstRate / 100;


        const sgst =
            taxable * sgstRate / 100;


        const igst =
            taxable * igstRate / 100;


        row.querySelector(
            '.cgst-amount'
        ).value =
            cgst.toFixed(2);


        row.querySelector(
            '.sgst-amount'
        ).value =
            sgst.toFixed(2);


        row.querySelector(
            '.igst-amount'
        ).value =
            igst.toFixed(2);


        row.querySelector(
            '.row-total'
        ).value =
            (
                taxable +
                cgst +
                sgst +
                igst
            ).toFixed(2);


        calculateAll();

    }


    // =========================================================
    // CALCULATE ALL
    // =========================================================

    function calculateAll() {

        let totalQty = 0;

        let totalTaxable = 0;

        let totalCGST = 0;

        let totalSGST = 0;

        let totalIGST = 0;

        let grand = 0;


        document
            .querySelectorAll('.invoice-item-row')
            .forEach(function (row) {

                totalQty +=
                    parseFloat(
                        row.querySelector('.qty').value
                    ) || 0;


                totalTaxable +=
                    parseFloat(
                        row.querySelector('.taxable-value').value
                    ) || 0;


                totalCGST +=
                    parseFloat(
                        row.querySelector('.cgst-amount').value
                    ) || 0;


                totalSGST +=
                    parseFloat(
                        row.querySelector('.sgst-amount').value
                    ) || 0;


                totalIGST +=
                    parseFloat(
                        row.querySelector('.igst-amount').value
                    ) || 0;


                grand +=
                    parseFloat(
                        row.querySelector('.row-total').value
                    ) || 0;

            });


        const totalTax =
            totalCGST +
            totalSGST +
            totalIGST;


        $('#totalQty')
            .val(totalQty);


        $('#totalTaxable')
            .val(totalTaxable.toFixed(2));


        $('#totalCGST')
            .val(totalCGST.toFixed(2));


        $('#totalSGST')
            .val(totalSGST.toFixed(2));


        $('#totalIGST')
            .val(totalIGST.toFixed(2));


        $('#grandTotalTable')
            .val(grand.toFixed(2));


        $('#summaryBeforeTax')
            .val(totalTaxable.toFixed(2));


        $('#summaryCGST')
            .val(totalCGST.toFixed(2));


        $('#summarySGST')
            .val(totalSGST.toFixed(2));


        $('#summaryIGST')
            .val(totalIGST.toFixed(2));


        $('#summaryTax')
            .val(totalTax.toFixed(2));


        $('#summaryGrandTotal')
            .val(grand.toFixed(2));


        updateAmountInWords();

    }


    // =========================================================
    // NUMBER TO WORDS
    // =========================================================

    function numberToWordsIndian(amount) {

        amount =
            parseFloat(amount) || 0;


        if (amount === 0) {

            return "Zero Rupees Only";

        }


        amount =
            Math.round(amount * 100) / 100;


        const ones = [

            "", "One", "Two", "Three", "Four",
            "Five", "Six", "Seven", "Eight", "Nine",
            "Ten", "Eleven", "Twelve", "Thirteen",
            "Fourteen", "Fifteen", "Sixteen",
            "Seventeen", "Eighteen", "Nineteen"

        ];


        const tens = [

            "", "",
            "Twenty",
            "Thirty",
            "Forty",
            "Fifty",
            "Sixty",
            "Seventy",
            "Eighty",
            "Ninety"

        ];


        function convertBelowThousand(num) {

            let result = "";


            if (num >= 100) {

                result +=
                    ones[Math.floor(num / 100)] +
                    " Hundred ";

                num %= 100;

            }


            if (num >= 20) {

                result +=
                    tens[Math.floor(num / 10)] +
                    " ";

                num %= 10;

            }


            if (num > 0) {

                result +=
                    ones[num] +
                    " ";

            }


            return result.trim();

        }


        function convertIndian(num) {

            if (num < 1000) {

                return convertBelowThousand(num);

            }


            if (num < 100000) {

                return convertIndian(
                    Math.floor(num / 1000)
                ) +
                " Thousand " +
                convertBelowThousand(
                    num % 1000
                );

            }


            if (num < 10000000) {

                return convertIndian(
                    Math.floor(num / 100000)
                ) +
                " Lakh " +
                convertIndian(
                    num % 100000
                );

            }


            return convertIndian(
                Math.floor(num / 10000000)
            ) +
            " Crore " +
            convertIndian(
                num % 10000000
            );

        }


        const rupees =
            Math.floor(amount);


        const paise =
            Math.round(
                (amount - rupees) * 100
            );


        let words =
            convertIndian(rupees);


        words =
            words
                .replace(/\s+/g, " ")
                .trim();


        let result =
            words + " Rupees";


        if (paise > 0) {

            result +=
                " and " +
                convertIndian(paise) +
                " Paise";

        }


        result += " Only";


        return result;

    }


    // =========================================================
    // AMOUNT WORDS
    // =========================================================

    function updateAmountInWords() {

        const grandTotal =
            parseFloat(
                $('#summaryGrandTotal').val()
            ) || 0;


        $('#amountInWords')
            .val(
                numberToWordsIndian(grandTotal)
            );

    }


    // =========================================================
    // VALIDATION
    // =========================================================

    function validateInvoice() {

        let valid = true;


        $('.field-error')
            .removeClass('field-error');


        $('.err-msg')
            .text('');


        if (!$('#invoiceDate').val()) {

            $('#invoiceDate')
                .addClass('field-error');


            $('#err-invoiceDate')
                .text(
                    'Invoice Date is required.'
                );


            valid = false;

        }


        if (!$('#companyName').val()) {

            $('#companyName')
                .addClass('field-error');


            $('#err-companyName')
                .text(
                    'Company Name is required.'
                );


            valid = false;

        }


        const rows =
            document.querySelectorAll(
                '.invoice-item-row'
            );


        if (rows.length === 0) {

            $('#err-items')
                .text(
                    'At least one invoice item is required.'
                );


            valid = false;

        }


        rows.forEach(function (row) {

            const description =
                row.querySelector('.description');


            const qty =
                row.querySelector('.qty');


            const rate =
                row.querySelector('.rate');


            if (!description.value.trim()) {

                description.classList.add(
                    'field-error'
                );

                valid = false;

            }


            if (
                (parseFloat(qty.value) || 0) <= 0
            ) {

                qty.classList.add(
                    'field-error'
                );

                valid = false;

            }


            if (
                (parseFloat(rate.value) || 0) <= 0
            ) {

                rate.classList.add(
                    'field-error'
                );

                valid = false;

            }

        });


        if (!valid) {

            const firstError =
                document.querySelector(
                    '.field-error'
                );


            if (firstError) {

                firstError.scrollIntoView({

                    behavior: 'smooth',

                    block: 'center'

                });

            }

        }


        return valid;

    }


    // =========================================================
    // SAVE / UPDATE
    // =========================================================

    function saveInvoice() {

        calculateAll();


        if (!validateInvoice()) {

            return;

        }


           const main = {

        Id: invoiceId,

        invoiceno:
            $('#invoiceNo').val() || null,

        invoicedate:
            $('#invoiceDate').val() || null,

        reversecharge:
            $('#reverseCharge').val() || null,

        InvoiceType:
            $('#InvoiceType').val() || null,

        companyName:
            $('#companyName').val() || null,

        gstIn:
