                    $('#summaryTax').val()
                ) || 0
            ),

        amtinwords:
            $('#amountInWords').val() || null

    };



        const details = [];


        document
            .querySelectorAll('.invoice-item-row')
            .forEach(function (row) {

                details.push({

                    id:
                        parseInt(
                            row.dataset.detailId || 0
                        ),

                    invoiceid:
                        invoiceId,

                    productdescription:
                        row.querySelector(
                            '.description'
                        ).value.trim() || null,

                    saccode:
                        row.querySelector(
                            '.sac-code'
                        ).value.trim() || null,

                    qty:
                        parseFloat(
                            row.querySelector('.qty').value
                        ) || 0,

                    rate:
                        parseFloat(
                            row.querySelector('.rate').value
                        ) || 0,

                    amount:
                        parseFloat(
                            row.querySelector('.taxable-value').value
                        ) || 0,

                    taxablevalue:
                        parseFloat(
                            row.querySelector('.taxable-value').value
                        ) || 0,

                    cgstrate:
                        parseFloat(
                            row.querySelector('.cgst-rate').value
                        ) || 0,

                    cgstamt:
                        parseFloat(
                            row.querySelector('.cgst-amount').value
                        ) || 0,

                    sgstrate:
                        parseFloat(
                            row.querySelector('.sgst-rate').value
                        ) || 0,

                    sgstamt:
                        parseFloat(
                            row.querySelector('.sgst-amount').value
                        ) || 0,

                    igstrate:
                        parseFloat(
                            row.querySelector('.igst-rate').value
                        ) || 0,

                    igstamt:
                        parseFloat(
                            row.querySelector('.igst-amount').value
                        ) || 0,

                    total:
                        parseFloat(
                            row.querySelector('.row-total').value
                        ) || 0

                });

            });


        const payload = {

            Main: main,

            Details: details

        };



        const url = isEdit

            ? '@Url.Action("UpdateInvoice", "Taxinvoice")'

            : '@Url.Action("SaveInvoice", "Taxinvoice")';


        const $btn =
            $('#saveBtn');


        $btn
            .prop('disabled', true)
            .text(
                isEdit
                    ? 'Updating...'
                    : 'Saving...'
            );


        $.ajax({

