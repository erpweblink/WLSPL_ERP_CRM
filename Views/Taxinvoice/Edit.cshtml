    // =========================================================
    // REMOVE ROW
    // =========================================================

    function removeRow(btn) {
        const rows = document.querySelectorAll('.invoice-item-row');
        if (rows.length <= 1) {
            showToast("At least one item row is required.", "warning");
            return;
        }

        showConfirmToast("Remove this item row?", function () {
            btn.closest('tr').remove();
            refreshSerialNumbers();
            calculateAll();
        });
    }

    // =========================================================
    // SERIAL NUMBERS
    // =========================================================

    function refreshSerialNumbers() {
        document.querySelectorAll('.invoice-item-row').forEach(function (row, index) {
            row.querySelector('.serial-number').value = index + 1;
        });
    }

    // =========================================================
    // TAX STATE
    // =========================================================

    function applyTaxState(row) {
        const cgstInput = row.querySelector('.cgst-rate');
        const sgstInput = row.querySelector('.sgst-rate');
        const igstInput = row.querySelector('.igst-rate');

        const cgst = parseFloat(cgstInput.value) || 0;
        const sgst = parseFloat(sgstInput.value) || 0;
        const igst = parseFloat(igstInput.value) || 0;

        if (igst > 0) {
            cgstInput.disabled = true;
            sgstInput.disabled = true;
            igstInput.disabled = false;
        } else if (cgst > 0 || sgst > 0) {
            igstInput.disabled = true;
            cgstInput.disabled = false;
            sgstInput.disabled = false;
        } else {
            cgstInput.disabled = false;
            sgstInput.disabled = false;
            igstInput.disabled = false;
        }
    }

    // =========================================================
    // TAX CHANGE
    // =========================================================

    function taxChanged(input, taxType) {
        const row = input.closest('tr');
        const cgst = row.querySelector('.cgst-rate');
        const sgst = row.querySelector('.sgst-rate');
        const igst = row.querySelector('.igst-rate');

        let value = parseFloat(input.value) || 0;
        if (value < 0) {
            input.value = 0;
            value = 0;
        }

        if (taxType === 'CGST' || taxType === 'SGST') {
            if (value > 0) {
                igst.value = 0;
                igst.disabled = true;
            } else if ((parseFloat(cgst.value) || 0) === 0 && (parseFloat(sgst.value) || 0) === 0) {
                igst.disabled = false;
            }
        }

        if (taxType === 'IGST') {
            if (value > 0) {
                cgst.value = 0;
                sgst.value = 0;
                cgst.disabled = true;
                sgst.disabled = true;
            } else {
                cgst.disabled = false;
                sgst.disabled = false;
            }
        }

        calculateRow(input);
    }

    // =========================================================
    // CALCULATE ROW
    // =========================================================

    function calculateRow(el) {
        const row = el.closest('tr');
        if (!row) return;

        const rate = parseFloat(row.querySelector('.rate').value) || 0;
        const taxable =   rate;

        row.querySelector('.taxable-value').value = taxable.toFixed(2);

        const cgstRate = parseFloat(row.querySelector('.cgst-rate').value) || 0;
        const sgstRate = parseFloat(row.querySelector('.sgst-rate').value) || 0;
        const igstRate = parseFloat(row.querySelector('.igst-rate').value) || 0;

        const cgst = taxable * cgstRate / 100;
        const sgst = taxable * sgstRate / 100;
        const igst = taxable * igstRate / 100;

        row.querySelector('.cgst-amount').value = cgst.toFixed(2);
        row.querySelector('.sgst-amount').value = sgst.toFixed(2);
        row.querySelector('.igst-amount').value = igst.toFixed(2);
        row.querySelector('.row-total').value = (taxable + cgst + sgst + igst).toFixed(2);

        calculateAll();
    }

    // =========================================================
    // CALCULATE ALL
    // =========================================================

    function calculateAll() {
        let totalTaxable = 0, totalCGST = 0, totalSGST = 0, totalIGST = 0, grand = 0;

        document.querySelectorAll('.invoice-item-row').forEach(function (row) {
            totalTaxable += parseFloat(row.querySelector('.taxable-value').value) || 0;
            totalCGST += parseFloat(row.querySelector('.cgst-amount').value) || 0;
            totalSGST += parseFloat(row.querySelector('.sgst-amount').value) || 0;
            totalIGST += parseFloat(row.querySelector('.igst-amount').value) || 0;
            grand += parseFloat(row.querySelector('.row-total').value) || 0;
        });

        const totalTax = totalCGST + totalSGST + totalIGST;

        $('#totalTaxable').val(totalTaxable.toFixed(2));
        $('#totalCGST').val(totalCGST.toFixed(2));
        $('#totalSGST').val(totalSGST.toFixed(2));
        $('#totalIGST').val(totalIGST.toFixed(2));
        $('#grandTotalTable').val(grand.toFixed(2));

        $('#summaryBeforeTax').val(totalTaxable.toFixed(2));
        $('#summaryCGST').val(totalCGST.toFixed(2));
        $('#summarySGST').val(totalSGST.toFixed(2));
        $('#summaryIGST').val(totalIGST.toFixed(2));
        $('#summaryTax').val(totalTax.toFixed(2));
        $('#summaryGrandTotal').val(grand.toFixed(2));

        $('#TransAmt').val(grand.toFixed(2));

        updateAmountInWords();
    }

    // =========================================================
    // NUMBER TO WORDS
    // =========================================================

    function numberToWordsIndian(amount) {
        amount = parseFloat(amount) || 0;
        if (amount === 0) return "Zero Rupees Only";

        amount = Math.round(amount * 100) / 100;

        const ones = ["", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine",
            "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen"];
        const tens = ["", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"];

        function convertBelowThousand(num) {
            let result = "";
            if (num >= 100) {
                result += ones[Math.floor(num / 100)] + " Hundred ";
                num %= 100;
            }
            if (num >= 20) {
                result += tens[Math.floor(num / 10)] + " ";
                num %= 10;
            }
            if (num > 0) result += ones[num] + " ";
            return result.trim();
        }

        function convertIndian(num) {
            if (num < 1000) return convertBelowThousand(num);
            if (num < 100000) return convertIndian(Math.floor(num / 1000)) + " Thousand " + convertBelowThousand(num % 1000);
            if (num < 10000000) return convertIndian(Math.floor(num / 100000)) + " Lakh " + convertIndian(num % 100000);
            return convertIndian(Math.floor(num / 10000000)) + " Crore " + convertIndian(num % 10000000);
        }

        const rupees = Math.floor(amount);
        const paise = Math.round((amount - rupees) * 100);

        let words = convertIndian(rupees).replace(/\s+/g, " ").trim();
        let result = words + " Rupees";

        if (paise > 0) result += " and " + convertIndian(paise) + " Paise";
        result += " Only";

        return result;
    }

    // =========================================================
    // AMOUNT WORDS
    // =========================================================

    function updateAmountInWords() {
        const grandTotal = parseFloat($('#summaryGrandTotal').val()) || 0;
        $('#amountInWords').val(numberToWordsIndian(grandTotal));
    }

    // =========================================================
    // VALIDATION
    // =========================================================

    function validateInvoice() {
        let valid = true;

        $('.field-error').removeClass('field-error');
        $('.err-msg').text('');

        if (!$('#invoiceDate').val()) {
            $('#invoiceDate').addClass('field-error');
            $('#err-invoiceDate').text('Invoice Date is required.');
            valid = false;
        }

        if (!$('#companyNameHidden').val() && !$('#companyName').val()) {
            $('#companyName').addClass('field-error');
            $('#err-companyName').text('Company Name is required.');
            valid = false;
        }

        const rows = document.querySelectorAll('.invoice-item-row');
        if (rows.length === 0) {
            $('#err-items').text('At least one invoice item is required.');
            valid = false;
        }

        rows.forEach(function (row) {
            const description = row.querySelector('.description');
            const rate = row.querySelector('.rate');

            if (!description.value.trim()) {
                description.classList.add('field-error');
                valid = false;
            }

            if ((parseFloat(rate.value) || 0) <= 0) {
                rate.classList.add('field-error');
                valid = false;
            }
        });

        if (!valid) {
            const firstError = document.querySelector('.field-error');
            if (firstError) {
                firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            showToast("Please fix the highlighted errors before saving.", "error");
        }

        return valid;
    }

    // =========================================================
    // SAVE / UPDATE
    // =========================================================

    function saveInvoice() {
        calculateAll();
        
        if (!validateInvoice()) return;

        const main = {
            Id: invoiceId.toString(),
            invoiceno: $('#invoiceNo').val() || null,
            invoicedate: $('#invoiceDate').val() || null,
            reversecharge: $('#reverseCharge').val() || null,
            InvoiceType: $('#InvoiceType').val() || null,
            companyName: $('#companyNameHidden').val() || $('#companyName').val() || null,
            AgainstBy:      $('#AgainstByHidden').val()      || $('#AgainstBy').val()      || null,
            AgainstByValue: $('#AgainstByValueHidden').val() || $('#AgainstByValue').val() || null,
            gstIn: $('#gstin').val() || null,
            Address: $('#address').val() || null,
            Location: $('#Location').val() || null,
            PinCode: $('#billingPincode').val() || null,
            state: $('#billingState').val() || null,
            statecode: $('#billingStateCode').val() || null,
            TransMode: $('#Transaction').val() || null,
            TransNo: $('#transNo').val() || null,
            TransDate: $('#transDate').val() || null,
            TransAmt: $('#TransAmt').val() || null,

            cgst: parseFloat($('.cgst-rate').first().val()) || 0,
            sgst: parseFloat($('.sgst-rate').first().val()) || 0,
            igst: parseFloat($('.igst-rate').first().val()) || 0,

            cgstamt: parseFloat($('#summaryCGST').val()) || 0,
            sgstamt: parseFloat($('#summarySGST').val()) || 0,
            igstamt: parseFloat($('#summaryIGST').val()) || 0,

            totalqty: parseFloat($('#totalQty').val()) || 0,
            totalrate: parseFloat($('#summaryBeforeTax').val()) || 0,
            taxablevalue: parseFloat($('#summaryBeforeTax').val()) || 0,
            totalamtbeforetax: parseFloat($('#summaryBeforeTax').val()) || 0,
            totalamtaftertax: parseFloat($('#summaryGrandTotal').val()) || 0,
            total_tax_amount: String(parseFloat($('#summaryTax').val()) || 0),

            amtinwords: $('#amountInWords').val() || null
        };

        const details = [];

        document.querySelectorAll('.invoice-item-row').forEach(function (row) {
            details.push({
                id: parseInt(row.dataset.detailId || 0),
                invoiceid: invoiceId,
                serviceId:row.querySelector('.service-id').value.trim()          || null,
                serviceName:row.querySelector('.service-name-hidden').value.trim() || null,
                serviceTill:row.querySelector('.validTill').value.trim()            || null,
                productdescription: row.querySelector('.description').value.trim() || null,
                saccode: row.querySelector('.sac-code').value.trim() || null,
                qty: 1,
                rate: parseFloat(row.querySelector('.rate').value) || 0,
                amount: parseFloat(row.querySelector('.taxable-value').value) || 0,
                taxablevalue: parseFloat(row.querySelector('.taxable-value').value) || 0,
                cgstrate: parseFloat(row.querySelector('.cgst-rate').value) || 0,
                cgstamt: parseFloat(row.querySelector('.cgst-amount').value) || 0,
                sgstrate: parseFloat(row.querySelector('.sgst-rate').value) || 0,
                sgstamt: parseFloat(row.querySelector('.sgst-amount').value) || 0,
                igstrate: parseFloat(row.querySelector('.igst-rate').value) || 0,
                igstamt: parseFloat(row.querySelector('.igst-amount').value) || 0,
                total: parseFloat(row.querySelector('.row-total').value) || 0
            });
        });

        const payload = { Main: main, Details: details };

        const url = isEdit
            ? '@Url.Action("UpdateInvoice", "Taxinvoice")'
            : '@Url.Action("SaveInvoice", "Taxinvoice")';

        const $btn = $('#saveBtn');
        $btn.prop('disabled', true).text(isEdit ? 'Updating...' : 'Saving...');

        $.ajax({
            url: url,
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(payload),
            success: function (response) {
                if (response && response.success) {
                    showToast(isEdit ? 'Invoice updated successfully.' : 'Invoice saved successfully.', 'success');
                    setTimeout(function () {
                        window.location.href = '@Url.Action("Index", "Taxinvoice")';
                    }, 1200);
                } else {
                    showToast(response?.message || 'Operation failed.', 'error');
                }
            },
            error: function () {
                showToast('Error while processing invoice.', 'error');
            },
            complete: function () {
                $btn.prop('disabled', false).text(isEdit ? 'Update' : 'Save');
            }
        });
    }

    // =========================================================
    // CLEAR
    // =========================================================

    function clearInvoice() {
        showConfirmToast("Are you sure you want to clear the invoice?", function () {
            $('#companyName').val('').trigger('change');
            $('#reverseCharge').val('N');
            $('#Transaction').val('');

            [
                '#gstin', '#address', '#Location', '#billingState', '#billingPincode',
                '#billingStateCode', '#transNo', '#transDate', '#TransAmt', '#amountInWords'
            ].forEach(function (id) {
                $(id).val('');
            });

            $('#invoiceItems').empty();
            rowCounter = 0;
            addInvoiceRow();
            setTodayDate();

            $('.field-error').removeClass('field-error');
            $('.err-msg').text('');

            calculateAll();
            showToast("Invoice cleared.", "info");
        });
    }

     // =========================================================
    // Apply GST
    // =========================================================
    function applyGSTBasedOnCompany() {

        var gstin = $('#gstin').val() || '';
        gstin = gstin.trim();

        if (gstin.length < 2) {
            return;
        }

        // First 2 digits of GSTIN = State Code
        var customerStateCode = gstin.substring(0, 2);

        // Your company state code
        // Maharashtra = 27
        var companyStateCode = '27';

        $('.invoice-item-row').each(function () {

            var row = this;

            var cgstRate = row.querySelector('.cgst-rate');
            var sgstRate = row.querySelector('.sgst-rate');
            var igstRate = row.querySelector('.igst-rate');

            if (customerStateCode === companyStateCode) {

                // Same state
                cgstRate.value = '9';
                sgstRate.value = '9';
                igstRate.value = '0';

                cgstRate.disabled = false;
                sgstRate.disabled = false;
                igstRate.disabled = true;

            } else {

                // Other state
                cgstRate.value = '0';
                sgstRate.value = '0';
                igstRate.value = '18';

                cgstRate.disabled = true;
                sgstRate.disabled = true;
                igstRate.disabled = false;
            }

            calculateRow(cgstRate);
        });

        calculateAll();
        updateAmountInWords();
    }

</script>

<script type="text/javascript">
    let searchTimer = null;

    function searchService(input) {
        const query = input.value.trim();
        const dropdown = input.closest('.service-wrapper').querySelector('.service-dropdown');

        // Clear previous hidden id when user types again
        input.closest('.service-wrapper').querySelector('.service-id').value = '';

        if (query.length < 2) {
            dropdown.style.display = 'none';
            dropdown.innerHTML = '';
            return;
        }

        // Show loading state
        dropdown.style.display = 'block';
        dropdown.innerHTML = '<li style="padding:8px 12px; color:#999;">Searching...</li>';

        // Debounce: wait 300ms after user stops typing
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
            fetchServices(query, input, dropdown);
        }, 100);
    }

    // ─── AJAX call ────────────────────────────────────────────────────────────────
    function fetchServices(query, input, dropdown) {
        $.ajax({
            url: '@Url.Action("SearchServices", "Taxinvoice")',   // 🔁 Change to your endpoint
            type: 'GET',
            data: { q: query },
            success: function (response) {
                renderServiceDropdown(response, input, dropdown);
            },
            error: function () {
                dropdown.innerHTML = '<li style="padding:8px 12px; color:red;">Error fetching services.</li>';
            }
        });
    }

    // ─── Render dropdown list ─────────────────────────────────────────────────────
    function renderServiceDropdown(services, input, dropdown) {
        dropdown.innerHTML = '';

        if (!services || services.length === 0) {
            dropdown.innerHTML = '<li style="padding:8px 12px; color:#999;">No services found.</li>';
            return;
        }

        services.forEach((svc, index) => {
            const li = document.createElement('li');
            li.style.cssText = 'padding:8px 12px; cursor:pointer; border-bottom:1px solid #f0f0f0; font-size:11px;';
            li.setAttribute('data-index', index);

            // Highlight matched text
            const regex = new RegExp(`(${input.value.trim()})`, 'gi');
            const highlighted = svc.serviceName.replace(regex, '<strong>$1</strong>');

            li.innerHTML = `
                <div style="font-weight:500;">${highlighted}</div>
                ${svc.saccode ? `<div style="font-size:9px; color:#888;">SAC: ${svc.saccode}</div>` : ''}
            `;

            li.addEventListener('mouseenter', () => {
                clearHighlight(dropdown);
                li.style.background = '#f0f7ff';
                li.classList.add('highlighted');
            });
            li.addEventListener('mouseleave', () => {
                li.style.background = '';
                li.classList.remove('highlighted');
            });
            li.addEventListener('mousedown', (e) => {
                e.preventDefault(); // prevent input blur before click fires
                selectService(svc, input);
            });

            dropdown.appendChild(li);
        });

        dropdown.style.display = 'block';
    }

    function selectService(svc, input) {
        const row     = input.closest('tr');
        const wrapper = input.closest('.service-wrapper');

        input.value = svc.serviceName ?? '';
        wrapper.querySelector('.service-id').value          = svc.serviceId  ?? '';
        wrapper.querySelector('.service-name-hidden').value = svc.serviceName ?? '';

        row.querySelector('.sac-code').value  = svc.saccode ?? '998314';
        row.querySelector('.rate').value      = svc.rate    ?? 0;

        wrapper.querySelector('.service-dropdown').style.display = 'none';
        wrapper.querySelector('.service-dropdown').innerHTML     = '';

        calculateRow(row.querySelector('.rate'));
        applyGSTBasedOnCompany();
        calculateAll();
        updateAmountInWords();
    }

    // ─── Keyboard navigation (↑ ↓ Enter Escape) ───────────────────────────────────
    function handleServiceKeydown(e, input) {
        const dropdown = input.closest('.service-wrapper').querySelector('.service-dropdown');
        const items    = dropdown.querySelectorAll('li[data-index]');

        if (!items.length) return;

        let current = dropdown.querySelector('.highlighted');
        let idx     = current ? parseInt(current.getAttribute('data-index')) : -1;

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            idx = Math.min(idx + 1, items.length - 1);
            setHighlight(items, idx);

        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            idx = Math.max(idx - 1, 0);
            setHighlight(items, idx);

        } else if (e.key === 'Enter') {
            e.preventDefault();
            if (current) current.dispatchEvent(new Event('mousedown'));

        } else if (e.key === 'Escape') {
            dropdown.style.display = 'none';
        }
    }

    function setHighlight(items, idx) {
        items.forEach(li => {
            li.style.background = '';
            li.classList.remove('highlighted');
        });
        items[idx].style.background = '#f0f7ff';
        items[idx].classList.add('highlighted');
        items[idx].scrollIntoView({ block: 'nearest' });
    }

    function clearHighlight(dropdown) {
        dropdown.querySelectorAll('li').forEach(li => {
            li.style.background = '';
            li.classList.remove('highlighted');
        });
    }

    function closeAllServiceDropdowns(e) {
        if (!e.target.closest('.service-wrapper')) {
            document.querySelectorAll('.service-dropdown').forEach(d => {
                d.style.display = 'none';
            });
        }
    }
</script>
