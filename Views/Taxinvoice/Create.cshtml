@model WLSPL_ERP_CRM.Models.Taxinvoice.TaxInvoiceCreateVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style type="text/css">
    .required::after {
        content: " *";
        color: red;
    }

    /* ── All form inputs / selects / textareas — light grey like screenshot ── */
    .form-control {
        border: 1px solid gray !important;
    }

        .form-control,
        .form-control:focus {
            background-color: #f4f5f6 !important;
            border: 1px solid #ced4da;
            color: #444;
            border-radius: 3px;
        }

            .form-control[readonly],
            .form-control:disabled {
                background-color: #e8eaeb !important;
                color: #6c757d;
                cursor: default;
            }

    /* Select2 match */
    .select2-container .select2-selection--single {
        background-color: #f4f5f6 !important;
        border: 1px solid #343434 !important;
        border-radius: 3px !important;
        height: 38px !important;
    }

        .select2-container .select2-selection--single .select2-selection__rendered {
            line-height: 36px !important;
            color: #444 !important;
        }

        .select2-container .select2-selection--single .select2-selection__arrow {
            height: 36px !important;
        }

    /* ── Consistent card-body row spacing ── */
    .card-body .row.form-row-item {
        margin-bottom: 16px;
    }

        .card-body .row.form-row-item:last-child {
            margin-bottom: 0;
        }

    /* ── Table ── */
    .invoice-table {
        width: 100%;
        height: 170px;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .invoice-table th,
        .invoice-table td {
            border: 1px solid #dee2e6;
            padding: 4px 6px;
            vertical-align: middle;
            text-align: center;
        }

        .invoice-table th {
            background: linear-gradient(314deg, #0b0f14, #1a3e66);
            color: #fff;
            font-size: 11px;
            font-weight: 600;
            white-space: normal;
        }

        .invoice-table td input,
        .invoice-table td select,
        .invoice-table td textarea {
            width: 100%;
            font-size: 11px;
            border: 1px solid gray;
            border-radius: 3px;
            padding: 2px 4px;
            background: #f4f5f6;
            color: #444;
        }

            .invoice-table td input[readonly],
            .invoice-table td input:disabled {
                background: #e8eaeb !important;
                color: #6c757d;
                cursor: default;
            }

        .invoice-table td textarea {
            min-height: 60px;
            resize: vertical;
        }

    /* column widths */
    .col-sn {
        width: 35px;
    }

    .col-qty {
        width: 100px;
    }

    .col-rate {
        width: 90px;
    }

    .col-taxable {
        width: 90px;
    }

    .col-tax {
        width: 110px;
    }

    .col-total {
        width: 95px;
    }

    .col-action {
        width: 36px;
    }

    .tax-pair {
        display: grid;
        grid-template-columns: 44px 1fr;
        gap: 3px;
    }

    .tfoot-row td {
        background: #f1f3f5;
        font-weight: 600;
    }

    /* ── Summary grid ── */
    .summary-grid {
        display: grid;
        grid-template-columns: 60% 40%;
    }

    .summary-right .summary-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #dee2e6;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 600;
    }

        .summary-right .summary-row input {
            width: 130px;
            text-align: right;
            border: 1px solid #ced4da;
            border-radius: 3px;
            background: #e8eaeb !important;
            color: #444;
            font-size: 11px;
            padding: 2px 6px;
            height: 28px;
        }

    .words-box {
        padding: 12px;
        min-height: 90px;
    }

        .words-box textarea {
            width: 100%;
            min-height: 55px;
            border: 1px solid #ced4da;
            border-radius: 3px;
            font-size: 11px;
            padding: 4px 6px;
            resize: vertical;
            background: #f4f5f6;
            color: #444;
        }

    /* ── Bank / Signature ── */
    .bottom-grid {
        display: grid;
        grid-template-columns: 60% 40%;
    }

    .bank-info p {
        margin: 0;
        font-size: 12px;
        padding: 6px 14px;
        border-bottom: 1px solid #343434;
    }

    .signature-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .seal-box,
    .sig-box {
        min-height: 120px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        font-size: 11px;
    }

    .seal {
        width: 72px;
        height: 72px;
        border: 2px solid #7186a2;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        color: #7186a2;
        transform: rotate(-15deg);
        text-align: center;
        font-size: 9px;
    }

    .seal-inner {
        width: 52px;
        height: 52px;
        border: 1px solid #7186a2;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* ── Validation ── */
    .field-error {
        border-color: #dc3545 !important;
        background-color: #fff5f5 !important;
        box-shadow: 0 0 0 0.15rem rgba(220,53,69,.15);
    }

    .err-msg {
        font-size: 10px;
        color: #dc3545;
        display: block;
        margin-top: 2px;
    }

    /* ── Print ── */
    @@media print {
        .add-row-btn, .remove-row, .action-btns {
            display: none !important;
        }

        @@page {
            size: A4 landscape;
            margin: 8mm;
        }
    }
</style>

<style type="text/css">
    .sd-top {
        display: grid;
        grid-template-columns: 1fr 100px;
        border-bottom: 1px solid #dee2e6;
    }

    .sd-service {
        padding: 6px 8px;
        border-right: 1px solid #dee2e6;
    }

    .sd-sac {
        padding: 6px 8px;
    }

    .sd-bottom {
        padding: 6px 8px;
    }



    .service-wrapper {
        position: relative;
    }

    .service-dropdown {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 9999;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 4px;
        max-height: 200px;
        overflow-y: auto;
        list-style: none;
        margin: 2px 0 0;
        padding: 0;
        box-shadow: 0 4px 12px rgba(0,0,0,.12);
    }
</style>

<form id="frmTaxInvoice">
    <!-- ══════════════ INVOICE HEADER ══════════════ -->
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between"
             style="background:  linear-gradient(314deg, #0b0f14, #1a3e66);">
            <h5 style="margin:0; color:#fff;">Tax Invoice</h5>
            <button type="button" class="btn btn-primary btn-sm" onclick="window.history.back();">
                <i class="fa fa-arrow-left"></i> Back
            </button>
        </div>

        <div class="card-body">

            <div class="row form-row-item">
                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold required">Invoice No</label>
                        <div class="col-md-8">
                            <input asp-for="main.invoiceno" type="text" class="form-control" id="invoiceNo"
                                   placeholder="Invoice No" readonly />
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold required">Invoice Date</label>
                        <div class="col-md-8">
                            <input asp-for="main.invoicedate" type="date" class="form-control"
                                   id="invoiceDate" />
                            <span class="err-msg" id="err-invoiceDate"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row form-row-item">
                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold">Reverse Charge</label>
                        <div class="col-md-8">
                            <select asp-for="main.reversecharge" class="form-control" id="reverseCharge">
                                <option value="N">N</option>
                                <option value="Y">Y</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ══════════════ BILL TO ══════════════ -->
    <div class="card mt-3">
        <div class="card-header" style="background:  linear-gradient(314deg, #0b0f14, #1a3e66);">
            <h5 style="margin:0; color:#fff;">Bill To</h5>
        </div>
        <div class="card-body">


            <div class="row form-row-item">
                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold required">Company Name</label>
                        <div class="col-md-8">
                            <select asp-for="main.companyName" class="form-control ddlselect"
                                    id="companyName">
                                <option value="">Select Company</option>
                                @foreach (var company in Model.companies)
                                {
                                    <option value="@company.companyName">
                                        @company.companyName
                                    </option>
                                }
                            </select>
                            <span class="err-msg" id="err-companyName"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold">Billing GST</label>
                        <div class="col-md-8">
                            <input asp-for="main.gstIn" type="text" class="form-control" id="gstin" placeholder="Billing GST" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="row form-row-item">
                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold">Billing Address</label>
                        <div class="col-md-8">
                            <textarea asp-for="main.Address" class="form-control" id="address" rows="2" placeholder="Billing Address"></textarea>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold">Billing Location</label>
                        <div class="col-md-8">
                            <input asp-for="main.Location" type="text" class="form-control" id="Location"
                                   placeholder="Billing Location" />
                        </div>
                    </div>
                </div>

            </div>

            <div class="row form-row-item">
                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold">Pincode</label>
                        <div class="col-md-8">
                            <input asp-for="main.PinCode" type="text" class="form-control" id="billingPincode"
                                   placeholder="Pincode" />
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold">Billing State</label>
                        <div class="col-md-8">
                            <input asp-for="main.state" type="text" class="form-control" id="billingState"
                                   placeholder="Billing State" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="row form-row-item">
                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold">Billing State Code</label>
                        <div class="col-md-8">
                            <input asp-for="main.statecode" type="text" class="form-control" id="billingStateCode"
                                   placeholder="State Code" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="row form-row-item">
                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold">Transaction Mode</label>
                        <div class="col-md-8">
                            <select asp-for="main.TransMode" class="form-control" id="Transaction">
                                <option value="">Select Transaction Mode</option>
                                <option value="Cheque">Cheque</option>
                                <option value="Online/UPI">Online/UPI</option>
                                <option value="Cash">Cash</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold">Transaction No</label>
                        <div class="col-md-8">
                            <input asp-for="main.TransNo" type="text" class="form-control" id="transNo"
                                   placeholder="Transaction No" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="row form-row-item">
                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold">Transaction Date</label>
                        <div class="col-md-8">
                            <input asp-for="main.TransDate" type="date" class="form-control" id="transDate" />
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold">Trasnaction Amount</label>
                        <div class="col-md-8">
                            <input asp-for="main.TransAmt" type="text" class="form-control" id="TransAmt"
                                   placeholder="Trasnaction Amount" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="row form-row-item">
                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold">Against By</label>
                        <div class="col-md-8">
                            <select asp-for="main.AgainstBy" type="text" class="form-control" id="AgainstBy">
                                <option value="Direct">Direct</option>
                                <option value="Quotation">Quotation</option>
                                <option value="Proforma">Proforma</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group row">
                        <label class="col-md-4 col-form-label font-weight-bold">Against By Value</label>
                        <div class="col-md-8">
                            <select asp-for="main.AgainstByValue" type="text" class="form-control" id="AgainstByValue">
                            </select>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ══════════════ ITEM DETAILS ══════════════ -->
    <div class="card mt-3">
        <div class="card-header" style="background:  linear-gradient(314deg, #0b0f14, #1a3e66);">
            <h5 style="margin:0; color:#fff;">Service Details</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="invoice-table" id="invoiceTable">
                    <thead>
                        <tr>
                            <th class="col-sn" rowspan="3">S.No</th>
                            <th colspan="2" style="width:280px;"></th>
                            <th class="col-qty" rowspan="3">Service Till</th>
                            <th class="col-rate" rowspan="3">Rate</th>
                            <th class="col-taxable" rowspan="3">Taxable Value</th>
                            <th class="col-tax" rowspan="3">CGST % | Amt</th>
                            <th class="col-tax" rowspan="3">SGST % | Amt</th>
                            <th class="col-tax" rowspan="3">IGST % | Amt</th>
                            <th class="col-total" rowspan="3">Total</th>
                            <th class="col-action" rowspan="3">#</th>
                        </tr>
                        <tr>
                            <th style="width:160px; border-right:1px solid rgba(255,255,255,0.2); border-bottom:1px solid rgba(255,255,255,0.2); font-size:10px; letter-spacing:.5px;">SERVICE</th>
                            <th style="width:100px; border-bottom:1px solid rgba(255,255,255,0.2); font-size:10px; letter-spacing:.5px;">SAC CODE</th>
                        </tr>
                        <tr>
                            <th colspan="2" style="font-size:10px; letter-spacing:.5px;">SERVICE DESCRIPTION</th>
                        </tr>
                    </thead>
                    <tbody id="invoiceItems"></tbody>
                    <tfoot>
                        <tr class="tfoot-row">
                            <td></td>
                            <td colspan="3" style="text-align:right; padding-right:10px; font-weight:700;">TOTAL</td>
                            <td></td>
                            <td><input type="text" id="totalTaxable" readonly class="form-control form-control-sm text-right" /></td>
                            <td><input type="text" id="totalCGST" readonly class="form-control form-control-sm text-right" /></td>
                            <td><input type="text" id="totalSGST" readonly class="form-control form-control-sm text-right" /></td>
                            <td><input type="text" id="totalIGST" readonly class="form-control form-control-sm text-right" /></td>
                            <td><input type="text" id="grandTotalTable" readonly class="form-control form-control-sm text-right" /></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="p-2 pt-3">
                <button type="button" class="btn btn-success btn-sm add-row-btn" onclick="addInvoiceRow()">
                    + Add New Row
                </button>
                <span class="err-msg d-inline-block ml-2" id="err-items"></span>
            </div>
        </div>
    </div>

    <!-- ══════════════ SUMMARY ══════════════ -->
    <div class="card mt-3">
        <div class="card-header" style="background:  linear-gradient(314deg, #0b0f14, #1a3e66);">
            <h5 style="margin:0; color:#fff;">Summary</h5>
        </div>
        <div class="card-body p-0">
            <div class="summary-grid">

                <div style="border-right:1px solid #dee2e6;">
                    <div style="padding:10px 12px; font-size:12px; font-weight:700; border-bottom:1px solid #000000;">
                        Amount in Words
                    </div>
                    <div class="words-box">
                        <label class="font-weight-bold mb-1" style="font-size:12px;">Total Amount (in words)</label>
                        <textarea id="amountInWords" asp-for="main.amtinwords" style="color: red;font-size: large;font-weight: 600;"
                                  placeholder="Amount in words" readonly="readonly"></textarea>
                        <span class="err-msg" id="err-amountInWords"></span>
                    </div>
                </div>

                <div class="summary-right">

                    <div style="padding:10px 16px; font-size:12px; font-weight:700;
                     border-bottom:1px solid #000000; display:flex; align-items:center; gap:6px;">
                        <i class="ti ti-calculator" style="font-size:14px; color:#1a3e66;"></i>
                        Tax Summary
                    </div>

                    <div class="summary-row">
                        <span><i class="ti ti-file-invoice" style="margin-right:5px;"></i>Total Basic Amount</span>
                        <input type="text" id="summaryBeforeTax" readonly />
                    </div>

                    <div class="summary-row">
                        <span><i class="ti ti-percentage" style="margin-right:5px;"></i>Total CGST</span>
                        <input type="text" id="summaryCGST" readonly />
                    </div>

                    <div class="summary-row">
                        <span><i class="ti ti-percentage" style="margin-right:5px;"></i>Total SGST</span>
                        <input type="text" id="summarySGST" readonly />
                    </div>

                    <div class="summary-row">
                        <span><i class="ti ti-percentage" style="margin-right:5px;"></i>Total IGST</span>
                        <input type="text" id="summaryIGST" readonly />
                    </div>

                    <div class="summary-row" style="background:#eef6ff;">
                        <span style="color:#185fa5; font-weight:600;">
                            <i class="ti ti-receipt-tax" style="margin-right:5px;"></i>Total Tax Amount
                        </span>
                        <input type="text" id="summaryTax" readonly
                               style="background:#d0e8ff !important; border-color:#378add; color:#185fa5; font-weight:600;" />
                    </div>

                    <div class="summary-row">
                        <span><i class="ti ti-cash" style="margin-right:5px;"></i>Grand Total</span>
                        <input type="text" id="summaryamountGtotal" readonly />
                    </div>

                    <!-- TDS row -->
                    <div class="summary-row" style="background:#fffbeb; border-top:1px dashed #e0c97a;">
                        <span style="color:#854f0b; font-weight:600; display:flex; align-items:center; gap:6px;">
                            <i class="ti ti-minus-vertical"></i>
                            TDS Deduction
                            <span style="font-size:10px; background:#fef3c7; color:#854f0b;
                   border:0.5px solid #e0c97a; border-radius:999px;
                   padding:1px 7px; font-weight:500;">%</span>
                        </span>
                        <input type="number" id="tdsPercent" min="0" max="100" value="0"
                               placeholder="Enter %"
                               oninput="calculateTDS()"
                               style="width:130px; text-align:right; border:1px solid #d0a800;
                  border-radius:6px; background:#fffef0 !important;
                  color:#444; font-size:11px; padding:2px 8px; height:28px;" />
                    </div>

                    <div class="summary-row" style="background:#fff5f5;">
                        <span style="color:#a32d2d;">
                            <i class="ti ti-arrow-down-circle" style="margin-right:5px;"></i>TDS Amount
                        </span>
                        <input type="text" id="summaryTDSAmount" readonly
                               style="background:#ffe4e4 !important; border-color:#f09595; color:#a32d2d;" />
                    </div>

                    <!-- Total Payable — dark footer row -->
                    <div style="display:flex; align-items:center; justify-content:space-between;
                          padding:10px 16px;
                          background:linear-gradient(135deg,#0b0f14,#1a3e66);
                          border-radius:0 0 8px 8px;">
                        <span style="font-size:12px; font-weight:600; color:rgba(255,255,255,0.85);
                             display:flex; align-items:center; gap:6px;">
                            <i class="ti ti-wallet" style="color:rgba(255,255,255,0.7);"></i>
                            Total Payable
                        </span>
                        <input type="text" id="summaryGrandTotal" readonly
                               style="width:130px; text-align:right; border:1px solid rgba(255,255,255,0.3);
                              border-radius:6px; background:rgba(255,255,255,0.1) !important;
                              color:#fff; font-size:13px; font-weight:700;
                              padding:2px 8px; height:30px;" />
                    </div>

                </div>

            </div>
        </div>
    </div>

    <!-- ══════════════ BANK + SIGNATURE ══════════════ -->
    <div class="card mt-3 d-none">
        <div class="card-body p-0">
            <div class="bottom-grid">

                <div style="border-right:1px solid #343434;">
                    <div style="padding:10px 12px; font-size:12px; font-weight:700; border-bottom:1px solid #343434;
                                background:  linear-gradient(314deg, #0b0f14, #1a3e66); color:#fff;">
                        Bank Details
                    </div>
                    <div class="bank-info">
                        <p><strong>Bank A/C :</strong>&nbsp; 916020085136854</p>
                        <p><strong>For :</strong>&nbsp; Web Link Services Pvt Ltd</p>
                        <p><strong>Bank IFSC :</strong>&nbsp; UTIB0001641</p>
                        <p><strong>Bank Name :</strong>&nbsp; Axis Bank Ltd</p>
                        <p><strong>Branch :</strong>&nbsp; Rahatani Branch, Pune</p>
                    </div>
                </div>

                <div class="signature-grid">
                    <div class="seal-box" style="border-right:1px solid #343434;">
                        <div class="seal">
                            <div class="seal-inner">COMPANY<br />SEAL</div>
                        </div>
                        <small class="mt-2 text-muted">Common Seal</small>
                    </div>
                    <div class="sig-box" style="justify-content:space-between; padding:14px 10px;">
                        <div style="font-size:11px; text-align:center;">
                            For,<br /><strong>Web Link Services Pvt Ltd</strong>
                        </div>
                        <div style="font-size:11px;">Authorized Signatory</div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- ══════════════ ACTION BUTTONS ══════════════ -->
    <div class="row justify-content-center mt-3 mb-4 action-btns">
        <div class="col-auto">
            <button type="button" class="btn btn-primary px-4" onclick="saveInvoice()">Save</button>
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-danger px-4" onclick="clearInvoice()">Clear</button>
        </div>
    </div>

</form>


<script type="text/javascript">
     // Razor writes this once — all JS can read it
     const isAdmin = @(Context.Session.GetString("Role").ToString() == "Admin" ? "true" : "false");
     let rowCounter = 0;

     $(document).ready(function () {
         $('#companyName').select2({ placeholder: 'Select Company', allowClear: true, width: '100%' });
         $('#companyName').on('change', function () {
             const cname = $(this).val();
             if (!cname) { clearCompanyDetails(); return; }
             getCompanyDetails(cname);
         });

          // AgainstByValue — initially disabled
         $('#AgainstByValue').prop('disabled', true)
             .html('<option value="">-- Select First --</option>');

         $('#AgainstBy').on('change', function () {
             const selected    = $(this).val();
             const companyName = $('#companyName').val();

             $('#AgainstByValue').html('<option value="">-- Select --</option>').prop('disabled', true);

             if (selected === 'Quotation' || selected === 'Proforma') {
                   $('.add-row-btn').hide();
                 if (!companyName) {
                         showToast('Please select a Company first.', 'warning');
                         $(this).val('Direct');
                         return;
                 }

                 $('#AgainstByValue').html('<option value="">Loading...</option>');

                 $.ajax({
                     url: '@Url.Action("GetQuotationsByCompany", "Taxinvoice")',
                     type: 'GET',
                     data: { companyName: companyName, type: selected },
                     success: function (response) {
                         $('#AgainstByValue').html('<option value="">-- Select --</option>');
                         if (!response || response.length === 0) {
                             $('#AgainstByValue').html('<option value="">No records found</option>');
                             return;
                         }
                         response.forEach(function (item) {
                             $('#AgainstByValue').append(
                                 $('<option>').val(item.id).text(item.displayText)
                             );
                         });
                         $('#AgainstByValue').prop('disabled', false);
                     },
                     error: function () {
                         $('#AgainstByValue').html('<option value="">No data</option>');
                     }
                 });
             } else {
                 $('#AgainstByValue').html('<option value="">N/A</option>').prop('disabled', true);
             }
         });

             setTodayDate();
             addInvoiceRow();
            applyGSTBasedOnCompany();
         });

         $('#AgainstByValue').on('change', function () {
             const selectedId = $(this).val();
             const type       = $('#AgainstBy').val();

             if (!selectedId || selectedId === '') return;

             $.ajax({
                 url: '@Url.Action("GetQuotationProformaDetails", "Taxinvoice")',
                 type: 'GET',
                 data: { id: selectedId, type: type },
                 beforeSend: function () {
                     $('#AgainstByValue').prop('disabled', true);
                 },
                 success: function (response) {
                     if (!response) {
                         showToast('No data found.', 'warning');
                         return;
                     }
                     bindQuotationProformaData(response);
                 },
                 error: function () {
                     showToast('Error loading details.', 'error');
                 },
                 complete: function () {
                     $('#AgainstByValue').prop('disabled', false);
                 }
             });
         });

     function bindQuotationProformaData(data) {
         // ── Clear existing rows ──
         document.getElementById('invoiceItems').innerHTML = '';
         rowCounter = 0;

         if (data.details && data.details.length > 0) {
             data.details.forEach(function (item) {
                 addInvoiceRow();

                 const rows = document.querySelectorAll('.invoice-item-row');
                 const row  = rows[rows.length - 1];

                 // ── Service ──
                 row.querySelector('.service').value             = item.serviceName        || '';
                 row.querySelector('.service-name-hidden').value = item.serviceName        || '';
                 row.querySelector('.service-id').value          = item.serviceId          || '';
                 row.querySelector('.sac-code').value            = item.sacCode            || '';
                 row.querySelector('.description').value         = item.productdescription || '';

                 // ── Amounts ──
                 row.querySelector('.rate').value          = parseInt(item.rate)         || 0;
                 row.querySelector('.taxable-value').value = parseInt(item.taxablevalue) || 0;

                 // ── CGST ──
                 row.querySelector('.cgst-rate').value   = parseInt(item.cgstrate) || 0;
                 row.querySelector('.cgst-amount').value = parseInt(item.cgstamt)  || 0;

                 // ── SGST ──
                 row.querySelector('.sgst-rate').value   = parseInt(item.sgstrate) || 0;
                 row.querySelector('.sgst-amount').value = parseInt(item.sgstamt)  || 0;

                 // ── IGST ──
                 row.querySelector('.igst-rate').value   = parseInt(item.igstrate) || 0;
                 row.querySelector('.igst-amount').value = parseInt(item.igstamt)  || 0;

                 // ── Row Total ──
                 row.querySelector('.row-total').value = parseInt(item.total) || 0;

                 // ── Lock/unlock tax fields based on which tax is applied ──
                 const cgst = parseInt(item.cgstrate) || 0;
                 const igst = parseInt(item.igstrate) || 0;

             });
         } else {
             addInvoiceRow();
         }

         calculateAll();
         updateAmountInWords();
     }

     function getCompanyDetails(cname) {
         $.ajax({
             url: '@Url.Action("Getcomapnybycname", "Taxinvoice")',
             type: 'GET',
             data: { cname: cname },
             beforeSend: function () { $('#companyName').prop('disabled', true); },
             success: function (data) {
                if (!data) {
                     showToast('Company details not found.', 'warning');
                     clearCompanyDetails();
                     return;
                }
                 $('#gstin').val(data.gstIn || '');
                 $('#address').val(data.address || '');
                 $('#Location').val(data.location ||  '');
                 $('#billingState').val(data.state || '');
                 $('#billingPincode').val(data.pinCode || '');
                 $('#billingStateCode').val(data.statecode  || '');
                 applyGSTBasedOnCompany();
             },
             error: function () { alert("Error while loading company details."); },
             complete: function () { $('#companyName').prop('disabled', false); }
         });
     }

     function clearCompanyDetails() {
         ['#gstin','#address','#Location','#billingState',
          '#billingPincode','#billingStateCode'].forEach(id => $(id).val(''));
     }

     function setTodayDate() {
         const d = new Date();
         $('#invoiceDate').val(`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`);
     }

     function addInvoiceRow() {
         rowCounter++;
         const row = document.createElement('tr');
         row.className = 'invoice-item-row';
         row.innerHTML = `
             <td><input type="text" value="${rowCounter}" readonly class="serial-number" /></td>
             <td class="service-desc-cell" colspan="2">
                 <div class="sd-top">
                     <div class="sd-service">
                         <div class="service-wrapper" style="position:relative;">
                             <input type="text" placeholder="Search service..." class="service"
                                    autocomplete="off"
                                    oninput="searchService(this)"
                                    onkeydown="handleServiceKeydown(event,this)" ${!isAdmin ? 'disabled' : ''} />
                             <input type="hidden" class="service-id" />
                             <input type="hidden" class="service-name-hidden" />
                             <ul class="service-dropdown"></ul>
                         </div>
                     </div>
                     <div class="sd-sac">
                         <input type="text" class="sac-code" value="" placeholder="SAC Code" />
                     </div>
                 </div>
                 <div class="sd-bottom">
                     <textarea class="description" placeholder="Enter service description..."></textarea>
                 </div>
             </td>
             <td>
                 <select class="validTill">
                     <option value="1 Year">1 Year</option>
                     <option value="2 Year">2 Year</option>
                     <option value="3 Year">3 Year</option>
                     <option value="4 Year">4 Year</option>
                     <option value="5 Year">5 Year</option>
                 </select>
             </td>
             <td><input type="number" class="rate" min="0" value="0"
                        oninput="calculateRow(this);updateAmountInWords();"
                        onblur="updateAmountInWords();" /></td>
             <td><input type="number" class="taxable-value" value="0" readonly /></td>
             <td><div class="tax-pair">
                 <input type="number" class="cgst-rate" min="0" value="0" placeholder="%"
                        oninput="taxChanged(this,'CGST');updateAmountInWords();"
                        onblur="updateAmountInWords();" ${!isAdmin ? 'disabled' : ''} />
                 <input type="text" class="cgst-amount" value="0" readonly />
             </div></td>
             <td><div class="tax-pair">
                 <input type="number" class="sgst-rate" min="0" value="0" placeholder="%"
                        oninput="taxChanged(this,'SGST');updateAmountInWords();"
                        onblur="updateAmountInWords();" ${!isAdmin ? 'disabled' : ''} />
                 <input type="text" class="sgst-amount" value="0" readonly />
             </div></td>
             <td><div class="tax-pair">
                 <input type="number" class="igst-rate" min="0" value="0" placeholder="%"
                        oninput="taxChanged(this,'IGST');updateAmountInWords();"
                        onblur="updateAmountInWords();" ${!isAdmin ? 'disabled' : ''} />
                 <input type="text" class="igst-amount" value="0" readonly />
             </div></td>
             <td><input type="number" class="row-total" value="0" readonly /></td>
             <td><button type="button" class="btn btn-danger btn-sm remove-row"
                         onclick="removeRow(this);" style="padding:1px 6px;">×</button></td>`;

         document.getElementById('invoiceItems').appendChild(row);
         applyGSTBasedOnCompany();
         refreshSerialNumbers();
         calculateAll();
         updateAmountInWords();
         $('#err-items').text('');
     }

     function removeRow(btn) {
         if (document.querySelectorAll('.invoice-item-row').length <= 1) {
             showToast('At least one item row is required.', 'warning');
             return;
         }
         showConfirmToast('Remove this row?', function () {
             btn.closest('tr').remove();
             refreshSerialNumbers();
             calculateAll();
         });
     }

     function refreshSerialNumbers() {
         document.querySelectorAll('.invoice-item-row').forEach((r, i) => {
             r.querySelector('.serial-number').value = i + 1;
         });
     }

     function taxChanged(input, taxType) {
         const row = input.closest('tr');
         const cgst = row.querySelector('.cgst-rate');
         const sgst = row.querySelector('.sgst-rate');
         const igst = row.querySelector('.igst-rate');
         let v = parseFloat(input.value) || 0;
         if (v < 0) { input.value = 0; v = 0; }
         if (taxType === 'CGST' || taxType === 'SGST') {
             if (v > 0) { igst.value = 0; igst.disabled = true; }
             else if ((parseFloat(cgst.value)||0)===0 && (parseFloat(sgst.value)||0)===0) igst.disabled = false;
         }
         if (taxType === 'IGST') {
             if (v > 0) { cgst.value = 0; sgst.value = 0; cgst.disabled = true; sgst.disabled = true; }
             else { cgst.disabled = false; sgst.disabled = false; }
         }
         calculateRow(input);
     }


    function calculateTDS() {
         // TDS always on basic/taxable amount (before GST)
         const taxableBase = parseFloat($('#summaryGrandTotal').data('tds-base')) || 0;
         const tdsPercent  = parseFloat($('#tdsPercent').val()) || 0;

         if (tdsPercent < 0 || tdsPercent > 100) {
             showToast('TDS % must be between 0 and 100.', 'warning');
             return;
         }

         const tdsAmount     = (taxableBase * tdsPercent) / 100;

         // Grand payable = grand total (with GST) - TDS amount
         const grandWithGST  = parseFloat($('#summaryamountGtotal').val()) || 0;
         const totalPayable  = grandWithGST - tdsAmount;

         $('#summaryTDSAmount').val(tdsAmount.toFixed(2));
         $('#summaryGrandTotal').val(totalPayable.toFixed(2));
         updateAmountInWords();
     }

     function calculateRow(el) {
         const row = el.closest('tr');
         if (!row) return;
         const rate = parseFloat(row.querySelector('.rate').value) || 0;
         const taxable = rate;
         row.querySelector('.taxable-value').value = taxable.toFixed(2);
         const cgst = taxable * (parseFloat(row.querySelector('.cgst-rate').value)||0) / 100;
         const sgst = taxable * (parseFloat(row.querySelector('.sgst-rate').value)||0) / 100;
         const igst = taxable * (parseFloat(row.querySelector('.igst-rate').value)||0) / 100;
         row.querySelector('.cgst-amount').value = cgst.toFixed(2);
         row.querySelector('.sgst-amount').value = sgst.toFixed(2);
         row.querySelector('.igst-amount').value = igst.toFixed(2);
         row.querySelector('.row-total').value = (taxable + cgst + sgst + igst).toFixed(2);
         calculateAll();
     }

     function calculateAll() {
         let totalQty=0, totalTaxable=0, totalCGST=0, totalSGST=0, totalIGST=0, grand=0;
         document.querySelectorAll('.invoice-item-row').forEach(row => {
             totalTaxable += parseFloat(row.querySelector('.taxable-value').value)||0;
             totalCGST    += parseFloat(row.querySelector('.cgst-amount').value)||0;
             totalSGST    += parseFloat(row.querySelector('.sgst-amount').value)||0;
             totalIGST    += parseFloat(row.querySelector('.igst-amount').value)||0;
             grand        += parseFloat(row.querySelector('.row-total').value)||0;
         });
         const totalTax = totalCGST + totalSGST + totalIGST;
         $('#totalTaxable').val(totalTaxable.toFixed(2));
         $('#totalCGST').val(totalCGST.toFixed(2));
         $('#totalSGST').val(totalSGST.toFixed(2));
         $('#totalIGST').val(totalIGST.toFixed(2));
         $('#grandTotalTable').val(grand.toFixed(2));
         $('#summaryBeforeTax').val(totalTaxable.toFixed(2));
         $('#summaryCGST').val(totalCGST.toFixed(2));
         $('#summarySGST').val(totalSGST.toFixed(2));
         $('#summaryIGST').val(totalIGST.toFixed(2));
         $('#summaryTax').val(totalTax.toFixed(2));
         $('#summaryamountGtotal').val(grand.toFixed(2));

         // Store taxable base for TDS calculation
         $('#summaryGrandTotal').data('tds-base', totalTaxable);

         // Always recalculate TDS if a % is already entered
         const tpct = parseFloat($('#tdsPercent').val()) || 0;
         if (tpct > 0) {
             calculateTDS();
         } else {
             $('#summaryTDSAmount').val('0.00');
             $('#summaryGrandTotal').val(grand.toFixed(2));
         }
            $('#TransAmt').val(grand.toFixed(2));

         updateAmountInWords();
     }

     function validateInvoice() {
         let valid = true;
         document.querySelectorAll('.field-error').forEach(el => el.classList.remove('field-error'));
         document.querySelectorAll('.err-msg').forEach(el => el.textContent = '');

         const requiredFields = [
             { id: 'invoiceDate',   errId: 'err-invoiceDate',   label: 'Invoice Date'   },
             { id: 'companyName',   errId: 'err-companyName',   label: 'Company Name'   },
             { id: 'amountInWords', errId: 'err-amountInWords', label: 'Amount in Words' },
         ];

         requiredFields.forEach(f => {
             const el = document.getElementById(f.id);
             if (!el || !el.value.trim()) {
                 if (el) el.classList.add('field-error');
                 document.getElementById(f.errId).textContent = `${f.label} is required.`;
                 valid = false;
             }
         });

         let itemsValid = true;
         document.querySelectorAll('.invoice-item-row').forEach(row => {
             const service = row.querySelector('.service');
             const rate    = row.querySelector('.rate');

             if (!service.value.trim()) {
                 service.classList.add('field-error');
                 itemsValid = false;
             }
             if ((parseFloat(rate.value) || 0) <= 0) {
                 rate.classList.add('field-error');
                 itemsValid = false;
             }
         });

         if (!itemsValid) {
             document.getElementById('err-items').textContent = 'All rows need a service name and rate > 0.';
             valid = false;
         }

         if ((parseFloat(document.getElementById('summaryGrandTotal').value) || 0) <= 0) {
             document.getElementById('err-items').textContent = 'Grand total must be greater than zero.';
             valid = false;
         }

         if (!valid) {
             const firstErr = document.querySelector('.field-error');
             if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
         }
         return valid;
     }

     function saveInvoice() {
         calculateAll();
         if (!validateInvoice()) return;

         // ── Helper: parse summary field safely ──
         function sumVal(id) {
             const v = parseFloat($('#' + id).val());
             return isNaN(v) ? 0 : v;
         }

         const totalCGST = sumVal('summaryCGST');
         const totalSGST = sumVal('summarySGST');
         const totalIGST = sumVal('summaryIGST');


         const main = {

             // ── Invoice Header ──
             invoiceno:         $('#invoiceNo').val()      || null,
             invoicedate:       $('#invoiceDate').val()    || null,
             reversecharge:     $('#reverseCharge').val()  || null,
             InvoiceType:        null,

             AgainstBy:         $('#AgainstBy').val()      || null,
             AgainstByValue:    $('#AgainstByValue').val()?.toString() || null,

             // ── Bill To ──
             companyName:       $('#companyName').val()        || null,
             gstIn:             $('#gstin').val()              || null,
             Address:           $('#address').val()            || null,
             Location:          $('#Location').val()           || null,
             PinCode:           $('#billingPincode').val()     || null,
             state:             $('#billingState').val()       || null,
             statecode:         $('#billingStateCode').val()   || null,

             // ── Transaction ──
             TransMode:         $('#Transaction').val()  || null,
             TransNo:           $('#transNo').val()       || null,
             TransDate:         $('#transDate').val()     || null,
             TransAmt:          $('#TransAmt').val()      || null,

             // ── Tax Summary ──
             cgst:              totalCGST > 0 ? 9  : 0,
             cgstamt:           totalCGST,
             sgst:              totalSGST > 0 ? 9  : 0,
             sgstamt:           totalSGST,
             igst:              totalIGST > 0 ? 18 : 0,
             igstamt:           totalIGST,

             totalqty:          document.querySelectorAll('.invoice-item-row').length,
             taxablevalue:      sumVal('summaryBeforeTax'),
             totalrate:         sumVal('summaryBeforeTax'),
             totalamtbeforetax: sumVal('summaryBeforeTax'),
             total_tax_amount:  sumVal('summaryTax').toString(),
             totalamtaftertax:  sumVal('summaryamountGtotal'),

             TdsPer:            String(parseFloat($('#tdsPercent').val()))        || 0,
             TdsAmt:            String(parseFloat($('#summaryTDSAmount').val()))   || 0,
             TotalPayable:      String(parseFloat($('#summaryGrandTotal').val()))   || 0,

             amtinwords:        $('#amountInWords').val() || null
         };

         // ── Build details rows ──
         const details = [];
         document.querySelectorAll('.invoice-item-row').forEach(row => {
             details.push({
                 serviceId:          row.querySelector('.service-id').value.trim()          || null,
                 serviceName:        row.querySelector('.service-name-hidden').value.trim() || null,
                 productdescription: row.querySelector('.description').value.trim()         || null,
                 saccode:            row.querySelector('.sac-code').value.trim()            || null,
                 serviceTill:        row.querySelector('.validTill').value.trim()            || null,
                 qty:                1,
                 rate:               parseFloat(row.querySelector('.rate').value)           || 0,
                 taxablevalue:       parseFloat(row.querySelector('.taxable-value').value)  || 0,
                 cgstrate:           parseFloat(row.querySelector('.cgst-rate').value)      || 0,
                 cgstamt:            parseFloat(row.querySelector('.cgst-amount').value)    || 0,
                 sgstrate:           parseFloat(row.querySelector('.sgst-rate').value)      || 0,
                 sgstamt:            parseFloat(row.querySelector('.sgst-amount').value)    || 0,
                 igstrate:           parseFloat(row.querySelector('.igst-rate').value)      || 0,
                 igstamt:            parseFloat(row.querySelector('.igst-amount').value)    || 0,
                 total:              parseFloat(row.querySelector('.row-total').value)      || 0
             });
         });

         const payload  = { main: main, details: details };
         const $saveBtn = $('button[onclick="saveInvoice()"]');
         $saveBtn.prop('disabled', true).text('Saving...');

         $.ajax({
             url:         '@Url.Action("SaveInvoice", "Taxinvoice")',
             type:        'POST',
             contentType: 'application/json',
             data:        JSON.stringify(payload),
             success: function (response) {
                 if (response && response.success) {
                     showToast('Invoice saved successfully! Invoice No: ' + (response.invoiceNo || ''), 'success');
                     setTimeout(function () {
                         window.location.href = '/Taxinvoice/Index';
                     }, 4000);
                 } else {
                     showToast('Save failed: ' + (response?.message || 'Unknown error.'), 'error');
                 }
             },
             error: function (xhr) {
                 let msg = 'Error saving invoice.';
                 try {
                     const err = JSON.parse(xhr.responseText);
                     if (err.message) msg = err.message;
                 } catch (e) { }
                 showToast(msg, 'error');
             },
             complete: function () {
                 $saveBtn.prop('disabled', false).text('Save');
             }
         });
     }

     function clearInvoice() {
         showConfirmToast('Are you sure you want to clear the invoice?', function () {
             $('#companyName').val('').trigger('change');
             $('#reverseCharge').val('N');
             $('#Transaction').val('');
             ['#gstin','#address','#Location','#billingState',
              '#billingPincode','#billingStateCode','#transNo','#transDate','#TransAmt','#amountInWords']
                 .forEach(id => $(id).val(''));
             document.getElementById('invoiceItems').innerHTML = '';
             rowCounter = 0;
             addInvoiceRow();
             setTodayDate();
             document.querySelectorAll('.field-error').forEach(el => el.classList.remove('field-error'));
             document.querySelectorAll('.err-msg').forEach(el => el.textContent = '');
         });
     }
</script>

<script type="text/javascript">

    function numberToWordsIndian(amount) {

        amount = parseFloat(amount) || 0;

        if (amount === 0) {
            return "Zero Rupees Only";
        }

        // Round to 2 decimal places
        amount = Math.round(amount * 100) / 100;

        const ones = [
            "", "One", "Two", "Three", "Four", "Five",
            "Six", "Seven", "Eight", "Nine", "Ten",
            "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen",
            "Sixteen", "Seventeen", "Eighteen", "Nineteen"
        ];

        const tens = [
            "", "", "Twenty", "Thirty", "Forty",
            "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"
        ];

        function convertBelowThousand(num) {

            let result = "";

            if (num >= 100) {
                result += ones[Math.floor(num / 100)] + " Hundred ";
                num %= 100;
            }

            if (num >= 20) {
                result += tens[Math.floor(num / 10)] + " ";
                num %= 10;
            }

            if (num > 0) {
                result += ones[num] + " ";
            }

            return result.trim();
        }

        function convertIndian(num) {

            if (num < 1000) {
                return convertBelowThousand(num);
            }

            if (num < 100000) {
                return convertIndian(Math.floor(num / 1000)) +
                    " Thousand " +
                    convertBelowThousand(num % 1000);
            }

            if (num < 10000000) {
                return convertIndian(Math.floor(num / 100000)) +
                    " Lakh " +
                    convertBelowThousand(num % 100000);
            }

            return convertIndian(Math.floor(num / 10000000)) +
                " Crore " +
                convertIndian(num % 10000000);
        }

        const rupees = Math.floor(amount);
        const paise = Math.round((amount - rupees) * 100);

        let words = convertIndian(rupees);

        words = words.replace(/\s+/g, " ").trim();

        let result = words + " Rupees";

        if (paise > 0) {
            result += " and " + convertIndian(paise) + " Paise";
        }

        result += " Only";

        return result;
    }

    function updateAmountInWords() {
        const grandTotal =
            parseFloat($('#summaryGrandTotal').val()) || 0;

        const amountWords = numberToWordsIndian(grandTotal);

        $('#amountInWords').val(amountWords);
    }

    function applyGSTBasedOnCompany() {

        var gstin = $('#gstin').val() || '';
        gstin = gstin.trim();

        if (gstin.length < 2) {
            return;
        }

        // First 2 digits of GSTIN = State Code
        var customerStateCode = gstin.substring(0, 2);

        // Your company state code
        // Maharashtra = 27
        var companyStateCode = '27';

        $('.invoice-item-row').each(function () {

            var row = this;

            var cgstRate = row.querySelector('.cgst-rate');
            var sgstRate = row.querySelector('.sgst-rate');
            var igstRate = row.querySelector('.igst-rate');

            if (customerStateCode === companyStateCode) {

                // Same state
                cgstRate.value = '9';
                sgstRate.value = '9';
                igstRate.value = '0';

                cgstRate.disabled = false;
                sgstRate.disabled = false;
                igstRate.disabled = true;

            } else {

                // Other state
                cgstRate.value = '0';
                sgstRate.value = '0';
                igstRate.value = '18';

                cgstRate.disabled = true;
                sgstRate.disabled = true;
                igstRate.disabled = false;
            }

            calculateRow(cgstRate);
        });

        calculateAll();
        updateAmountInWords();
    }

</script>

<script type="text/javascript">
    let searchTimer = null;

    function searchService(input) {
        const query = input.value.trim();
        const dropdown = input.closest('.service-wrapper').querySelector('.service-dropdown');

        // Clear previous hidden id when user types again
        input.closest('.service-wrapper').querySelector('.service-id').value = '';

        if (query.length < 2) {
            dropdown.style.display = 'none';
            dropdown.innerHTML = '';
            return;
        }

        // Show loading state
        dropdown.style.display = 'block';
        dropdown.innerHTML = '<li style="padding:8px 12px; color:#999;">Searching...</li>';

        // Debounce: wait 300ms after user stops typing
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
            fetchServices(query, input, dropdown);
        }, 100);
    }

    // ─── AJAX call ────────────────────────────────────────────────────────────────
    function fetchServices(query, input, dropdown) {
        $.ajax({
            url: '@Url.Action("SearchServices", "Taxinvoice")',   // 🔁 Change to your endpoint
            type: 'GET',
            data: { q: query },
            success: function (response) {
                renderServiceDropdown(response, input, dropdown);
            },
            error: function () {
                dropdown.innerHTML = '<li style="padding:8px 12px; color:red;">Error fetching services.</li>';
            }
        });
    }

    // ─── Render dropdown list ─────────────────────────────────────────────────────
    function renderServiceDropdown(services, input, dropdown) {
        dropdown.innerHTML = '';

        if (!services || services.length === 0) {
            dropdown.innerHTML = '<li style="padding:8px 12px; color:#999;">No services found.</li>';
            return;
        }

        services.forEach((svc, index) => {
            const li = document.createElement('li');
            li.style.cssText = 'padding:8px 12px; cursor:pointer; border-bottom:1px solid #f0f0f0; font-size:11px;';
            li.setAttribute('data-index', index);

            // Highlight matched text
            const regex = new RegExp(`(${input.value.trim()})`, 'gi');
            const highlighted = svc.serviceName.replace(regex, '<strong>$1</strong>');

            li.innerHTML = `
                <div style="font-weight:500;">${highlighted}</div>
                ${svc.saccode ? `<div style="font-size:9px; color:#888;">SAC: ${svc.saccode}</div>` : ''}
            `;

            li.addEventListener('mouseenter', () => {
                clearHighlight(dropdown);
                li.style.background = '#f0f7ff';
                li.classList.add('highlighted');
            });
            li.addEventListener('mouseleave', () => {
                li.style.background = '';
                li.classList.remove('highlighted');
            });
            li.addEventListener('mousedown', (e) => {
                e.preventDefault(); // prevent input blur before click fires
                selectService(svc, input);
            });

            dropdown.appendChild(li);
        });

        dropdown.style.display = 'block';
    }

    function selectService(svc, input) {
        const row     = input.closest('tr');
        const wrapper = input.closest('.service-wrapper');

        input.value = svc.serviceName ?? '';
        wrapper.querySelector('.service-id').value          = svc.serviceId  ?? '';
        wrapper.querySelector('.service-name-hidden').value = svc.serviceName ?? '';

        row.querySelector('.sac-code').value  = svc.saccode ?? '998314';
        row.querySelector('.rate').value      = svc.rate    ?? 0;

        wrapper.querySelector('.service-dropdown').style.display = 'none';
        wrapper.querySelector('.service-dropdown').innerHTML     = '';

        calculateRow(row.querySelector('.rate'));
        applyGSTBasedOnCompany();
        calculateAll();
        updateAmountInWords();
    }

    // ─── Keyboard navigation (↑ ↓ Enter Escape) ───────────────────────────────────
    function handleServiceKeydown(e, input) {
        const dropdown = input.closest('.service-wrapper').querySelector('.service-dropdown');
        const items    = dropdown.querySelectorAll('li[data-index]');

        if (!items.length) return;

        let current = dropdown.querySelector('.highlighted');
        let idx     = current ? parseInt(current.getAttribute('data-index')) : -1;

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            idx = Math.min(idx + 1, items.length - 1);
            setHighlight(items, idx);

        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            idx = Math.max(idx - 1, 0);
            setHighlight(items, idx);

        } else if (e.key === 'Enter') {
            e.preventDefault();
            if (current) current.dispatchEvent(new Event('mousedown'));

        } else if (e.key === 'Escape') {
            dropdown.style.display = 'none';
        }
    }

    function setHighlight(items, idx) {
        items.forEach(li => {
            li.style.background = '';
            li.classList.remove('highlighted');
        });
        items[idx].style.background = '#f0f7ff';
        items[idx].classList.add('highlighted');
        items[idx].scrollIntoView({ block: 'nearest' });
    }

    function clearHighlight(dropdown) {
        dropdown.querySelectorAll('li').forEach(li => {
            li.style.background = '';
            li.classList.remove('highlighted');
        });
    }

    function closeAllServiceDropdowns(e) {
        if (!e.target.closest('.service-wrapper')) {
            document.querySelectorAll('.service-dropdown').forEach(d => {
                d.style.display = 'none';
            });
        }
    }
</script>
