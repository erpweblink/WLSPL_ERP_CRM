@model IEnumerable<WEBLINK_CRM.Models.LeadGenration>

@{
    ViewData["Title"] = "Lead Management";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />

<style>

    body {
        background: #f4f6f9;
    }

    .lead-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 5px 18px rgba(0,0,0,.08);
        overflow: hidden;
    }

    .lead-header {
        background: #fff;
        padding: 18px 20px;
        border-bottom: 1px solid #e9ecef;
    }

    .page-title {
        margin: 0;
        color: #0d6efd;
        font-size: 22px;
        font-weight: 700;
    }

    .page-title i {
        margin-right: 8px;
    }

    .add-btn {
        border-radius: 7px;
        font-size: 13px;
        padding: 8px 15px;
    }

    .search-box {
        max-width: 350px;
    }

    .record-info {
        font-size: 14px;
        color: #6c757d;
    }

    .table {
        margin-bottom: 0;
    }

    .table thead th {
        background: #0d6efd;
        color: white;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
        vertical-align: middle;
    }

    .table tbody td {
        font-size: 13px;
        vertical-align: middle;
        white-space: nowrap;
    }

    .table tbody tr:hover {
        background: #f4f8ff;
    }

    .lead-code {
        color: #0d6efd;
        font-weight: 600;
    }

    .company-name {
        font-weight: 600;
    }

    .badge-new {
        background: #0d6efd;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
    }

    .badge-active {
        background: #198754;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
    }

    .badge-pending {
        background: #ffc107;
        color: #212529;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
    }

    .badge-inactive {
        background: #dc3545;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
    }

    .badge-default {
        background: #6c757d;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
    }

    .source-badge {
        background: #e9ecef;
        color: #495057;
        padding: 5px 9px;
        border-radius: 15px;
        font-size: 11px;
        font-weight: 600;
    }

    .action-btn {
        width: 34px;
        height: 32px;
        padding: 5px;
    }

    .no-record {
        text-align: center;
        padding: 30px !important;
        color: #777;
    }

</style>


<div class="container-fluid py-3">

    <div class="card lead-card">

        <!-- HEADER -->

        <div class="lead-header">

            <div class="row align-items-center">

                <div class="col-md-6">

                    <h2 class="page-title">

                        <i class="fa fa-user-tie"></i>

                        Lead Management

                    </h2>

                </div>

                <div class="col-md-6 text-md-end mt-2 mt-md-0">

                    <a asp-controller="Lead"
                       asp-action="CreateOrEdit"
                       class="btn btn-primary add-btn">

                        <i class="fa fa-plus"></i>

                        Add New Lead

                    </a>

                </div>

            </div>

        </div>


        <!-- BODY -->

        <div class="card-body">

            <!-- SEARCH -->

            <div class="row mb-3 align-items-center">

                <div class="col-md-5">

                    <div class="input-group">

                        <span class="input-group-text bg-white">

                            <i class="fa fa-search"></i>

                        </span>

                        <input type="text"
                               id="searchInput"
                               class="form-control search-box"
                               placeholder="Search lead..." />

                    </div>

                </div>


                <div class="col-md-7 text-md-end mt-2">

                    <span class="record-info">

                        Total Records :

                        <strong id="totalRecords">
                            @(Model?.Count() ?? 0)
                        </strong>

                    </span>

                </div>

            </div>


            <!-- TABLE -->

            <div class="table-responsive">

             

                <table class="table table-bordered table-hover"
                       id="leadTable">

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>Lead Code</th>

                            <th>Company Name</th>

                            <th>Owner Name</th>

                            <th>Mobile</th>

                            <th>Email</th>

                            <th>Product</th>

                            <th>Qty</th>

                            <th>Source</th>

                            <th>City</th>

                            <th>Status</th>

                            <th>Created On</th>

                            <th>Created By</th>

                            <th>Action</th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            int count = 1;
                        }

                        @if (Model != null && Model.Any())
                        {

                            foreach (var item in Model)
                            {

                                <tr>

                                    <td>
                                        @count
                                    </td>


                                    <td>

                                        <span class="lead-code">

                                            @(item.Leadcode ?? "-")

                                        </span>

                                    </td>


                                    <td>

                                        <span class="company-name">

                                            @(item.CompanyName ?? "-")

                                        </span>

                                    </td>


                                    <td>
                                        @(item.OwnerName ?? "-")
                                    </td>


                                    <td>
                                        @(item.Mobile ?? "-")
                                    </td>


                                    <td>
                                        @(item.Email ?? "-")
                                    </td>


                                    <td>
                                        @(item.Product ?? "-")
                                    </td>


                                    <td class="text-center">

                                        @item.Quantity

                                    </td>


                                    <td>

                                        <span class="source-badge">

                                            @(item.Source ?? "-")

                                        </span>

                                    </td>


                                    <td>
                                        @(item.City ?? "-")
                                    </td>


                                    <td>

                                        @if (string.Equals(
                                        item.Status,
                                        "New",
                                        StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge-new">
                                                <i class="fa fa-star"></i>
                                                New
                                            </span>
                                        }
                                        else if (string.Equals(
                                        item.Status,
                                        "Active",
                                        StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge-active">
                                                <i class="fa fa-check"></i>
                                                Active
                                            </span>
                                        }
                                        else if (string.Equals(
                                        item.Status,
                                        "Pending",
                                        StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge-pending">
                                                <i class="fa fa-clock"></i>
                                                Pending
                                            </span>
                                        }
                                        else if (string.Equals(
                                        item.Status,
                                        "Inactive",
                                        StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge-inactive">
                                                <i class="fa fa-times"></i>
                                                Inactive
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-default">
                                                @(item.Status ?? "N/A")
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @if (item.CreatedOn != DateTime.MinValue)
                                        {
                                            @item.CreatedOn.ToString("dd-MM-yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }

                                    </td>


                                    <td>
                                        @(item.Createdby ?? "-")
                                    </td>


                                    <td>

                                        <!-- EDIT -->

                                        <a asp-controller="Lead"
                                           asp-action="CreateOrEdit"
                                           asp-route-id="@item.ID"
                                           class="btn btn-warning btn-sm action-btn"
                                           title="Edit">

                                            <i class="fa fa-edit"></i>

                                        </a>


                                        <!-- DELETE -->

                                        <form asp-controller="Lead"
                                              asp-action="Delete"
                                              asp-route-id="@item.ID"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm action-btn"
                                                    title="Delete"
                                                    onclick="return confirm('Are you sure you want to delete this lead?');">

                                                <i class="fa fa-trash"></i>

                                            </button>

                                        </form>

                                    </td>

                                </tr>

                                count++;

                            }

                        }
                        else
                        {

                            <tr>

                                <td colspan="14"
                                    class="no-record">

                                    <i class="fa fa-folder-open fa-2x"></i>

                                    <br />

                                    No leads found.

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>


            <!-- PAGINATION -->

            <nav>

                <ul class="pagination justify-content-center mt-4"
                    id="pagination">

                </ul>

            </nav>

        </div>

    </div>

</div>


<script>

    const rowsPerPage = 10;

    let currentPage = 1;


    function getRows() {

        return Array.from(
            document.querySelectorAll("#leadTable tbody tr")
        ).filter(row =>
            !row.querySelector(".no-record")
        );

    }


    function displayTable(page) {

        const rows = getRows();

        const start =
            (page - 1) * rowsPerPage;

        const end =
            start + rowsPerPage;


        rows.forEach((row, index) => {

            row.style.display =
                index >= start && index < end
                    ? ""
                    : "none";

        });


        createPagination(rows.length);

    }


    function createPagination(totalRows) {

        const pagination =
            document.getElementById("pagination");

        pagination.innerHTML = "";


        const pages =
            Math.ceil(totalRows / rowsPerPage);


        if (pages <= 1)
            return;


        for (let i = 1; i <= pages; i++) {

            const li =
                document.createElement("li");

            li.className =
                "page-item " +
                (i === currentPage ? "active" : "");


            const a =
                document.createElement("a");

            a.className = "page-link";

            a.href = "javascript:void(0);";

            a.innerText = i;


            a.onclick = function () {

                currentPage = i;

                displayTable(i);

            };


            li.appendChild(a);

            pagination.appendChild(li);

        }

    }


    document
        .getElementById("searchInput")
        .addEventListener("keyup", function () {

            const search =
                this.value.toLowerCase().trim();

            const rows = getRows();

            let matched = 0;


            rows.forEach(row => {

                const text =
                    row.innerText.toLowerCase();

                if (text.includes(search)) {

                    row.style.display = "";

                    matched++;

                }
                else {

                    row.style.display = "none";

                }

            });


            document.getElementById("totalRecords")
                .innerText = matched;


            document.getElementById("pagination")
                .innerHTML = "";

        });


    displayTable(1);

</script>


@if (TempData["Success"] != null)
{
    <script>

        Swal.fire({
            title: "Success!",
            text: "@TempData["Success"]",
            icon: "success",
            confirmButtonColor: "#0d6efd"
        });

    </script>
}


@if (TempData["Error"] != null)
{
    <script>

        Swal.fire({
            title: "Error!",
            text: "@TempData["Error"]",
            icon: "error",
            confirmButtonColor: "#dc3545"
        });

    </script>
}