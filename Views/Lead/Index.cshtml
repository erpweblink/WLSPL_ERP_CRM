@model IEnumerable<WEBLINK_CRM.Models.Inquiry>

@{
    ViewData["Title"] = "Lead Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>

    .table tbody td {
        font-size: 13px;
        vertical-align: middle;
    }

    .table tbody tr {
        transition: all .15s ease;
    }

        .table tbody tr:hover {
            background: #f4f8ff;
        }

    /* =====================================================
                                   SALESPERSON
                                ===================================================== */

    .lead-code {
        color: #0d6efd;
        font-weight: 600;
    }

    /* =====================================================
                                   NAME
                                ===================================================== */

    .company-name {
        font-weight: 600;
        color: #344054;
    }

    /* =====================================================
                                   SERVICE
                                ===================================================== */

    .service-text {
        display: block;
        max-width: 400px;
        white-space: normal;
        line-height: 1.5;
        color: #495057;
    }

    /* =====================================================
                                   STATUS
                                ===================================================== */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-new {
        color: #15803d;
        background: #dcfce7;
        border: 1px solid #bbf7d0;
    }

    .status-old {
        color: #64748b;
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }

    /* =====================================================
                                   EMPTY
                                ===================================================== */

    .no-record {
        text-align: center;
        padding: 40px !important;
        color: #777;
    }

        .no-record i {
            color: #adb5bd;
            margin-bottom: 10px;
        }

    /* =====================================================
                                   PAGINATION
                                ===================================================== */

    .pagination {
        margin-bottom: 0;
        gap: 4px;
    }

        .pagination .page-item .page-link {
            border: 1px solid #dee2e6;
            color: #0d6efd;
            background: #fff;
            border-radius: 7px;
            font-size: 13px;
            font-weight: 500;
            padding: 7px 12px;
            transition: all .2s ease;
        }

            .pagination .page-item .page-link:hover {
                background: #e9f2ff;
                border-color: #0d6efd;
                color: #0d6efd;
            }

        .pagination .page-item.active .page-link {
            background: #0d6efd;
            border-color: #0d6efd;
            color: #fff;
            box-shadow: 0 3px 8px rgba(13, 110, 253, .25);
        }

        .pagination .page-item.disabled .page-link {
            color: #adb5bd;
            background: #f8f9fa;
            border-color: #dee2e6;
            cursor: not-allowed;
        }

    /* =====================================================
                                   MOBILE
                                ===================================================== */

    @@media (max-width: 767.98px) {

        .container-fluid {
            padding-left: 8px;
            padding-right: 8px;
        }

        .lead-card {
            border-radius: 8px;
        }

        .lead-header {
            padding: 15px;
        }

        .page-title {
            font-size: 18px;
        }

        .add-btn {
            font-size: 12px;
            padding: 7px 11px;
        }

        .search-box {
            max-width: 100%;
            width: 100%;
        }

        .record-info {
            display: block;
            margin-top: 8px;
            text-align: left !important;
            font-size: 12px;
        }

        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        #leadTable {
            min-width: 1100px;
        }

        .table thead th,
        .table tbody td {
            font-size: 12px;
            padding: 8px;
        }

        .service-text {
            max-width: 300px;
        }

        .pagination {
            flex-wrap: wrap;
            justify-content: center;
            gap: 2px;
        }

            .pagination .page-item .page-link {
                font-size: 11px;
                padding: 6px 9px;
            }
    }

</style>

<style>

    /* ==============================
                                   STATUS BADGE
                                   ============================== */

    .status-column {
        min-width: 90px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-width: 60px;
        padding: 5px 12px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.2;
    }


    /* Dot */

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }


    /* NEW */

    .status-new {
        color: #087443;
        background: #e8fff2;
        border: 1px solid #b8f0d0;
    }

        .status-new .status-dot {
            background: #159957;
            box-shadow: 0 0 0 3px rgba(21, 153, 87, .10);
        }


    /* OLD */

    .status-old {
        color: #64748b;
        background: #f4f7fb;
        border: 1px solid #cbd5e1;
    }

        .status-old .status-dot {
            background: #64748b;
            box-shadow: 0 0 0 3px rgba(100, 116, 139, .10);
        }


    /* ==============================
                                   ACTION BUTTON
                                   ============================== */

    .action-column {
        width: 70px;
        min-width: 70px;
    }

    .lead-action-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #159447;
        color: #fff;
        border-radius: 6px;
        text-decoration: none;
        font-size: 15px;
        transition: all .2s ease;
    }

        .lead-action-btn:hover {
            background: #107c3a;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(21, 148, 71, .25);
        }

        .lead-action-btn:active {
            transform: scale(.95);
        }
</style>



<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h3 class="page-title mb-0">
            <i class="fa fa-user-tie"></i>
            Lead Management
        </h3>
        <a asp-controller="Lead"
           asp-action="CreateOrEdit"
           class="btn btn-primary">
            <i class="fa fa-plus"></i>
            Add New Lead
        </a>
    </div>

    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-4">
                <input type="text"
                       id="searchInput"
                       class="form-control search-box"
                       placeholder="Search salesperson, name, mobile, email, city..." />
            </div>
            <div class="col-md-8 d-flex justify-content-end align-items-center">
                <span class="record-info">
                    Total Records :
                    <strong id="totalRecords">@Model.Count()</strong>
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover"
                   id="leadTable">

                <thead>

                    <tr>

                        <th>#</th>

                        <th>Salesperson</th>

                        <th>Requested Person</th>

                        <th>Mobile</th>

                        <th>Email</th>

                        <th>City</th>

                        <th>Service Requested</th>

                        <th class="text-center">Status</th>

                        <th class="text-center">Action</th>

                    </tr>

                </thead>

                <tbody id="leadTableBody">

                    @if (Model != null && Model.Any())
                    {
                        int count = 1;

                        foreach (var item in Model)
                        {
                            <tr class="lead-row">

                                <!-- NUMBER -->
                                <td class="row-number">
                                    @count
                                </td>


                                <!-- SALESPERSON -->
                                <td>
                                    <span class="lead-code">
                                        @(item.SalesPerson ?? "-")
                                    </span>
                                </td>


                                <!-- REQUESTED PERSON -->
                                <td>
                                    <span class="company-name">
                                        @(item.Name ?? "-")
                                    </span>
                                </td>


                                <!-- MOBILE -->
                                <td>
                                    @(item.MobileNumber ?? "-")
                                </td>


                                <!-- EMAIL -->
                                <td>
                                    @(item.Email ?? "-")
                                </td>


                                <!-- CITY -->
                                <td>
                                    @(item.City ?? "-")
                                </td>


                                <!-- SERVICE -->
                                <td>
                                    <span class="service-text">

                                        @if (!string.IsNullOrWhiteSpace(item.ServiceRequested))
                                        {
                                            @Html.Raw(
                                            item.ServiceRequested
                                            .Replace("<br>", " ")
                                            .Replace("<br/>", " ")
                                            .Replace("<br />", " ")
                                                                )
                                                                }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }

                                    </span>
                                </td>


                                <!-- STATUS -->
                                <td class="text-center status-column">

                                    @if (string.Equals(
                                                                item.Status,
                                                                "New",
                                                                StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge status-new">

                                            <span class="status-dot"></span>

                                            <span>New</span>

                                        </span>
                                    }
                                    else if (string.Equals(
                                    item.Status,
                                    "Old",
                                    StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge status-old">

                                            <span class="status-dot"></span>

                                            <span>Old</span>

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-old">

                                            <span class="status-dot"></span>

                                            <span>-</span>

                                        </span>
                                    }

                                </td>

                                <td class="text-center action-column">

                                    @if (string.Equals(item.Status, "New", StringComparison.OrdinalIgnoreCase)
                                                                && !string.IsNullOrWhiteSpace(item.Leadcode))
                                    {
                                        <a href="@Url.Action(
                                                                                                          "Create",
                                                                                                          "Companymaster",
                                                                                                          new
                                                                                                          {
                                                                                                              leadCode = item.Leadcode,
                                                                                                              mobile = item.MobileNumber,
                                                                                                              email = item.Email,
                                                                                                              ownerName = item.Name
                                                                                                          })"
                               class="lead-action-btn"
                               title="Create Company"
                               aria-label="Create Company">

                                            <i class="fa fa-paper-plane"></i>

                                        </a>
                                                        }

                                </td>


                            </tr>

                            count++;
                        }
                    }
                    else
                    {
                        <tr id="initialEmptyRow">

                            <td colspan="9" class="no-record">

                                <i class="fa fa-folder-open fa-2x"></i>

                                <br />

                                No leads found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
            <nav>

                <ul class="pagination justify-content-md-end justify-content-center"
                    id="pagination">
                </ul>

            </nav>

        </div>
    </div>

</div>


<script>

    // =====================================================
    // SETTINGS
    // =====================================================

    const rowsPerPage = 10;

    let currentPage = 1;

    let allRows = [];

    let filteredRows = [];


    // =====================================================
    // PAGE LOAD
    // =====================================================

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            allRows =
                Array.from(
                    document.querySelectorAll(
                        "#leadTableBody .lead-row"
                    )
                );

            filteredRows =
                [...allRows];


            updateTotalRecords();

            renderTable();

        }
    );


    // =====================================================
    // SEARCH
    // =====================================================

    document
        .getElementById("searchInput")
        .addEventListener(
            "input",
            function () {

                const searchValue =
                    this.value
                        .toLowerCase()
                        .trim();


                filteredRows =
                    allRows.filter(
                        function (row) {

                            return row.innerText
                                .toLowerCase()
                                .includes(searchValue);

                        }
                    );


                // Reset to first page
                currentPage = 1;


                updateTotalRecords();

                renderTable();

            }
        );


    // =====================================================
    // UPDATE TOTAL RECORDS
    // =====================================================

    function updateTotalRecords() {

        document.getElementById(
            "totalRecords"
        ).innerText =
            filteredRows.length;

    }


    // =====================================================
    // RENDER TABLE
    // =====================================================

    function renderTable() {

        removeDynamicEmptyRow();


        // Hide all rows
        allRows.forEach(
            function (row) {

                row.style.display = "none";

            }
        );


        // =================================================
        // NO RESULT
        // =================================================

        if (filteredRows.length === 0) {

            showEmptyRow();

            document.getElementById(
                "showingRecords"
            ).innerText = 0;


            createPagination();

            return;

        }


        // =================================================
        // CALCULATE PAGE
        // =================================================

        const totalPages =
            Math.ceil(
                filteredRows.length /
                rowsPerPage
            );


        // Safety
        if (currentPage > totalPages) {

            currentPage = totalPages;

        }


        const startIndex =
            (currentPage - 1) *
            rowsPerPage;


        const endIndex =
            Math.min(
                startIndex + rowsPerPage,
                filteredRows.length
            );


        const pageRows =
            filteredRows.slice(
                startIndex,
                endIndex
            );


        // =================================================
        // SHOW CURRENT PAGE
        // =================================================

        pageRows.forEach(
            function (row, index) {

                row.style.display = "";

            }
        );


        // =================================================
        // SHOWING COUNT
        // =================================================

        document.getElementById(
            "showingRecords"
        ).innerText =
            pageRows.length;





        // =================================================
        // PAGINATION
        // =================================================

        createPagination();

    }


    // =====================================================
    // CREATE PAGINATION
    // =====================================================

    function createPagination() {

        const pagination =
            document.getElementById(
                "pagination"
            );


        pagination.innerHTML = "";


        const totalPages =
            Math.ceil(
                filteredRows.length /
                rowsPerPage
            );


        // No pagination
        if (totalPages <= 1) {

            return;

        }


        // =================================================
        // PREVIOUS
        // =================================================

        const previous =
            document.createElement("li");


        previous.className =
            "page-item " +
            (
                currentPage === 1
                    ? "disabled"
                    : ""
            );


        previous.innerHTML = `
            <a class="page-link"
               href="javascript:void(0);">

                <i class="fa fa-chevron-left"></i>

                Previous

            </a>
        `;


        previous.onclick =
            function () {

                if (currentPage > 1) {

                    currentPage--;

                    renderTable();

                    scrollToTable();

                }

            };


        pagination.appendChild(
            previous
        );


        // =================================================
        // PAGE NUMBERS
        // =================================================

        const maxVisiblePages = 5;

        let startPage =
            Math.max(
                1,
                currentPage - 2
            );

        let endPage =
            Math.min(
                totalPages,
                startPage + maxVisiblePages - 1
            );


        if (
            endPage - startPage + 1
            < maxVisiblePages
        ) {

            startPage =
                Math.max(
                    1,
                    endPage - maxVisiblePages + 1
                );

        }


        // First page
        if (startPage > 1) {

            addPageButton(
                1,
                pagination
            );


            if (startPage > 2) {

                addDots(
                    pagination
                );

            }

        }


        // Main pages
        for (
            let i = startPage;
            i <= endPage;
            i++
        ) {

            addPageButton(
                i,
                pagination
            );

        }


        // Last page
        if (endPage < totalPages) {

            if (endPage < totalPages - 1) {

                addDots(
                    pagination
                );

            }


            addPageButton(
                totalPages,
                pagination
            );

        }


        // =================================================
        // NEXT
        // =================================================

        const next =
            document.createElement("li");


        next.className =
            "page-item " +
            (
                currentPage === totalPages
                    ? "disabled"
                    : ""
            );


        next.innerHTML = `
            <a class="page-link"
               href="javascript:void(0);">

                Next

                <i class="fa fa-chevron-right"></i>

            </a>
        `;


        next.onclick =
            function () {

                if (
                    currentPage <
                    totalPages
                ) {

                    currentPage++;

                    renderTable();

                    scrollToTable();

                }

            };


        pagination.appendChild(
            next
        );

    }


    // =====================================================
    // ADD PAGE BUTTON
    // =====================================================

    function addPageButton(
        pageNumber,
        pagination
    ) {

        const li =
            document.createElement("li");


        li.className =
            "page-item " +
            (
                pageNumber === currentPage
                    ? "active"
                    : ""
            );


        li.innerHTML = `
            <a class="page-link"
               href="javascript:void(0);">

                ${pageNumber}

            </a>
        `;


        li.onclick =
            function () {

                currentPage =
                    pageNumber;

                renderTable();

                scrollToTable();

            };


        pagination.appendChild(
            li
        );

    }


    // =====================================================
    // DOTS
    // =====================================================

    function addDots(pagination) {

        const li =
            document.createElement("li");


        li.className =
            "page-item disabled";


        li.innerHTML = `
            <span class="page-link">
                ...
            </span>
        `;


        pagination.appendChild(
            li
        );

    }


    // =====================================================
    // EMPTY ROW
    // =====================================================

    function showEmptyRow() {

        const tbody =
            document.getElementById(
                "leadTableBody"
            );


        const emptyRow =
            document.createElement("tr");


        emptyRow.id =
            "dynamicEmptyRow";


        emptyRow.innerHTML = `

            <td colspan="8"
                class="no-record">

                <i class="fa fa-search fa-2x"></i>

                <br />

                No matching leads found.

            </td>

        `;


        tbody.appendChild(
            emptyRow
        );

    }


    // =====================================================
    // REMOVE EMPTY ROW
    // =====================================================

    function removeDynamicEmptyRow() {

        const emptyRow =
            document.getElementById(
                "dynamicEmptyRow"
            );


        if (emptyRow) {

            emptyRow.remove();

        }

    }


    // =====================================================
    // SCROLL TO TABLE
    // =====================================================

    function scrollToTable() {

        const table =
            document.getElementById(
                "leadTable"
            );


        if (table) {

            table.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });

        }

    }

</script>



