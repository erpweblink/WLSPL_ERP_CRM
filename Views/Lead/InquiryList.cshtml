@model List<WEBLINK_CRM.Models.Inquiry>


@{
    ViewData["Title"] = "Inquiry List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .table tbody td {
        font-size: 13px;
        vertical-align: middle;
    }

    .table tbody tr:hover {
        background: #f4f8ff;
    }

    #statusMessage {
        font-size: 13px;
        color: #fff;
    }

    .feedback-scroll {
        max-height: 120px;
        overflow-y: auto;
        overflow-y: auto;
        word-break: break-word;
        padding: 4px 8px;
        background: #ffffff;
        font-size: 12px;
    }

    .status-icon {
        margin-right: 5px;
    }
     
    .record-info {
        font-size: 14px;
        color: #6c757d;
    }

        .record-info strong {
            color: #0d6efd;
            font-size: 15px;
        }

    .name-text {
        color: #344054;
        font-weight: 600;
    }

    /* =========================================================
                                               MOBILE
                                            ========================================================= */

    .mobile-text {
        color: #344054;
    }

    /* =========================================================
                                               EMAIL
                                            ========================================================= */

    .email-text {
        color: #0d6efd;
    }


    /* =========================================================
                                               DATE
                                            ========================================================= */

    .date-text {
        color: #667085;
        font-size: 12px;
    }

    /* =========================================================
                                               LOCATION
                                            ========================================================= */

    .location-badge {
        display: inline-block;
        background: #f0fdf4;
        color: #198754;
        border: 1px solid #d1e7dd;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 12px;
    }

    .pagination {
        margin-bottom: 0;
    }

        .pagination .page-link {
            font-size: 12px;
            padding: 6px 11px;
            color: #0d6efd;
        }

        .pagination .active .page-link {
            background-color: #142c45;
            border-color: #142d47;
            color: #ffffff;
        }

        .pagination .page-link:hover {
            background-color: #e9f2ff;
        }

</style>

<div class="card">
    <div class="card-header">
        <div>
            <h3><i class="fa fa-envelope-open-text"></i> Inquiry Management</h3>
            <span class="page-subtitle">
                Manage customer inquiries and convert them into leads
            </span>
        </div>
    </div>
    <div class="card-body">
        <span id="statusMessage">
            <i class="fa fa-circle-check status-icon"></i>
            Records loaded
        </span>

        <div class="row align-items-center">
            <div class="col-md-4">
                <input type="text"
                       id="searchInput"
                       class="form-control search-box"
                       placeholder="Search salesperson, name, mobile, email, city..." />
            </div>
            <div class="col-md-8 d-flex justify-content-end align-items-center">
                <span class="record-info">
                    Total Records :
                    <strong id="totalRecords">@Model.Count()</strong>
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table id="dataTable"
                   class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>#</th>

                        <th>Name</th>

                        <th>Mobile</th>

                        <th>Email</th>

                        <th>Inquiry</th>

                        <th>Date</th>

                        <th>Location</th>

                        <th>Action</th>

                    </tr>

                </thead>
                <tbody id="tableBody">
                    @{
                        var count = 1;
                    }
                    @if (Model != null && Model.Any())
                    {

                        foreach (var inquiry in Model)
                        {

                            <tr class="inquiry-row">
                                <td>
                                    @count
                                </td>
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(inquiry.Name))
                                    {

                                        <span class="name-text">

                                            @inquiry.Name

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="text-muted">
                                            -
                                        </span>

                                    }

                                </td>


                                <!-- =================================
                                     MOBILE
                                ================================== -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(inquiry.MobileNumber))
                                    {

                                        <span class="mobile-text">

                                            @inquiry.MobileNumber

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="text-muted">
                                            -
                                        </span>

                                    }

                                </td>


                                <!-- =================================
                                     EMAIL
                                ================================== -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(inquiry.Email))
                                    {

                                        <span class="email-text">

                                            @inquiry.Email

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="text-muted">
                                            -
                                        </span>

                                    }

                                </td>


                                <!-- =================================
                                     INQUIRY
                                ================================== -->

                                <td>
                                    <div class="feedback-scroll">

                                        @if (!string.IsNullOrWhiteSpace(inquiry.ServiceRequested))
                                        {
                                            @Html.Raw(
                                            inquiry.ServiceRequested
                                            .Replace("<br>", " ")
                                            .Replace("<br/>", " ")
                                            .Replace("<br />", " "))
                                                                }
                                        else
                                        {
                                            <span class="text-muted">
                                                No inquiry details
                                            </span>
                                        }
                                    </div>
                                </td>


                                <!-- =================================
                                     DATE
                                ================================== -->

                                <td>

                                    @if (inquiry.CreatedAt != null)
                                    {

                                        <span class="date-text">

                                            @inquiry.CreatedAt

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="text-muted">
                                            -
                                        </span>

                                    }

                                </td>


                                <!-- =================================
                                     LOCATION
                                ================================== -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(inquiry.City))
                                    {

                                        <span class="location-badge">

                                            <i class="fa fa-location-dot me-1"></i>

                                            @inquiry.City

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="text-muted">
                                            -
                                        </span>

                                    }

                                </td>



                                <td>
                                    <select class="form-select form-select-sm sales-person-select"
                                            data-inquiry-id="@inquiry.Id"
                                            onchange="updateSalesPerson(this)">

                                        <option value="">Select Sales Person</option>

                                        @if (inquiry.SalesPersons != null && inquiry.SalesPersons.Any())
                                        {
                                            foreach (var employee in inquiry.SalesPersons)
                                            {
                                                if (employee.empcode == inquiry.SalesEmpCode)
                                                {
                                                    <option value="@employee.empcode" selected>
                                                        @employee.name
                                                        @if (!string.IsNullOrWhiteSpace(employee.empcode))
                                                        {
                                                            @: (@employee.empcode)
                                                        }
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@employee.empcode">
                                                        @employee.name
                                                        @if (!string.IsNullOrWhiteSpace(employee.empcode))
                                                        {
                                                            @: (@employee.empcode)
                                                        }
                                                    </option>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <option value="" disabled>
                                                No Sales Person Found
                                            </option>
                                        }

                                    </select>
                                </td>
                            </tr>

                            count++;
                        }
                    }
                    else
                    {

                        <tr>

                            <td colspan="10"
                                class="empty-row">

                                <i class="fa fa-envelope-open"></i>

                                No inquiry records found.

                            </td>

                        </tr>

                    }

                </tbody>

            </table>
            <nav>

                <ul class="pagination justify-content-center"
                    id="pagination">
                </ul>

            </nav>
        </div>

    </div>

</div>

<script>
        const rowsPerPage = 20;

        let currentPage = 1;

        let allRows = [];

        let filteredRows = [];



        document.addEventListener(
            "DOMContentLoaded",
            function () {

                allRows =
                    Array.from(
                        document.querySelectorAll(
                            "#tableBody .inquiry-row"
                        )
                    );


                filteredRows =
                    [...allRows];


                document.getElementById(
                    "totalRecords"
                ).textContent =
                    allRows.length;


                document.getElementById(
                    "statusMessage"
                ).innerHTML = `

                    <i class="fa fa-circle-check status-icon"></i>

                    Loaded ${allRows.length} database records.

                `;


                renderTable();

            }
        );


        document
            .getElementById("searchInput")
            .addEventListener(
                "input",
                function () {

                    const searchValue =
                        this.value
                            .toLowerCase()
                            .trim();


                    filteredRows =
                        allRows.filter(
                            function (row) {

                                return row.innerText
                                    .toLowerCase()
                                    .includes(
                                        searchValue
                                    );

                            }
                        );


                    currentPage = 1;


                    document.getElementById(
                        "totalRecords"
                    ).textContent =
                        filteredRows.length;


                    renderTable();

                }
            );


        function renderTable() {

            allRows.forEach(
                function (row) {

                    row.style.display =
                        "none";

                }
            );


            if (filteredRows.length === 0) {

                showEmptyResult();

                createPagination();

                return;

            }


            const startIndex =
                (currentPage - 1) *
                rowsPerPage;


            const endIndex =
                startIndex +
                rowsPerPage;


            const pageRows =
                filteredRows.slice(
                    startIndex,
                    endIndex
                );


            pageRows.forEach(
                function (row) {

                    row.style.display =
                        "";

                }
            );


            createPagination();

        }

        function showEmptyResult() {

            allRows.forEach(
                function (row) {

                    row.style.display =
                        "none";

                }
            );


            let emptyRow =
                document.getElementById(
                    "dynamicEmptyRow"
                );


            if (!emptyRow) {

                emptyRow =
                    document.createElement(
                        "tr"
                    );

                emptyRow.id =
                    "dynamicEmptyRow";


                emptyRow.innerHTML = `

                    <td colspan="10"
                        class="empty-row">

                        <i class="fa fa-search"></i>

                        No matching records found.

                    </td>

                `;


                document
                    .getElementById("tableBody")
                    .appendChild(emptyRow);

            }

            emptyRow.style.display = "";

        }


        // =====================================================
        // PAGINATION
        // =====================================================

        function createPagination() {

            const pagination =
                document.getElementById(
                    "pagination"
                );


            pagination.innerHTML = "";


            const totalPages =
                Math.ceil(
                    filteredRows.length /
                    rowsPerPage
                );


            if (totalPages <= 1) {

                return;

            }


            // =================================================
            // PREVIOUS
            // =================================================

            const previous =
                document.createElement(
                    "li"
                );


            previous.className =
                "page-item " +
                (
                    currentPage === 1
                        ? "disabled"
                        : ""
                );


            previous.innerHTML = `

                <a class="page-link"
                   href="javascript:void(0);">

                    Previous

                </a>

            `;


            previous.onclick =
                function () {

                    if (
                        currentPage > 1
                    ) {

                        currentPage--;

                        removeEmptyRow();

                        renderTable();

                    }

                };


            pagination.appendChild(
                previous
            );


            // =================================================
            // PAGE NUMBERS
            // =================================================

            for (
                let i = 1;
                i <= totalPages;
                i++
            ) {

                const li =
                    document.createElement(
                        "li"
                    );


                li.className =
                    "page-item " +
                    (
                        i === currentPage
                            ? "active"
                            : ""
                    );


                li.innerHTML = `

                    <a class="page-link"
                       href="javascript:void(0);">

                        ${i}

                    </a>

                `;


                li.onclick =
                    function () {

                        currentPage = i;

                        removeEmptyRow();

                        renderTable();

                    };


                pagination.appendChild(
                    li
                );

            }


            // =================================================
            // NEXT
            // =================================================

            const next =
                document.createElement(
                    "li"
                );


            next.className =
                "page-item " +
                (
                    currentPage === totalPages
                        ? "disabled"
                        : ""
                );


            next.innerHTML = `

                <a class="page-link"
                   href="javascript:void(0);">

                    Next

                </a>

            `;


            next.onclick =
                function () {

                    if (
                        currentPage <
                        totalPages
                    ) {

                        currentPage++;

                        removeEmptyRow();

                        renderTable();

                    }

                };


            pagination.appendChild(
                next
            );

        }


        function removeEmptyRow() {

            const emptyRow =
                document.getElementById(
                    "dynamicEmptyRow"
                );


            if (emptyRow) {

                emptyRow.remove();

            }

        }



        function addLead(id) {

            if (!id) {

                      showToast( "Inquiry ID not found.","error");
                return;
            }
            window.location.href =
                `/Lead/CreateOrEdit?inquiryId=${encodeURIComponent(id)}`;
        }


      $(document).ready(function () {

        $('.sales-person-select').select2({
            placeholder: "Select Sales Person",
            allowClear: true,
            width: '220px'
        });

    });


