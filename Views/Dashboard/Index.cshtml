@using Microsoft.AspNetCore.Html
@using System.Text.Encodings.Web
@using WLSPL_ERP_CRM.Models
@model List<WLSPL_ERP_CRM.Models.EmployeeNode>
@{
    ViewData["Title"] = "Employee Hierarchy";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var root = Model?.FirstOrDefault();
    string currentCode = (Context.Session.GetString("EmpCode") ?? "").Trim();
}
<style type="text/css">
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

    :root {
        --connector: #c9d2df;
        --ink: #1b2333;
        --muted: #7b869a;
        --line-c: #e6eaf1;
        --c-ceo: #3d322c;
        --c-branch: #e2492a;
        --c-cluster: #f5a623;
        --c-manager: #1fa2d8;
        --c-exec: #7cb342;
        --font: 'Plus Jakarta Sans','Inter',system-ui,sans-serif;
        --line: 2px;
        --gap: 30px
    }

    *, *::before, *::after {
        box-sizing: border-box
    }

    body {
        background: #fff
    }

    .tree-page {
        width: 100%;
        font-family: var(--font)
    }

    .org-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0 0 14px
    }

        .org-legend span {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 5px 12px;
            background: #fff;
            border: 1px solid var(--line-c);
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            color: var(--ink)
        }

        .org-legend i {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--rc)
        }

        .org-legend span[data-role="ceo"], .person[data-role="ceo"] {
            --rc: var(--c-ceo)
        }

        .org-legend span[data-role="manager"], .person[data-role="manager"] {
            --rc: var(--c-branch)
        }

        .org-legend span[data-role="assimanager"], .person[data-role="assimanager"] {
            --rc: var(--c-cluster)
        }

        .org-legend span[data-role="team-lead"], .person[data-role="team-lead"] {
            --rc: var(--c-manager)
        }

        .org-legend span[data-role="executive"], .person[data-role="executive"] {
            --rc: var(--c-exec)
        }

    .org-wrap {
        width: 100%;
        overflow: auto;
        padding: 44px 28px 64px;
        background: radial-gradient(circle at 1px 1px,#d8dfea 1px,transparent 0) 0 0/22px 22px,#f7f9fc;
        border: 1px solid var(--line-c);
        border-radius: 20px;
        box-shadow: 0 12px 32px -18px rgba(16,30,54,.18);
        -webkit-overflow-scrolling: touch
    }

    .org-tree {
        display: flex;
        justify-content: center;
        width: max-content;
        min-width: 100%
    }

        .org-tree ul {
            list-style: none;
            margin: 0;
            padding: var(--gap) 0 0;
            display: flex;
            justify-content: center;
            position: relative;
            animation: openIn .26s ease both
        }

        .org-tree > ul {
            padding-top: 0;
            animation: none
        }

        .org-tree li {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: var(--gap) 33px 0
        }

        .org-tree > ul > li {
            padding-top: 0
        }

        .org-tree li::before, .org-tree li::after {
            content: "";
            position: absolute;
            top: 0;
            right: 50%;
            width: 50%;
            height: var(--gap);
            border-top: var(--line) solid var(--connector)
        }

        .org-tree li::after {
            right: auto;
            left: 50%;
            border-left: var(--line) solid var(--connector)
        }

        .org-tree > ul > li::before, .org-tree > ul > li::after, .org-tree li:only-child::before, .org-tree li:only-child::after {
            display: none
        }

        .org-tree li:only-child {
            padding-top: 0
        }

        .org-tree li:first-child::before, .org-tree li:last-child::after {
            border: 0 none
        }

        .org-tree li:last-child::before {
            border-right: var(--line) solid var(--connector);
            border-radius: 0 14px 0 0
        }

        .org-tree li:first-child::after {
            border-radius: 14px 0 0 0
        }

        .org-tree li > ul::before {
            content: "";
            position: absolute;
            top: 0;
            left: 50%;
            height: var(--gap);
            border-left: var(--line) solid var(--connector)
        }

        .org-tree li.collapsed > ul {
            display: none
        }

    .person {
        --rc: #9BAABF;
        --sz: 52px;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 134px
    }

        .person.xl {
            --sz: 96px
        }

        .person.lg {
            --sz: 72px
        }

        .person.md {
            --sz: 60px
        }

    .employee-avatar-img {
        width: 100%;
        height: 100%;
        display: block;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #fff;
    }


    .avatar {
        position: relative;
        width: var(--sz);
        height: var(--sz);
        padding: calc(var(--sz)*.07);
        border-radius: 50%;
        background: linear-gradient(145deg,var(--rc),color-mix(in srgb,var(--rc) 45%,#fff));
        transform: translateY(-3px);
        box-shadow: 0 16px 26px -8px color-mix(in srgb,var(--rc) 70%,transparent),0 2px 4px rgba(16,30,54,.1)
    }

        .avatar > span {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
            background: linear-gradient(160deg,#fff,color-mix(in srgb,var(--rc) 14%,#fff));
            color: color-mix(in srgb,var(--rc) 85%,#1b2333);
            font-weight: 800;
            font-size: calc(var(--sz)*.3);
            letter-spacing: .3px
        }


    .company-counts {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5px 8px;
        margin-top: 8px;
        padding-top: 7px;
        border-top: 1px solid #eef1f5;
    }

    .company-count-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 4px;
        font-size: 9px;
        color: #7b869a;
        line-height: 1.3;
    }

        .company-count-item strong {
            color: #1b2333;
            font-size: 10px;
            font-weight: 900;
        }

        .company-count-item span {
            color: black;
            font-size: 9px;
            font-weight: 600;
        }

        .company-count-item:nth-child(2) strong {
            color: #059669;
        }

        .company-count-item:nth-child(3) strong {
            color: #2563eb;
        }

        .company-count-item:nth-child(4) strong {
            color: #ea580c;
        }

    .person-card {
        margin-top: 11px;
        width: 178px;
        padding: 8px 8px 9px;
        background: #fff;
        border-radius: 12px;
        box-shadow: rgb(23 47 72) 0px 5px 15px;
    }

    .person-name {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--ink);
        line-height: 1.25;
        overflow-wrap: anywhere
    }

    .person-title {
        display: inline-block;
        margin-top: 5px;
        padding: 1px 9px;
        border-radius: 20px;
        background: color-mix(in srgb,var(--rc) 13%,#fff);
        color: color-mix(in srgb,var(--rc) 65%,#1b2333);
        font-size: 10px;
        font-weight: 600;
        line-height: 1.5
    }

    .person.me .avatar {
        box-shadow: 0 0 0 5px color-mix(in srgb,var(--rc) 24%,transparent),0 12px 22px -8px color-mix(in srgb,var(--rc) 60%,transparent)
    }

    .toggle {
        margin-top: 9px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 11px;
        border-radius: 20px;
        border: 1.5px solid var(--rc);
        background: #fff;
        color: var(--rc);
        font-size: 10.5px;
        font-weight: 700;
        line-height: 1.5;
        cursor: pointer;
        transition: background .15s,color .15s
    }

        .toggle i {
            font-size: 8px;
            transition: transform .2s
        }

        .toggle:hover, li.collapsed > .person .toggle {
            background: var(--rc);
            color: #fff
        }

            li.collapsed > .person .toggle i {
                transform: rotate(-90deg)
            }

    .org-tree li.is-hidden {
        display: none
    }

    .org-tree li.solo::before, .org-tree li.solo::after {
        display: none
    }

    .org-tree li.solo {
        padding-top: 0
    }

    .org-reset {
        margin-left: auto;
        padding: 5px 14px;
        border: 1px solid var(--line-c);
        border-radius: 20px;
        background: #fff;
        color: var(--ink);
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s,color .15s
    }

        .org-reset:hover {
            background: var(--ink);
            color: #fff
        }

    @@keyframes openIn {
        from {
            opacity: 0;
            transform: translateY(-8px)
        }

        to {
            opacity: 1;
            transform: none
        }
    }

    @@media (max-width:640px) {
        .org-wrap {
            padding: 28px 14px 44px;
            border-radius: 14px
        }

        .person {
            width: 116px
        }

            .person.xl {
                --sz: 80px
            }

            .person.lg {
                --sz: 64px
            }

            .person.md {
                --sz: 54px
            }

        .org-tree li {
            padding-left: 6px;
            padding-right: 6px
        }
    }

    @@media (prefers-reduced-motion:reduce) {
        .org-tree * {
            animation: none !important;
            transition: none !important
        }
    }

    .modal-content {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(0,0,0,.25)
    }

    .modal-header {
        padding: 14px 18px;
        border-bottom: none !important;
        display: flex;
        align-items: center;
        justify-content: space-between
    }

    .modal-header-content {
        display: flex;
        align-items: center;
        gap: 10px
    }

    .modal-icon-box {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: rgba(255,255,255,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 13px
    }

    .btn-close-custom {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: rgba(220,50,50,.18);
        border: 1.5px solid rgba(220,80,80,.45);
        color: #f87171;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 12px;
        transition: background .2s,color .2s;
        padding: 0;
        line-height: 1
    }

        .btn-close-custom:hover {
            background: rgba(220,50,50,.4);
            color: #fff;
            border-color: rgba(220,80,80,.75)
        }

    .modal-body {
        padding: 14px 16px;
        background: #fff
    }

    .employee-info-header {
        display: flex;
        flex-direction: column;
        gap: 2px
    }

    .modal-title.employee-name {
        color: #fff !important;
        font-size: 14px !important;
        font-weight: 600 !important;
        margin: 0 !important;
        line-height: 1.3
    }

    .employee-code {
        color: rgba(255,255,255,.55);
        font-size: 11px;
        font-weight: 400
    }

    .stats-label {
        font-size: 10px;
        font-weight: 600;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin: 0 0 8px
    }





    @@media (min-width:1400px) {
        .modal-xxl {
            max-width: 1320px !important
        }
    }

    .renewal-marquee {
        position: relative;
        width: 100%;
        height: 33px;
        margin: 0 0 18px 0;
        display: flex;
        align-items: center;
        overflow: hidden;
        border-radius: 9px;
        box-shadow: 0 2px 6px rgba(16,30,54,.04)
    }

    .renewal-marquee-track {
        position: absolute;
        left: 0;
        right: 150px;
        height: 100%;
        display: flex;
        align-items: center;
        overflow: hidden;
        white-space: nowrap
    }

    .renewal-marquee-content {
        display: inline-flex;
        align-items: center;
        width: max-content;
        animation: renewalScroll 18s linear infinite
    }

    .renewal-message {
        display: inline-flex;
        align-items: center;
        padding-right: 100px;
        color: #345374;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap
    }

        .renewal-message i {
            margin-right: 7px;
            color: #ea580c;
            font-size: 12px
        }

    @@keyframes renewalScroll {
        from {
            transform: translateX(100%)
        }

        to {
            transform: translateX(-100%)
        }
    }

    .renewal-marquee:hover .renewal-marquee-content {
        animation-play-state: paused
    }

    @@media (max-width:768px) {
        .renewal-marquee {
            height: 40px
        }

        .renewal-marquee-track {
            right: 120px
        }

        .renewal-message {
            font-size: 10px;
            padding-right: 70px
        }
    }

    .renewal-header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px
    }

    .renewal-filter-btn {
        border: 0;
        background: transparent;
        color: #94a3b8;
        cursor: pointer;
        padding: 2px 4px
    }

        .renewal-filter-btn:hover, .renewal-filter-btn.active {
            color: #2563eb
        }

    .renewal-filter-dropdown {
        background: #fff;
        border: 1px solid #d9dee7;
        border-radius: 8px;
        box-shadow: 0 8px 25px rgba(0,0,0,.15);
        padding: 10px
    }

    .renewal-filter-select-all {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 6px 4px;
        cursor: pointer;
        font-size: 12px
    }

    .renewal-filter-divider {
        border-top: 1px solid #e5e7eb;
        margin: 5px 0
    }

    .renewal-filter-options {
        max-height: 220px;
        overflow-y: auto
    }

    .renewal-filter-option {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 5px 4px;
        margin: 0;
        cursor: pointer;
        font-size: 12px;
        color: #475569
    }

        .renewal-filter-option:hover {
            background: #f1f5f9
        }

    .renewal-filter-actions {
        display: flex;
        justify-content: flex-end;
        gap: 6px;
        border-top: 1px solid #e5e7eb;
        margin-top: 8px;
        padding-top: 8px
    }

    .renewal-filter-dropdown::-webkit-scrollbar, .renewal-filter-options::-webkit-scrollbar {
        width: 5px
    }

    .renewal-filter-dropdown::-webkit-scrollbar-thumb, .renewal-filter-options::-webkit-scrollbar-thumb {
        background: #94a3b8;
        border-radius: 10px
    }

    #commonModalBody .renewal-table-wrapper {
        max-height: 420px;
        overflow-y: auto;
        overflow-x: auto;
        border: 1px solid #e8ecf2;
        border-radius: 10px
    }

    #commonModalBody .renewal-table {
        width: 100%;
        margin: 0;
        font-size: 12px;
        border-collapse: separate;
        border-spacing: 0
    }

        #commonModalBody .renewal-table thead {
            position: sticky;
            top: 0;
            z-index: 5
        }

            #commonModalBody .renewal-table thead th {
                position: sticky;
                top: 0;
                z-index: 5;
                background: #5e7185 !important;
                color: whitesmoke;
                font-size: 10px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .04em;
                padding: 10px;
                white-space: nowrap;
                border-bottom: 1px solid #e8ecf2
            }

        #commonModalBody .renewal-table tbody td {
            padding: 10px;
            color: #475569;
            white-space: nowrap;
            border-bottom: 1px solid #f1f5f9;
            background: #fff
        }

        #commonModalBody .renewal-table tbody tr:hover td {
            background: #f8fafc
        }

        #commonModalBody .renewal-table tbody tr:last-child td {
            border-bottom: none
        }

    #commonModalBody .renewal-table-wrapper::-webkit-scrollbar {
        width: 6px;
        height: 6px
    }

    #commonModalBody .renewal-table-wrapper::-webkit-scrollbar-track {
        background: #f1f5f9
    }

    #commonModalBody .renewal-table-wrapper::-webkit-scrollbar-thumb {
        background: #94a3b8;
        border-radius: 10px
    }

        #commonModalBody .renewal-table-wrapper::-webkit-scrollbar-thumb:hover {
            background: #64748b
        }

    .daysBadge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 72px;
        padding: 4px 9px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700
    }

        .daysBadge.red {
            color: #dc2626;
            background: #fef2f2;
            border: 1px solid #fecaca
        }

        .daysBadge.orange {
            color: #ea580c;
            background: #fff7ed;
            border: 1px solid #fed7aa
        }

        .daysBadge.green {
            color: #059669;
            background: #ecfdf5;
            border: 1px solid #a7f3d0
        }
</style>

<style>
    .employee-performance-section {
        width: 100%;
        background: #fff;
        border: 1px solid #dfe5ee;
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 12px 34px rgba(16, 30, 54, .08);
    }

    .performance-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 18px;
    }

    .performance-title {
        margin: 0;
        color: #1b2333;
        font-size: 16px;
        font-weight: 800;
        letter-spacing: -.2px;
    }

        .performance-title i {
            color: #2563eb;
            font-size: 15px;
        }

    .performance-subtitle {
        margin-top: 5px;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
    }

    .performance-date {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .performance-date label {
            color: #475569;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .performance-date .form-control {
            width: 150px;
            height: 38px;
            padding: 6px 10px;
            font-size: 12px;
            font-weight: 600;
            color: #334155;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            background: #fff;
            box-shadow: 0 2px 6px rgba(15, 23, 42, .05);
            transition: all .2s ease;
        }

            .performance-date .form-control:hover {
                border-color: #94a3b8;
            }

            .performance-date .form-control:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 3px rgba(37, 99, 235, .15);
                outline: none;
            }

    /* ==============================
           TABLE WRAPPER (clear outer border)
           ============================== */
    .performance-table-wrapper {
        width: 100%;
        max-height: 450px;
        overflow: auto;
        border: 1px solid #cfd8e5;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 4px 14px rgba(15, 23, 42, .06);
    }

        .performance-table-wrapper::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        .performance-table-wrapper::-webkit-scrollbar-track {
            background: #f1f5f9;
        }

        .performance-table-wrapper::-webkit-scrollbar-thumb {
            background: #b6c2d3;
            border-radius: 10px;
        }

            .performance-table-wrapper::-webkit-scrollbar-thumb:hover {
                background: #8294ac;
            }

    .employee-performance-table {
        width: 100%;
        min-width: 850px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 13px;
    }

        /* ---------- HEADER (background unchanged) ---------- */
        .employee-performance-table thead th {
            position: sticky;
            top: 0;
            z-index: 5;
            padding: 13px 14px;
            background: linear-gradient(314deg, #0b0f14, #1a3e66);
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            white-space: nowrap;
            text-align: center;
            border: 0;
            border-right: 1px solid rgba(255, 255, 255, .14);
            border-bottom: 2px solid #2563eb;
            box-shadow: 0 3px 8px rgba(15, 23, 42, .15);
        }

            .employee-performance-table thead th:last-child {
                border-right: 0;
            }

            .employee-performance-table thead th:nth-child(2) {
                text-align: left;
            }

        /* ---------- BODY (visible cell borders) ---------- */
        .employee-performance-table tbody td {
            padding: 12px 14px;
            height: 62px;
            background: #fff;
            color: #334155;
            text-align: center;
            border-right: 1px solid #e3e9f1;
            border-bottom: 1px solid #e3e9f1;
            white-space: nowrap;
            vertical-align: middle;
            transition: background-color .18s ease, color .18s ease;
        }

            .employee-performance-table tbody td:last-child {
                border-right: 0;
            }

            .employee-performance-table tbody td:nth-child(2) {
                text-align: left;
            }

        .employee-performance-table tbody tr:last-child td {
            border-bottom: 0;
        }

        /* zebra stripes */
        .employee-performance-table tbody tr:nth-child(even) td {
            background: #f8fafd;
        }

        /* hover with blue accent bar */
        .employee-performance-table tbody tr:hover td {
            background: #eaf2ff;
        }

            .employee-performance-table tbody tr:hover td:first-child {
                color: #2563eb;
                font-weight: 800;
                box-shadow: inset 4px 0 0 #2563eb;
            }

        .employee-performance-table tbody td:first-child {
            color: #64748b;
            font-size: 12px;
            font-weight: 700;
            width: 50px;
        }

    .performance-employee {
        display: flex;
        flex-direction: column;
        gap: 3px;
        min-width: 160px;
    }

        .performance-employee strong {
            color: #0f172a;
            font-size: 13px;
