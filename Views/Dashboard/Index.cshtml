@using Microsoft.AspNetCore.Html
@using System.Text.Encodings.Web
@using WLSPL_ERP_CRM.Models

@model List<WLSPL_ERP_CRM.Models.EmployeeNode>

@{
    ViewData["Title"] = "Employee Hierarchy";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var root = Model?.FirstOrDefault();

    string rootRole = root != null ? DataRole(root.CustRole) : "manager";
}

<style type="text/css">
    :root {
        --page-bg: #F4F6FA;
        --surface: #FFFFFF;
        --surface-soft: #F9FAFB;
        --border: #E8ECF2;
        --connector: #CBD5E1;
        --text-primary: #1A2035;
        --text-secondary: #5C6B82;
        --text-muted: #9BAABF;
        --c-admin: #1a80e1;
        --c-manager: #D97706;
        --c-assimanager: #1d3a58;
        --c-lead: #7843e7;
        --c-exec: #059669;
        --r-sm: 8px;
        --r-md: 14px;
        --r-lg: 18px;
        --shadow-card: 0 2px 8px rgba(16,30,54,.07), 0 1px 2px rgba(16,30,54,.04);
        --shadow-hover: 0 8px 28px rgba(16,30,54,.13), 0 2px 6px rgba(16,30,54,.06);
        --shadow-admin: 0 8px 28px rgba(224,57,75,.18);
        --line-w: 2px;
        --font: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    }

    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

    *, *::before, *::after {
        box-sizing: border-box;
    }

    body {
        background: var(--page-bg);
    }

    .tree-page {
        width: 100%;
        font-family: var(--font);
    }

    .tree {
        width: 100%;
        max-width: 1800px;
        margin: 0 auto;
        padding: 48px 32px 80px;
        position: relative;
        overflow-x: auto;
        overflow-y: visible;
        border-radius: 20px;
        background: #F8FAFD;
        border: 1px solid var(--border);
        box-shadow: 0 2px 12px rgba(16,30,54,.05);
    }

    .level {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        position: relative;
        width: 100%;
        margin: 0;
        gap: 20px;
    }

    .node {
        --nc: #9BAABF;
        position: relative;
        display: grid;
        grid-template-columns: 48px 1fr;
        grid-auto-rows: min-content;
        align-items: center;
        column-gap: 12px;
        min-width: 210px;
        padding: 13px 14px 13px 12px;
        background: var(--surface);
        border-top: 2.5px solid var(--nc);
        border-left: 1.5px solid color-mix(in srgb, var(--nc) 35%, var(--border));
        border-right: 1.5px solid color-mix(in srgb, var(--nc) 35%, var(--border));
        border-bottom: 1.5px solid color-mix(in srgb, var(--nc) 35%, var(--border));
        border-radius: var(--r-md);
        text-align: left;
        cursor: pointer;
        box-shadow: var(--shadow-card);
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
        z-index: 5;
    }

    .node {
        position: relative;
    }

    .employee-info-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 15px;
        height: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 1px solid #0476eb;
        border-radius: 50%;
        background: #0476ebad;
        color: #ffffff;
        font-size: 7px;
        cursor: pointer;
        z-index: 1;
        transition: all .2s ease;
    }

        .employee-info-btn:hover {
            background: var(--nc);
            color: #fff;
            border-color: var(--nc);
            transform: scale(1.1);
        }

        .employee-info-btn i {
            font-size: 9px;
        }



    .node:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-hover);
        border-top-color: var(--nc);
        border-left-color: color-mix(in srgb, var(--nc) 55%, var(--border));
        border-right-color: color-mix(in srgb, var(--nc) 55%, var(--border));
        border-bottom-color: color-mix(in srgb, var(--nc) 55%, var(--border));
    }

    .node:active {
        transform: translateY(-1px);
    }

    .node-avatar {
        grid-row: 1 / -1;
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: color-mix(in srgb, var(--nc) 12%, white);
        color: var(--nc);
        font-family: var(--font);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .3px;
        border: 1.5px solid color-mix(in srgb, var(--nc) 22%, white);
        position: relative;
        flex-shrink: 0;
    }

        .node-avatar::after {
            position: absolute;
            right: -4px;
            bottom: -4px;
            width: 16px;
            height: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: var(--nc);
            color: #fff;
            font-size: 8px;
            font-weight: 700;
            border: 2px solid #fff;
            box-shadow: 0 1px 4px rgba(16,30,54,.2);
        }

    .node[data-role="admin"] .node-avatar::after {
        content: "★";
    }

    .node[data-role="manager"] .node-avatar::after {
        content: "M";
        font-size: 7px;
    }

    .node[data-role="team-lead"] .node-avatar::after {
        content: "L";
        font-size: 7px;
    }

    .node[data-role="executive"] .node-avatar::after {
        content: "✓";
    }

    .node strong {
        display: block;
        margin: 0 0 3px;
        color: var(--text-primary);
        font-family: var(--font);
        font-size: 19px;
        font-weight: 700;
        line-height: 1.3;
        white-space: normal;
        padding-right: 22px;
    }

    .node small {
        display: block;
        font-size: 10.5px;
        line-height: 1.5;
        color: var(--text-secondary);
    }

    .empcode {
        font-size: 11.5px !important;
        color: #9d9fa1 !important;
        font-weight: 700 !important;
    }

    .employee-role {
        color: var(--nc) !important;
        font-weight: 600 !important;
        font-size: 10px !important;
    }

        .employee-role i {
            width: 11px;
            margin-right: 2px;
            font-size: 8.5px;
            color: var(--nc);
        }

    .employee-designation {
        color: var(--text-muted) !important;
        font-size: 10px !important;
    }

        .employee-designation i {
            width: 11px;
            margin-right: 2px;
            font-size: 8.5px;
            color: var(--text-muted);
        }

    .team-count {
        display: inline-flex !important;
        align-items: center;
        gap: 4px;
        margin-top: 6px;
        padding: 2px 8px;
        border-radius: 20px;
        background: color-mix(in srgb, var(--nc) 10%, white);
        color: var(--nc) !important;
        font-size: 9.5px !important;
        font-weight: 700 !important;
        letter-spacing: .2px;
        border: 1px solid color-mix(in srgb, var(--nc) 20%, white);
    }

        .team-count::before {
            content: "";
            display: inline-block;
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--nc);
            opacity: .75;
        }

    .node[data-role="admin"] {
        --nc: var(--c-admin);
        min-width: 255px;
        border-radius: var(--r-lg);
        box-shadow: var(--shadow-admin);
        background: #1a80e133;
    }

        .node[data-role="admin"] .node-avatar {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            font-size: 16px;
        }

        .node[data-role="admin"] strong {
            font-size: 20px;
        }

    .node[data-role="manager"] {
        --nc: var(--c-manager);
        min-width: 255px;
        background: rgb(255 153 35 / 22%);
    }

    .node[data-role="assimanager"] {
        --nc: var(--c-assimanager);
        min-width: 255px;
        background: rgb(97 151 201 / 32%);
    }

    .node[data-role="team-lead"] {
        --nc: var(--c-lead);
        min-width: 255px;
        background: #704ac136;
    }

    .node[data-role="executive"] {
        --nc: var(--c-exec);
        min-width: 255px;
        background: rgb(5 150 105 / 19%);
        cursor: default;
    }

        .node[data-role="executive"]:hover {
            transform: none;
            box-shadow: var(--shadow-card);
        }

    .team-count-wrapper {
        display: flex;
        align-items: center;
        width: 100%;
        margin-top: 6px;
    }

        .team-count-wrapper .team-count {
            margin-top: 0;
        }

    .team-toggle-btn {
        margin-left: auto;
        width: 25px;
        height: 25px;
        padding: 3px 3px 6px 3px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background: var(--nc);
        color: #fff;
        border-color: var(--nc);
        font-size: 14px;
        font-weight: 700;
        line-height: 1;
        cursor: pointer;
        transition: all .18s ease;
    }

        .team-toggle-btn:hover {
            border: 1px solid color-mix(in srgb, var(--nc) 22%, white);
            background: color-mix(in srgb, var(--nc) 8%, white);
            color: var(--nc);
        }

        .team-toggle-btn:active {
            transform: scale(.92);
        }


    .node.active {
        border-top-color: var(--nc);
        border-left-color: color-mix(in srgb, var(--nc) 55%, var(--border));
        border-right-color: color-mix(in srgb, var(--nc) 55%, var(--border));
        border-bottom-color: color-mix(in srgb, var(--nc) 55%, var(--border));
        box-shadow: 0 4px 18px color-mix(in srgb, var(--nc) 16%, transparent), var(--shadow-card);
    }

    .manager-container {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: flex-start;
        width: 100%;
        gap: 20px;
        flex-wrap: wrap;
        margin: 32px 0 0;
        padding-top: 0;
        padding-bottom: 16px;
        position: relative;
    }

        .manager-container::before {
            display: none;
        }

    .manager-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        animation: fadeUp .3s ease both;
    }

        .manager-block::before {
            display: none;
        }

    .tl-horizontal-container {
        display: none;
        flex-direction: column;
        align-items: center;
        position: relative;
        width: max-content;
        min-width: 100%;
        margin-top: 16px;
        padding-top: 20px;
        animation: expandTree .24s ease both;
    }

        .tl-horizontal-container::before {
            content: "";
            position: absolute;
            top: 0;
            left: 50%;
            width: var(--line-w);
            height: 20px;
            background: var(--connector);
            transform: translateX(-50%);
            border-radius: 2px;
        }

    .tl-horizontal-line {
        height: var(--line-w);
        width: 100%;
        min-width: 160px;
        margin-bottom: 20px;
        background: var(--connector);
        border-radius: 2px;
    }

    .tl-row {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        width: 100%;
    }

    .tl-column {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        padding-top: 20px;
    }

        .tl-column::before {
            content: "";
            position: absolute;
            top: 0;
            left: 50%;
            width: var(--line-w);
            height: 20px;
            background: var(--connector);
            transform: translateX(-50%);
            border-radius: 2px;
        }

        .tl-column > .tl-horizontal-container {
            display: none;
            flex-direction: column !important;
            align-items: center;
            margin-top: 12px;
            min-width: unset;
            width: max-content;
        }

            .tl-column > .tl-horizontal-container > .tl-horizontal-line {
                display: none;
            }

            .tl-column > .tl-horizontal-container > .tl-row {
                flex-direction: column !important;
                align-items: center;
                gap: 10px;
            }

                .tl-column > .tl-horizontal-container > .tl-row > .tl-column {
                    padding-top: 0;
                }

                    .tl-column > .tl-horizontal-container > .tl-row > .tl-column::before {
                        display: none;
                    }

    .executive-container {
        display: none;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        margin-top: 0;
        padding: 4px 6px 10px;
        max-height: 400px;
        overflow-y: auto;
        scrollbar-width: thin;
        animation: expandTree .22s ease both;
    }

    .tl-vertical-connector {
        display: none;
        width: var(--line-w);
        height: 18px;
        background: var(--connector);
        border-radius: 2px;
    }

    .manager-connector,
    .manager-vertical-connector,
    .executive-connector {
        display: none;
    }

    .node[style*="background:#eee"] {
        --nc: #B0BEC5;
        background: var(--surface-soft) !important;
        border: 1.5px dashed var(--border) !important;
        box-shadow: none;
        opacity: .75;
        cursor: default;
    }

        .node[style*="background:#eee"] strong,
        .node[style*="background:#eee"] small {
            color: var(--text-muted) !important;
        }

    .tree::-webkit-scrollbar,
    .executive-container::-webkit-scrollbar,
    .tl-row::-webkit-scrollbar {
        width: 5px;
        height: 5px;
    }

    .tree::-webkit-scrollbar-thumb,
    .executive-container::-webkit-scrollbar-thumb,
    .tl-row::-webkit-scrollbar-thumb {
        background: var(--connector);
        border-radius: 10px;
    }

    .tree::-webkit-scrollbar-track,
    .executive-container::-webkit-scrollbar-track,
    .tl-row::-webkit-scrollbar-track {
        background: transparent;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes expandTree {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .tree {
            padding: 28px 10px 50px;
            border-radius: 14px;
        }

        .manager-container {
            justify-content: flex-start;
            flex-wrap: nowrap;
            overflow-x: auto;
            padding: 0 20px 24px;
            gap: 14px;
            scroll-snap-type: x mandatory;
        }

        .manager-block {
            flex: 0 0 auto;
            scroll-snap-align: center;
        }

        .tl-row {
            flex-wrap: nowrap;
            justify-content: flex-start;
            overflow-x: auto;
            padding: 0 16px 16px;
            scroll-snap-type: x mandatory;
        }

        .tl-column {
            flex: 0 0 auto;
            scroll-snap-align: center;
        }

        .node[data-role="admin"] {
            min-width: 210px;
        }

        .node[data-role="manager"] {
            min-width: 198px;
        }

        .node[data-role="team-lead"] {
            min-width: 188px;
        }

        .node[data-role="executive"] {
            min-width: 180px;
        }
    }
</style>

<style type="text/css">
    /* Modal Structure */
    .modal-content {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25);
    }

    /* Header */
    .modal-header {
        padding: 14px 18px;
        border-bottom: none !important;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .modal-header-content {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .modal-icon-box {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 13px;
    }


    /* Red Close Button */
    .btn-close-custom {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: rgba(220, 50, 50, 0.18);
        border: 1.5px solid rgba(220, 80, 80, 0.45);
        color: #f87171;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 12px;
        transition: background 0.2s, color 0.2s;
        padding: 0;
        line-height: 1;
    }

        .btn-close-custom:hover {
            background: rgba(220, 50, 50, 0.4);
            color: #fff;
            border-color: rgba(220, 80, 80, 0.75);
        }

    /* Modal Body */
    .modal-body {
        padding: 14px 16px;
        background: #fff;
    }

    .employee-info-header {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .modal-title.employee-name {
        color: #fff !important;
        font-size: 14px !important;
        font-weight: 600 !important;
        margin: 0 !important;
        line-height: 1.3;
    }

    .employee-code {
        color: rgba(255, 255, 255, 0.55);
        font-size: 11px;
        font-weight: 400;
    }

    /* Section Label */
    .stats-label {
        font-size: 10px;
        font-weight: 600;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin: 0 0 8px;
    }

    /* Stats Grid */
    .company-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .company-stat {
        padding: 10px 8px;
        border-radius: 10px;
        text-align: center;
        position: relative;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .company-stat:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
        }

        /* Colored top accent bar */
        .company-stat::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: 10px 10px 0 0;
        }

        /* Company stat accent bars */
        .company-stat.total::before {
            background: linear-gradient(90deg, #3b82f6, #2563eb);
        }

        .company-stat.paid::before {
            background: linear-gradient(90deg, #10b981, #059669);
        }

        .company-stat.unpaid::before {
            background: linear-gradient(90deg, #f97316, #ea580c);
        }

        /* Meeting stat accent bars */
        .company-stat.fresh::before {
            background: linear-gradient(90deg, #8b5cf6, #7c3aed);
        }

        .company-stat.followup::before {
            background: linear-gradient(90deg, #60a5fa, #2563eb);
        }

        .company-stat.service::before {
            background: linear-gradient(90deg, #34d399, #059669);
        }

    /* Stat Icon */
    .stat-icon {
        font-size: 14px;
        margin-bottom: 5px;
    }

    /* Company stat icon colors */
    .company-stat.total .stat-icon {
        color: #2563eb;
    }

    .company-stat.paid .stat-icon {
        color: #059669;
    }

    .company-stat.unpaid .stat-icon {
        color: #ea580c;
    }

    /* Meeting stat icon colors */
    .company-stat.fresh .stat-icon {
        color: #7c3aed;
    }

    .company-stat.followup .stat-icon {
        color: #2563eb;
    }

    .company-stat.service .stat-icon {
        color: #059669;
    }

    /* Stat Title */
    .company-stat .stat-title {
        display: block;
        font-size: 10px;
        color: #64748b;
        margin-bottom: 4px;
        font-weight: 500;
    }

    /* Stat Number */
    .company-stat strong {
        display: block;
        font-size: 20px;
        font-weight: 700;
        line-height: 1;
    }

    /* Company stat backgrounds */
    .company-stat.total {
        background: #eff6ff;
        color: #2563eb;
    }

    .company-stat.paid {
        background: #ecfdf5;
        color: #059669;
    }

    .company-stat.unpaid {
        background: #fff7ed;
        color: #ea580c;
    }

    /* Meeting stat backgrounds */
    .company-stat.fresh {
        background: #f5f3ff;
        color: #7c3aed;
    }

    .company-stat.followup {
        background: #eff6ff;
        color: #2563eb;
    }

    .company-stat.service {
        background: #ecfdf5;
        color: #059669;
    }

    /* Total Meetings Bar */
    .total-meetings-bar {
        background: linear-gradient(100deg, #0b0f14, #1a3e66);
        border-radius: 10px;
        padding: 10px 14px;
        margin-top: 8px;
    }

    .total-meetings-info {
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: #fff;
        font-size: 13px;
    }

        .total-meetings-info strong {
            font-size: 18px;
            font-weight: 700;
            color: #fff;
        }
</style>

@functions {

    private string Safe(object value)
    {
        return HtmlEncoder.Default.Encode(Convert.ToString(value) ?? "");
    }

    private string DataRole(string role)
    {
        if (string.IsNullOrWhiteSpace(role))
            return "executive";

        return role.Trim() switch
        {
            "Admin" => "admin",
            "Sub Admin" => "admin",
            "Other" => "admin",   // ← ADD THIS (Vaibhav SubAdmin case)
            "Sales Manager" => "manager",
            "Assistant Sales Manager" => "assimanager",
            "Sales TL" => "team-lead",
            "Sales Executive" => "executive",
            _ => "executive"
        };
    }

    private IHtmlContent RenderEmployeeChildren(EmployeeNode employee, string employeeId)
    {
        var html = new HtmlContentBuilder();

        var children = employee.Children?
            .Where(x => !string.Equals(
                Convert.ToString(x.EmpCode),
                Convert.ToString(employee.EmpCode),
                StringComparison.OrdinalIgnoreCase))
            .ToList()
            ?? new List<EmployeeNode>();

        if (!children.Any()) return html;

        // Separate into three buckets
        var teamLeads = children
            .Where(c => string.Equals(c.CustRole, "Sales TL", StringComparison.OrdinalIgnoreCase))
            .ToList();

        var directExecutives = children
            .Where(c => string.Equals(c.CustRole, "Sales Executive", StringComparison.OrdinalIgnoreCase))
            .ToList();

        // Everything else: Assistant Sales Manager, Other, etc.
        var midLevelChildren = children
            .Where(c => !teamLeads.Contains(c) && !directExecutives.Contains(c))
            .ToList();

        html.AppendHtml($@"
        <div class='tl-horizontal-container' data-manager-id='{Safe(employeeId)}'>
            <div class='tl-horizontal-line'></div>
            <div class='tl-row'>
    ");

        // ── 1. Team Leads (Sales TL) ─────────────────────────────────
        foreach (var tl in teamLeads)
        {
            var tlId = Convert.ToString(tl.EmpCode) ?? "";
            var tlRole = DataRole(tl.CustRole);

            var tlExecutives = tl.Children?
                .Where(c => !string.Equals(c.EmpCode, tl.EmpCode, StringComparison.OrdinalIgnoreCase))
                .ToList()
                ?? new List<EmployeeNode>();

            html.AppendHtml($@"
            <div class='tl-column'>
                <div class='node' data-role='{tlRole}'
                     data-tl-id='{Safe(tlId)}'>
                    <div class='node-avatar'>{Safe(GetInitials(tl.Name))}</div>
                    <div>
                        <strong>{Safe(tl.Name)}</strong>
                        <small class='empcode'>{Safe(tl.EmpCode)}</small>
                        <small class='employee-role'>
                            <i class='fas fa-user-tag'></i>{Safe(tl.Role)}
                        </small>
                        <small class='employee-designation'>
                            <i class='fas fa-briefcase'></i>Team Lead
                        </small>
                       <div class='team-count-wrapper'>
                            <small class='team-count'>Team {tlExecutives.Count}</small>
                            <button type='button' class='team-toggle-btn'
                                    onclick='event.stopPropagation(); toggleExecutives(this.closest("".node""))'
                                    aria-label='Toggle team'>+</button>
                       </div>
                    </div>
                    <button type='button' class='employee-info-btn'
                            data-empcode={Safe(tl.EmpCode)}
                            onclick='event.stopPropagation(); showEmployeeInfo(this);'
                            title='Employee Information'>
                            <i class='fas fa-info'></i>
                     </button>
                </div>
                <div class='tl-vertical-connector' data-tl-id='{Safe(tlId)}'></div>
                <div class='executive-container' data-tl-id='{Safe(tlId)}'>
        ");

            if (tlExecutives.Any())
            {
                foreach (var exec in tlExecutives)
                {
                    var execRole = DataRole(exec.CustRole);
                    html.AppendHtml($@"
                    <div class='node' data-role='{execRole}'>
                        <div class='node-avatar'>{Safe(GetInitials(exec.Name))}</div>
                        <div>
                            <strong>{Safe(exec.Name)}</strong>
                            <small class='empcode'>{Safe(exec.EmpCode)}</small>
                            <small class='employee-role'>
                                <i class='fas fa-user-tag'></i>{Safe(exec.Role)}
                            </small>
                            <small class='employee-designation'>
                                <i class='fas fa-briefcase'></i>Executive
                            </small>
                        </div>
                    </div>
                ");
                }
            }
            else
            {
                html.AppendHtml(@"
                <div class='node' data-role='executive' style='background:#eee;'>
                    <div><small>No team members</small></div>
                </div>
            ");
            }

            html.AppendHtml("</div></div>"); // close executive-container + tl-column
        }

        foreach (var mid in midLevelChildren)
        {
            var midId = Convert.ToString(mid.EmpCode) ?? "";
            var midRole = DataRole(mid.CustRole);

            var midChildCount = mid.Children?
                .Where(c => !string.Equals(c.EmpCode, mid.EmpCode, StringComparison.OrdinalIgnoreCase))
                .Count() ?? 0;

            var midTLCount = mid.Children?
                .Where(c => string.Equals(c.CustRole, "Sales TL", StringComparison.OrdinalIgnoreCase))
                .Count() ?? 0;

            string midCount = midTLCount > 0
                ? "TL: " + midTLCount
                : "Team: " + midChildCount;

            string designation = mid.CustRole switch
            {
                "Assistant Sales Manager" => "Asst. Manager",
                "Sales Manager" => "Manager",
                _ => mid.CustRole ?? "Staff"
            };

            // Render the mid-level node card
            html.AppendHtml($@"
            <div class='tl-column'>
                <div class='node' data-role='{midRole}'
                     onclick='toggleTeamLeads(this)'
                     data-manager-id='{Safe(midId)}'>
                    <div class='node-avatar'>{Safe(GetInitials(mid.Name))}</div>
                    <div>
                        <strong>{Safe(mid.Name)}</strong>
                        <small class='empcode'>{Safe(mid.EmpCode)}</small>
                        <small class='employee-role'>
                            <i class='fas fa-user-tag'></i>{Safe(mid.Role)}
                        </small>
                        <small class='employee-designation'>
                            <i class='fas fa-briefcase'></i>{designation}
                        </small>
                        <div class='team-count-wrapper'>
                            <small class='team-count'>{midCount}</small>
                            <button type='button' class='team-toggle-btn'
                                    onclick='event.stopPropagation(); toggleTeamLeads(this.closest("".node""))'
                                    aria-label='Toggle team'>+</button>
                        </div>
                    </div>
                    <button type='button' class='employee-info-btn'
                            data-empcode={Safe(mid.EmpCode)}
                            onclick='event.stopPropagation(); showEmployeeInfo(this);'
                            title='Employee Information'>
                            <i class='fas fa-info'></i>
                     </button>
                </div>
                <div class='manager-vertical-connector'
                     data-manager-id='{Safe(midId)}'></div>
        ");

            html.AppendHtml(RenderEmployeeChildren(mid, midId));

            html.AppendHtml("</div>");
        }

        // ── 3. Direct Sales Executives (leaf nodes) ──────────────────
        foreach (var exec in directExecutives)
        {
            var execRole = DataRole(exec.CustRole);
            html.AppendHtml($@"
            <div class='tl-column'>
                <div class='node' data-role='{execRole}'>
                    <div class='node-avatar'>{Safe(GetInitials(exec.Name))}</div>
                    <div>
                        <strong>{Safe(exec.Name)}</strong>
                        <small class='empcode'>{Safe(exec.EmpCode)}</small>
                        <small class='employee-role'>
                            <i class='fas fa-user-tag'></i>{Safe(exec.Role)}
                        </small>
                        <small class='employee-designation'>
                            <i class='fas fa-briefcase'></i>Executive
                        </small>
                    </div>
                     <button type='button' class='employee-info-btn'
                            data-empcode={Safe(exec.EmpCode)}
                            onclick='event.stopPropagation(); showEmployeeInfo(this);'
                            title='Employee Information'>
                            <i class='fas fa-info'></i>
                     </button>
                </div>
            </div>
        ");
        }

        html.AppendHtml("</div></div>");

        return html;
    }

    private IHtmlContent RenderManagers(EmployeeNode root)
    {
        var html = new HtmlContentBuilder();

        var children = root.Children?
            .Where(x => !string.Equals(Convert.ToString(x.EmpCode), Convert.ToString(root.EmpCode), StringComparison.OrdinalIgnoreCase))
            .ToList()
            ?? new List<EmployeeNode>();

        if (!children.Any()) return html;

        html.AppendHtml(@"<div class='level'><div class='manager-container' style='display:flex;'>");

        foreach (var employee in children)
        {
            var employeeId = Convert.ToString(employee.EmpCode) ?? "";
            var empRole = DataRole(employee.OrgRole);

            var teamLeads = employee.Children?
                 .Where(c => string.Equals(c.CustRole, "Sales TL", StringComparison.OrdinalIgnoreCase))
                 .ToList()
                 ?? new List<EmployeeNode>();

            var teamCount = employee.Children?.Count ?? 0;
            string count = teamLeads.Any()
                ? "Team Leader: " + teamLeads.Count
                : "Team: " + teamCount;

            // Designation label — contextual
            string designation = empRole switch
            {
                "manager" => "Manager",
                "team-lead" => "Team Lead",
                "executive" => "Executive",
                _ => "Sub-Admin"
            };

            html.AppendHtml($@"
                <div class='manager-block'>
                    <div class='node' data-role='{empRole}'
                         data-manager-id='{Safe(employeeId)}' title='{Safe(employee.Role)}'>
                        <div class='node-avatar'>{Safe(GetInitials(employee.Name))}</div>
                        <div>
                            <strong>{Safe(employee.Name)}</strong>
                            <small class='empcode'>{Safe(employee.EmpCode)}</small>
                            <small class='employee-role'><i class='fas fa-user-tag'></i>{Safe(employee.Role)}</small>
                            <small class='employee-designation'><i class='fas fa-briefcase'></i>{designation}</small>
                            <div class='team-count-wrapper'>
                               <small class='team-count'>{count}</small>
                                 <button type='button' class='team-toggle-btn'
                                 onclick='event.stopPropagation(); toggleTeamLeads(this.closest("".node""))'
                                  aria-label='Toggle team'>+</button>
                            </div>
                        </div>
                        <button type='button'
                            class='employee-info-btn'
                            data-empcode={Safe(employee.EmpCode)}
                            onclick='event.stopPropagation(); showEmployeeInfo(this);'
                            title='Employee Information'>
                            <i class='fas fa-info'></i>
                        </button>
                    </div>
                    <div class='manager-vertical-connector' data-manager-id='{Safe(employeeId)}'></div>
            ");

            html.AppendHtml(RenderEmployeeChildren(employee, employeeId));
            html.AppendHtml("</div>");
        }

        html.AppendHtml("</div></div>");
        return html;
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpper();
    }
}

