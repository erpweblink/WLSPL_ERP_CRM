@functions {
    private string Safe(object value)
    {
        return HtmlEncoder.Default.Encode(Convert.ToString(value) ?? "");
    }

    private string DataRole(string role)
    {
        if (string.IsNullOrWhiteSpace(role))
            return "executive";
        return role.Trim().ToLowerInvariant() switch
        {
            "ceo" => "ceo",
            "branch manager" => "manager",
            "cluster manager" => "assimanager",
            "manager" => "team-lead",
            "executive" => "executive",
            _ => "executive"
        };
    }

    private static List<EmployeeNode> GetTeam(EmployeeNode e)
    {
        return e.Children?
            .Where(c => !string.Equals(c.EmpCode?.Trim(), e.EmpCode?.Trim(), StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(c => c.Children != null && c.Children.Count > 0)
            .ToList()
            ?? new List<EmployeeNode>();
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpper();
    }

    private IHtmlContent RenderTree(EmployeeNode emp, int depth, string me, bool inScope)
    {
        var html = new HtmlContentBuilder();
        var team = GetTeam(emp);
        var showInfo = inScope || string.Equals(emp.EmpCode?.Trim(), me, StringComparison.OrdinalIgnoreCase);
        var id = Safe(emp.EmpCode);
        var size = depth == 0 ? "xl" : depth == 1 ? "lg" : depth == 2 ? "md" : "sm";
        var cls = depth > 0 && team.Any() ? " class='collapsed'" : "";
        var imagePath = Safe(emp.ProfileImagePath);
        html.AppendHtml($"<li data-empcode='{id}'{cls}><div class='person {size}' data-role='{DataRole(emp.CustRole)}'><div class='avatar'>");

        if (!string.IsNullOrWhiteSpace(emp.ProfileImagePath))
        {
            html.AppendHtml($@"
            <img src='{imagePath}'
                 alt='{Safe(emp.Name)}'
                 class='employee-avatar-img'
                 onerror=""this.style.display='none'; this.nextElementSibling.style.display='flex';"" />
            <span style='display:none;'>{Safe(GetInitials(emp.Name))}</span>");
        }
        else
        {
            html.AppendHtml($"<span>{Safe(GetInitials(emp.Name))}</span>");
        }

        html.AppendHtml($"</div><div class='person-card'><div class='person-name'>{Safe(emp.Name)}</div><div class='person-title'>{Safe(emp.Role)}</div>");
        if (showInfo)
            html.AppendHtml($"<div class='company-counts'><div class='company-count-item'><span>Self</span><strong>{Safe(emp.SelfCompnaies ?? "0")}</strong></div><div class='company-count-item'><span>Paid</span><strong>{Safe(emp.PaidCompanies ?? "0")}</strong></div><div class='company-count-item'><span>Team Total</span><strong>{Safe(emp.TeamTotalCompanies ?? "0")}</strong></div><div class='company-count-item'><span>Unpaid</span><strong>{Safe(emp.UnPaidCompanies ?? "0")}</strong></div></div>");
        html.AppendHtml("</div>");
        if (team.Any())
            html.AppendHtml($"<button type='button' class='toggle' onclick='toggleNode(this)' data-empcode='{emp.EmpCode}' title='Show or hide team'><i class='fas fa-chevron-down'></i><span>{team.Count}</span></button>");
        html.AppendHtml("</div>");
        if (team.Any())
        {
            html.AppendHtml("<ul>");
            foreach (var child in team)
                html.AppendHtml(RenderTree(child, depth + 1, me, showInfo));
            html.AppendHtml("</ul>");
        }
        html.AppendHtml("</li>");
        return html;
    }
}
