<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function () {

       const currentEmpCode = document.getElementById("currentEmpCode")?.value?.trim();
       const currentRole  = document.getElementById("currentRole")?.value?.trim()?.toLowerCase();

       if (currentRole === "admin") return;

       const currentNode = document.querySelector(
            `.node[data-tl-id="${currentEmpCode}"],
             .node[data-manager-id="${currentEmpCode}"]`
        );

        function expandAncestors(element) {
            if (!element) return;

            let parent = element.parentElement;

            while (parent) {

                if (parent.classList.contains("tl-horizontal-container") &&
                    parent.style.display !== "flex") {
                    parent.style.display = "flex";
                    const managerId = parent.getAttribute("data-manager-id");
                    if (managerId) {
                        const managerNode = document.querySelector(
                            `.node[data-manager-id="${managerId}"]`
                        );
                        if (managerNode) {
                            managerNode.classList.add("active");
                            const connector = managerNode.parentElement?.querySelector(
                                `:scope > .manager-vertical-connector[data-manager-id="${managerId}"]`
                            );
                            if (connector) connector.style.display = "block";
                            const btn = managerNode.querySelector(".team-toggle-btn");
                            if (btn) btn.textContent = "−";
                        }
                    }
                }
                if (parent.classList.contains("executive-container") &&
                    parent.style.display !== "flex") {

                    parent.style.display = "flex";

                    const tlId = parent.getAttribute("data-tl-id");
                    if (tlId) {
                        const tlNode = document.querySelector(
                            `.node[data-tl-id="${tlId}"]`
                        );
                        if (tlNode) {
                            tlNode.classList.add("active");
                            const vertConnector = tlNode.parentElement?.querySelector(
                                `:scope > .tl-vertical-connector[data-tl-id="${tlId}"]`
                            );
                            if (vertConnector) vertConnector.style.display = "block";
                            const btn = tlNode.querySelector(".team-toggle-btn");
                            if (btn) btn.textContent = "−";
                        }
                    }
                }

                parent = parent.parentElement;
            }
        }

        function expandOwnChildren(empCode, role) {
            if (["manager", "assimanager", "team-lead"].includes(role)) {
                const ownContainer = document.querySelector(
                    `.tl-horizontal-container[data-manager-id="${empCode}"]`
                );
                if (ownContainer && ownContainer.style.display !== "flex") {
                    ownContainer.style.display = "flex";
                    const ownNode = document.querySelector(
                        `.node[data-manager-id="${empCode}"]`
                    );
                    if (ownNode) {
                        ownNode.classList.add("active");
                        const connector = ownNode.parentElement?.querySelector(
                            `:scope > .manager-vertical-connector[data-manager-id="${empCode}"]`
                        );
                        if (connector) connector.style.display = "block";
                        const btn = ownNode.querySelector(".team-toggle-btn");
                        if (btn) btn.textContent = "−";
                    }
                }
                if (role === "team-lead") {
                    const execContainer = document.querySelector(
                        `.executive-container[data-tl-id="${empCode}"]`
                    );
                    if (execContainer && execContainer.style.display !== "flex") {
                        execContainer.style.display = "flex";
                        const tlNode = document.querySelector(
                            `.node[data-tl-id="${empCode}"]`
                        );
                        if (tlNode) {
                            tlNode.classList.add("active");
                            const vertConnector = tlNode.parentElement?.querySelector(
                                `:scope > .tl-vertical-connector[data-tl-id="${empCode}"]`
                            );
                            if (vertConnector) vertConnector.style.display = "block";
                            const btn = tlNode.querySelector(".team-toggle-btn");
                            if (btn) btn.textContent = "−";
                        }
                    }
                }
            }
        }

        if (currentNode) {
            expandAncestors(currentNode);
        } else {
            const infoBtn = document.querySelector(
                `.employee-info-btn[data-empcode="${currentEmpCode}"]`
            );
            if (infoBtn) {
                expandAncestors(infoBtn.closest(".node"));
            }
        }

        const roleMapped = {
            "salesmanager"          : "manager",
            "assistantsalesmanager" : "assimanager",
            "salestl"               : "team-lead",
            "salesexecutive"        : "executive"
        };

        const normalizedRole = currentRole?.replace(/\s+/g, "").toLowerCase();
        const mappedRole = roleMapped[normalizedRole] ?? currentRole;

        expandOwnChildren(currentEmpCode, mappedRole);
    });
</script>

<script type="text/javascript">

    function toggleTeamLeads(managerNode) {
        const managerId = managerNode.getAttribute("data-manager-id");

        const container = managerNode.parentElement;
        if (!container) return;

        const tlContainer = container.querySelector(
            `:scope > .tl-horizontal-container[data-manager-id="${managerId}"]`
        );
        const connector = container.querySelector(
            `:scope > .manager-vertical-connector[data-manager-id="${managerId}"]`
        );

        if (!tlContainer) return;

        const toggleButton = managerNode.querySelector(".team-toggle-btn");
        const isVisible = tlContainer.style.display === "flex";

        if (isVisible) {
            collapseContainer(tlContainer);
            tlContainer.style.display = "none";
            managerNode.classList.remove("active");
            if (connector) connector.style.display = "none";
            if (toggleButton) toggleButton.textContent = "+";
        } else {
            tlContainer.style.display = "flex";
            managerNode.classList.add("active");
            if (connector) connector.style.display = "block";
             if (toggleButton) toggleButton.textContent = "-";
        }
    }

    function toggleExecutives(teamLeadNode) {
        const tlId = teamLeadNode.getAttribute("data-tl-id");

        const column = teamLeadNode.parentElement;
        if (!column) return;

        const executiveContainer = column.querySelector(
            `:scope > .executive-container[data-tl-id="${tlId}"]`
        );
        const verticalConnector = column.querySelector(
            `:scope > .tl-vertical-connector[data-tl-id="${tlId}"]`
        );

        if (!executiveContainer) return;

        const toggleButton = teamLeadNode.querySelector(".team-toggle-btn");
        const isVisible = executiveContainer.style.display === "flex";

        if (isVisible) {
            executiveContainer.style.display = "none";
            teamLeadNode.classList.remove("active");
            if (verticalConnector) verticalConnector.style.display = "none";
            if (toggleButton) toggleButton.textContent = "+";

        } else {
            executiveContainer.style.display = "flex";
            teamLeadNode.classList.add("active");
            if (verticalConnector) verticalConnector.style.display = "block";
            if (toggleButton) toggleButton.textContent = "−";
        }
    }

    function collapseContainer(container) {
        container.querySelectorAll(".executive-container").forEach(el => {
            el.style.display = "none";
        });

        container.querySelectorAll(".tl-horizontal-container").forEach(el => {
            el.style.display = "none";
        });

        container.querySelectorAll(".tl-vertical-connector").forEach(el => {
            el.style.display = "none";
        });

        container.querySelectorAll(".manager-vertical-connector").forEach(el => {
            el.style.display = "none";
        });

        container.querySelectorAll(".node.active").forEach(el => {
            el.classList.remove("active");
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(
            ".manager-block > .tl-horizontal-container"
        ).forEach(container => {
            const row = container.querySelector(".tl-row");
            if (!row) return;
            const columns = row.querySelectorAll(".tl-column");
            if (columns.length > 0) {
                const line = container.querySelector(".tl-horizontal-line");
                line.style.width ="100%";
            }
        });
    });
</script>

<script type="text/javascript">
    function showEmployeeInfo(button) {
        const empCode = button.getAttribute("data-empcode");

        if (!empCode) {
            showToast("Employee code not found.", "error");
            return;
        }

        button.disabled = true;

        $("#commonModalDialog").removeClass("modal-xxl");
        $("#commonModalIcon").attr("class", "fas fa-user");
        $("#commonModalTitle").text("Employee Information");
        $("#commonModalSubtitle").text("");

        $.ajax({
            url: '@Url.Action("GetEmployeeInfo", "Dashboard")',
            type: 'GET',
            data: { empCode: empCode },
            success: function (response) {
                if (!response.success) {
                    showToast(response.message || "Unable to get employee information.", "error");
                    return;
                }

                const data = response.data;

                $("#commonModalTitle").text(data.employeeName);
                $("#commonModalSubtitle").text(data.employeeCode);

                const fresh = parseInt(data.fresh) || 0;
                const followUp = parseInt(data.followUp) || 0;
                const service = parseInt(data.service) || 0;
                const total = parseInt(data.total) || 0;

                $("#commonModalBody").html(`
                    <p class="stats-label">Company Overview</p>

                    <div class="company-stats">
                        <div class="company-stat total">
                            <div class="stat-icon"><i class="fas fa-building"></i></div>
                            <span class="stat-title">Total Companies</span>
                            <strong>${data.totalCompanies ?? 0}</strong>
                        </div>

                        <div class="company-stat paid">
                            <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
                            <span class="stat-title">Paid Companies</span>
                            <strong>${data.paidCompanies ?? 0}</strong>
                        </div>

                        <div class="company-stat unpaid">
                            <div class="stat-icon"><i class="fas fa-clock"></i></div>
                            <span class="stat-title">Unpaid Companies</span>
                            <strong>${data.unPaidCompanies ?? 0}</strong>
                        </div>
                    </div>

                    ${fresh > 0 || followUp > 0 || service > 0 || total > 0 ? `
                        <div class="meetings-section">
                            <hr>
                            <p class="stats-label">
                                <i class="fas fa-calendar-day me-1"></i> This Month's Meetings
                            </p>

                            <div class="company-stats meetings-stats">
                                <div class="company-stat fresh">
                                    <div class="stat-icon"><i class="fas fa-star"></i></div>
                                    <span class="stat-title">Fresh</span>
                                    <strong>${fresh}</strong>
                                </div>

                                <div class="company-stat followup">
                                    <div class="stat-icon"><i class="fas fa-redo"></i></div>
                                    <span class="stat-title">Follow-up</span>
                                    <strong>${followUp}</strong>
                                </div>

                                <div class="company-stat service">
                                    <div class="stat-icon"><i class="fas fa-tools"></i></div>
                                    <span class="stat-title">Services</span>
                                    <strong>${service}</strong>
                                </div>
                            </div>

                            <div class="total-meetings-bar mt-3">
                                <div class="total-meetings-info">
                                    <span>
                                        <i class="fas fa-chart-bar me-1"></i>
                                        Total Meetings
                                    </span>
                                    <strong>${total}</strong>
                                </div>
                            </div>
                        </div>
                    ` : ""}
                `);

                $("#commonInfoModal").modal("show");
            },
            error: function (xhr) {
                console.error(xhr);
                showToast("Something went wrong while getting employee information.", "error");
            },
            complete: function () {
                button.disabled = false;
            }
        });
    }

    function showInvoiceRenewals() {
        $("#commonModalDialog").addClass("modal-xxl");
        $("#commonModalIcon").attr("class", "fas fa-file-invoice");
        $("#commonModalTitle").text("Invoice Renewals");
        $("#commonModalSubtitle").text("Renewals due within 30 days");

        $("#commonModalBody").html(`
            <div class="text-center py-4">
                <i class="fas fa-spinner fa-spin"></i>
                <span class="ms-2">Loading renewals...</span>
            </div>
        `);

        $("#commonInfoModal").modal("show");

        $.ajax({
            url: '@Url.Action("GetInvoiceRenewals", "Dashboard")',
            type: "GET",
            success: function (response) {
                if (!response.success) {
                    showToast(
                        response.message || "Unable to get invoice renewals.",
                        "error"
                    );
                    return;
                }

                const data = response.data || [];

                window.invoiceRenewalData = data;
                window.renewalFilters = {};

                if (!data.length) {
                    $("#commonModalBody").html(`
                        <div class="text-center py-5">
                            <i class="fas fa-check-circle text-success"
                               style="font-size:40px;"></i>
                            <h6 class="mt-3 mb-1">No Renewals Found</h6>
                            <p class="text-muted mb-0">
                                There are no invoices requiring renewal
                                within the next 30 days.
                            </p>
                        </div>
                    `);
                    return;
                }

                renderRenewalTable();
            },
            error: function (xhr) {
                console.error(xhr);

                $("#commonModalBody").html(`
                    <div class="alert alert-danger mb-0">
                        Unable to load invoice renewals.
                    </div>
                `);
            }
        });
    }

    function renderRenewalTable() {
        const columns = [
            ["Invoice No", "invoiceNo"],
            ["Customer", "customerName"],
            ["Sales Person", "salesPerson"],
            ["Invoice Date", "invoiceDate"],
            ["Renewal Date", "renewalDate"],
            ["Days Left", "daysRemaining"],
            ["Amount", "totalAmount"]
        ];

        const data = getFilteredRenewalData();

        let html = `
            <div class="renewal-filter-toolbar mb-1">
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        onclick="clearRenewalFilters()">
                    <i class="fas fa-filter-circle-xmark me-1"></i>
                    Clear Filters
                </button>

                <span class="text-muted ms-2" style="color: #ed0909 !important;">
                    <span id="renewalResultCount">${data.length}</span>
                    record(s)
                </span>
            </div>

            <div class="renewal-table-wrapper">
                <table class="table table-hover align-middle renewal-table">
                    <thead>
                        <tr>
                            <th>#</th>

                            ${columns.map(function (column) {
                                return createFilterHeader(
                                    column[0],
                                    column[1]
                                );
                            }).join("")}
                        </tr>
                    </thead>

                    <tbody id="renewalTableBody"></tbody>
                </table>
            </div>
        `;

        $("#commonModalBody").html(html);

        renderRenewalRows(data);

        $(".renewal-filter-btn")
            .off("click")
            .on("click", function (e) {
                e.stopPropagation();

                openRenewalFilter(
                    this,
                    $(this).data("field")
                );
            });

        $(document)
            .off("click.renewalFilter")
            .on("click.renewalFilter", function () {
                closeRenewalFilter();
            });

        $(document)
            .off("click.renewalDropdown")
            .on(
                "click.renewalDropdown",
                ".renewal-filter-dropdown",
                function (e) {
                    e.stopPropagation();
                }
            );
    }

    function createFilterHeader(title, field) {
        const active =
            window.renewalFilters &&
            window.renewalFilters[field] &&
            window.renewalFilters[field].length;

        return `
            <th>
                <div class="renewal-header-content">
                    <span>${title}</span>

                    <button type="button"
                            class="renewal-filter-btn ${active ? "active" : ""}"
                            data-field="${field}"
                            title="Filter ${title}">
                        <i class="fas fa-filter"></i>
                    </button>
                </div>
            </th>
        `;
    }

    function openRenewalFilter(button, field) {
        closeRenewalFilter();

        const data = getAvailableFilterData(field);

        let values = data
            .map(function (item) {
                return getFilterValue(item[field], field);
            })
            .filter(function (value) {
                return value !== "";
            });

        values = [...new Set(values)];

        sortFilterValues(values, field);

        const currentFilter =
            window.renewalFilters &&
            window.renewalFilters[field];

        const selectedValues = currentFilter
            ? [...currentFilter]
            : [...values];

        const allSelected =
            selectedValues.length === values.length;

        const optionsHtml = values.map(function (value) {
            const checked = selectedValues.includes(value);

            return `
                <label class="renewal-filter-option">
                    <input type="checkbox"
                           class="renewal-value-checkbox"
                           value="${escapeHtml(value)}"
                           ${checked ? "checked" : ""}>

                    <span>
                        ${escapeHtml(
                            formatFilterValue(field, value)
                        )}
                    </span>
                </label>
            `;
        }).join("");

        const dropdown = $(`
            <div class="renewal-filter-dropdown">

               <label class="renewal-filter-select-all">
                    <input type="checkbox"
                           id="renewalSelectAll"
                           ${allSelected ? "checked" : ""}>

                    <strong>Select All</strong>
                </label>

                <div class="renewal-filter-divider"></div>

                <div class="renewal-filter-options">
                    ${optionsHtml}
                </div>

                <div class="renewal-filter-actions">

                    <button type="button"
                            class="btn btn-sm btn-secondary"
                            onclick="closeRenewalFilter()">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-sm btn-primary"
                            onclick="applyRenewalFilter('${field}')">
                        Apply
                    </button>

                </div>
            </div>
        `);

        $("body").append(dropdown);

        positionRenewalFilter(dropdown, button);

        $("#renewalSelectAll").on("change", function () {
            $(".renewal-value-checkbox:visible")
                .prop("checked", this.checked);
        });

        $(".renewal-value-checkbox").on(
            "change",
            updateRenewalSelectAllState
        );
    }

    function getAvailableFilterData(currentField) {
        const data = window.invoiceRenewalData || [];
        const filters = window.renewalFilters || {};

        return data.filter(function (item) {
            return Object.keys(filters)
                .filter(function (field) {
                    return field !== currentField;
                })
                .every(function (field) {
                    const itemValue =
                        getFilterValue(item[field], field);

                    return filters[field].includes(itemValue);
                });
        });
    }

    function getFilteredRenewalData() {
        const data = window.invoiceRenewalData || [];
        const filters = window.renewalFilters || {};

        return data.filter(function (item) {
            return Object.keys(filters).every(function (field) {
                const itemValue =
                    getFilterValue(item[field], field);

                return filters[field].includes(itemValue);
            });
        });
    }

    function getFilterValue(value, field) {
        if (value === null || value === undefined)
            return "";

        if (
            field === "invoiceDate" ||
            field === "renewalDate"
        ) {
            return normalizeRenewalDate(value);
        }

        if (field === "daysRemaining") {
            return String(
                Number(value)
            );
        }

        if (field === "totalAmount") {
            return String(
                Number(value || 0)
            );
        }

        return String(value).trim();
    }

    function sortFilterValues(values, field) {
        values.sort(function (a, b) {

            if (
                field === "daysRemaining" ||
                field === "totalAmount"
            ) {
                return Number(a) - Number(b);
            }

            if (
                field === "invoiceDate" ||
                field === "renewalDate"
            ) {
                return normalizeRenewalDate(a)
                    .localeCompare(
                        normalizeRenewalDate(b)
                    );
            }

            return a.localeCompare(
                b,
                undefined,
                {
                    numeric: true,
                    sensitivity: "base"
                }
            );
        });
    }

    function applyRenewalFilter(field) {
        const checkedValues = $(".renewal-value-checkbox:checked")
            .map(function () {
                return $(this).val();
            })
            .get();

        const totalValues =
            $(".renewal-value-checkbox").length;

        if (!window.renewalFilters) {
            window.renewalFilters = {};
        }

        if (
            checkedValues.length === 0
        ) {
            window.renewalFilters[field] = [];
        }
        else if (
            checkedValues.length === totalValues
        ) {
            delete window.renewalFilters[field];
        }
        else {
            window.renewalFilters[field] =
                checkedValues;
        }

        closeRenewalFilter();

        refreshRenewalTable();
    }

    function refreshRenewalTable() {
        const data = getFilteredRenewalData();

        renderRenewalRows(data);

        updateFilterButtons();
    }

    function renderRenewalRows(data) {
        if (!data || !data.length) {
            $("#renewalTableBody").html(`
                <tr>
                    <td colspan="8"
                        class="text-center text-muted py-4">
                        No matching records found.
                    </td>
                </tr>
            `);

            $("#renewalResultCount").text("0");
            return;
        }

        const html = data.map(function (item, index) {

            const days =
                Number(item.daysRemaining || 0);

            const daysClass =
                days <= 15
                    ? "red"
                    : days <= 30
                        ? "orange"
                        : "green";

            return `
                <tr>
                    <td>${index + 1}</td>

                    <td>
                        <strong>
                            ${escapeHtml(
                                item.invoiceNo || ""
                            )}
                        </strong>
                    </td>

                    <td>
                        ${escapeHtml(
                            item.customerName || ""
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            item.salesPerson || ""
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            item.invoiceDate || ""
                        )}
                    </td>

                    <td>
                        ${escapeHtml(
                            item.renewalDate || ""
                        )}
                    </td>

                    <td>
                        <span class="daysBadge ${daysClass}">
                            ${days} Days
                        </span>
                    </td>

                    <td class="text-end">
                        ${Number(
                            item.totalAmount || 0
                        ).toLocaleString("en-IN", {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        })}
                    </td>
                </tr>
            `;
        }).join("");

        $("#renewalTableBody").html(html);
        $("#renewalResultCount").text(data.length);
    }

    function updateFilterButtons() {
        $(".renewal-filter-btn").each(function () {
            const field = $(this).data("field");

            const active =
                window.renewalFilters &&
                window.renewalFilters[field] &&
                window.renewalFilters[field].length;

            $(this).toggleClass(
                "active",
                !!active
            );
        });
    }

    function updateRenewalSelectAllState() {
        const visible =
            $(".renewal-value-checkbox:visible");

        const checked =
            visible.filter(":checked");

        $("#renewalSelectAll").prop(
            "checked",
            visible.length > 0 &&
            visible.length === checked.length
        );
    }

    function clearRenewalFilters() {
        window.renewalFilters = {};

        closeRenewalFilter();

        refreshRenewalTable();
    }

    function closeRenewalFilter() {
        $(".renewal-filter-dropdown").remove();
    }

    function positionRenewalFilter(dropdown, button) {
        const rect =
            button.getBoundingClientRect();

        const width = 260;
        const height = 350;

        let left = rect.left;
        let top = rect.bottom + 5;

        if (
            left + width >
            window.innerWidth
        ) {
            left =
                window.innerWidth -
                width -
                10;
        }

        if (
            left < 10
        ) {
            left = 10;
        }

        if (
            top + height >
            window.innerHeight
        ) {
            top =
                rect.top -
                height -
                5;
        }

        if (top < 10) {
            top = 10;
        }

        dropdown.css({
            position: "fixed",
            top: top + "px",
            left: left + "px",
            width: width + "px",
            zIndex: 99999
        });
    }

    function formatFilterValue(field, value) {
        if (field === "daysRemaining") {
            return `${value} Days`;
        }

        if (field === "totalAmount") {
            return Number(value || 0)
                .toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
        }

        if (field === "invoiceDate" || field === "renewalDate") {
             return value;
        }

        return value;
    }

    function normalizeRenewalDate(value) {
      if (value === null || value === undefined) {
            return "";
        }

        return String(value).trim().replace(/\//g, "-");
    }

    function escapeHtml(value) {
        return $("<div>")
            .text(value ?? "")
            .html();
    }

</script>



