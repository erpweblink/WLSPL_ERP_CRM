@using Microsoft.AspNetCore.Html
@using System.Text.Encodings.Web
@using WLSPL_ERP_CRM.Models

@model List<WLSPL_ERP_CRM.Models.EmployeeNode>

@{
    ViewData["Title"] = "Employee Hierarchy";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var root = Model?.FirstOrDefault();
}

<style>
    :root {
        --page-bg: #f5f7fb;
        --surface: #ffffff;
        --surface-soft: #f8fafc;
        --text: #172033;
        --text-secondary: #64748b;
        --text-light: #94a3b8;
        --border: #e5e9f2;
        --line: #cbd5e1;
        --admin: #ef4444;
        --manager: #f59e0b;
        --teamlead: #0891b2;
        --executive: #10b981;
        --shadow-card: 0 4px 12px rgba(15, 23, 42, .06), 0 1px 3px rgba(15, 23, 42, .04);
        --shadow-hover: 0 16px 35px rgba(15, 23, 42, .13);
        --radius: 16px;
    }

    /* =========================================================
           PAGE
           ========================================================= */

    body {
        background: var(--page-bg);
    }

    .tree-page {
        width: 100%;
        font-family: 'Inter', sans-serif;
    }

    /* =========================================================
           TREE AREA
           ========================================================= */

    .tree {
        width: 100%;
        max-width: 1800px;
        margin: 0 auto;
        padding: 40px 30px 70px;
        position: relative;
        overflow-x: auto;
        overflow-y: visible;
        border-radius: 24px;
        background: linear-gradient( rgba(255,255,255,.96), rgba(255,255,255,.96) ), radial-gradient( circle, #dce3ef 1px, transparent 1px );
        background-size: auto, 24px 24px;
        border: 1px solid #e7ebf3;
        box-shadow: 0 10px 35px rgba(15,23,42,.06);
    }

    /* =========================================================
           LEVEL
           ========================================================= */

    .level {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        position: relative;
        width: 100%;
        margin: 10px 0 45px;
        gap: 25px;
    }

    /* =========================================================
           BASE NODE
           ========================================================= */

    .node {
        --node-color: #64748b;
        position: relative;
        display: grid;
        grid-template-columns: 48px 1fr;
        grid-auto-rows: min-content;
        align-items: center;
        column-gap: 12px;
        min-width: 220px;
        min-height: 78px;
        padding: 12px 16px 12px 12px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        text-align: left;
        cursor: pointer;
        box-shadow: var(--shadow-card);
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        z-index: 5;
    }

        .node:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
            border-color: color-mix( in srgb, var(--node-color) 35%, white );
        }

        .node:active {
            transform: translateY(-1px);
        }

        /* =========================================================
           TOP COLOR BAR
           ========================================================= */

        .node::before {
            content: "";
            position: absolute;
            top: 0;
            left: 16px;
            right: 16px;
            height: 3px;
            background: var(--node-color);
            border-radius: 0 0 8px 8px;
            opacity: .9;
        }

    /* =========================================================
           AVATAR
           ========================================================= */

    .node-avatar {
        grid-row: 1 / -1;
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient( 135deg, color-mix( in srgb, var(--node-color) 16%, white ), color-mix( in srgb, var(--node-color) 5%, white ) );
        color: var(--node-color);
        border: 1px solid color-mix( in srgb, var(--node-color) 20%, white );
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        font-weight: 700;
        box-shadow: 0 3px 8px rgba(15,23,42,.08);
        position: relative;
    }

        /* =========================================================
           STATUS / LEVEL ICON
           ========================================================= */

        .node-avatar::after {
            position: absolute;
            right: -5px;
            bottom: -5px;
            width: 17px;
            height: 17px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: var(--node-color);
            color: white;
            font-size: 9px;
            border: 2px solid white;
            box-shadow: 0 2px 5px rgba(15,23,42,.18);
        }

    .node[data-role="admin"] .node-avatar::after {
        content: "★";
    }

    .node[data-role="manager"] .node-avatar::after {
        content: "M";
        font-size: 8px;
    }

    .node[data-role="team-lead"] .node-avatar::after {
        content: "L";
        font-size: 8px;
    }

    .node[data-role="executive"] .node-avatar::after {
        content: "✓";
    }

    /* =========================================================
           TEXT
           ========================================================= */

    .node strong {
        display: block;
        margin: 0 0 3px;
        color: var(--text);
        font-family: 'Poppins', sans-serif;
        font-size: 13.5px;
        font-weight: 700;
        line-height: 1.35;
        white-space: normal;
    }

    .node small {
        display: block;
        color: var(--text-secondary);
        font-size: 11px;
        line-height: 1.45;
    }

    /* =========================================================
           ROLE
           ========================================================= */

    .employee-role {
        color: var(--node-color) !important;
        font-weight: 600;
        font-size: 10.5px !important;
        margin-top: 1px;
    }

    /* =========================================================
           DESIGNATION
           ========================================================= */

    .employee-designation {
        color: var(--text-secondary) !important;
        font-size: 10.5px !important;
        margin-top: 1px;
    }

        .employee-role i,
        .employee-designation i {
            width: 12px;
            margin-right: 3px;
            color: var(--node-color);
            font-size: 9px;
        }

    /* =========================================================
           TEAM COUNT
           ========================================================= */

    .team-count {
        display: inline-block !important;
        width: fit-content;
        margin-top: 5px;
        padding: 3px 8px;
        border-radius: 20px;
        background: color-mix( in srgb, var(--node-color) 9%, white );
        color: var(--node-color) !important;
        font-size: 9.5px !important;
        font-weight: 700;
        line-height: 1.3;
    }

    /* =========================================================
           ADMIN
           ========================================================= */

    .node[data-role="admin"] {
        --node-color: var(--admin);
        min-width: 250px;
        min-height: 92px;
        border-radius: 18px;
        box-shadow: 0 12px 28px rgba(239,68,68,.14);
    }

        .node[data-role="admin"] .node-avatar {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            font-size: 17px;
        }

        .node[data-role="admin"] strong {
            font-size: 16px;
        }

    /* =========================================================
           MANAGER
           ========================================================= */

    .node[data-role="manager"] {
        --node-color: var(--manager);
        min-width: 220px;
        min-height: 82px;
    }

    /* =========================================================
           TEAM LEAD
           ========================================================= */

    .node[data-role="team-lead"] {
        --node-color: var(--teamlead);
        min-width: 205px;
        min-height: 78px;
    }

    /* =========================================================
           EXECUTIVE
           ========================================================= */

    .node[data-role="executive"] {
        --node-color: var(--executive);
        min-width: 195px;
        min-height: 70px;
        cursor: default;
    }

        .node[data-role="executive"]:hover {
            transform: none;
            box-shadow: var(--shadow-card);
        }

    /* =========================================================
           MANAGER CONTAINER
           ========================================================= */

    .manager-container {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: flex-start;
        width: 100%;
        gap: 28px;
        flex-wrap: wrap;
        margin: 10px 0 40px;
        padding-top: 38px;
        position: relative;
    }

        /* Main root connector */

        .manager-container::before {
            position: absolute;
            top: 0;
            left: 50%;
            width: 2px;
            height: 22px;
            background: var(--line);
            transform: translateX(-50%);
        }


    .manager-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        animation: fadeUp .35s ease both;
    }

        .manager-block::before {
            position: absolute;
            top: -38px;
            left: 50%;
            width: 2px;
            height: 38px;
            background: var(--line);
            transform: translateX(-50%);
        }

    /* =========================================================
           TEAM LEAD AREA
           ========================================================= */

    .tl-horizontal-container {
        display: none;
        flex-direction: column;
        align-items: center;
        position: relative;
        width: max-content;
        min-width: 100%;
        margin-top: 25px;
        padding-top: 20px;
        animation: expandTree .28s ease both;
    }

        /* Connector from manager */

        .tl-horizontal-container::before {
            content: "";
            position: absolute;
            top: 0;
            left: 50%;
            width: 2px;
            height: 20px;
            background: var(--line);
            transform: translateX(-50%);
        }

    /* =========================================================
           HORIZONTAL TEAM LEAD LINE
           ========================================================= */

    .tl-horizontal-line {
        height: 2px;
        width: 100%;
        min-width: 180px;
        margin-bottom: 22px;
        background: linear-gradient( 90deg, transparent, var(--line) 10%, var(--line) 90%, transparent );
        position: relative;
    }

    /* =========================================================
           TEAM LEAD ROW
           ========================================================= */

    .tl-row {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 20px;
        width: 100%;
    }

    /* =========================================================
           TEAM LEAD COLUMN
           ========================================================= */

    .tl-column {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        padding-top: 20px;
    }

        /* connector from horizontal line */

        .tl-column::before {
            content: "";
            position: absolute;
            top: 0;
            left: 50%;
            width: 2px;
            height: 20px;
            background: var(--line);
            transform: translateX(-50%);
        }

    /* =========================================================
           EXECUTIVES
           ========================================================= */

    .executive-container {
        display: none;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        margin-top: 18px;
        padding: 4px 8px 12px;
        max-height: 420px;
        overflow-y: auto;
        scrollbar-width: thin;
        animation: expandTree .25s ease both;
    }

    /* connector */

    .tl-vertical-connector {
        display: none;
        width: 2px;
        height: 18px;
        margin-top: 0;
        background: var(--line);
        border-radius: 10px;
    }

    /* =========================================================
           OLD CONNECTORS HIDDEN
           ========================================================= */

    .manager-connector,
    .manager-vertical-connector {
        display: none;
    }

    .executive-connector {
        display: none;
    }

    /* =========================================================
           ACTIVE CARD
           ========================================================= */

    .node.active {
        border-color: color-mix( in srgb, var(--node-color) 35%, white );
        box-shadow: 0 12px 30px color-mix( in srgb, var(--node-color) 18%, transparent );
    }

        /* Expand/collapse button */

        .node.active::after {
            content: "−";
            position: absolute;
            right: 9px;
            top: 9px;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: color-mix( in srgb, var(--node-color) 10%, white );
            color: var(--node-color);
            font-size: 13px;
            font-weight: 700;
        }

    .node:not(.active)[data-role="manager"]::after,
    .node:not(.active)[data-role="team-lead"]::after {
        content: "+";
        position: absolute;
        right: 9px;
        top: 9px;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f1f5f9;
        color: var(--text-light);
        font-size: 13px;
        font-weight: 600;
        transition: all .2s ease;
    }

    .node:not(.active)[data-role="manager"]:hover::after,
    .node:not(.active)[data-role="team-lead"]:hover::after {
        background: var(--node-color);
        color: white;
    }

    /* =========================================================
           EMPTY NODE
           ========================================================= */

    .node[style*="background:#eee"] {
        --node-color: #94a3b8;
        background: #f8fafc !important;
        border: 1px dashed #cbd5e1;
        box-shadow: none;
        opacity: .85;
        cursor: default;
    }

        .node[style*="background:#eee"] strong,
        .node[style*="background:#eee"] small {
            color: #94a3b8 !important;
        }

    /* =========================================================
           SCROLLBARS
           ========================================================= */

    .tree::-webkit-scrollbar,
    .manager-container::-webkit-scrollbar,
    .tl-row::-webkit-scrollbar,
    .executive-container::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .tree::-webkit-scrollbar-thumb,
    .manager-container::-webkit-scrollbar-thumb,
    .tl-row::-webkit-scrollbar-thumb,
    .executive-container::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 20px;
    }

    .tree::-webkit-scrollbar-track,
    .manager-container::-webkit-scrollbar-track,
    .tl-row::-webkit-scrollbar-track,
    .executive-container::-webkit-scrollbar-track {
        background: transparent;
    }

    /* =========================================================
           ANIMATIONS
           ========================================================= */

    @@keyframes fadeUp {

        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes expandTree {

        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
           DARK MODE
           ========================================================= */

    [data-bs-theme="dark"] body {
        background: #0f141c;
    }

    [data-bs-theme="dark"] .tree {
        background: linear-gradient( rgba(20,27,38,.97), rgba(20,27,38,.97) ), radial-gradient( circle, #293241 1px, transparent 1px );
        border-color: #273142;
        box-shadow: 0 15px 40px rgba(0,0,0,.35);
    }

    [data-bs-theme="dark"] .node {
        background: #18202c;
        border-color: #2a3444;
        box-shadow: 0 5px 15px rgba(0,0,0,.25);
    }

        [data-bs-theme="dark"] .node strong {
            color: #f8fafc;
        }

        [data-bs-theme="dark"] .node small {
            color: #94a3b8;
        }

    [data-bs-theme="dark"] .employee-designation {
        color: #94a3b8 !important;
    }

    [data-bs-theme="dark"] .node-avatar {
        background: #202a38;
        border-color: #344052;
    }

    [data-bs-theme="dark"] .manager-container::before,
    [data-bs-theme="dark"] .manager-block::before,
    [data-bs-theme="dark"] .tl-horizontal-container::before,
    [data-bs-theme="dark"] .tl-horizontal-line,
    [data-bs-theme="dark"] .tl-column::before,
    [data-bs-theme="dark"] .tl-vertical-connector {
        background: #3a4658;
    }

    [data-bs-theme="dark"] .node:not(.active)[data-role="manager"]::after,
    [data-bs-theme="dark"] .node:not(.active)[data-role="team-lead"]::after {
        background: #263142;
        color: #94a3b8;
    }

    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 768px) {

        .tree-page {
            padding: 10px 5px 40px;
        }

        .tree {
            padding: 30px 10px 50px;
            border-radius: 16px;
        }

        .level {
            margin-bottom: 30px;
        }

        .manager-container {
            justify-content: flex-start;
            flex-wrap: nowrap;
            overflow-x: auto;
            padding: 38px 25px 25px;
            gap: 18px;
            scroll-snap-type: x mandatory;
        }

        .manager-block {
            flex: 0 0 auto;
            scroll-snap-align: center;
        }

        .tl-row {
            flex-wrap: nowrap;
            justify-content: flex-start;
            overflow-x: auto;
            padding: 5px 20px 20px;
            scroll-snap-type: x mandatory;
        }

        .tl-column {
            flex: 0 0 auto;
            scroll-snap-align: center;
        }

        .node[data-role="admin"] {
            min-width: 225px;
        }

        .node[data-role="manager"] {
            min-width: 205px;
        }

        .node[data-role="team-lead"] {
            min-width: 195px;
        }

        .node[data-role="executive"] {
            min-width: 190px;
        }
    }
</style>


@functions {

    private string Safe(object value)
    {
        return HtmlEncoder.Default.Encode(
            Convert.ToString(value) ?? ""
        );
    }

    private IHtmlContent RenderEmployeeChildren(EmployeeNode employee, string employeeId)
    {
        var html = new HtmlContentBuilder();

        var children = employee.Children?
            .Where(x =>
                !string.Equals(
                    Convert.ToString(x.EmpCode),
                    Convert.ToString(employee.EmpCode),
                    StringComparison.OrdinalIgnoreCase))
            .ToList()
            ?? new List<EmployeeNode>();

        if (!children.Any())
        {
            return html;
        }

        var teamLeads = children
            .Where(c =>
                !string.IsNullOrWhiteSpace(c.Role) &&
                (
                    c.Role.Contains(
                        "Team Lead",
                        StringComparison.OrdinalIgnoreCase) ||

                    c.Role.Contains(
                        "Lead",
                        StringComparison.OrdinalIgnoreCase) ||

                    c.Role.Contains(
                        "Supervisor",
                        StringComparison.OrdinalIgnoreCase)
                ))
            .ToList();

        var executives = children
            .Where(c =>
                !string.IsNullOrWhiteSpace(c.Role) &&
                c.Role.Contains(
                    "Executive",
                    StringComparison.OrdinalIgnoreCase))
            .ToList();

        var otherChildren = children
            .Where(c =>
                !teamLeads.Contains(c) &&
                !executives.Contains(c))
            .ToList();

        if (teamLeads.Any())
        {
            html.AppendHtml($@"
                <div class='tl-horizontal-container'
                     data-manager-id='{Safe(employeeId)}'>

                    <div class='tl-horizontal-line'></div>

                    <div class='tl-row'>
            ");

            foreach (var tl in teamLeads)
            {
                var tlId = Convert.ToString(tl.EmpCode) ?? "";

                var tlExecutives = tl.Children?
                    .Where(c =>
                        !string.IsNullOrWhiteSpace(c.Role) &&
                        c.Role.Contains(
                            "Executive",
                            StringComparison.OrdinalIgnoreCase))
                    .ToList()
                    ?? new List<EmployeeNode>();

                html.AppendHtml($@"
                    <div class='tl-column'>

                        <div class='node'
                             data-role='team-lead'
                             onclick='toggleExecutives(this)'
                             data-tl-id='{Safe(tlId)}'>

                            <div class='node-avatar'>
                                {Safe(GetInitials(tl.Name))}
                            </div>

                            <div>

                                <strong>
                                    {Safe(tl.Name)}
                                </strong>

                                <small class='employee-role'>
                                    <i class='fas fa-user-tag'></i>
                                    {Safe(tl.Role)}
                                </small>

                                <small class='employee-designation'>
                                    <i class='fas fa-briefcase'></i>
                                    Team Lead
                                </small>

                                <small class='team-count'>
                                    Team: {tlExecutives.Count}
                                </small>

                            </div>

                        </div>

                        <div class='tl-vertical-connector'
                             data-tl-id='{Safe(tlId)}'>
                        </div>

                        <div class='executive-container'
                             data-tl-id='{Safe(tlId)}'>
                ");


                if (tlExecutives.Any())
                {
                    foreach (var exec in tlExecutives)
                    {
                        html.AppendHtml($@"
                            <div class='node'
                                 data-role='executive'>

                                <div class='node-avatar'>
                                    {Safe(GetInitials(exec.Name))}
                                </div>

                                <div>

                                    <strong>
                                        {Safe(exec.Name)}
                                    </strong>

                                    <small class='employee-role'>
                                        <i class='fas fa-user-tag'></i>
                                        {Safe(exec.Role)}
                                    </small>

                                    <small class='employee-designation'>
                                        <i class='fas fa-briefcase'></i>
                                        Executive
                                    </small>

                                </div>

                            </div>
                        ");

                    }
                }
                else
                {
                    html.AppendHtml(@"
                        <div class='node'
                             data-role='executive'
                             style='background:#eee;'>

                            <div>
                                <small>
                                    No team members
                                </small>
                            </div>

                        </div>
                    ");
                }

                html.AppendHtml("</div></div>");
            }

            html.AppendHtml("</div></div>");
        }

        else if (otherChildren.Any())
        {
            html.AppendHtml($@"
                <div class='tl-horizontal-container'
                     data-manager-id='{Safe(employeeId)}'>

                    <div class='tl-horizontal-line'></div>

                    <div class='tl-row'>
            ");

            foreach (var child in otherChildren)
            {
                var childId = Convert.ToString(child.EmpCode) ?? "";

                var childMembers =
                    child.Children?.ToList()
                    ?? new List<EmployeeNode>();

                html.AppendHtml($@"
                    <div class='tl-column'>

                        <div class='node'
                             data-role='team-lead'
                             onclick='toggleExecutives(this)'
                             data-tl-id='{Safe(childId)}'>

                            <div>
                                <strong>
                                    {Safe(child.Name)}
                                </strong>
                            </div>

                            <small>
                                {Safe(child.Role)}
                            </small>

                            <small style='font-size:12px;color:gray;'>
                                Team: {childMembers.Count}
                            </small>

                        </div>

                        <div class='tl-vertical-connector'
                             data-tl-id='{Safe(childId)}'>
                        </div>

                        <div class='executive-container'
                             data-tl-id='{Safe(childId)}'>
                ");

                if (childMembers.Any())
                {
                    foreach (var member in childMembers)
                    {
                        html.AppendHtml($@"
                            <div class='node'
                                 data-role='executive'>

                                <div>
                                    <strong>
                                        {Safe(member.Name)}
                                    </strong>
                                </div>

                                <small>
                                    {Safe(member.Role)}
                                </small>

                            </div>
                        ");
                    }
                }
                else
                {
                    html.AppendHtml(@"
                        <div class='node'
                             data-role='executive'
                             style='background:#eee;'>

                            <div>
                                <small>
                                    No team members
                                </small>
                            </div>

                        </div>
                    ");
                }

                html.AppendHtml("</div></div>");
            }

            html.AppendHtml("</div></div>");
        }

        return html;
    }

    private IHtmlContent RenderManagers(EmployeeNode root)
    {
        var html = new HtmlContentBuilder();

        var children = root.Children?
            .Where(x =>
                !string.Equals(
                    Convert.ToString(x.EmpCode),
                    Convert.ToString(root.EmpCode),
                    StringComparison.OrdinalIgnoreCase))
            .ToList()
            ?? new List<EmployeeNode>();

        if (!children.Any())
        {
            return html;
        }

        html.AppendHtml(@"
            <div class='level'>

                <div class='manager-container'
                     style='display:flex;'>
        ");

        foreach (var employee in children)
        {
            var employeeId =
                Convert.ToString(employee.EmpCode) ?? "";

            var teamLeads = employee.Children?
                .Where(c =>
                    !string.IsNullOrWhiteSpace(c.Role) &&
                    (
                        c.Role.Contains(
                            "Team Lead",
                            StringComparison.OrdinalIgnoreCase) ||

                        c.Role.Contains(
                            "Lead",
                            StringComparison.OrdinalIgnoreCase) ||

                        c.Role.Contains(
                            "Supervisor",
                            StringComparison.OrdinalIgnoreCase)
                    ))
                .ToList()
                ?? new List<EmployeeNode>();

            var teamCount =
                employee.Children?.Count ?? 0;

            string count;

            if (teamLeads.Any())
            {
                count =
                    "Team Leader: " +
                    teamLeads.Count;
            }
            else
            {
                count =
                    "Team: " +
                    teamCount;
            }

            html.AppendHtml($@"
                <div class='manager-block'>

                    <div class='node'
                         data-role='manager'
                         onclick='toggleTeamLeads(this)'
                         data-manager-id='{Safe(employeeId)}'
                         title='{Safe(employee.Role)}'>

                        <div class='node-avatar'>
                            {Safe(GetInitials(employee.Name))}
                        </div>

                        <div>

                            <strong>
                                {Safe(employee.Name)}
                            </strong>

                            <small class='employee-role'>
                                <i class='fas fa-user-tag'></i>
                                {Safe(employee.Role)}
                            </small>

                            <small class='employee-designation'>
                                <i class='fas fa-briefcase'></i>
                                Managers
                            </small>

                            <small class='team-count'>
                                {count}
                            </small>

                        </div>

                    </div>

                    <div class='manager-vertical-connector'
                         data-manager-id='{Safe(employeeId)}'>
                    </div>
            ");



            html.AppendHtml(
     RenderEmployeeChildren(
         employee,
         employeeId));


            html.AppendHtml("</div>");
        }

        html.AppendHtml(@"
                </div>
            </div>
        ");

        return html;
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name
            .Trim()
            .Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 1)
            return parts[0].Substring(0, 1).ToUpper();

        return (
            parts[0].Substring(0, 1) +
            parts[^1].Substring(0, 1)
        ).ToUpper();
    }
}

@if (root == null)
{
    <div class="alert alert-warning">
        No employees found.
    </div>
}
else
{
    <div class="tree-page">
        <div class="tree">

            <div class="level">

                <div class="node"
                     data-role="admin">

                    <div class="node-avatar">
                        @GetInitials(root.Name)
                    </div>

                    <div>
                        <strong>
                            @root.Name
                        </strong>
                    </div>

                    <small>
                        @root.Role
                    </small>

                </div>

            </div>

            @RenderManagers(root)

        </div>
    </div>
}

<script>

       function toggleTeamLeads(managerNode) {

        const managerId =
            managerNode.getAttribute("data-manager-id");

        const container =
            managerNode.closest(".manager-block");

        if (!container)
            return;

        const tlContainer =
            container.querySelector(
                `.tl-horizontal-container[data-manager-id="${managerId}"]`
            );

        const connector =
            container.querySelector(
                `.manager-vertical-connector[data-manager-id="${managerId}"]`
            );

        if (!tlContainer)
            return;

        const isVisible =
            tlContainer.style.display === "flex";

        tlContainer.style.display =
            isVisible ? "none" : "flex";

        managerNode.classList.toggle(
            "active",
            !isVisible
        );

        if (connector) {
            connector.style.display =
                isVisible ? "none" : "block";
        }

        if (isVisible) {

            container
                .querySelectorAll(".executive-container")
                .forEach(e => {
                    e.style.display = "none";
                });

            container
                .querySelectorAll(".tl-vertical-connector")
                .forEach(e => {
                    e.style.display = "none";
                });

            container
                .querySelectorAll(".tl-column .node")
                .forEach(e => {
                    e.classList.remove("active");
                });
        }
    }


     function toggleExecutives(teamLeadNode) {

        const tlId =
            teamLeadNode.getAttribute("data-tl-id");

        const column =
            teamLeadNode.closest(".tl-column");

        if (!column)
            return;

        const executiveContainer =
            column.querySelector(
                `.executive-container[data-tl-id="${tlId}"]`
            );

        const verticalConnector =
            column.querySelector(
                `.tl-vertical-connector[data-tl-id="${tlId}"]`
            );

        if (!executiveContainer)
            return;

        const isVisible =
            executiveContainer.style.display === "flex";

        executiveContainer.style.display =
            isVisible ? "none" : "flex";

        teamLeadNode.classList.toggle(
            "active",
            !isVisible
        );

        if (verticalConnector) {

            verticalConnector.style.display =
                isVisible ? "none" : "block";
        }
    }

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const containers =
                document.querySelectorAll(
                    ".tl-horizontal-container"
                );

            containers.forEach(container => {

                const row =
                    container.querySelector(
                        ".tl-row");

                if (!row)
                    return;

                const columns =
                    row.querySelectorAll(
                        ".tl-column");

                if (columns.length > 0) {

                    const line =
                        container.querySelector(
                            ".tl-horizontal-line");

                    if (line) {

                        const width =
                            Math.max(
                                145,
                                (columns.length * 160) +
                                ((columns.length - 1) * 15)
                            );

                        line.style.width =
                            width + "px";
                    }
                }
            });

        }
    );

</script>