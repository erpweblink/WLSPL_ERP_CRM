        --navy: #112438;
        --navy-dark: #0b1822;
        --surface: #FFFFFF;
        --canvas: #f0f2f5;
        --ink: #0f1e2e;
        --muted: #778ca3;
        --line: #e2e8f0;
        --sage: #1a6e42;
        --sage-bg: #d4f0e2;
        --rust: #b03030;
        --rust-bg: #fde8e8;
    }

    .sb-pulse {
        background: linear-gradient(314deg, #0b0f14, #1a3e66);
        border-radius: 16px;
        padding: 24px 32px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0;
        margin-bottom: 32px;
    }

    .sb-pulse-title {
        flex: 1 1 220px;
    }

        .sb-pulse-title h4 {
            font-family: 'Sora', sans-serif;
            font-weight: 700;
            font-size: 20px;
            color: #fff;
            margin: 0 0 4px;
        }

        .sb-pulse-title span {
            font-size: 13px;
            color: #b7d6cf;
        }

    .sb-pulse-stats {
        display: flex;
        flex-wrap: wrap;
    }

    .sb-pulse-stat {
        padding: 0 28px;
        border-left: 1px solid rgba(255,255,255,.2);
    }

        .sb-pulse-stat:first-child {
            border-left: none;
        }

        .sb-pulse-stat .num {
            font-family: 'Sora', sans-serif;
            font-size: 30px;
            font-weight: 700;
            color: #fff;
            line-height: 1;
            font-variant-numeric: tabular-nums;
        }

        .sb-pulse-stat .lbl {
            font-size: 12px;
            color: #b7d6cf;
            margin-top: 5px;
        }

    .sb-section-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 16px;
    }

        .sb-section-head h5 {
            font-family: 'Sora', sans-serif;
            font-weight: 600;
            font-size: 16px;
            margin: 0;
        }

        .sb-section-head small {
            color: var(--muted);
        }

    .org-chart-wrapper {
        width: 100%;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 35px 20px 60px;
        overflow-x: auto;
        overflow-y: hidden;
        min-height: 500px;
    }

        .org-chart-wrapper::-webkit-scrollbar {
            height: 10px;
        }

        .org-chart-wrapper::-webkit-scrollbar-track {
            background: #f1f4f6;
            border-radius: 10px;
        }

        .org-chart-wrapper::-webkit-scrollbar-thumb {
            background: #b7c4d0;
            border-radius: 10px;
        }

            .org-chart-wrapper::-webkit-scrollbar-thumb:hover {
                background: #8fa2b3;
            }

    .org-chart {
        width: max-content;
        min-width: 100%;
        text-align: center;
    }

    .org-tree {
        width: max-content;
        min-width: 100%;
        margin: 0;
        padding: 0;
        list-style: none;
        display: block;
    }

        .org-tree > li {
            width: max-content;
            min-width: 100%;
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .org-tree > li > .org-node {
                position: relative;
                margin: 0 auto;
                width: 160px;
            }

        .org-tree ul {
            position: relative;
            display: flex;
            flex-wrap: nowrap;
            justify-content: center;
            align-items: flex-start;
            width: max-content;
            min-width: 100%;
            margin: 55px 0 0;
            padding: 0;
            list-style: none;
        }

            .org-tree ul::before {
                content: "";
                position: absolute;
                top: -28px;
                left: 85px;
                right: 85px;
                height: 2px;
                background: #d5dce4;
            }

            .org-tree ul > li:only-child:first-child {
                margin-left: auto;
            }

            .org-tree ul::after {
                content: "";
                position: absolute;
                top: -55px;
                left: 50%;
                width: 2px;
                height: 28px;
                background: #d5dce4;
                transform: translateX(-1px);
            }

            .org-tree ul > li {
                position: relative;
                flex: 0 0 170px;
                min-width: 170px;
                padding: 0 10px;
                text-align: center;
                list-style: none;
            }

                .org-tree ul > li::before {
                    content: "";
                    position: absolute;
                    top: -28px;
                    left: 50%;
                    width: 2px;
                    height: 28px;
                    background: #d5dce4;
                    transform: translateX(-1px);
                }

            .org-tree ul ul {
                margin-top: 55px;
                width: max-content;
                min-width: 100%;
                display: flex;
                flex-wrap: nowrap;
                justify-content: center;
                align-items: flex-start;
            }

                .org-tree ul ul > li {
                    flex: 0 0 150px;
                    min-width: 150px;
                    padding: 0 8px;
                }

    .org-node {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        min-width: 0;
        cursor: pointer;
        z-index: 5;
    }

    .org-avatar {
        width: 62px;
        height: 62px;
        flex-shrink: 0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #112438, #315a7d);
        border: 4px solid #fff;
        box-shadow: 0 0 0 2px #dbe3eb, 0 6px 15px rgba(17,36,56,.18);
        color: #fff;
        font-family: 'Sora', sans-serif;
        font-size: 16px;
        font-weight: 800;
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .org-node:hover .org-avatar {
        transform: translateY(-4px);
        box-shadow: 0 0 0 3px #9eb6cc, 0 10px 25px rgba(17,36,56,.25);
    }

    .org-name {
        margin-top: 9px;
        width: 100%;
        max-width: 150px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: 'Sora', sans-serif;
        font-size: 11px;
        font-weight: 700;
        color: #112438;
    }

    .org-code {
        margin-top: 3px;
        font-size: 8px;
        color: #8a98a8;
        font-weight: 700;
        letter-spacing: .3px;
    }

    .org-role {
        margin-top: 3px;
        font-size: 8px;
        color: #778ca3;
        font-weight: 500;
        max-width: 150px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .org-stats {
        position: absolute;
        top: 72px;
        left: 50%;
        width: 210px;
        padding: 12px;
        background: #fff;
        border: 1px solid #e1e7ee;
        border-radius: 12px;
        box-shadow: 0 15px 35px rgba(17,36,56,.18);
        transform: translateX(-50%) translateY(5px);
        opacity: 0;
        visibility: hidden;
        transition: opacity .15s ease, transform .15s ease;
        z-index: 100;
    }

    .org-node:hover .org-stats {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
    }

    .org-stat-row {
        display: flex;
        justify-content: space-between;
        padding: 5px 0;
        border-bottom: 1px dashed #edf0f3;
        font-size: 10px;
    }

        .org-stat-row:last-child {
            border-bottom: none;
        }

        .org-stat-row span {
            color: #778ca3;
            font-weight: 600;
        }

        .org-stat-row strong {
            color: #112438;
            font-weight: 800;
        }

    .sb-empty {
        background: #fff;
        border: 1px dashed #d7e0e8;
        border-radius: 16px;
        padding: 50px;
        text-align: center;
        color: #778ca3;
    }

    @@media (max-width: 768px) {
        .sb-pulse {
            padding: 20px;
        }

        .sb-pulse-stat {
            padding: 15px;
        }

        .sb-section-head {
            flex-direction: column;
            gap: 5px;
        }

        .org-chart-wrapper {
            padding: 30px 10px 40px;
        }

        .org-tree ul > li {
            flex: 0 0 140px;
            min-width: 140px;
        }

        .org-tree ul ul > li {
            flex: 0 0 130px;
            min-width: 130px;
        }
    }
</style>

<div class="sb-page">
    <div class="sb-pulse">
        <div class="sb-pulse-title">
            <h4>Team Pulse</h4>
            <span>@Model.Today.ToString("dddd, dd MMM yyyy")</span>
        </div>

        <div class="sb-pulse-stats">
            <div class="sb-pulse-stat">
                <div class="num">@Model.TotalEmployees</div>
                <div class="lbl">Employees</div>
            </div>

            <div class="sb-pulse-stat">
                <div class="num">@Model.TotalClients</div>
                <div class="lbl">Total Clients</div>
            </div>

            <div class="sb-pulse-stat">
                <div class="num">@Model.TotalMeetingsThisMonth</div>
                <div class="lbl">Meetings this month</div>
            </div>

            <div class="sb-pulse-stat">
                <div class="num">@Model.TotalCompaniesToday</div>
                <div class="lbl">Companies today</div>
            </div>
        </div>
    </div>

    <div class="sb-section-head">
        <h5>Team Performance</h5>
        <small>Clients · meetings this month · companies registered today</small>
    </div>

    @if (Model.EmployeeTree != null && Model.EmployeeTree.Any())
    {
        <div class="org-chart-wrapper">
            <div class="org-chart">
                <ul class="org-tree">
                    @foreach (var root in Model.EmployeeTree)
                    {
                        @await Html.PartialAsync("_EmployeeHierarchyNode", root)
                    }
                </ul>
            </div>
        </div>
    }
    else
    {
        <div class="sb-empty">
            No employee hierarchy to display yet.
        </div>
    }
</div>

<div class="modal fade" id="companyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:#112438; color:#fff;">
                <h5 class="modal-title" id="companyModalLabel">
                    Companies added today
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body p-0">
                <table class="table table-sm mb-0" style="font-size:13.5px;">
                    <thead class="table-light">
                        <tr>
                            <th>Company</th>
                            <th>Owner / Mobile</th>
                            <th>Area / State</th>
                            <th>GST No.</th>
                            <th>Registered at</th>
                        </tr>
                    </thead>
                    <tbody id="companyModalBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    const sbCompanyData = @Html.Raw(
                Newtonsoft.Json.JsonConvert.SerializeObject(
                        Model.Employees.ToDictionary(
                                e => e.EmpCode,
                                e => e.CompaniesToday
                        )
                )
        );

    function showCompanies(empCode, empName) {
        document.getElementById('companyModalLabel').textContent =
            empName + ' — companies added today';

        const rows = sbCompanyData[empCode] || [];

        document.getElementById('companyModalBody').innerHTML =
            rows.map(c => `
                <tr>
                    <td>
                        ${c.CompanyName}
                        <span style="color:#778ca3">
                            (${c.CompanyCode})
                        </span>
                    </td>
                    <td>
                        ${c.OwnerName}
                        <br>
                        <span style="color:#778ca3">
                            ${c.Mobile}
                        </span>
                    </td>
                    <td>
                        ${c.Area}, ${c.State}
                    </td>
                    <td>${c.GstNo}</td>
                    <td>${c.RegisteredAt}</td>
                </tr>
            `).join('');
    }
</script>





*@
