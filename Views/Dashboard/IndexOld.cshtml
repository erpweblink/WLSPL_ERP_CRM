@using Microsoft.AspNetCore.Html
@using System.Text.Encodings.Web
@using WLSPL_ERP_CRM.Models
@model List<WLSPL_ERP_CRM.Models.EmployeeNode>
@{
    ViewData["Title"] = "Employee Hierarchy";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var root = Model?.FirstOrDefault();
    string rootRole = root != null ? DataRole(root.CustRole) : "ceo";
}
<style type="text/css">
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

    :root {
        --page-bg: #F4F6FA;
        --surface: #FFFFFF;
        --surface-soft: #F9FAFB;
        --border: #E8ECF2;
        --connector: #CBD5E1;
        --text-primary: #1A2035;
        --text-secondary: #5C6B82;
        --text-muted: #9BAABF;
        --c-admin: #1a80e1;
        --c-manager: #D97706;
        --c-assimanager: #1d3a58;
        --c-lead: #7843e7;
        --c-exec: #059669;
        --r-sm: 8px;
        --r-md: 14px;
        --r-lg: 18px;
        --shadow-card: 0 2px 8px rgba(16,30,54,.07),0 1px 2px rgba(16,30,54,.04);
        --shadow-hover: 0 8px 28px rgba(16,30,54,.13),0 2px 6px rgba(16,30,54,.06);
        --shadow-admin: 0 8px 28px rgba(224,57,75,.18);
        --line-w: 2px;
        --font: 'Plus Jakarta Sans','Inter',system-ui,sans-serif
    }

    *, *::before, *::after {
        box-sizing: border-box
    }

    body {
        background: var(--page-bg)
    }

    .tree-page {
        width: 100%;
        font-family: var(--font)
    }

    .tree {
        width: 100%;
        max-width: 1800px;
        margin: 0 auto;
        padding: 48px 32px 80px;
        position: relative;
        overflow-x: auto;
        overflow-y: visible;
        border-radius: 20px;
        background: #F8FAFD;
        border: 1px solid var(--border);
        box-shadow: 0 2px 12px rgba(16,30,54,.05)
    }

    .level {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        position: relative;
        width: 100%;
        margin: 0;
        gap: 20px
    }

    .node {
        --nc: #9BAABF;
        position: relative;
        display: grid;
        grid-template-columns: 48px 1fr;
        grid-auto-rows: min-content;
        align-items: center;
        column-gap: 12px;
        min-width: 210px;
        padding: 13px 14px 13px 12px;
        background: var(--surface);
        border-top: 2.5px solid var(--nc);
        border-left: 1.5px solid color-mix(in srgb,var(--nc) 35%,var(--border));
        border-right: 1.5px solid color-mix(in srgb,var(--nc) 35%,var(--border));
        border-bottom: 1.5px solid color-mix(in srgb,var(--nc) 35%,var(--border));
        border-radius: var(--r-md);
        text-align: left;
        cursor: pointer;
        box-shadow: var(--shadow-card);
        transition: transform .2s ease,box-shadow .2s ease,border-color .2s ease;
        z-index: 5
    }

    .employee-info-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 15px;
        height: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border-radius: 50%;
        background: var(--nc);
        color: #fff;
        border-color: var(--nc);
        font-size: 7px;
        cursor: pointer;
        z-index: 1;
        transition: all .2s ease
    }

        .employee-info-btn:hover {
            background: var(--nc);
            color: #fff;
            border-color: var(--nc);
            transform: scale(1.1)
        }

        .employee-info-btn i {
            font-size: 9px
        }

    .node:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-hover);
        border-top-color: var(--nc);
        border-left-color: color-mix(in srgb,var(--nc) 55%,var(--border));
        border-right-color: color-mix(in srgb,var(--nc) 55%,var(--border));
        border-bottom-color: color-mix(in srgb,var(--nc) 55%,var(--border))
    }

    .node:active {
        transform: translateY(-1px)
    }

    .node-avatar {
        grid-row: 1 / -1;
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: color-mix(in srgb,var(--nc) 12%,white);
        color: var(--nc);
        font-family: var(--font);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .3px;
        border: 1.5px solid color-mix(in srgb,var(--nc) 22%,white);
        position: relative;
        flex-shrink: 0
    }

        .node-avatar::after {
            position: absolute;
            right: -4px;
            bottom: -4px;
            width: 16px;
            height: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: var(--nc);
            color: #fff;
            font-size: 8px;
            font-weight: 700;
            border: 2px solid #fff;
            box-shadow: 0 1px 4px rgba(16,30,54,.2)
        }

    .node[data-role="ceo"] .node-avatar::after {
        content: "★"
    }

    .node[data-role="manager"] .node-avatar::after {
        content: "B";
        font-size: 7px
    }

    .node[data-role="assimanager"] .node-avatar::after {
        content: "C";
        font-size: 7px
    }

    .node[data-role="team-lead"] .node-avatar::after {
        content: "M";
        font-size: 7px
    }

    .node[data-role="executive"] .node-avatar::after {
        content: "✓"
    }

    .node strong {
        display: block;
        margin: 0 0 3px;
        color: var(--text-primary);
        font-family: var(--font);
        font-size: 16px;
        font-weight: 700;
        line-height: 1.3;
        white-space: normal;
        padding-right: 22px
    }

    .node small {
        display: block;
        font-size: 10.5px;
        line-height: 1.5;
        color: var(--text-secondary)
    }

    .empcode {
        font-size: 11.5px !important;
        color: #9d9fa1 !important;
        font-weight: 700 !important
    }

    .employee-role {
        color: var(--nc) !important;
        font-weight: 600 !important;
        font-size: 10px !important
    }

        .employee-role i {
            width: 11px;
            margin-right: 2px;
            font-size: 8.5px;
            color: var(--nc)
        }

    .team-count {
        display: inline-flex !important;
        align-items: center;
        gap: 4px;
        margin-top: 6px;
        padding: 2px 8px;
        border-radius: 20px;
        background: color-mix(in srgb,var(--nc) 10%,white);
        color: var(--nc) !important;
        font-size: 9.5px !important;
        font-weight: 700 !important;
        letter-spacing: .2px;
        border: 1px solid color-mix(in srgb,var(--nc) 20%,white)
    }

        .team-count::before {
            content: "";
            display: inline-block;
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--nc);
            opacity: .75
        }

    .node[data-role="ceo"] {
        --nc: var(--c-admin);
        min-width: 255px;
        border-radius: var(--r-lg);
        box-shadow: var(--shadow-admin);
        background: #1a80e133
    }

        .node[data-role="ceo"] .node-avatar {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            font-size: 16px
        }

        .node[data-role="ceo"] strong {
            font-size: 16px
        }

    .node[data-role="manager"] {
        --nc: var(--c-manager);
        min-width: 255px;
        background: rgb(255 153 35 / 22%)
    }

    .node[data-role="assimanager"] {
        --nc: var(--c-assimanager);
        min-width: 255px;
        background: rgb(97 151 201 / 32%)
    }

    .node[data-role="team-lead"] {
        --nc: var(--c-lead);
        min-width: 255px;
        background: #704ac136
    }

    .node[data-role="executive"] {
        --nc: var(--c-exec);
        min-width: 255px;
        background: rgb(5 150 105 / 19%);
        cursor: default
    }

        .node[data-role="executive"]:hover {
            transform: none;
            box-shadow: var(--shadow-card)
        }

    .team-count-wrapper {
        display: flex;
        align-items: center;
        width: 100%;
        margin-top: 6px
    }

        .team-count-wrapper .team-count {
            margin-top: 0
        }

    .team-toggle-btn {
        margin-left: auto;
        width: 25px;
        height: 25px;
        padding: 3px 3px 6px 3px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background: var(--nc);
        color: #fff;
        border-color: var(--nc);
        font-size: 14px;
        font-weight: 700;
        line-height: 1;
        cursor: pointer;
        transition: all .18s ease
    }

        .team-toggle-btn:hover {
            border: 1px solid color-mix(in srgb,var(--nc) 22%,white);
            background: color-mix(in srgb,var(--nc) 8%,white);
            color: var(--nc)
        }

        .team-toggle-btn:active {
            transform: scale(.92)
        }

    .node.active {
        border-top-color: var(--nc);
        border-left-color: color-mix(in srgb,var(--nc) 55%,var(--border));
        border-right-color: color-mix(in srgb,var(--nc) 55%,var(--border));
        border-bottom-color: color-mix(in srgb,var(--nc) 55%,var(--border));
        box-shadow: 0 4px 18px color-mix(in srgb,var(--nc) 16%,transparent),var(--shadow-card)
    }

    .manager-container {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: flex-start;
        width: 100%;
        gap: 20px;
        flex-wrap: wrap;
        margin: 32px 0 0;
        padding-top: 0;
        padding-bottom: 16px;
        position: relative
    }

    .manager-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        animation: fadeUp .3s ease both
    }

    .tl-horizontal-container {
        display: none;
        flex-direction: column;
        align-items: center;
        position: relative;
        width: max-content;
        min-width: 100%;
        margin-top: 16px;
        padding-top: 20px;
        animation: expandTree .24s ease both
    }

        .tl-horizontal-container::before {
            content: "";
            position: absolute;
            top: 0;
            left: 50%;
            width: var(--line-w);
            height: 20px;
            background: var(--connector);
            transform: translateX(-50%);
            border-radius: 2px
        }

    .tl-horizontal-line {
        height: var(--line-w);
        width: 100%;
        min-width: 160px;
        margin-bottom: 20px;
        background: var(--connector);
        border-radius: 2px
    }

    .tl-row {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        width: 100%
    }

    .tl-column {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        padding-top: 20px
    }

        .tl-column::before {
            content: "";
            position: absolute;
            top: 0;
            left: 50%;
            width: var(--line-w);
            height: 20px;
            background: var(--connector);
            transform: translateX(-50%);
            border-radius: 2px
        }

        .tl-column > .tl-horizontal-container {
            display: none;
            flex-direction: column !important;
            align-items: center;
            margin-top: 12px;
            min-width: unset;
            width: max-content
        }

            .tl-column > .tl-horizontal-container > .tl-horizontal-line {
                display: none
            }

            .tl-column > .tl-horizontal-container > .tl-row {
                flex-direction: column !important;
                align-items: center;
                gap: 10px
            }

                .tl-column > .tl-horizontal-container > .tl-row > .tl-column {
                    padding-top: 0
                }

                    .tl-column > .tl-horizontal-container > .tl-row > .tl-column::before {
                        display: none
                    }

    .manager-vertical-connector {
        display: none
    }

    .tree::-webkit-scrollbar, .tl-row::-webkit-scrollbar {
        width: 5px;
        height: 5px
    }

    .tree::-webkit-scrollbar-thumb, .tl-row::-webkit-scrollbar-thumb {
        background: var(--connector);
        border-radius: 10px
    }

    .tree::-webkit-scrollbar-track, .tl-row::-webkit-scrollbar-track {
        background: transparent
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(10px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    @@keyframes expandTree {
        from {
            opacity: 0;
            transform: translateY(-6px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    @@media (max-width:768px) {
        .tree {
            padding: 28px 10px 50px;
            border-radius: 14px
        }

        .manager-container {
            justify-content: flex-start;
            flex-wrap: nowrap;
            overflow-x: auto;
            padding: 0 20px 24px;
            gap: 14px;
            scroll-snap-type: x mandatory
        }

        .manager-block {
            flex: 0 0 auto;
            scroll-snap-align: center
        }

        .tl-row {
            flex-wrap: nowrap;
            justify-content: flex-start;
            overflow-x: auto;
            padding: 0 16px 16px;
            scroll-snap-type: x mandatory
        }

        .tl-column {
            flex: 0 0 auto;
            scroll-snap-align: center
        }

        .node[data-role="ceo"] {
            min-width: 210px
        }

        .node[data-role="manager"] {
            min-width: 198px
        }

        .node[data-role="assimanager"] {
            min-width: 198px
        }

        .node[data-role="team-lead"] {
            min-width: 188px
        }

        .node[data-role="executive"] {
            min-width: 180px
        }
    }

    .modal-content {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(0,0,0,.25)
    }

    .modal-header {
        padding: 14px 18px;
        border-bottom: none !important;
        display: flex;
        align-items: center;
        justify-content: space-between
    }

    .modal-header-content {
        display: flex;
        align-items: center;
        gap: 10px
    }

    .modal-icon-box {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: rgba(255,255,255,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 13px
    }

    .btn-close-custom {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: rgba(220,50,50,.18);
        border: 1.5px solid rgba(220,80,80,.45);
        color: #f87171;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 12px;
        transition: background .2s,color .2s;
        padding: 0;
        line-height: 1
    }

        .btn-close-custom:hover {
            background: rgba(220,50,50,.4);
            color: #fff;
            border-color: rgba(220,80,80,.75)
        }

    .modal-body {
        padding: 14px 16px;
        background: #fff
    }

    .employee-info-header {
        display: flex;
        flex-direction: column;
        gap: 2px
    }

    .modal-title.employee-name {
        color: #fff !important;
        font-size: 14px !important;
        font-weight: 600 !important;
        margin: 0 !important;
        line-height: 1.3
    }

    .employee-code {
        color: rgba(255,255,255,.55);
        font-size: 11px;
        font-weight: 400
    }

    .stats-label {
        font-size: 10px;
        font-weight: 600;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin: 0 0 8px
    }

    .company-stats {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 8px
    }

    .company-stat {
        padding: 10px 8px;
        border-radius: 10px;
        text-align: center;
        position: relative;
        overflow: hidden;
        transition: transform .2s,box-shadow .2s
    }

        .company-stat:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 14px rgba(0,0,0,.08)
        }

        .company-stat::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: 10px 10px 0 0
        }

        .company-stat.total::before {
            background: linear-gradient(90deg,#3b82f6,#2563eb)
        }

        .company-stat.paid::before {
            background: linear-gradient(90deg,#10b981,#059669)
        }

        .company-stat.unpaid::before {
            background: linear-gradient(90deg,#f97316,#ea580c)
        }

        .company-stat.fresh::before {
            background: linear-gradient(90deg,#8b5cf6,#7c3aed)
        }

        .company-stat.followup::before {
            background: linear-gradient(90deg,#60a5fa,#2563eb)
        }

        .company-stat.service::before {
            background: linear-gradient(90deg,#34d399,#059669)
        }

    .stat-icon {
        font-size: 14px;
        margin-bottom: 5px
    }

    .company-stat.total .stat-icon {
        color: #2563eb
    }

    .company-stat.paid .stat-icon {
        color: #059669
    }

    .company-stat.unpaid .stat-icon {
        color: #ea580c
    }

    .company-stat.fresh .stat-icon {
        color: #7c3aed
    }

    .company-stat.followup .stat-icon {
        color: #2563eb
    }

    .company-stat.service .stat-icon {
        color: #059669
    }

    .company-stat .stat-title {
        display: block;
        font-size: 10px;
        color: #64748b;
        margin-bottom: 4px;
        font-weight: 500
    }

    .company-stat strong {
        display: block;
        font-size: 20px;
        font-weight: 700;
        line-height: 1
    }

    .company-stat.total {
        background: #eff6ff;
        color: #2563eb
    }

    .company-stat.paid {
        background: #ecfdf5;
        color: #059669
    }

    .company-stat.unpaid {
        background: #fff7ed;
        color: #ea580c
    }

    .company-stat.fresh {
        background: #f5f3ff;
        color: #7c3aed
    }

    .company-stat.followup {
        background: #eff6ff;
        color: #2563eb
    }

    .company-stat.service {
        background: #ecfdf5;
        color: #059669
    }

    .total-meetings-bar {
        background: linear-gradient(100deg,#0b0f14,#1a3e66);
        border-radius: 10px;
        padding: 10px 14px;
        margin-top: 8px
    }

    .total-meetings-info {
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: #fff;
        font-size: 13px
    }

        .total-meetings-info strong {
            font-size: 18px;
            font-weight: 700;
            color: #fff
        }

    @@media (min-width:1400px) {
        .modal-xxl {
            max-width: 1320px !important
        }
    }

    .renewal-marquee {
        position: relative;
        width: 100%;
        height: 33px;
        margin: 0 0 18px 0;
        display: flex;
        align-items: center;
        overflow: hidden;
        border-radius: 9px;
        box-shadow: 0 2px 6px rgba(16,30,54,.04)
    }

    .renewal-marquee-track {
        position: absolute;
        left: 0;
        right: 150px;
        height: 100%;
        display: flex;
        align-items: center;
        overflow: hidden;
        white-space: nowrap
    }

    .renewal-marquee-content {
        display: inline-flex;
        align-items: center;
        width: max-content;
        animation: renewalScroll 18s linear infinite
    }

    .renewal-message {
        display: inline-flex;
        align-items: center;
        padding-right: 100px;
        color: #345374;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap
    }

        .renewal-message i {
            margin-right: 7px;
            color: #ea580c;
            font-size: 12px
        }

    @@keyframes renewalScroll {
        from {
            transform: translateX(100%)
        }

        to {
            transform: translateX(-100%)
        }
    }

    .renewal-marquee:hover .renewal-marquee-content {
        animation-play-state: paused
    }

    @@media (max-width:768px) {
        .renewal-marquee {
            height: 40px
        }

        .renewal-marquee-track {
            right: 120px
        }

        .renewal-message {
            font-size: 10px;
            padding-right: 70px
        }
    }

    .renewal-header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px
    }

    .renewal-filter-btn {
        border: 0;
        background: transparent;
        color: #94a3b8;
        cursor: pointer;
        padding: 2px 4px
    }

        .renewal-filter-btn:hover, .renewal-filter-btn.active {
            color: #2563eb
        }

    .renewal-filter-dropdown {
        background: #fff;
        border: 1px solid #d9dee7;
        border-radius: 8px;
        box-shadow: 0 8px 25px rgba(0,0,0,.15);
        padding: 10px
    }

    .renewal-filter-select-all {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 6px 4px;
        cursor: pointer;
        font-size: 12px
    }

    .renewal-filter-divider {
        border-top: 1px solid #e5e7eb;
        margin: 5px 0
    }

    .renewal-filter-options {
        max-height: 220px;
        overflow-y: auto
    }

    .renewal-filter-option {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 5px 4px;
        margin: 0;
        cursor: pointer;
        font-size: 12px;
        color: #475569
    }

        .renewal-filter-option:hover {
            background: #f1f5f9
        }

    .renewal-filter-actions {
        display: flex;
        justify-content: flex-end;
        gap: 6px;
        border-top: 1px solid #e5e7eb;
        margin-top: 8px;
        padding-top: 8px
    }

    .renewal-filter-dropdown::-webkit-scrollbar, .renewal-filter-options::-webkit-scrollbar {
        width: 5px
    }

    .renewal-filter-dropdown::-webkit-scrollbar-thumb, .renewal-filter-options::-webkit-scrollbar-thumb {
        background: #94a3b8;
        border-radius: 10px
    }

    #commonModalBody .renewal-table-wrapper {
        max-height: 420px;
        overflow-y: auto;
        overflow-x: auto;
