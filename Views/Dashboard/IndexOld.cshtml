</style>
@functions {
    private string Safe(object value)
    {
        return HtmlEncoder.Default.Encode(Convert.ToString(value) ?? "");
    }
    private string DataRole(string role)
    {
        if (string.IsNullOrWhiteSpace(role))
            return "executive";
        return role.Trim().ToLowerInvariant() switch
        {
            "ceo" => "ceo",
            "branch manager" => "manager",
            "cluster manager" => "assimanager",
            "manager" => "team-lead",
            "executive" => "executive",
            _ => "executive"
        };
    }
    private static List<EmployeeNode> GetTeam(EmployeeNode e)
    {
        return e.Children?
            .Where(c => !string.Equals(c.EmpCode?.Trim(), e.EmpCode?.Trim(), StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(c => c.Children != null && c.Children.Count > 0)
            .ToList()
            ?? new List<EmployeeNode>();
    }
    private string RenderNode(EmployeeNode emp, int teamCount)
    {
        var role = DataRole(emp.CustRole);
        var id = Safe(emp.EmpCode);
        var hasTeam = teamCount > 0;
        var teamHtml = hasTeam ? $@"<div class='team-count-wrapper'><small class='team-count'>Team: {teamCount}</small><button type='button' class='team-toggle-btn' onclick='event.stopPropagation(); toggleTeamLeads(this.closest("".node""))' aria-label='Toggle team'>+</button></div>" : "";
        var nodeAttrs = hasTeam ? $"data-manager-id='{id}' onclick='toggleTeamLeads(this)'" : "";
        return $@"<div class='node' data-role='{role}' data-empcode='{id}' {nodeAttrs}><div class='node-avatar'>{Safe(GetInitials(emp.Name))}</div><div><strong>{Safe(emp.Name)}</strong><small class='empcode'>{id}</small><small class='employee-role'><i class='fas fa-user-tag'></i>{Safe(emp.Role)}</small>{teamHtml}</div><button type='button' class='employee-info-btn' data-empcode='{id}' onclick='event.stopPropagation(); showEmployeeInfo(this);' title='Employee Information'><i class='fas fa-info'></i></button></div>";
    }
    private IHtmlContent RenderEmployeeChildren(EmployeeNode employee, string employeeId)
    {
        var html = new HtmlContentBuilder();
        var children = GetTeam(employee);
        if (!children.Any()) return html;
        html.AppendHtml($"<div class='tl-horizontal-container' data-manager-id='{Safe(employeeId)}'><div class='tl-horizontal-line'></div><div class='tl-row'>");
        foreach (var child in children)
        {
            var childTeam = GetTeam(child);
            html.AppendHtml("<div class='tl-column'>");
            html.AppendHtml(RenderNode(child, childTeam.Count));
            if (childTeam.Any())
            {
                html.AppendHtml($"<div class='manager-vertical-connector' data-manager-id='{Safe(child.EmpCode)}'></div>");
                html.AppendHtml(RenderEmployeeChildren(child, child.EmpCode));
            }
            html.AppendHtml("</div>");
        }
        html.AppendHtml("</div></div>");
        return html;
    }
    private IHtmlContent RenderManagers(EmployeeNode root)
    {
        var html = new HtmlContentBuilder();
        var children = GetTeam(root);
        if (!children.Any()) return html;
        html.AppendHtml("<div class='level'><div class='manager-container' style='display:flex;'>");
        foreach (var emp in children)
        {
            var team = GetTeam(emp);
            html.AppendHtml("<div class='manager-block'>");
            html.AppendHtml(RenderNode(emp, team.Count));
            if (team.Any())
            {
                html.AppendHtml($"<div class='manager-vertical-connector' data-manager-id='{Safe(emp.EmpCode)}'></div>");
                html.AppendHtml(RenderEmployeeChildren(emp, emp.EmpCode));
            }
            html.AppendHtml("</div>");
        }
        html.AppendHtml("</div></div>");
        return html;
    }
    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpper();
    }
}
@if (root == null)
{
    <div class="alert alert-warning m-3">No data found for your account.</div>
}
else
{
