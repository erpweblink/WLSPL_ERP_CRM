@model WEBLINK_CRM.Models.RegisterUserr

@{
    ViewData["Title"] = "Create User";
}

<style>
    .user-page {
        background: #f5f7fa;
        padding: 20px;
        min-height: calc(100vh - 80px);
    }

    .user-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0,0,0,.08);
        overflow: hidden;
        background: #fff;
    }

    .user-header {
        background: linear-gradient(314deg, #0b0f14, #1a3e66);
        color: #fff;
        padding: 16px 20px;
    }

        .user-header h3 {
            margin: 0;
            font-size: 21px;
            font-weight: 600;
        }

    .user-body {
        padding: 25px;
    }

    .form-label {
        font-weight: 600;
        color: #344054;
        margin-bottom: 6px;
    }

    .form-control,
    .form-select {
        height: 44px;
        border: 1px solid #d0d5dd;
        border-radius: 8px;
        font-size: 14px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .15rem rgba(13,110,253,.12);
        }

    .field-group {
        margin-bottom: 18px;
    }

    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: #1a3e66;
        border-bottom: 1px solid #e5e7eb;
        padding-bottom: 8px;
        margin: 5px 0 20px;
    }

    .btn {
        height: 42px;
        border-radius: 8px;
        font-weight: 600;
        padding: 0 20px;
    }

    .btn-success {
        background: #198754;
        border: none;
    }

        .btn-success:hover {
            background: #157347;
        }

    .btn-danger {
        background: #dc3545;
        border: none;
    }

        .btn-danger:hover {
            background: #bb2d3b;
        }

    .validation-message {
        font-size: 12px;
    }

    .required {
        color: #dc3545;
    }
</style>

<div class="user-page">

    <div class="user-card">

        <!-- Header -->
        <div class="user-header">
            <h3>
                <i class="fa fa-user-plus me-2"></i>
                Create New User
            </h3>
        </div>

        <!-- Body -->
        <div class="user-body">

            <form asp-action="Create" method="post" enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- Hidden Fields -->
                <input asp-for="empcode" type="hidden" />
                <input asp-for="isdeleted" type="hidden" />
                <input asp-for="regdate" type="hidden" />
                <input asp-for="ProfileImagePath" type="hidden" />

                <!-- ================= ACCOUNT DETAILS ================= -->

                <div class="section-title">
                    <i class="fa fa-user me-2"></i>
                    Account Details
                </div>

                <div class="row">



                    <!-- Name -->
                    <div class="col-md-4 field-group">

                        <label class="form-label">
                            Name <span class="required">*</span>
                        </label>

                        <input asp-for="name"
                               class="form-control"
                               placeholder="Enter full name" />

                        <span asp-validation-for="name"
                              class="text-danger validation-message">
                        </span>

                    </div>


                    <!-- Mobile -->
                    <div class="col-md-4 field-group">

                        <label class="form-label">
                            Mobile
                        </label>

                        <input asp-for="mobile"
                               type="tel"
                               class="form-control"
                               placeholder="Enter mobile number" />

                        <span asp-validation-for="mobile"
                              class="text-danger validation-message">
                        </span>

                    </div>


                    <!-- Registration Date -->
                    <div class="col-md-4 field-group">

                        <label class="form-label">
                            Registration Date
                        </label>

                        <input asp-for="regdate"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="regdate"
                              class="text-danger validation-message">
                        </span>

                    </div>


                    <!-- Profile Image -->
                    <div class="col-md-4 field-group">

                        <label class="form-label">
                            Profile Image
                        </label>

                        <input type="file"
                               name="ProfileImage"
                               class="form-control"
                               accept="image/*" />

                    </div>


                </div>


                <!-- ================= PASSWORD DETAILS ================= -->

                <div class="section-title mt-3">
                    <i class="fa fa-lock me-2"></i>
                    Password Details
                </div>

                <div class="row">

                    <!-- Email -->
                    <div class="col-md-4 field-group">

                        <label class="form-label">
                            Email <span class="required">*</span>
                        </label>

                        <input asp-for="email"
                               type="email"
                               class="form-control"
                               placeholder="Enter email address" />

                        <span asp-validation-for="email"
                              class="text-danger validation-message">
                        </span>

                    </div>
                    <!-- Email Password -->
                    <div class="col-md-4 field-group">

                        <label class="form-label">
                            Email Password
                        </label>

                        <input asp-for="emailpsw"
                               type="text"
                               class="form-control"
                               placeholder="Enter email password" />

                        <span asp-validation-for="emailpsw"
                              class="text-danger validation-message">
                        </span>

                    </div>

                </div>
                <div class="row">
                    <!-- Username -->
                    <div class="col-md-4 field-group">

                        <label class="form-label">
                            Username <span class="required">*</span>
                        </label>

                        <input asp-for="UserName"
                               class="form-control"
                               placeholder="Enter username"
                               autocomplete="off" />

                        <span asp-validation-for="UserName"
                              class="text-danger validation-message">
                        </span>

                    </div>
                    <!-- Panel Password -->
                    <div class="col-md-4 field-group">

                        <label class="form-label">
                            Panel Password
                        </label>

                        <input asp-for="panelpsw"
                               type="text"
                               class="form-control"
                               placeholder="Enter panel password" />

                        <span asp-validation-for="panelpsw"
                              class="text-danger validation-message">
                        </span>

                    </div>
                </div>





                <!-- ================= ROLE & ACCESS ================= -->

                <div class="section-title mt-3">
                    <i class="fa fa-shield me-2"></i>
                    Role & Access
                </div>

                <div class="row">

                    <!-- Department -->
                    <div class="col-md-4 field-group">

                        <label class="form-label">
                            Department
                        </label>

                        <select asp-for="Department"
                                class="form-select">

                            <option value="">
                                Select Department
                            </option>

                            <option value="Sales">
                                Sales
                            </option>

                            <option value="HR">
                                HR
                            </option>

                            <option value="Purchase">
                                Software
                            </option>

                            <option value="Production">
                                Testing
                            </option>

                            <option value="Service">
                                Social Media
                            </option>

                            <option value="Store">
                                Web Developer
                            </option>

                            <option value="Management">
                                SEO
                            </option>


                        </select>

                        <span asp-validation-for="Department"
                              class="text-danger validation-message">
                        </span>

                    </div>

                    <!-- Role -->
                    <div class="col-md-4 field-group">

                        <label class="form-label">
                            Role <span class="required">*</span>
                        </label>

                        <select asp-for="role"
                                class="form-select">

                            <option value="">
                                Select Role
                            </option>

                            <option value="Admin">
                                CEO
                            </option>

                            <option value="Sub Admin">
                                Cluster Manager
                            </option>

                            <option value="Sales">
                                Branch Manager
                            </option>

                            <option value="HR">
                                Manager
                            </option>

                            <option value="BDE">
                                Team Leader
                            </option>
                            <option value="User">
                                Executive
                            </option>
                            <option value="User">
                                User
                            </option>

                        </select>

                        <span asp-validation-for="role"
                              class="text-danger validation-message">
                        </span>

                    </div>


                    <!-- Team Leader -->
                    <div class="col-md-4 field-group">

                        <label class="form-label">
                            Team Leader
                        </label>

                        <select asp-for="TL_Manager"
                                asp-items="Model.SalesTLList"
                                class="form-select">

                            <option value="">
                                Select Team Leader
                            </option>

                        </select>

                        <span asp-validation-for="TL_Manager"
                              class="text-danger validation-message">
                        </span>

                    </div>

                    <!-- Status -->
                    <div class="col-md-4 field-group">

                        <label class="form-label">
                            Status
                        </label>

                        <select asp-for="status"
                                class="form-select">

                            <option value="true">
                                Active
                            </option>

                            <option value="false">
                                Inactive
                            </option>

                        </select>

                        <span asp-validation-for="status"
                              class="text-danger validation-message">
                        </span>

                    </div>

                </div>


                <!-- ================= BUTTONS ================= -->

                <div class="row mt-4">

                    <div class="col-12 d-flex justify-content-center gap-2">

                        <button type="submit"
                                class="btn btn-success">

                            <i class="fa fa-save me-1"></i>
                            Save User

                        </button>

                        <a asp-action="Index"
                           class="btn btn-danger">

                            <i class="fa fa-arrow-left me-1"></i>
                            Back

                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>
</div>

