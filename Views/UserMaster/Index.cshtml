@model IEnumerable<WEBLINK_CRM.Models.RegisterUserr>

@{
    ViewData["Title"] = "User Management";
}

<style type="text/css">
    .search-box {
        width: 315px;
        height: 35px;
        font-size: 13px;
        border-radius: 6px;
    }

    .record-info {
        font-size: 13px;
        color: #6c757d;
    }

        .record-info strong {
            color: #212529;
        }

    .table tbody td {
        font-size: 13px;
        vertical-align: middle;
    }

    .table tbody tr:hover {
        background: #f4f8ff;
    }

    .lead-code {
        color: #0d6efd;
        font-weight: 600;
    }

    .company-name {
        font-weight: 600;
    }

    .badge-new {
        background: #0d6efd;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
    }

    .badge-active {
        background: #198754;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
    }

    .badge-pending {
        background: #ffc107;
        color: #212529;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
    }

    .badge-inactive {
        background: #dc3545;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
    }

    .action-btn {
        width: 32px;
        height: 30px;
        padding: 5px;
        border-radius: 5px;
    }

    .edit-btn {
        background: #ffc107;
        border-color: #ffc107;
        color: #000;
    }

    .delete-btn {
        background: #dc3545;
        border-color: #dc3545;
        color: #fff;
    }

    .badge-default {
        background: #6c757d;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
    }

    .source-badge {
        background: #e9ecef;
        color: #495057;
        padding: 5px 9px;
        border-radius: 15px;
        font-size: 11px;
        font-weight: 600;
    }

    .no-record {
        text-align: center;
        padding: 30px !important;
        color: #777;
    }

    .active-status {
        background-color: #198754 !important;
        color: #ffffff !important;
        padding: 6px 12px !important;
        border-radius: 20px !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        display: inline-block;
    }

    .inactive-status {
        background-color: #dc3545 !important;
        color: #ffffff !important;
        padding: 6px 12px !important;
        border-radius: 20px !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        display: inline-block;
    }

    .pagination {
        margin-bottom: 0;
    }

        .pagination .page-link {
            font-size: 12px;
            padding: 6px 11px;
            color: #0d6efd;
        }

        .pagination .active .page-link {
            background-color: #142c45;
            border-color: #142d47;
            color: #ffffff;
        }

        .pagination .page-link:hover {
            background-color: #e9f2ff;
        }

</style>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h3 class="page-title mb-0">
            <i class="fa fa-users"></i>
            User Management
        </h3>

        <a asp-action="Create"
           class="btn btn-primary btn-sm">
            <i class="fa fa-plus"></i>
            Add New User
        </a>
    </div>


    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-4">
                <input type="text"
                       id="searchInput"
                       class="form-control search-box"
                       placeholder="Search employee..." />
            </div>

            <div class="col-md-8 d-flex justify-content-end align-items-center">
                <span class="record-info">
                    Total Records :
                    <strong id="totalRecords">@Model.Count()</strong>
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover"
                   id="userTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Employee Code</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>User Name</th>

                        <th>TL Manager</th>
                        <th>Sales TL</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int count = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@count</td>
                            <td>@item.empcode</td>
                            <td>
                                <strong>@item.name</strong>
                            </td>
                            <td>@item.email</td>
                            <td>@item.mobile</td>
                            <td>@item.role</td>
                            <td>
                                @if (item.status)
                                {
                                    <span class="badge active-status">
                                        <i class="fa fa-check-circle"></i>
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge inactive-status">
                                        <i class="fa fa-times-circle"></i>
                                        Inactive
                                    </span>
                                }

                            </td>

                            <td>@item.UserName</td>

                            <td>@item.TL_Manager</td>

                            <td>@item.Sales_TL_Manager</td>

                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.id"
                                       class="btn btn-warning btn-sm action-btn edit-btn"
                                       title="Edit">

                                        <i class="fa fa-edit"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.id"
                                       onclick="return confirm('Are you sure you want to delete this user?')"
                                       class="btn btn-danger btn-sm action-btn delete-btn"
                                       title="Delete">

                                        <i class="fa fa-trash"></i>

                                    </a>
                                </div>

                            </td>


                        </tr>


                        count++;

                    }


                </tbody>
            </table>
            <!-- Pagination -->
            <nav>
                <ul class="pagination justify-content-center mt-3"
                    id="pagination">
                </ul>
            </nav>
        </div>
    </div>
</div>

<script type="text/javascript">
     const rowsPerPage = 10;
    let currentPage = 1;
    const tableRows = document.querySelectorAll("#userTable tbody tr");

    function displayTable(page) {
        let start = (page - 1) * rowsPerPage;
        let end = start + rowsPerPage;
        tableRows.forEach((row, index) => {
            row.style.display = (index >= start && index < end) ? "" : "none";
        });
        createPagination();
    }

    function createPagination() {
        let pages = Math.ceil(tableRows.length / rowsPerPage);
        let pagination = document.getElementById("pagination");
        pagination.innerHTML = "";
        for (let i = 1; i <= pages; i++) {
            let li = document.createElement("li");
            li.className = "page-item " + (i == currentPage ? "active" : "");
            li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
            li.onclick = function() {
                currentPage = i;
                displayTable(i);
            };
            pagination.appendChild(li);
        }
    }

    document.getElementById("searchInput").addEventListener("keyup", function() {
        let value = this.value.toLowerCase();
        tableRows.forEach(row => {
            row.style.display = row.innerText.toLowerCase().includes(value) ? "" : "none";
        });
    });

    displayTable(1);

</script>
